{
  "name": "@lararium/keyhive",
  "version": "0.1.0",
  "private": true,
  "description": "Keyhive (Ink & Switch concap) integration for the Lares stack — capability layer + probes against pre-alpha @keyhive/keyhive WASM bindings.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./operator-daemon-behavior": {
      "import": "./dist/src/operator-daemon-behavior.js",
      "types": "./dist/src/operator-daemon-behavior.d.ts"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "clean": "node ../../tools/clean-output.mjs dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@keyhive/keyhive": "0.1.0-alpha.8",
    "@lararium/mesh": "workspace:*",
    "@lararium/tw5": "workspace:*"
  },
  "devDependencies": {
    "@automerge/automerge": "3.4.1",
    "vitest": "4.1.11"
  }
}
