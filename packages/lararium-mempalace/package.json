{
  "name": "@lararium/mempalace",
  "version": "0.1.0",
  "private": true,
  "description": "The pinned upstream MemPalace library and guest-comparator boundary: client, holder caps, and spawn resolvers for the sovereign Sensorium in @lararium/sensorium.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./xdg-base": {
      "import": "./dist/xdg-base.js",
      "types": "./dist/xdg-base.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node ../../tools/clean-output.mjs dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@lararium/mesh": "workspace:*"
  }
}
