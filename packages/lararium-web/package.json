{
  "name": "@lararium/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lararium web surface — composes DOM, Vite, and projection capabilities with browser-native capabilities in one local Web device/context peer; when reachable, it reads the public @oracle face. Location-agnostic: served from localhost / LAN / elyncia.app, static distribution never grants authority.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@automerge/automerge-repo": "2.6.0-alpha.5",
    "@automerge/automerge-repo-storage-indexeddb": "2.6.0-alpha.5",
    "@lararium/browser": "workspace:*",
    "@lararium/mesh": "workspace:*",
    "@lararium/tw5": "workspace:*",
    "idiomorph": "0.8.0"
  },
  "devDependencies": {
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@keyhive/keyhive": "0.3.0-alpha.1",
    "@lararium/keyhive": "workspace:*",
    "vite": "8.3.4",
    "vite-plugin-arraybuffer": "0.1.4",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.0.5"
  }
}
