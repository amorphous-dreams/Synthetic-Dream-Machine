{
  "name": "@lararium/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lararium web surface — composes DOM, Vite, and projection capabilities with browser-native capabilities in one local Web device/context peer; when reachable, it reads the public @oracle face. Location-agnostic: served from localhost / LAN / elyncia.app, static distribution never grants authority.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@automerge/automerge": "3.4.1",
    "@automerge/automerge-repo": "2.6.0-alpha.3",
    "@automerge/automerge-repo-storage-indexeddb": "2.6.0-alpha.3",
    "@lararium/browser": "workspace:*",
    "@lararium/mesh": "workspace:*",
    "idiomorph": "0.7.4"
  },
  "devDependencies": {
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@keyhive/keyhive": "0.1.0-alpha.8",
    "@lararium/keyhive": "workspace:*",
    "vite": "8.2.2",
    "vite-plugin-arraybuffer": "0.1.4",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "4.1.11"
  }
}
