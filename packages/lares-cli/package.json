{
  "name": "@lares/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Lares operator CLI — lares vessel found, lares act (Residency Model ACTION verbs), lares wiki, lares bag, lares heleuma, … One entry point for every operator-facing ceremony.",
  "type": "module",
  "bin": {
    "lares": "./bin/lares.mjs"
  },
  "scripts": {
    "clean": "node ../../tools/clean-output.mjs dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/lares.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@lararium/memetic-frame": "workspace:*",
    "@lararium/mempalace": "workspace:*",
    "@lararium/mesh": "workspace:*",
    "@lararium/node": "workspace:*",
    "@lararium/sensorium": "workspace:*",
    "@lararium/tw5": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
