// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the per-command help registry > meme help publishes the required store target > meme help 1`] = `
{
  "examples": [
    "lares tiddler get lar:///ha.ka.ba/lares/api/corpus --recipe lares --meme   # READ a meme: the carrier, base on stderr (the one door)",
    "lares meme patch lar:///ha.ka.ba/... --recipe lares --slot '#/x' --append note.txt --base <hash>  # one slot's body through the put's gate, resealed",
    "lares meme put lar:///ha.ka.ba/... --recipe lares --file note.mem     # land a framed meme through the gate",
    "lares meme put lar:///ha.ka.ba/... --bag lar:///ha.ka.ba/bags/daemon-<relation> --face 1 --file note.mem   # a lit face writes its own lane, sealed by its own chain",
  ],
  "synopsis": "THE MEME DOOR — one family for every law over meme text, and each verb DECLARES ITS SEAT: \`normalize\` · \`check\` · \`sitting\` · \`project --to md\` (over a file) run LOCAL with no daemon in reach; \`put\` · \`patch\` · \`list\` · \`delete\` · \`project\` to any other target, or from a \`lar:\` uri, ride the daemon verb. A meme READS through the one door: \`lares tiddler get <uri> --recipe <slug> --meme\` (whole within a page, its has-stack past it; \`--all\` the whole carrier). Store-backed verbs require \`(--recipe <slug> | --bag <slug>)\`; \`--recipe\` edits AS the named wiki; \`--bag\` places into that bag and REFUSES when this island cannot write it; \`--realm <id>\` beside \`--bag\` names the realm whose registration that bag resolves through, and reads that realm alone. \`--base\` carries the canonical hash last read — a record that moved past it CONFLICTS and nothing lands.",
  "usage": "usage: lares meme <put | patch | list | delete | normalize | check | sitting | project | promote | offer> (store verbs require (--recipe <slug> | --bag <slug>))",
}
`;
