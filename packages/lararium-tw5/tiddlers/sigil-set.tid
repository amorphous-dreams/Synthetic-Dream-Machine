lar-pattern: <<~\s*set\b((?:[^>]|>(?!>))*)>>
lar-example: <<~ set lares=`aim` from=`lar:///a.b.c/x` to=`lar:///a.b.c/y` mode=`build` aperture=`9/measure` ooda-ha=`7/declare-glyphs` drift-ward=`a pull`>>
type: text/vnd.tiddlywiki

<!-- set — the TURN FRAME, one sigil, three firings. The `lares` key names the firing: `aim` opens the
     turn and seeds the gauges, `steer` turns it mid-way (a new `to`, and/or any other key), `yield`
     closes it and slides them. `lares` leads every firing. The aim seats `from` and `to` right after it
     and the ward LAST; the yield seats the ward right after it and `from` and `to` LAST; a steer seats
     `to` (when it carries one) right after it and the ward LAST. `mode mood mu stance aperture ooda-ha`
     ride between in any order and `note` trails at the very end: the WRITTEN brackets carry the
     chiasmus, and the three `set-*` procedures hold one canonical order per firing, so the renderer
     sorts the keys into it. A key left blank writes nothing, so an absent instrument reads absent
     rather than empty. Absent `lares`, the sigil rides only as an in-content cite or hand-off.
     The definitions below match the boot seed's `#/set-and-setting` block key for key. -->

\procedure set-aim() lares from to mode mood mu stance aperture ooda-ha drift-ward
\procedure set-steer() lares to mode mood mu stance aperture ooda-ha drift-ward
\procedure set-yield() lares drift-ward aperture ooda-ha mode mood mu stance from to

\procedure ~set(lares mode mood mu stance aperture ooda-ha drift-ward from to note)
\whitespace trim
~ set&#32;{{{ [<lares>match[yield]then<set-yield>] :else[<lares>match[steer]then<set-steer>] :else[<set-aim>] +[enlist-input[]]
:filter[getvariable[]!is[blank]]
:map[getvariable[]addprefix[=`]addprefix<currentTiddler>addsuffix[`]]
+[join[ ]] }}}&#32;{{{ [<note>!is[blank]addprefix[note=`]addsuffix[`]] }}}
\end
