title: lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-season
tags: $:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil
lar-kind: relation
lar-pono-uri: lar:///ha.ka.ba/lares/api/noosphere-boot
lar-pattern: <<~\s*season\s+name=`([\w.-]+)`(?:\s+params=`([^`]*)`)?\s*>>
lar-example: <<~ season name=`winter` params=`the tending turn`>>
type: text/vnd.tiddlywiki

<!-- season — a SEASON and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, each named and ticked.

     A SECOND WORD NAMING A CHILD SLOT OPENS A COMPOUND. `<<~ season kau …>>` reads as
     `season~kau` and reaches no definition — the slot names are `ahu` and `kau`, and any
     sigil whose second word is one of them binds a compound, its slot riding as `slot=`#…``. -->

\procedure ~season(name:"" params:"")
<$transclude $variable="~has" entity="season" name=<<name>> params=<<params>>/>
\end
