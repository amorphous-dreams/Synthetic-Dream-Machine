lar-alias-for: integrity
lar-pattern: <<~\s*integrity\s+([\w.-]+)(?:\s+"?((?:[^"]|"(?!\s*>>))*)"?)?\s*>>
lar-example: <<~ integrity pattern "one spelling, one act">>
type: text/vnd.tiddlywiki

<!-- integrity — an INTEGRITY and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, quoted. -->

\procedure ~integrity(p1:"" p2:"")
<$transclude $variable="~has" p1="integrity" p2=<<p1>> p3=<<p2>>/>
\end
