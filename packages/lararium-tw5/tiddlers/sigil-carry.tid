<!-- carry — what a turn CARRIES forward. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, each named and ticked. -->

\procedure ~carry(name:"" params:"")
<$transclude $variable="~has" entity="carry" name=<<name>> params=<<params>>/>
\end
