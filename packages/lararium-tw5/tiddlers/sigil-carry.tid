<!-- carry — what a turn CARRIES forward. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, quoted. -->

\procedure ~carry(p1:"" p2:"")
<$transclude $variable="~has" p1="carry" p2=<<p1>> p3=<<p2>>/>
\end
