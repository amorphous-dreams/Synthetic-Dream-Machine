<!-- mu — a TOOL of the four, and the standpoint it carries. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, each named and ticked. -->

\procedure ~mu(name:"" params:"")
<$transclude $variable="~has" entity="mu" name=<<name>> params=<<params>>/>
\end
