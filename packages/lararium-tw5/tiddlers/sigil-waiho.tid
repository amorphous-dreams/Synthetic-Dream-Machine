lar-open-pattern: <<~\s*waiho\s+([\w-]+)\s+([^\n>]+?)\s*>>
lar-close-pattern: <<~\/waiho\s*>>
lar-pragma-pattern: <<~!\s*waiho\s+([\w-]+)\s+([^\n>]+?)\s*>>
