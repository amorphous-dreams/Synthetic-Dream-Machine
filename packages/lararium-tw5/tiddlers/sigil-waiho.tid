title: lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-waiho
tags: $:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil
lar-kind: pragma
lar-pono-uri: lar:///ha.ka.ba/lares/api/pono/waiho
lar-see-also: let
lar-open-pattern: <<~\s*waiho\s+name=`([\w-]+)`\s+value=`([^`]*)`(?:\s+sigil=`[^`]*`)?\s*>>
lar-close-pattern: <<~\/waiho\s*>>
lar-pragma-pattern: <<~!\s*waiho\s+name=`([\w-]+)`\s+value=`([^`]*)`(?:\s+sigil=`[^`]*`)?\s*>>
lar-example: <<~ waiho name=`name` value=`value`>>\nbody\n<<~/waiho>>
type: text/vnd.tiddlywiki

<!-- waiho — `<<~ waiho name value>>body<<~/waiho>>` binds `name` for the body's duration (block-scoped).
     `<<~! waiho name value>>` (lar-pragma-pattern, PRAGMA_HAND_KEPT) carries no closer: it
     hoists to the top of the carrier's execution context, immutable by convention
     (api/pono/waiho.mem #/law) — a genuinely DIFFERENT posture from the block form, not a cosmetic
     `!` variant, so it rides its own pattern field/eventType rather than folding into open/close. -->

\procedure ~waiho(name:"" value:"" sigil:"")
<$set name=<<name>> value=<<value>>><$transclude $variable="~" name=<<sigil>>/></$set>
\end
