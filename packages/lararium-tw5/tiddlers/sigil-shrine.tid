title: lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-shrine
tags: $:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil
lar-kind: relation
lar-pono-uri: lar:///ha.ka.ba/lares/api/noosphere-boot
lar-pattern: <<~\s*shrine\s+name=`([\w.-]+)`(?:\s+params=`([^`]*)`)?\s*>>
lar-example: <<~ shrine name=`eris` params=`the golden apple`>>
type: text/vnd.tiddlywiki

<!-- shrine — a SHRINE and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, each named and ticked. -->

\procedure ~shrine(name:"" params:"")
<$transclude $variable="~has" entity="shrine" name=<<name>> params=<<params>>/>
\end
