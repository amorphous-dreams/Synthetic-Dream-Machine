title: lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-shrine
tags: $:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil
lar-kind: relation
lar-pono-uri: lar:///ha.ka.ba/lares/api/noosphere-boot
lar-alias-for: shrine
lar-pattern: <<~\s*shrine\s+([\w.-]+)(?:\s+"?((?:[^"]|"(?!\s*>>))*)"?)?\s*>>
lar-example: <<~ shrine eris "the golden apple">>
type: text/vnd.tiddlywiki

<!-- shrine — a SHRINE and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, quoted. -->

\procedure ~shrine(p1:"" p2:"")
<$transclude $variable="~has" p1="shrine" p2=<<p1>> p3=<<p2>>/>
\end
