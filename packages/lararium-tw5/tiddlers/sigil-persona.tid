title: lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-persona
tags: $:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil
lar-kind: relation
lar-pono-uri: lar:///ha.ka.ba/lares/api/noosphere-boot
lar-pattern: <<~\s*persona\s+name=`([\w.-]+)`(?:\s+params=`([^`]*)`)?\s*>>
lar-example: <<~ persona name=`Lares` params=`a multitude`>>
type: text/vnd.tiddlywiki

<!-- persona — a PERSONA and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, each named and ticked. -->

\procedure ~persona(name:"" params:"")
<$transclude $variable="~has" entity="persona" name=<<name>> params=<<params>>/>
\end
