title: lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-persona
tags: $:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil
lar-kind: relation
lar-pono-uri: lar:///ha.ka.ba/lares/api/noosphere-boot
lar-alias-for: persona
lar-pattern: <<~\s*persona\s+([\w.-]+)(?:\s+"?((?:[^"]|"(?!\s*>>))*)"?)?\s*>>
lar-example: <<~ persona Lares "a multitude">>
type: text/vnd.tiddlywiki

<!-- persona — a PERSONA and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as
     that same relation under its own head: a NAME, and what it holds, quoted. -->

\procedure ~persona(p1:"" p2:"")
<$transclude $variable="~has" p1="persona" p2=<<p1>> p3=<<p2>>/>
\end
