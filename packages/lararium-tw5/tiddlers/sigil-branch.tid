lar-pattern: <<~\s*branch\s+"?((?:[^"\s>]|>(?!>))+)"?\s*>>
lar-example: <<~ branch "lar:///a.b.c/x">>
type: text/vnd.tiddlywiki

<!-- branch — the English mirror of `lele`, the side flow the caller does not wait on. The enclosing
     async context bounds it and cancels what remains when that context completes.

     ONE DEFINITION ANSWERS FOR BOTH. The mirror delegates to the head rather than restating it, so
     the discipline moves in one place. -->

\procedure ~branch(p1:"")
<$transclude $variable="~lele" p1=<<p1>>/>
\end
