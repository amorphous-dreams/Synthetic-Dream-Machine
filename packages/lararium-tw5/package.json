{
  "name": "@lararium/tw5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./meme-normalize": {
      "import": "./dist/meme-normalize.js",
      "types": "./dist/meme-normalize.d.ts"
    },
    "./root-meta": {
      "import": "./dist/root-meta.js",
      "types": "./dist/root-meta.d.ts"
    },
    "./form-layer": {
      "import": "./dist/form-layer/index.js",
      "types": "./dist/form-layer/index.d.ts"
    },
    "./carrier-canonical": {
      "import": "./dist/carrier-canonical.js",
      "types": "./dist/carrier-canonical.d.ts"
    },
    "./meme-ast": {
      "import": "./dist/meme-ast/index.js",
      "types": "./dist/meme-ast/index.d.ts"
    },
    "./memetic-wikitext-sensorium": {
      "import": "./dist/memetic-wikitext-sensorium.js",
      "types": "./dist/memetic-wikitext-sensorium.d.ts"
    },
    "./tw5-memes-root": {
      "import": "./tw5-memes-root.js",
      "types": "./tw5-memes-root.d.ts"
    },
    "./plugin-tiddler.generated": {
      "import": "./dist/plugin-tiddler.generated.js",
      "types": "./dist/plugin-tiddler.generated.d.ts"
    },
    "./weave": {
      "import": "./dist/weave/index.js",
      "types": "./dist/weave/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node ../../tools/clean-output.mjs dist dist-plugin",
    "build": "tsx scripts/build-plugin-tiddler.ts && tsc -p tsconfig.build.json && tsx scripts/sync-heleuma.ts",
    "build:tw5-vendor": "tsx scripts/build-tw5-vendor.ts",
    "build:heleuma": "tsx scripts/sync-heleuma.ts",
    "build:heleuma:commit": "tsx scripts/sync-heleuma.ts --commit",
    "build:plugin": "tsx scripts/build-plugin-tiddler.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:sigil-alignment": "tsx scripts/check-sigil-alignment.ts",
    "smoke:plugin-boot": "tsx scripts/smoke-plugin-boot.ts",
    "smoke:plugin-provenance": "tsx scripts/smoke-plugin-provenance.ts",
    "measure:frames": "tsx scripts/frame-baseline.ts",
    "measure:stock-tab": "tsx scripts/stock-tab-baseline.ts"
  },
  "dependencies": {
    "@lararium/memetic-frame": "workspace:*",
    "@lararium/mesh": "workspace:*",
    "@taplo/lib": "0.5.0",
    "smol-toml": "1.9.0",
    "tiddlywiki": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "tw5-typed": "1.1.5",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
