 over one wiki — exported so a test binds it to a wiki it constructs. */\nfunction memeFaceOf(wiki) {\n\tconst sink = (0, lararium_place_meme.wikiMemeSink)(wiki);\n\treturn {\n\t\tplace: (uri, text, base) => (0, lararium_place_meme.placeMeme)({\n\t\t\turi,\n\t\t\ttext,\n\t\t\tbaseHash: base ?? null\n\t\t}, sink),\n\t\tread: async (uri) => {\n\t\t\tif (await (0, lararium_place_meme.holdsUnreadPointer)(uri, sink)) throw new Error(`${lararium_place_meme.POINTER_BODY_CODE}: ${uri} holds a pointer whose body rests in the content tier; the meme face reads no pointer body`);\n\t\t\treturn (0, lararium_place_meme.readMeme)(uri, sink);\n\t\t},\n\t\tlist: (opts) => (0, lararium_place_meme.listMemes)(sink, opts),\n\t\tremove: (uri, base) => (0, lararium_place_meme.removeMeme)({\n\t\t\turi,\n\t\t\tbaseHash: base ?? null\n\t\t}, sink),\n\t\tnormalize: (text) => (0, lararium_meme_laws.normalizeMemeSource)(text),\n\t\tcheck: (text) => {\n\t\t\tconst { diagnostics } = memeticIngestOps.deserialize((0, _lararium_memetic_frame.headUriOf)(text) ?? \"\", text, (0, _lararium_memetic_frame.verdict)(text));\n\t\t\treturn {\n\t\t\t\tshape: (0, lararium_meme_laws.readCarrierShape)(text),\n\t\t\t\tcheck: (0, _lararium_memetic_frame.verifyBcc)(text),\n\t\t\t\tbcc: (0, _lararium_memetic_frame.bccOf)(text),\n\t\t\t\tedges: (0, lararium_meme_laws.readCarrierEdges)(text),\n\t\t\t\tgrade: gradeOf(diagnostics),\n\t\t\t\tdiagnostics\n\t\t\t};\n\t\t},\n\t\tproject: (uri, to, opts) => (0, lararium_meme_project.projectMeme)(wiki, uri, to, opts),\n\t\trecompose: (uri) => (0, lararium_meme_project.recomposeMeme)(wiki, uri),\n\t\tparse: (uri, text, grammar) => (0, lararium_meme_ast.parseMemeText)(uri, text, grammar ?? getGrammar() ?? void 0)\n\t};\n}\nfunction startup() {\n\tif (!$tw?.wiki) return;\n\t$tw.lares ??= {};\n\t$tw.lares.meme = memeFaceOf($tw.wiki);\n}\n//#endregion\nexports.after = after;\nexports.memeFaceOf = memeFaceOf;\nexports.name = name;\nexports.startup = startup;\nexports.synchronous = synchronous;\n","type":"application/javascript","module-type":"startup"},"lar:///ha.ka.ba/lararium/tw5/modules/nalu-engine":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/nalu-engine","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/nalu-engine\ntype: application/javascript\nmodule-type: startup\n\\*/\n//#region src/modules/nalu-engine.ts\nvar name = \"lararium-nalu-engine\";\nvar after = [\"startup\"];\nvar synchronous = true;\nvar _applying = false;\nvar _wiki = null;\n/** The applier ran with no wiki under it: boot the TW5 wiki with this module before landing a change. */\nvar NaluWikiUnavailableError = class extends Error {\n\tname = \"NaluWikiUnavailableError\";\n\tconstructor(title) {\n\t\tsuper(`nalu-engine: no wiki stands to apply \"${title}\" to — boot the TW5 wiki with this module before landing a change`);\n\t}\n};\n/**\n* The wiki fields an inbound change lands as. CRDT records store the title as the doc key, not nested\n* in `tiddler` — restore it from `change.title` so the wiki tiddler carries its identity.\n*\n* Residency Model — every inbound write annotates `$origin-bag` from the ENVELOPE so the operator\n* can answer \"which bag does this come from?\" at every read (Anti-pattern #4 defense). `bag` is\n* user space: an author's own field rides through untouched, as TiddlyWeb's stamp would ride under\n* theirs — the host's provenance wears a name no author collides with.\n*/\nfunction toWikiFields(change) {\n\treturn {\n\t\t...change.record.tiddler,\n\t\ttitle: change.title,\n\t\t...change.bag !== void 0 ? { \"$origin-bag\": change.bag } : {}\n\t};\n}\n/** Apply ONE inbound change to the wiki, synchronously. */\nfunction applyNalu(change) {\n\tconst Tiddler = $tw?.Tiddler;\n\tif (!_wiki || !Tiddler) throw new NaluWikiUnavailableError(change.title);\n\tconst outer = _applying;\n\t_applying = true;\n\ttry {\n\t\tif (change.record === null || change.record.meta?.deleted) _wiki.deleteTiddler(change.title);\n\t\telse _wiki.addTiddler(new Tiddler(toWikiFields(change)));\n\t} finally {\n\t\t_applying = outer;\n\t}\n}\n/** True while an `applyNalu` call runs. */\nfunction isApplyingNalu() {\n\treturn _applying;\n}\nfunction startup() {\n\tconst wiki = $tw?.wiki;\n\tif (!wiki) return;\n\t_wiki = wiki;\n\tconst lares = $tw.lares ?? {};\n\tlares[\"applyNalu\"] = applyNalu;\n\tlares[\"isApplyingNalu\"] = isApplyingNalu;\n\t$tw.lares = lares;\n}\n//#endregion\nexports.NaluWikiUnavailableError = NaluWikiUnavailableError;\nexports.after = after;\nexports.applyNalu = applyNalu;\nexports.isApplyingNalu = isApplyingNalu;\nexports.name = name;\nexports.startup = startup;\nexports.synchronous = synchronous;\nexports.toWikiFields = toWikiFields;\n","type":"application/javascript","module-type":"startup"},"lar:///ha.ka.ba/lararium/tw5/routes/native-delete-door":{"title":"lar:///ha.ka.ba/lararium/tw5/routes/native-delete-door","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/routes/native-delete-door\ntype: application/javascript\nmodule-type: route\n\\*/\nlet lararium_place_meme = require(\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\");\n//#region ../lararium-mesh/src/agile-digest.ts\n/** The algorithm tag of the house's sha256 digests — the one RFC 9530 `Repr-Digest` maps to. */\nvar SHA256_ALGO = \"sha256\";\n/** A 32-byte (SHA-256) digest's hex: exactly 64 hex chars. */\nvar SHA256_HEX = /^[0-9a-fA-F]{64}$/;\n/** A digest's hex part (even length ≥ 2) — another algorithm may carry another width. */\nvar HEX_BYTES = /^(?:[0-9a-fA-F]{2})+$/;\n/** A valid algorithm tag: lowercase alnum + dashes (blake3, sha512, sha2-256…). */\nvar ALGO_TAG = /^[a-z0-9][a-z0-9-]*$/;\n/** The RFC 9530 `Repr-Digest` field value: `sha-256=:<base64>:` (one member, the sf-binary item). */\nvar REPR_DIGEST = /^(sha-256)=:([A-Za-z0-9+/]+={0,2}):$/;\nvar B64 = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n/** The lowercase hex of a base64 byte string, or null where the base64 reads torn. Hand-rolled so\n*  the law runs the same in a browser, a plugin VM and node — no `Buffer`, no `atob`. */\nfunction hexOfBase64(b64) {\n\tconst body = b64.replace(/=+$/, \"\");\n\tif (body.length % 4 === 1) return null;\n\tlet bits = 0;\n\tlet acc = 0;\n\tlet hex = \"\";\n\tfor (const ch of body) {\n\t\tconst v = B64.indexOf(ch);\n\t\tif (v < 0) return null;\n\t\tacc = acc << 6 | v;\n\t\tbits += 6;\n\t\tif (bits >= 8) {\n\t\t\tbits -= 8;\n\t\t\thex += (acc >> bits & 255).toString(16).padStart(2, \"0\");\n\t\t}\n\t}\n\treturn hex;\n}\n/** The base64 of a lowercase hex byte string. */\nfunction base64OfHex(hex) {\n\tlet out = \"\";\n\tlet acc = 0;\n\tlet bits = 0;\n\tfor (let i = 0; i < hex.length; i += 2) {\n\t\tacc = acc << 8 | parseInt(hex.slice(i, i + 2), 16);\n\t\tbits += 8;\n\t\twhile (bits >= 6) {\n\t\t\tbits -= 6;\n\t\t\tout += B64[acc >> bits & 63];\n\t\t}\n\t}\n\tif (bits > 0) out += B64[acc << 6 - bits & 63];\n\twhile (out.length % 4 !== 0) out += \"=\";\n\treturn out;\n}\n/**\n* Parse a digest string into `(algo, hex)`.\n*\n*   \"sha256:ab…\"      → { algo: \"sha256\", hex: \"ab…\" }   (tagged, `:`)\n*   \"sha-256=:q80…=:\" → { algo: \"sha256\", hex: \"ab…\" }   (RFC 9530 Repr-Digest)\n*   \"blake3:cd…\"      → { algo: \"blake3\", hex: \"cd…\" }   (another scheme rides free)\n*   \"ab…64…\"          → throws — a bare hex names no algorithm\n*\n* The hex and the algo lowercase. Throws a NAMED error on anything else.\n*\n* The split falls on the first `:` only, and holds only when the head reads as an\n* algorithm tag and the tail as hex — hex holds no `:`, so no value mis-splits.\n*/\nfunction parseDigest(digest) {\n\tif (typeof digest !== \"string\" || digest.length === 0) throw new TypeError(`parseDigest: empty or non-string digest`);\n\tconst repr = REPR_DIGEST.exec(digest);\n\tif (repr) {\n\t\tconst hex = hexOfBase64(repr[2]);\n\t\tif (hex === null || !SHA256_HEX.test(hex)) throw new TypeError(`parseDigest: malformed tagged digest \"${digest}\"`);\n\t\treturn {\n\t\t\talgo: SHA256_ALGO,\n\t\t\thex\n\t\t};\n\t}\n\tconst sepIndex = digest.indexOf(\":\");\n\tif (sepIndex > 0) {\n\t\tconst algo = digest.slice(0, sepIndex).toLowerCase();\n\t\tconst hex = digest.slice(sepIndex + 1).toLowerCase();\n\t\tif (ALGO_TAG.test(algo) && HEX_BYTES.test(hex)) return {\n\t\t\talgo,\n\t\t\thex\n\t\t};\n\t\tthrow new TypeError(`parseDigest: malformed tagged digest \"${digest}\"`);\n\t}\n\tif (HEX_BYTES.test(digest)) throw new TypeError(`parseDigest: bare hex \"${digest.slice(0, 16)}…\" names no algorithm — write it tagged (\\`sha256:<hex>\\`)`);\n\tthrow new TypeError(`parseDigest: not a tagged digest \"${digest}\"`);\n}\n/**\n* The RFC 9530 `Repr-Digest` field value for a sha256 digest in any of its tagged spellings —\n* `sha-256=:<base64>:`. An HTTP skin emits it beside the `ETag`, so a client that speaks the\n* standard field verifies the body without learning the house's tag grammar. Only sha256 carries a\n* registered RFC 9530 algorithm key here; another algorithm refuses loud.\n*/\nfunction reprDigestOf(digest) {\n\tconst { algo, hex } = parseDigest(digest);\n\tif (algo !== \"sha256\") throw new TypeError(`reprDigestOf: only sha-256 carries a Repr-Digest key here (got \"${algo}\")`);\n\treturn `sha-256=:${base64OfHex(hex)}:`;\n}\n//#endregion\n//#region src/routes/plain-server.ts\n/**\n* THE PLAIN SERVER'S SHORE — what the meme route skins stand on when a plain TiddlyWiki server\n* (the fork's `--listen`) carries them. One law, inlined into each skin's bundle (the sandbox's web\n* globals ride the `host-globals` startup module, which runs before any route answers):\n*\n* THE CONTAINER LAW. A 1-wiki server holds ONE container, and `recipes/default` and `bags/default`\n* both name it (TiddlyWeb's own stub). `default` names THE HOST'S ANCHOR — the one wiki here; daemon-plane\n* on a lares island — and any other recipe or bag is a name the server cannot resolve. A bag the\n* server cannot name MUST NOT swallow a write, so the skins answer 404 with a one-line body before\n* the path is read.\n*\n* THE DIGEST PAIR. A response that carries a canonical hash carries it twice: `ETag` (the house's\n* `sha256:hex`, the merge base a writer hands back as `If-Match`) and `Repr-Digest` (RFC 9530,\n* `sha-256=:<base64>:`, the standard field a client verifies the body against). One digest, two\n* spellings; `digestsEqual` reads either.\n*/\n/** The `ETag` + `Repr-Digest` pair for a canonical hash; empty where no hash stands (a refusal). */\nfunction digestHeaders(canonicalHash) {\n\tif (!canonicalHash) return {};\n\treturn {\n\t\t\"ETag\": `\"${canonicalHash}\"`,\n\t\t\"Repr-Digest\": reprDigestOf(canonicalHash)\n\t};\n}\n//#endregion\n//#region src/routes/native-delete-door.ts\n/**\n* DELETE /bags/default/tiddlers/:title — the NATIVE DELETE DOOR, gated by the plugin before stock answers.\n*\n* THE GROUP LEAVES TOGETHER. `removeMeme` is the one removal law every skin calls: a meme's root, its\n* `#slot` fragments and its `/path` children go as ONE act, because a fragment left standing is a record\n* no door can reach — `memes.json` never lists it, `GET /memes/` answers 404 over it, and it re-cuts the\n* next founding at the same uri. The stock tiddlyweb syncadaptor deletes ONE title\n* (`tiddlywebadaptor.js` `deleteTiddler` → `DELETE /bags/<bag>/tiddlers/<title>`), so a trash-icon\n* delete of a meme root in a browser leaves its whole split behind. This skin stands in front of stock's\n* route at a higher priority and reads the standing record: a MEME ROOT (`isMemeRoot` — the listing's own\n* law) leaves through `removeMeme`; every other title reaches stock's handler untouched.\n*\n* The answer stays stock's `204` either way — the syncer reads a status, never a receipt — and the\n* client learns the group left on its next `syncFromServer`, which deletes what the server stopped\n* listing. An `If-Match` rides here as it does on `DELETE …/memes/…`: a base the records moved past\n* answers `412` and removes nothing.\n*\n*   204 · the group left, or stock removed the plain title\n*   412 · the records moved past the writer's base\n*/\nvar methods = [\"DELETE\"];\n/** Stock's own path, so the two skins answer the same addresses. */\nvar path = /^\\/bags\\/default\\/tiddlers\\/(.+)$/;\n/** Above stock's 100, so the server asks this skin first. */\nvar info = { priority: 110 };\nvar STOCK_DELETE = \"$:/core/modules/server/routes/delete-tiddler.js\";\n/** Strip the entity-tag quotes and any weak marker: `W/\"abc\"` → `abc`. */\nfunction baseHashOf(header) {\n\tconst raw = Array.isArray(header) ? header[0] : header;\n\tif (!raw) return null;\n\tconst bare = raw.trim().replace(/^W\\//, \"\").replace(/^\"(.*)\"$/, \"$1\");\n\treturn bare === \"\" || bare === \"*\" ? null : bare;\n}\nfunction handler(request, response, state) {\n\tconst title = $tw.utils.decodeURIComponentSafe(state.params[0] ?? \"\");\n\tconst standing = state.wiki.getTiddler(title)?.fields;\n\tif (!(0, lararium_place_meme.isMemeRoot)(title, standing)) {\n\t\t$tw.modules.execute(STOCK_DELETE).handler(request, response, state);\n\t\treturn;\n\t}\n\t(0, lararium_place_meme.removeMeme)({\n\t\turi: title,\n\t\tbaseHash: baseHashOf(request.headers[\"if-match\"])\n\t}, (0, lararium_place_meme.wikiMemeSink)(state.wiki)).then((receipt) => {\n\t\tif (receipt.decision === \"conflict\") {\n\t\t\tresponse.writeHead(412, {\n\t\t\t\t\"Content-Type\": \"application/json\",\n\t\t\t\t...digestHeaders(receipt.canonicalHash)\n\t\t\t});\n\t\t\tresponse.end(JSON.stringify({\n\t\t\t\turi: title,\n\t\t\t\tdecision: \"conflict\",\n\t\t\t\treason: \"If-Match — the records moved past the base the writer read\"\n\t\t\t}));\n\t\t\treturn;\n\t\t}\n\t\tresponse.writeHead(204, { \"Content-Type\": \"text/plain\" });\n\t\tresponse.end();\n\t}, (err) => {\n\t\tresponse.writeHead(500, { \"Content-Type\": \"text/plain\" });\n\t\tresponse.end(err instanceof Error ? err.message : String(err));\n\t});\n}\n//#endregion\nexports.handler = handler;\nexports.info = info;\nexports.metho