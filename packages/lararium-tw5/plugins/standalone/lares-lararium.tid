 on its line, so the line reads as a paragraph with the sigil inline; a block sigil ends its line`\n\t\t};\n\t\treturn {\n\t\t\tfrom,\n\t\t\tto,\n\t\t\tseverity: severityOf(failure),\n\t\t\tsource,\n\t\t\tcode: failure.reason,\n\t\t\tmessage: failure.sigilName ? `The ${failure.sigilName} sigil recovered as ${failure.recoveredAs}: ${failure.reason}` : `The parser recovered this span as ${failure.recoveredAs}: ${failure.reason}`\n\t\t};\n\t});\n}\n/** The carrier's grade: the worst severity it carries, or `clean` when it carries none. */\nfunction gradeOf(diagnostics) {\n\tlet worst = \"clean\";\n\tfor (const diagnostic of diagnostics) if (worst === \"clean\" || SEVERITY_RANK[diagnostic.severity] < SEVERITY_RANK[worst]) worst = diagnostic.severity;\n\treturn worst;\n}\n[\"[prefix[$:/temp/]]\", \"[prefix[$:/state/]]\"].join(\"\\n\");\nvar LAR_PREFIX = `lar:///ha.ka.ba/`;\nvar TAG_PREFIX = `${LAR_PREFIX}tags/`;\nvar VOLATILE_VM_PREFIX = `lar:///lararium.local.vm/`;\nfunction volatileVmUri(path) {\n\treturn `${VOLATILE_VM_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableLarUri(path) {\n\treturn `${LAR_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableTagUri(name) {\n\treturn `${TAG_PREFIX}${name.replace(/^\\/+/, \"\")}`;\n}\nvolatileVmUri(\"verb/\");\nvar BAGS_SEGMENT = \"bags\";\n/** Mint the canonical URI of a BAG (a composable recipe piece; mutable, the IPNS plane). */\nfunction bagUri(slug) {\n\treturn stableLarUri(`${BAGS_SEGMENT}/${slug}`);\n}\nbagUri(\"oracle\");\nbagUri(\"lararium\");\nvar CATALOG_DOC_URI = bagUri(\"catalog\");\nbagUri(\"lares\");\nbagUri(\"crossroads\");\nbagUri(\"kahua\");\nstableLarUri(\"lararium/plugins/lares/memetic-wikitext\");\nstableLarUri(\"lararium/plugins/lares/lararium\");\nvar GRAMMAR_TAG = stableTagUri(\"SharktoothSigil\");\nstableTagUri(\"lararium-parse-warnings\");\nstableTagUri(\"lararium-bag-mirror\");\nstableTagUri(\"lares-verb\");\nstableTagUri(\"lares-verb-event\");\nstableTagUri(\"lares-pin\");\nstableTagUri(\"cap-event\");\nstableTagUri(\"cap-event/prekey\");\nstableTagUri(\"cap-event/cgka\");\nstableTagUri(\"cap-event/delegation\");\nstableTagUri(\"cap-event/revocation\");\nstableLarUri(\"state/boot-splash/active\");\nbagUri(\"identities\");\nbagUri(\"circles\");\nbagUri(\"sessions\");\nbagUri(\"intents\");\n`${CATALOG_DOC_URI}`;\n/** The vessel's daemon document — `bags/daemon`, SOVEREIGN-per-vessel and never shared across vessels. It holds vessel\n*  state (bindings, the bag-doc ledger, the active-wiki marker) and names the control document; it carries no canon role\n*  (the daemon wiki's canon follows the worn face, `daemonFaceCanonBag`) and no mirror. */\nvar DAEMON_BAG_ID = bagUri(\"daemon\");\nbagUri(\"control\");\nbagUri(\"secret\");\n/** The persona NAMESPACE — two jobs, and a reader who fuses them will look for a bag that does not exist.\n*\n*  The word is deliberate. SDSI's ruling on this exact shape reads \"a NAMESPACE, not a super-key\" — a place\n*  local names hang from, carrying no authority of its own. Calling it a ROOT would claim the opposite and\n*  name the very thing canon forbids above a person's compartments.\n*\n*  ① The TITLE prefix every PersonaGroup plane uses INSIDE its own document: the signer pin, the KEL\n*     prefix, the selves, the binding records all spell `persona/...` whichever plane holds them. Titles\n*     resolve verbatim within a document and the composite finds one by walking layers, so every plane\n*     carries the same internal shape regardless of the bag it answers to.\n*  ② The STEM a plane's own bag id extends — `personaBagIdFor` derives `persona-<tag>` from that group's\n*     doc id, and `isPersonaBagId` matches the family by that shape rather than by any fixed id.\n*\n*  It NAMES NO BAG on its own. A vessel holds one plane per PersonaGroup it stands in, each seeded,\n*  mounted, registered and reached under its own derived name; nothing answers to the bare stem. */\nvar PERSONA_NAMESPACE = bagUri(\"persona\");\nstableLarUri(\"identities\");\nstableLarUri(\"circles\");\nstableLarUri(\"sessions\");\nstableLarUri(\"intents\");\nbagUri(\"nexus\");\nstableLarUri(\"sentinel/kahu-cabal\");\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${DAEMON_BAG_ID}`;\n`${DAEMON_BAG_ID}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n//#endregion\n//#region src/grammar-cache.ts\nvar _cache = void 0;\nfunction getGrammar() {\n\tif (_cache) return _cache.rules;\n\tlet rules = null;\n\ttry {\n\t\tconst wiki = $tw?.wiki;\n\t\tif (wiki) rules = buildGrammarFromWiki(wiki);\n\t} catch {}\n\t_cache = {\n\t\tloaded: true,\n\t\trules\n\t};\n\treturn rules;\n}\nfunction str(v) {\n\treturn typeof v === \"string\" ? v : \"\";\n}\n/**\n* Derive sigil name from tiddler fields or title.\n* `lar-name` field takes precedence; otherwise strips the \"sigil-\" prefix\n* from the last path segment of the title (e.g. \"…/sigil-ahu\" → \"ahu\").\n*/\nfunction nameFromTitle(title, fields) {\n\tif (fields[\"lar-name\"]) return str(fields[\"lar-name\"]);\n\tconst last = title.split(\"/\").pop() ?? title;\n\treturn last.startsWith(\"sigil-\") ? last.slice(6) : last;\n}\n/**\n* Build SigilRule from a SharktoothSigil tiddler's fields. Returns null for family tiddlers.\n*\n* SHARED CONVERTER: this is the ONE fields→rule fold. The node-side generator\n* (scripts/build-grammar-table.ts, reading .tid frontmatter off disk) imports this\n* same function rather than re-deriving the field→rule mapping, so the live-wiki\n* path and the generated-table path cannot diverge on what a field MEANS.\n*/\nfunction sigilFromFields(title, fields) {\n\tconst kindRaw = str(fields[\"lar-kind\"]);\n\tif (!kindRaw || kindRaw === \"family\") return null;\n\tconst kind = kindRaw;\n\tconst rule = {\n\t\tname: nameFromTitle(title, fields),\n\t\tkind\n\t};\n\tif (fields[\"lar-pattern\"]) rule.pattern = str(fields[\"lar-