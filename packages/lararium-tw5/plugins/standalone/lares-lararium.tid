{"tiddlers":{"$:/config/AutoSave":{"title":"$:/config/AutoSave","text":"no\n"},"$:/config/ConfirmIgnoredFields":{"title":"$:/config/ConfirmIgnoredFields","text":"$origin-bag"},"$:/config/lares/ProjectionFilter/temp":{"title":"$:/config/lares/ProjectionFilter/temp","type":"text/vnd.tiddlywiki","text":"[prefix[lar:///ha.ka.ba/lararium/config/]]\n"},"$:/config/lares/ProjectionFilter":{"title":"$:/config/lares/ProjectionFilter","type":"text/vnd.tiddlywiki","text":"[prefix[$:/temp/]]\n[prefix[$:/state/]]\n"},"$:/config/Drafts/TypingTimeout":{"title":"$:/config/Drafts/TypingTimeout","text":"16"},"$:/config/SaverFilter":{"title":"$:/config/SaverFilter","text":""},"$:/DefaultTiddlers":{"title":"$:/DefaultTiddlers","type":"text/vnd.tiddlywiki","text":"[all[tiddlers]tag[$:/tags/lares/Landing]] ~[[GettingStarted]]\n"},"lar:///ha.ka.ba/lararium/tw5/heleuma/relink":{"title":"lar:///ha.ka.ba/lararium/tw5/heleuma/relink","type":"text/memetic-wikitext+tiddlywiki","heleuma":"ka","module-ref":"lar:///ha.ka.ba/lararium/tw5/relink/relink-sigil lar:///ha.ka.ba/lararium/tw5/relink/relink-memetic","role":"the house's handlers under Relink's own API: a rename's relink reaches meme slots and the sigils' lar: values","source-file":"packages/lararium-tw5/src/relink/relink-sigil.ts packages/lararium-tw5/src/relink/relink-memetic.ts packages/lararium-tw5/src/relink-sigil-core.ts","uri-path":"ha.ka.ba/lararium/tw5/heleuma/relink","text":"<<~ ahu slot=`#/contract`>>\n\n!! Contract\n\nThe rename door hands references to TiddlyWiki's own `relinkTiddler`, and the Relink offering (flibbles, BSD-3-Clause) walks wikitext, filters and fields through it. Two house modules carry the house's own syntax into that walk, through Relink's own handler API, so the door's dry-run capture sees every edit:\n\n* `relink/relink-memetic` (`relinktext`) hands the carrier type `text/memetic-wikitext+tiddlywiki` Relink's wikitext handler, honouring `lar:///ha.ka.ba/config/memetic-rules-except` through a `\\rules except` line.\n* `relink/relink-sigil` (`relinkwikitextrule`) gives the `lar-sigil` and `lar-declaration` rules a report and a relink: a named value holding a `lar:///` local URI that names the moved record, or a slot of it, follows the rename; a container pair's body walks on as wikitext.\n\nBoth stand inert where Relink stands absent: only Relink reads their module types.\n\n<<~/ahu>>\n\n<<~ ahu slot=`#/unrelinked`>>\n\n!! What Stays\n\n* The session form `lar://alias:grant@host/…`: it names an exchange, never a record.\n* A digest (`bcc=`): the seal re-mints, it never relinks.\n* A positional value and a bare word (`<<~ has name=…>>`): a word reads the same as a title.\n* A typed value inside a sigil (`{{…}}`, `{{{…}}}`, `<<…>>`): it keeps its own grammar.\n* The TOML meta `title` and `uri-path`: the family law's rename moves them.\n\n<<~/ahu>>\n\n<<~ ahu slot=`#/source`>>\n\n!! Source\n\n{{lar:///ha.ka.ba/lararium/tw5/relink/relink-sigil}}\n\n{{lar:///ha.ka.ba/lararium/tw5/relink/relink-memetic}}\n\n<<~/ahu>>\n\n<<~ ahu slot=`#/edges`>>\n\n<<~ loulou uri=`lar:///ha.ka.ba/kahua/memory/research/adopt-relink`>>\n<<~ loulou uri=`lar:///ha.ka.ba/lares/api/vendor/flibbles-relink`>>\n\n<<~/ahu>>\n"},"lar:///ha.ka.ba/lararium/templates/parallel-drafts/badge":{"title":"lar:///ha.ka.ba/lararium/templates/parallel-drafts/badge","tags":"$:/tags/ViewTemplate","list-after":"$:/core/ui/ViewTemplate/title","type":"text/vnd.tiddlywiki","text":"\\whitespace trim\n<$list filter=\"[all[tiddlers]field:draft.of<currentTiddler>has[lar-conflict-actor]limit[1]]\" variable=\"-\">\n<div class=\"lar-parallel-drafts\" title=\"A concurrent edit kept as a parallel draft. The live value is the merge's own; discard the draft to let it go.\">\n<$list filter=\"[all[tiddlers]field:draft.of<currentTiddler>has[lar-conflict-actor]sort[title]]\">\n<$link to=<<currentTiddler>> class=\"lar-parallel-draft-badge\">⋔ <$text text={{{ [<currentTiddler>get[modifier]] ~[<currentTiddler>get[lar-conflict-actor]] }}}/></$link>\n</$list>\n</div>\n</$list>\n"},"$:/SiteSubtitle":{"title":"$:/SiteSubtitle","type":"text/vnd.tiddlywiki","text":"Welcome to the DreamNet\n"},"$:/SiteTitle":{"title":"$:/SiteTitle","type":"text/vnd.tiddlywiki","text":"Lararium\n"},"lar:///ha.ka.ba/lararium/tw5/widgets/action-meme-place":{"title":"lar:///ha.ka.ba/lararium/tw5/widgets/action-meme-place","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/widgets/action-meme-place\ntype: application/javascript\nmodule-type: widget\n\\*/\n//#region src/widgets/action-meme-place.ts\n/** The receipt's home — a `$:/temp` prefix, so nothing here persists or syncs. */\nvar MEME_PLACE_RECEIPT_PREFIX = \"$:/temp/lares/meme-place/\";\n/** Where the receipt for one placement lands. */\nfunction memePlaceReceiptTitle(uri) {\n\treturn MEME_PLACE_RECEIPT_PREFIX + uri;\n}\n/** The fields a receipt carries: the whole reply as JSON, the decision flat beside it. */\nfunction memePlaceReceiptFields(uri, container, receipt) {\n\tconst fields = {\n\t\ttitle: memePlaceReceiptTitle(uri),\n\t\ttype: \"application/json\",\n\t\turi,\n\t\tdecision: receipt.decision,\n\t\tgrade: receipt.grade,\n\t\ttext: JSON.stringify(receipt, null, 2)\n\t};\n\tif (receipt.canonicalHash) fields[\"canonical-hash\"] = receipt.canonicalHash;\n\tif (container) fields[\"container\"] = container;\n\treturn fields;\n}\n/** The fields a placement that THREW carries — the reason an author can read, no invented decision. */\nfunction memePlaceErrorFields(uri, container, reason) {\n\tconst fields = {\n\t\ttitle: memePlaceReceiptTitle(uri),\n\t\ttype: \"application/json\",\n\t\turi,\n\t\terror: reason,\n\t\ttext: JSON.stringify({\n\t\t\turi,\n\t\t\terror: reason\n\t\t}, null, 2)\n\t};\n\tif (container) fields[\"container\"] = container;\n\treturn fields;\n}\nvar Widget = (globalThis.require ?? require)(\"$:/core/modules/widgets/widget.js\")[\"widget\"];\nvar ActionMemePlaceWidget = function(parseTreeNode, options) {\n\tthis.initialise(parseTreeNode, options);\n};\nActionMemePlaceWidget.prototype = new Widget();\n/** Render this widget into the DOM. */\nActionMemePlaceWidget.prototype.render = function() {\n\tthis.computeAttributes();\n\tthis.execute();\n};\n/** Compute the internal state of the widget. */\nActionMemePlaceWidget.prototype.execute = function() {\n\tthis.placeUri = this.getAttribute(\"uri\", \"\");\n\tthis.placeText = this.getAttribute(\"text\", \"\");\n\tconst bag = this.getAttribute(\"bag\", \"\");\n\tconst recipe = this.getAttribute(\"recipe\", \"\");\n\tthis.container = bag && recipe ? \"\" : bag ? `bags/${bag}` : recipe ? `recipes/${recipe}` : \"\";\n};\n/** Refresh the widget by ensuring our attributes are up to date. */\nActionMemePlaceWidget.prototype.refresh = function(changedTiddlers) {\n\tconst changedAttributes = this.computeAttributes();\n\tif (changedAttributes[\"uri\"] || changedAttributes[\"text\"] || changedAttributes[\"bag\"] || changedAttributes[\"recipe\"]) {\n\t\tthis.refreshSelf();\n\t\treturn true;\n\t}\n\treturn this.refreshChildren(changedTiddlers);\n};\n/** Invoke the action associated with this widget. */\nActionMemePlaceWidget.prototype.invokeAction = function() {\n\tconst uri = this.placeUri;\n\tconst text = this.placeText;\n\tconst face = $tw?.lares?.meme;\n\tif (!uri || !text || !face) return true;\n\tconst wiki = this.wiki;\n\tconst container = this.container;\n\tPromise.resolve(face.place(uri, text)).then((receipt) => {\n\t\twiki.addTiddler(memePlaceReceiptFields(uri, container, receipt));\n\t}).catch((err) => {\n\t\twiki.addTiddler(memePlaceErrorFields(uri, container, String(err)));\n\t});\n\treturn true;\n};\n//#endregion\nexports.MEME_PLACE_RECEIPT_PREFIX = MEME_PLACE_RECEIPT_PREFIX;\nexports[\"action-meme-place\"] = ActionMemePlaceWidget;\nexports.memePlaceErrorFields = memePlaceErrorFields;\nexports.memePlaceReceiptFields = memePlaceReceiptFields;\nexports.memePlaceReceiptTitle = memePlaceReceiptTitle;\n","type":"application/javascript","module-type":"widget"},"lar:///ha.ka.ba/lararium/tw5/widgets/action-oracle-cast":{"title":"lar:///ha.ka.ba/lararium/tw5/widgets/action-oracle-cast","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/widgets/action-oracle-cast\ntype: application/javascript\nmodule-type: widget\n\\*/\n//#region ../lararium-mesh/src/crypto.ts\nfunction webGetRandomValues(array) {\n\tconst fn = globalThis.crypto?.getRandomValues?.bind(globalThis.crypto);\n\tif (!fn) throw new Error(\"crypto.getRandomValues unavailable in this runtime\");\n\treturn fn(array);\n}\n//#endregion\n//#region ../lararium-mesh/src/entropy-door.ts\n/**\n* entropy-door — the house's one door for outside randomness.\n*\n* A cast that draws chance (a ddate exclamation, an oracle throw) takes its bytes from an `EntropyDoor` the caller\n* hands in, never from a hidden global. The door names its source in a field, so a result that drew from it can say\n* what it drew from, and a test stands a seeded door in its place.\n*\n* The platform door reads `crypto.getRandomValues`: real randomness, drawn at the call and kept nowhere. A\n* deterministic door (a seeded list, a day-keyed hash) names itself plainly as one, so no reader mistakes a replay\n* for a cast.\n*\n* Platform-blind: this file reads only `globalThis.crypto` (Node 19+ and every modern browser) through the mesh's\n* Web Crypto port.\n*/\n/** The platform's own randomness: the default door for a live cast. */\nvar PLATFORM_ENTROPY = {\n\tsource: \"platform:crypto.getRandomValues\",\n\tfill: (bytes) => webGetRandomValues(bytes)\n};\nvar UINT32_SPAN = 4294967296;\n/**\n* One integer in `[0, bound)` drawn from `door`, unbiased: a draw landing in the short tail of the 32-bit span\n* (where `bound` does not divide it evenly) is thrown back and drawn again.\n*/\nfunction entropyBelow(door, bound) {\n\tif (!Number.isInteger(bound) || bound < 1 || bound > UINT32_SPAN) throw new RangeError(`entropyBelow: bound must be an integer in [1, 2^32]; got ${String(bound)}`);\n\tconst limit = UINT32_SPAN - UINT32_SPAN % bound;\n\tconst cell = /* @__PURE__ */ new Uint8Array(4);\n\tfor (;;) {\n\t\tdoor.fill(cell);\n\t\tconst draw = cell[0] * 16777216 + (cell[1] << 16) + (cell[2] << 8) + cell[3];\n\t\tif (draw < limit) return draw % bound;\n\t}\n}\n//#endregion\n//#region ../lararium-mesh/src/oracle-cast.ts\n/**\n* oracle-cast — the I Ching's three-coin cast, drawn through the house's entropy door.\n*\n* A line throws three coins, heads counting three and tails two, so each line sums to 6 (old yin, changing), 7 (young\n* yang), 8 (young yin) or 9 (old yang, changing). Six lines stack bottom line first into the PRIMARY hexagram; the\n* changing lines turned over make the RELATING hexagram, and a cast with no changing line names none. The figures\n* number in the King Wen order, 1 to 64, from the trigram below and the trigram above.\n*\n* ONE DOOR FOR CHANCE. A house cast draws every coin through the `EntropyDoor` the caller hands in\n* (`./entropy-door.js`), and the result names the door's source: `platform:crypto.getRandomValues` for a live cast, a\n* seeded door's own name in a test. An operator who threw real coins types the six values instead, and the result\n* names `operator:three-coins`: the strong cast, made by a hand.\n*\n* THE CLOCK SEAM. The core reads no clock: the caller names the time of the cast (`at`) and the caster. The same door\n* bytes and the same ask answer the same cast.\n*\n* A CAST STANDS AS AN ACT. `castFields` shapes the tiddler a cast writes, under the `casts/` prefix, naming the\n* readings the house imported (`oracles/doa`, `oracles/e-jing`); a surface writes it once, and re-rendering it never\n* casts again. The throw stands and the reading stays open.\n*\n* Platform-blind and pure.\n*/\n/** The method every cast here names. */\nvar CAST_METHOD = \"three-coins\";\n/** The source an operator's typed throw names: six lines thrown by a hand with real coins. */\nvar OPERATOR_COINS = \"operator:three-coins\";\n/** The oracle's pono place, said wherever it answers: a blind throw to collide uncertainty with. */\nvar ORACLE_THROW_STANDS = \"a blind throw to collide uncertainty with: the throw stands, the reading stays open\";\n/** The prefix every cast tiddler's title sits under. */\nvar CAST_TITLE_PREFIX = \"lar:///ha.ka.ba/lares/oracle/casts/\";\n/** The house's imported readings: one tiddler per hexagram per source. */\nvar READING_SOURCES = [\"doa\", \"e-jing\"];\n/** The eight trigrams by name, each a figure of three lines, bottom line first, 1 for yang. */\nvar TRIGRAMS = {\n\tqian: \"111\",\n\tzhen: \"100\",\n\tkan: \"010\",\n\tgen: \"001\",\n\tkun: \"000\",\n\txun: \"011\",\n\tli: \"101\",\n\tdui: \"110\"\n};\nvar TRIGRAM_ORDER = [\n\t\"qian\",\n\t\"zhen\",\n\t\"kan\",\n\t\"gen\",\n\t\"kun\",\n\t\"xun\",\n\t\"li\",\n\t\"dui\"\n];\n/** King Wen numbers: a row per trigram above, a column per trigram below, both in `TRIGRAM_ORDER`. */\nvar KING_WEN = [\n\t[\n\t\t1,\n\t\t25,\n\t\t6,\n\t\t33,\n\t\t12,\n\t\t44,\n\t\t13,\n\t\t10\n\t],\n\t[\n\t\t34,\n\t\t51,\n\t\t40,\n\t\t62,\n\t\t16,\n\t\t32,\n\t\t55,\n\t\t54\n\t],\n\t[\n\t\t5,\n\t\t3,\n\t\t29,\n\t\t39,\n\t\t8,\n\t\t48,\n\t\t63,\n\t\t60\n\t],\n\t[\n\t\t26,\n\t\t27,\n\t\t4,\n\t\t52,\n\t\t23,\n\t\t18,\n\t\t22,\n\t\t41\n\t],\n\t[\n\t\t11,\n\t\t24,\n\t\t7,\n\t\t15,\n\t\t2,\n\t\t46,\n\t\t36,\n\t\t19\n\t],\n\t[\n\t\t9,\n\t\t42,\n\t\t59,\n\t\t53,\n\t\t20,\n\t\t57,\n\t\t37,\n\t\t61\n\t],\n\t[\n\t\t14,\n\t\t21,\n\t\t64,\n\t\t56,\n\t\t35,\n\t\t50,\n\t\t30,\n\t\t38\n\t],\n\t[\n\t\t43,\n\t\t17,\n\t\t47,\n\t\t31,\n\t\t45,\n\t\t28,\n\t\t49,\n\t\t58\n\t]\n];\nvar FIGURE = /^[01]{6}$/;\n/** The hexagram a six-line figure names (bottom line first, 1 for yang). */\nfunction hexagramOf(figure) {\n\tif (!FIGURE.test(figure)) throw new RangeError(`hexagramOf: a figure reads six 0s and 1s, bottom line first; got \"${figure}\"`);\n\tconst lower = TRIGRAM_ORDER.find((name) => TRIGRAMS[name] === figure.slice(0, 3));\n\tconst upper = TRIGRAM_ORDER.find((name) => TRIGRAMS[name] === figure.slice(3));\n\tconst number = KING_WEN[TRIGRAM_ORDER.indexOf(upper)][TRIGRAM_ORDER.indexOf(lower)];\n\treturn {\n\t\tnumber,\n\t\tfigure,\n\t\tlower,\n\t\tupper,\n\t\tglyph: String.fromCodePoint(19904 + number - 1)\n\t};\n}\n/** One coin through the door: heads three, tails two. */\nfunction throwCoin(door) {\n\treturn entropyBelow(door, 2) === 1 ? 3 : 2;\n}\n/** One line: three coins summed. */\nfunction throwLine(door) {\n\treturn throwCoin(door) + throwCoin(door) + throwCoin(door);\n}\nfunction requireAsk(ask) {\n\tif (typeof ask.caster !== \"string\" || ask.caster.trim() === \"\") throw new RangeError(\"oracle cast: name the caster (who casts)\");\n\tif (typeof ask.at !== \"string\" || ask.at.trim() === \"\") throw new RangeError(\"oracle cast: name the time of the cast (`at`); the core reads no clock\");\n}\nfunction castOf(lines, entropy, ask) {\n\tconst primary = lines.map((v) => v === 7 || v === 9 ? \"1\" : \"0\").join(\"\");\n\tconst relating = lines.map((v) => v === 7 || v === 6 ? \"1\" : \"0\").join(\"\");\n\tconst changing = lines.flatMap((v, i) => v === 6 || v === 9 ? [i + 1] : []);\n\treturn {\n\t\tmethod: CAST_METHOD,\n\t\tentropy,\n\t\tlines: [...lines],\n\t\tchanging,\n\t\tprimary: hexagramOf(primary),\n\t\trelating: changing.length > 0 ? hexagramOf(relating) : null,\n\t\tcaster: ask.caster,\n\t\tat: ask.at\n\t};\n}\n/** A house cast: eighteen coins through `door`, six lines bottom first. */\nfunction castThreeCoins(door, ask) {\n\trequireAsk(ask);\n\tconst lines = [];\n\tfor (let i = 0; i < 6; i += 1) lines.push(throwLine(door));\n\treturn castOf(lines, door.source, ask);\n}\n/** The operator's own throw: six line values cast with real coins, bottom line first. */\nfunction castFromCoins(values, ask) {\n\trequireAsk(ask);\n\tif (values.length !== 6) throw new RangeError(`oracle cast: an operator's throw names six lines, bottom first; got ${values.length}`);\n\treturn castOf(values.map((v) => {\n\t\tif (v !== 6 && v !== 7 && v !== 8 && v !== 9) throw new RangeError(`oracle cast: each line reads 6, 7, 8 or 9; got ${String(v)}`);\n\t\treturn v;\n\t}), OPERATOR_COINS, ask);\n}\n/** Six line values from a line of text (\"7,8,9,6,7,7\", \"7 8 9 6 7 7\" or \"789677\"), or null where it reads otherwise. */\nfunction parseCoins(text) {\n\tconst trimmed = text.trim();\n\tconst parts = /^[6-9]{6}$/.test(trimmed) ? trimmed.split(\"\") : trimmed.split(/[\\s,]+/).filter((p) => p !== \"\");\n\tif (parts.length !== 6 || !parts.every((p) => /^[6-9]$/.test(p))) return null;\n\treturn parts.map((p) => Number(p));\n}\n/** The title of a reading the house imported: `oracles/<source>/hexagram-NN`. */\nfunction readingTitle(source, n) {\n\treturn `lar:///ha.ka.ba/lares/library/oracles/${source}/hexagram-${String(n).padStart(2, \"0\")}`;\n}\n/** The readings a cast names: each source for the primary, then each for the relating. */\nfunction castReadingTitles(cast) {\n\treturn (cast.relating ? [cast.primary.number, cast.relating.number] : [cast.primary.number]).flatMap((n) => READING_SOURCES.map((source) => readingTitle(source, n)));\n}\n/** The cast's tiddler title: the caller's time, then the primary and the relating number. */\nfunction castTitle(cast) {\n\treturn `${CAST_TITLE_PREFIX}${cast.at.trim().replace(/[^0-9A-Za-z]+/g, \"-\").replace(/^-+|-+$/g, \"\")}-${cast.primary.number}${cast.relating ? `-${cast.relating.number}` : \"\"}`;\n}\n/** The tiddler a cast writes: its facts as flat fields, its body naming and transcluding the readings. */\nfunction castFields(cast) {\n\tconst readings = castReadingTitles(cast);\n\tconst body = [\n\t\t`!! ${cast.primary.glyph} Hexagram ${cast.primary.number}${cast.relating ? ` changing to ${cast.relating.glyph} ${cast.relating.number}` : \"\"}`,\n\t\t\"\",\n\t\t`Lines, bottom first: ${cast.lines.join(\" \")}${cast.changing.length > 0 ? ` · changing: ${cast.changing.join(\", \")}` : \" · no line changes\"}`,\n\t\t\"\",\n\t\t`Cast by ${cast.caster} at ${cast.at}, ${cast.method}, entropy from \\`${cast.entropy}\\`.`\n\t];\n\tconst sections = [[\"Primary\", cast.primary]];\n\tif (cast.relating) sections.push([\"Relating\", cast.relating]);\n\tfor (const [label, h] of sections) {\n\t\tbody.push(\"\", `!!! ${label}: ${h.glyph} ${h.number}`);\n\t\tfor (const source of READING_SOURCES) body.push(\"\", `{{${readingTitle(source, h.number)}#/reading}}`);\n\t}\n\tbody.push(\"\", `//(${ORACLE_THROW_STANDS})//`);\n\tconst fields = {\n\t\ttitle: castTitle(cast),\n\t\ttype: \"text/vnd.tiddlywiki\",\n\t\ttags: \"oracle/cast\",\n\t\tmethod: cast.method,\n\t\tentropy: cast.entropy,\n\t\tlines: cast.lines.join(\" \"),\n\t\tchanging: cast.changing.join(\" \"),\n\t\tprimary: String(cast.primary.number),\n\t\t\"primary-figure\": cast.primary.figure,\n\t\tcaster: cast.caster,\n\t\t\"cast-at\": cast.at,\n\t\treadings: readings.map((t) => `[[${t}]]`).join(\" \"),\n\t\ttext: body.join(\"\\n\")\n\t};\n\tif (cast.relating) {\n\t\tfields[\"relating\"] = String(cast.relating.number);\n\t\tfields[\"relating-figure\"] = cast.relating.figure;\n\t}\n\treturn fields;\n}\n//#endregion\n//#region src/widgets/action-oracle-cast.ts\n/**\n* action-oracle-cast — the I Ching's three-coin cast inside a wiki: a button casts, and the cast lands as a tiddler.\n*\n*   <$button>Cast<$action-oracle-cast/></$button>\n*   <$button>Cast my coins<$action-oracle-cast coins={{!!coins}} caster=\"operator\" result=\"$:/temp/oracle/last\"/></$button>\n*\n* ── A CAST STANDS AS AN ACT ─────────────────────────────────────────────────────────────────────\n* The cast happens when the action fires and never at render: rendering the button, or the cast tiddler, or any\n* wikitext that names either, casts nothing, so the record holds the throw. The tiddler it writes sits under the\n* `casts/` prefix with its facts as fields (method, entropy, lines, changing, primary, relating, caster, cast-at,\n* readings), from the one core the CLI and the daemon verb share (`@lararium/mesh/oracle-cast`). A title already\n* standing stays as it stands: a cast never writes over another.\n*\n* ── ONE DOOR FOR CHANCE, ONE CLOCK READ ─────────────────────────────────────────────────────────\n* With no `coins` the eighteen coins draw through the platform's entropy door (`crypto.getRandomValues`), named in the\n* `entropy` field. Six `coins` (6, 7, 8 or 9, bottom line first: \"7,8,9,6,7,7\") stand as the operator's own throw,\n* named `operator:three-coins`; a value that reads otherwise casts nothing. THE CLOCK SEAM sits at this edge: the\n* widget reads the time once when it fires and hands it to the core, which reads no clock.\n*\n* `caster` names who cast (default `wiki`). `result` names a tiddler whose text receives the cast's title, so a button\n* can open what it cast. The throw stands and the reading stays open.\n*/\n/** The base widget class: a `require` installed on the global wins (a test's stub), else TW5's own parameter. */\nvar hostRequire = globalThis.require ?? require;\n/** The cast an action names: the operator's typed coins, or a house cast through the platform door; null where coins read wrong. */\nfunction oracleCastFor(coins, caster, at) {\n\tconst who = caster.trim() || \"wiki\";\n\tif (coins.trim() === \"\") return castThreeCoins(PLATFORM_ENTROPY, {\n\t\tcaster: who,\n\t\tat\n\t});\n\tconst lines = parseCoins(coins);\n\treturn lines === null ? null : castFromCoins(lines, {\n\t\tcaster: who,\n\t\tat\n\t});\n}\nvar Widget = hostRequire(\"$:/core/modules/widgets/widget.js\")[\"widget\"];\nvar ActionOracleCastWidget = function(parseTreeNode, options) {\n\tthis.initialise(parseTreeNode, options);\n};\nActionOracleCastWidget.prototype = new Widget();\n/** Render this widget into the DOM: an action widget renders nothing and casts nothing. */\nActionOracleCastWidget.prototype.render = function() {\n\tthis.computeAttributes();\n\tthis.execute();\n};\n/** Compute the internal state of the widget. */\nActionOracleCastWidget.prototype.execute = function() {\n\tthis.castCoins = this.getAttribute(\"coins\", \"\");\n\tthis.castCaster = this.getAttribute(\"caster\", \"wiki\");\n\tthis.castResult = this.getAttribute(\"result\", \"\");\n};\n/** Refresh the widget by ensuring our attributes are up to date. */\nActionOracleCastWidget.prototype.refresh = function(changedTiddlers) {\n\tconst changedAttributes = this.computeAttributes();\n\tif (changedAttributes[\"coins\"] || changedAttributes[\"caster\"] || changedAttributes[\"result\"]) {\n\t\tthis.refreshSelf();\n\t\treturn true;\n\t}\n\treturn this.refreshChildren(changedTiddlers);\n};\n/** Invoke the action: cast once, write the cast tiddler, hand its title to `result`. */\nActionOracleCastWidget.prototype.invokeAction = function() {\n\tconst cast = oracleCastFor(this.castCoins, this.castCaster, (/* @__PURE__ */ new Date()).toISOString());\n\tif (cast === null) return true;\n\tconst fields = castFields(cast);\n\tconst title = fields[\"title\"];\n\tif (!this.wiki.tiddlerExists(title)) this.wiki.addTiddler(fields);\n\tif (this.castResult) this.wiki.addTiddler({\n\t\ttitle: this.castResult,\n\t\ttext: title\n\t});\n\treturn true;\n};\n//#endregion\nexports[\"action-oracle-cast\"] = ActionOracleCastWidget;\nexports.oracleCastFor = oracleCastFor;\n","type":"application/javascript","module-type":"widget"},"lar:///ha.ka.ba/lararium/tw5/macros/ddate":{"title":"lar:///ha.ka.ba/lararium/tw5/macros/ddate","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/macros/ddate\ntype: application/javascript\nmodule-type: macro\n\\*/\n//#region ../lararium-mesh/src/entropy-door.ts\nvar UINT32_SPAN = 4294967296;\n/**\n* One integer in `[0, bound)` drawn from `door`, unbiased: a draw landing in the short tail of the 32-bit span\n* (where `bound` does not divide it evenly) is thrown back and drawn again.\n*/\nfunction entropyBelow(door, bound) {\n\tif (!Number.isInteger(bound) || bound < 1 || bound > UINT32_SPAN) throw new RangeError(`entropyBelow: bound must be an integer in [1, 2^32]; got ${String(bound)}`);\n\tconst limit = UINT32_SPAN - UINT32_SPAN % bound;\n\tconst cell = /* @__PURE__ */ new Uint8Array(4);\n\tfor (;;) {\n\t\tdoor.fill(cell);\n\t\tconst draw = cell[0] * 16777216 + (cell[1] << 16) + (cell[2] << 8) + cell[3];\n\t\tif (draw < limit) return draw % bound;\n\t}\n}\n/** One member of a non-empty list, chosen through `door`. */\nfunction entropyPick(door, list) {\n\tif (list.length === 0) throw new RangeError(\"entropyPick: the list holds nothing to pick\");\n\treturn list[entropyBelow(door, list.length)];\n}\n//#endregion\n//#region ../lararium-mesh/src/ddate.ts\n/**\n* ddate — the Discordian calendar, computed from a Gregorian date the caller names.\n*\n* Five seasons of 73 days (Chaos, Discord, Confusion, Bureaucracy, The Aftermath), a five-day week (Sweetmorn,\n* Boomtime, Pungenday, Prickle-Prickle, Setting Orange) cycling on the day of the season, the year of Our Lady of\n* Discord (YOLD) at the Gregorian year plus 1166, and St. Tib's Day on February 29 standing outside every season and\n* week, so the days after it keep their place in the calendar. Day 5 of a season holds its apostle's holyday, day 50\n* its season holyday. X-Day falls on Confusion 40, 9827 YOLD, the SubGenius reckoning that moved the first X-Day's\n* date once it passed without incident.\n*\n* THE CLOCK SEAM. The core reads no clock: every function takes the Gregorian date it answers for. A caller at an edge\n* (the CLI, a daemon verb's caller, a wiki macro) reads its own clock and passes the day in; the same day always\n* answers the same words. The one draw of chance (`%.`) comes from an injected entropy door (`./entropy-door.js`).\n*\n* THE FORMAT CODES follow the `ddate(1)` the hosts carry, with two additions:\n*\n*   %A %a  weekday, long and short        %B %b  season, long and short\n*   %d     day of the season              %e     the day as an ordinal (1st, 11th, 21st, 22nd, 23rd)\n*   %E     the ordinal by its last digit alone (11st, 12nd, 13rd): the first ddate's reading, kept as an easter egg\n*   %H     the day's holyday, or nothing  %N     stop here unless today holds a holyday\n*   %Y     the YOLD                       %X     days until X-Day (negative once it passed)\n*   %n %t  newline, tab                   %.     an exclamation drawn through the entropy door\n*   %{ %}  the span between them reads \"St. Tib's Day\" on February 29 and prints plain on every other day\n*\n* A code this core does not know prints nothing. On St. Tib's Day a field outside the `%{ %}` span (`%A %a %B %b %d\n* %e %E`) reads \"St. Tib's Day\": the day carries no weekday, season or number, and the name stands in each place.\n* Of several `%{ %}` spans only the last one is replaced, as the hosts' ddate does.\n*\n* Platform-blind and pure.\n*/\nvar SEASONS = [\n\t\"Chaos\",\n\t\"Discord\",\n\t\"Confusion\",\n\t\"Bureaucracy\",\n\t\"The Aftermath\"\n];\nvar SEASONS_SHORT = [\n\t\"Chs\",\n\t\"Dsc\",\n\t\"Cfn\",\n\t\"Bcy\",\n\t\"Afm\"\n];\nvar WEEKDAYS = [\n\t\"Sweetmorn\",\n\t\"Boomtime\",\n\t\"Pungenday\",\n\t\"Prickle-Prickle\",\n\t\"Setting Orange\"\n];\nvar WEEKDAYS_SHORT = [\n\t\"SM\",\n\t\"BT\",\n\t\"PD\",\n\t\"PP\",\n\t\"SO\"\n];\n/** Day 5 of each season. */\nvar APOSTLE_HOLYDAYS = [\n\t\"Mungday\",\n\t\"Mojoday\",\n\t\"Syaday\",\n\t\"Zaraday\",\n\t\"Maladay\"\n];\n/** Day 50 of each season. */\nvar SEASON_HOLYDAYS = [\n\t\"Chaoflux\",\n\t\"Discoflux\",\n\t\"Confuflux\",\n\t\"Bureflux\",\n\t\"Afflux\"\n];\nvar TIBS_DAY = \"St. Tib's Day\";\n/** What `%.` draws from, in the order the hosts' ddate keeps them. */\nvar EXCLAMATIONS = [\n\t\"Hail Eris!\",\n\t\"All Hail Discordia!\",\n\t\"Kallisti!\",\n\t\"Fnord.\",\n\t\"Or not.\",\n\t\"Wibble.\",\n\t\"Pzat!\",\n\t\"P'tang!\",\n\t\"Frink!\",\n\t\"Grudnuk demand sustenance!\",\n\t\"Keep the Lasagna flying!\",\n\t\"You are what you see.\",\n\t\"Or is it?\",\n\t\"This statement is false.\",\n\t\"Lies and slander, sire!\",\n\t\"Hee hee hee!\",\n\t\"Hail Eris, Hack Linux!\"\n];\n/** The format a bare `ddate` reads today with. */\nvar DEFAULT_FORMAT = \"Today is %{%A, the %e day of %B%} in the YOLD %Y%N%nCelebrate %H\";\n/** X-Day: Confusion 40, 9827 YOLD, which falls on the Gregorian date below. */\nvar X_DAY_GREGORIAN = {\n\tyear: 8661,\n\tmonth: 7,\n\tday: 5\n};\nvar CUMULATIVE_DAYS = [\n\t0,\n\t31,\n\t59,\n\t90,\n\t120,\n\t151,\n\t181,\n\t212,\n\t243,\n\t273,\n\t304,\n\t334\n];\nvar MONTH_LENGTH = [\n\t31,\n\t28,\n\t31,\n\t30,\n\t31,\n\t30,\n\t31,\n\t31,\n\t30,\n\t31,\n\t30,\n\t31\n];\n/** The Gregorian leap rule on the year as written (the date's validity reads it so). */\nfunction isLeap(year) {\n\treturn year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\n}\n/** True when `date` names a day: a whole year (never zero), a month 1..12 and a day within that month. */\nfunction isGregorianDate(date) {\n\tconst { year, month, day } = date;\n\tif (![\n\t\tyear,\n\t\tmonth,\n\t\tday\n\t].every(Number.isInteger) || year === 0 || Math.abs(year) > 2147483647) return false;\n\tif (month < 1 || month > 12) return false;\n\tconst length = MONTH_LENGTH[month - 1] + (month === 2 && isLeap(year) ? 1 : 0);\n\treturn day >= 1 && day <= length;\n}\n/** Days since 1970-01-01 of a proleptic Gregorian date in astronomical years (year 0 stands). */\nfunction daysFromCivil(year, month, day) {\n\tconst y = month <= 2 ? year - 1 : year;\n\tconst era = Math.floor(y / 400);\n\tconst yearOfEra = y - era * 400;\n\tconst dayOfYear = Math.floor((153 * (month + (month > 2 ? -3 : 9)) + 2) / 5) + day - 1;\n\tconst dayOfEra = yearOfEra * 365 + Math.floor(yearOfEra / 4) - Math.floor(yearOfEra / 100) + dayOfYear;\n\treturn era * 146097 + dayOfEra - 719468;\n}\n/** The astronomical year of a year written without a year zero. */\nvar astronomical = (year) => year > 0 ? year : year + 1;\n/**\n* The Discordian day of a Gregorian date, or null when the date names no day. The YOLD reads the year plus 1166\n* (a BCE year counts one more, since no year zero stands between 1 BCE and 1 CE).\n*/\nfunction discordianDay(date) {\n\tif (!isGregorianDate(date)) return null;\n\tconst { year, month, day } = date;\n\tconst yold = year > 0 ? year + 1166 : year + 1167;\n\tconst leap = isLeap(year);\n\tlet yearDay = CUMULATIVE_DAYS[month - 1] + day - 1;\n\tif (leap && month > 2) yearDay += 1;\n\tif (leap && yearDay === 59) return {\n\t\tgregorian: date,\n\t\tyold,\n\t\ttibs: true,\n\t\tseason: -1,\n\t\tdayOfSeason: 0,\n\t\tweekday: -1,\n\t\tholyday: null\n\t};\n\tif (leap && yearDay > 59) yearDay -= 1;\n\tconst season = Math.floor(yearDay / 73);\n\tconst dayOfSeason = yearDay % 73 + 1;\n\tconst holyday = dayOfSeason === 5 ? APOSTLE_HOLYDAYS[season] : dayOfSeason === 50 ? SEASON_HOLYDAYS[season] : null;\n\treturn {\n\t\tgregorian: date,\n\t\tyold,\n\t\ttibs: false,\n\t\tseason,\n\t\tdayOfSeason,\n\t\tweekday: yearDay % 5,\n\t\tholyday\n\t};\n}\n/** Whole days from `date` to X-Day (negative once X-Day has passed). */\nfunction daysUntilXDay(date) {\n\tconst x = X_DAY_GREGORIAN;\n\treturn daysFromCivil(x.year, x.month, x.day) - daysFromCivil(astronomical(date.year), date.month, date.day);\n}\nvar suffixOf = (last) => last === 1 ? \"st\" : last === 2 ? \"nd\" : last === 3 ? \"rd\" : \"th\";\n/** The ordinal as people say it: 1st, 2nd, 3rd, 4th, 11th, 12th, 13th, 21st, 22nd, 23rd. */\nfunction ordinal(n) {\n\treturn `${n}${Math.abs(n) % 100 >= 11 && Math.abs(n) % 100 <= 13 ? \"th\" : suffixOf(Math.abs(n) % 10)}`;\n}\n/** The ordinal by its last digit alone: 11st, 12nd, 13rd. The easter egg `%E` prints this. */\nfunction ordinalByLastDigit(n) {\n\treturn `${n}${suffixOf(Math.abs(n) % 10)}`;\n}\n/** Render one Discordian day through a format. The text carries no trailing newline. */\nfunction formatDiscordian(day, format, door) {\n\tlet out = \"\";\n\tlet drew = false;\n\tconst tibStart = day.tibs ? format.lastIndexOf(\"%{\") : -1;\n\tconst tibEnd = day.tibs ? format.lastIndexOf(\"%}\") : -1;\n\tconst tibsOr = (text) => day.tibs ? TIBS_DAY : text;\n\tlet i = 0;\n\twhile (i < format.length) {\n\t\tconst ch = format[i];\n\t\tif (ch !== \"%\") {\n\t\t\tout += ch;\n\t\t\ti += 1;\n\t\t\tcontinue;\n\t\t}\n\t\tif (i === tibStart) {\n\t\t\tout += TIBS_DAY;\n\t\t\tif (tibEnd > tibStart) {\n\t\t\t\ti = tibEnd + 2;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tbreak;\n\t\t}\n\t\tconst code = format[i + 1];\n\t\ti += 2;\n\t\tswitch (code) {\n\t\t\tcase \"A\":\n\t\t\t\tout += tibsOr(WEEKDAYS[day.weekday]);\n\t\t\t\tbreak;\n\t\t\tcase \"a\":\n\t\t\t\tout += tibsOr(WEEKDAYS_SHORT[day.weekday]);\n\t\t\t\tbreak;\n\t\t\tcase \"B\":\n\t\t\t\tout += tibsOr(SEASONS[day.season]);\n\t\t\t\tbreak;\n\t\t\tcase \"b\":\n\t\t\t\tout += tibsOr(SEASONS_SHORT[day.season]);\n\t\t\t\tbreak;\n\t\t\tcase \"d\":\n\t\t\t\tout += tibsOr(String(day.dayOfSeason));\n\t\t\t\tbreak;\n\t\t\tcase \"e\":\n\t\t\t\tout += tibsOr(ordinal(day.dayOfSeason));\n\t\t\t\tbreak;\n\t\t\tcase \"E\":\n\t\t\t\tout += tibsOr(ordinalByLastDigit(day.dayOfSeason));\n\t\t\t\tbreak;\n\t\t\tcase \"H\":\n\t\t\t\tout += day.holyday ?? \"\";\n\t\t\t\tbreak;\n\t\t\tcase \"N\":\n\t\t\t\tif (day.holyday === null) return {\n\t\t\t\t\ttext: out,\n\t\t\t\t\tentropy: drew ? door.source : null\n\t\t\t\t};\n\t\t\t\tbreak;\n\t\t\tcase \"n\":\n\t\t\t\tout += \"\\n\";\n\t\t\t\tbreak;\n\t\t\tcase \"t\":\n\t\t\t\tout += \"\t\";\n\t\t\t\tbreak;\n\t\t\tcase \"Y\":\n\t\t\t\tout += String(day.yold);\n\t\t\t\tbreak;\n\t\t\tcase \"X\":\n\t\t\t\tout += String(daysUntilXDay(day.gregorian));\n\t\t\t\tbreak;\n\t\t\tcase \".\":\n\t\t\t\tout += entropyPick(door, EXCLAMATIONS);\n\t\t\t\tdrew = true;\n\t\t}\n\t}\n\treturn {\n\t\ttext: out,\n\t\tentropy: drew ? door.source : null\n\t};\n}\n/**\n* A deterministic door keyed on a day, for a surface that renders the day and never casts (a wiki macro): the same\n* day draws the same exclamation, and the door names itself as day-keyed.\n*/\nfunction dayEntropy(date) {\n\tlet state = daysFromCivil(astronomical(date.year), date.month, date.day) >>> 0 || 1;\n\treturn {\n\t\tsource: \"ddate:day-keyed (deterministic; never a cast)\",\n\t\tfill: (bytes) => {\n\t\t\tfor (let k = 0; k < bytes.length; k += 1) {\n\t\t\t\tstate ^= state << 13;\n\t\t\t\tstate >>>= 0;\n\t\t\t\tstate ^= state >>> 17;\n\t\t\t\tstate ^= state << 5;\n\t\t\t\tstate >>>= 0;\n\t\t\t\tbytes[k] = state & 255;\n\t\t\t}\n\t\t\treturn bytes;\n\t\t}\n\t};\n}\n//#endregion\n//#region src/macros/ddate.ts\n/**\n* `<<ddate>>` and `<<ddate format>>` — the Discordian date of the day the wiki renders on, through the house's own calendar core.\n*\n* The macro renders the DAY and never a cast: the same day answers the same words, and a `%.` in the format draws its\n* exclamation from a door keyed on the day, where the CLI and the daemon verb draw through the platform's entropy\n* door. THE CLOCK SEAM stays at this edge: the macro reads the local calendar day once and hands it to the core,\n* which reads no clock.\n*\n* The format takes the ddate(1) codes (`%A %a %B %b %d %e %E %H %N %n %t %Y %. %X %{ %}`); with none the default line\n* reads: \"Today is Prickle-Prickle, the 32nd day of The Aftermath in the YOLD 3192\".\n*/\nvar name = \"ddate\";\nvar params = [{ name: \"format\" }];\nfunction run(format) {\n\tconst here = /* @__PURE__ */ new Date();\n\tconst today = {\n\t\tyear: here.getFullYear(),\n\t\tmonth: here.getMonth() + 1,\n\t\tday: here.getDate()\n\t};\n\tconst day = discordianDay(today);\n\tif (day === null) return \"\";\n\treturn formatDiscordian(day, typeof format === \"string\" && format !== \"\" ? format : DEFAULT_FORMAT, dayEntropy(today)).text;\n}\n//#endregion\nexports.name = name;\nexports.params = params;\nexports.run = run;\n","type":"application/javascript","module-type":"macro"},"lar:///ha.ka.ba/lararium/tw5/routes/delete-meme":{"title":"lar:///ha.ka.ba/lararium/tw5/routes/delete-meme","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/routes/delete-meme\ntype: application/javascript\nmodule-type: route\n\\*/\nlet lararium_place_meme = require(\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\");\n//#region ../lararium-mesh/src/agile-digest.ts\n/** The algorithm tag of the house's sha256 digests — the one RFC 9530 `Repr-Digest` maps to. */\nvar SHA256_ALGO = \"sha256\";\n/** A 32-byte (SHA-256) digest's hex: exactly 64 hex chars. */\nvar SHA256_HEX = /^[0-9a-fA-F]{64}$/;\n/** A digest's hex part (even length ≥ 2) — another algorithm may carry another width. */\nvar HEX_BYTES = /^(?:[0-9a-fA-F]{2})+$/;\n/** A valid algorithm tag: lowercase alnum + dashes (blake3, sha512, sha2-256…). */\nvar ALGO_TAG = /^[a-z0-9][a-z0-9-]*$/;\n/** The RFC 9530 `Repr-Digest` field value: `sha-256=:<base64>:` (one member, the sf-binary item). */\nvar REPR_DIGEST = /^(sha-256)=:([A-Za-z0-9+/]+={0,2}):$/;\nvar B64 = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n/** The lowercase hex of a base64 byte string, or null where the base64 reads torn. Hand-rolled so\n*  the law runs the same in a browser, a plugin VM and node — no `Buffer`, no `atob`. */\nfunction hexOfBase64(b64) {\n\tconst body = b64.replace(/=+$/, \"\");\n\tif (body.length % 4 === 1) return null;\n\tlet bits = 0;\n\tlet acc = 0;\n\tlet hex = \"\";\n\tfor (const ch of body) {\n\t\tconst v = B64.indexOf(ch);\n\t\tif (v < 0) return null;\n\t\tacc = acc << 6 | v;\n\t\tbits += 6;\n\t\tif (bits >= 8) {\n\t\t\tbits -= 8;\n\t\t\thex += (acc >> bits & 255).toString(16).padStart(2, \"0\");\n\t\t}\n\t}\n\treturn hex;\n}\n/** The base64 of a lowercase hex byte string. */\nfunction base64OfHex(hex) {\n\tlet out = \"\";\n\tlet acc = 0;\n\tlet bits = 0;\n\tfor (let i = 0; i < hex.length; i += 2) {\n\t\tacc = acc << 8 | parseInt(hex.slice(i, i + 2), 16);\n\t\tbits += 8;\n\t\twhile (bits >= 6) {\n\t\t\tbits -= 6;\n\t\t\tout += B64[acc >> bits & 63];\n\t\t}\n\t}\n\tif (bits > 0) out += B64[acc << 6 - bits & 63];\n\twhile (out.length % 4 !== 0) out += \"=\";\n\treturn out;\n}\n/**\n* Parse a digest string into `(algo, hex)`.\n*\n*   \"sha256:ab…\"      → { algo: \"sha256\", hex: \"ab…\" }   (tagged, `:`)\n*   \"sha-256=:q80…=:\" → { algo: \"sha2