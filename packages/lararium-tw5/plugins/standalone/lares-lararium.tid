he sigil-head strata the memetic-wikitext reader typed; score = matching-strata count, max-normalized. */\nfunction structureTier(fold, sigilHead, limit = 10) {\n\tif (sigilHead.length === 0) return [];\n\tconst head = sigilHead.toLowerCase();\n\tconst counts = fold.docs.map((d) => ({\n\t\ttitle: d.title,\n\t\tn: d.stalk.headCounts.get(head) ?? 0\n\t})).filter((x) => x.n > 0);\n\tconst maxN = Math.max(1, ...counts.map((x) => x.n));\n\treturn rankHits(counts.map((x) => ({\n\t\ttitle: x.title,\n\t\tscore: x.n / maxN\n\t})), limit);\n}\n/** form — the seed title's shingle neighbors, ranked by Jaccard SIMILARITY; the seed stays out. */\nfunction formTier(fold, likeTitle, limit = 10) {\n\tconst seed = fold.docs.find((d) => d.title === likeTitle);\n\tif (!seed) return [];\n\tconst hits = [];\n\tfor (const d of fold.docs) {\n\t\tif (d.title === seed.title) continue;\n\t\tconst sim = 1 - jaccardDistance(seed.stalk.shingleSet, d.stalk.shingleSet);\n\t\tif (sim > 0) hits.push({\n\t\t\ttitle: d.title,\n\t\t\tscore: sim\n\t\t});\n\t}\n\treturn rankHits(hits, limit);\n}\n//#endregion\nexports.FORM_SHINGLE_K = FORM_SHINGLE_K;\nexports.IncrementalCorpusFold = IncrementalCorpusFold;\nexports.LOCI_CAP = LOCI_CAP;\nexports.MAX_DOC_SHINGLES = MAX_DOC_SHINGLES;\nexports.RECALL_LIMIT = RECALL_LIMIT;\nexports.capLoci = capLoci;\nexports.cohereFold = cohereFold;\nexports.contentTier = contentTier;\nexports.corpusPlanes = corpusPlanes;\nexports.deriveDocStalk = deriveDocStalk;\nexports.foldCorpus = foldCorpus;\nexports.formTier = formTier;\nexports.rankHits = rankHits;\nexports.readTw5Universe = readTw5Universe;\nexports.senseBodyOf = senseBodyOf;\nexports.shingles = shingles;\nexports.structureSalience = structureSalience;\nexports.structureTier = structureTier;\nexports.summarizeCoherence = summarizeCoherence;\nexports.universeOptions = universeOptions;\n","type":"application/javascript","module-type":"library"},"lar:///ha.ka.ba/lararium/tw5/modules/wiki-sense-indexer":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/wiki-sense-indexer","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/wiki-sense-indexer\ntype: application/javascript\nmodule-type: indexer\n\\*/\nlet lararium_wiki_sense_fold = require(\"lar:///ha.ka.ba/lararium/tw5/lib/wiki-sense-fold\");\n//#region src/modules/wiki-sense-indexer.ts\n/** The per-title cache key the stalk derivation rides (cleared by TW5 on that title's change). */\nvar STALK_CACHE = \"lararium-wiki-sense-stalk\";\n/**\n* The indexer — TW5 constructs one per wiki (`new WikiSenseIndexer(wiki)`), then drives\n* init/rebuild/update; lookups reach it through `wiki.getIndexer(\"WikiSenseIndexer\").fold(...)`.\n*/\nvar WikiSenseIndexer = class {\n\twiki;\n\t/** the volatile corpus memo, one fold per named universe — dies on ANY update, rebuilds on lookup. */\n\tfolds = {};\n\tconstructor(wiki) {\n\t\tthis.wiki = wiki;\n\t}\n\tinit() {\n\t\tthis.folds = {};\n\t}\n\trebuild() {\n\t\tthis.folds = {};\n\t}\n\t/** Fires SYNCHRONOUSLY inside addTiddler/deleteTiddler — invalidate cheap, rebuild on lookup. */\n\tupdate(_updateDescriptor) {\n\t\tthis.folds = {};\n\t}\n\t/** The lookup — the memoized corpus fold over the designated universe (default: the WHOLE wiki). */\n\tfold(universe = \"whole\") {\n\t\treturn this.folds[universe] ??= this.buildFold(universe);\n\t}\n\tbuildFold(universe) {\n\t\tconst docs = (0, lararium_wiki_sense_fold.readTw5Universe)(this.wiki, (0, lararium_wiki_sense_fold.universeOptions)(universe));\n\t\treturn (0, lararium_wiki_sense_fold.foldCorpus)(docs, (d) => this.wiki.getCacheForTiddler(d.title, STALK_CACHE, () => (0, lararium_wiki_sense_fold.deriveDocStalk)((0, lararium_wiki_sense_fold.senseBodyOf)(d.fields))));\n\t}\n};\n//#endregion\nexports.WikiSenseIndexer = WikiSenseIndexer;\n","type":"application/javascript","module-type":"indexer"},"lar:///ha.ka.ba/lararium/tw5/filters/wikisense":{"title":"lar:///ha.ka.ba/lararium/tw5/filters/wikisense","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/filters/wikisense\ntype: application/javascript\nmodule-type: filteroperator\n\\*/\nlet lararium_wiki_sense_fold = require(\"lar:///ha.ka.ba/lararium/tw5/lib/wiki-sense-fold\");\n//#region src/filters/wikisense.ts\n/** Reach the corpus fold — the indexer's held fold when it enumerates, else the direct fold. */\nfunction corpusOf(wiki, universe) {\n\tconst indexer = typeof wiki.getIndexer === \"function\" ? wiki.getIndexer(\"WikiSenseIndexer\") : null;\n\tif (indexer && typeof indexer.fold === \"function\") return indexer.fold(universe);\n\treturn (0, lararium_wiki_sense_fold.foldCorpus)((0, lararium_wiki_sense_fold.readTw5Universe)(wiki, (0, lararium_wiki_sense_fold.universeOptions)(universe)));\n}\n/** [wikisense:<verb>[:tier][:ordinary][operand]] — the sensorium spoken from wikitext-land. */\nfunction wikisense(_source, operator, options) {\n\tconst parts = (operator.suffix ?? \"\").split(\":\").filter((p) => p.length > 0);\n\tconst verb = parts[0] ?? \"\";\n\tconst universe = parts.includes(\"ordinary\") ? \"ordinary\" : \"whole\";\n\tconst operand = operator.operand ?? \"\";\n\tconst residual = parts.slice(1).find((p) => p !== \"title\" && p !== \"structure\" && p !== \"form\" && p !== \"ordinary\");\n\tif (residual !== void 0) return [`wikisense: unknown suffix token \"${residual}\" (expected title|structure|form|ordinary)`];\n\tif (verb === \"cohere\") {\n\t\tconst verdict = (0, lararium_wiki_sense_fold.cohereFold)(corpusOf(options.wiki, universe));\n\t\treturn [JSON.stringify((0, lararium_wiki_sense_fold.summarizeCoherence)(verdict))];\n\t}\n\tif (verb === \"recall\") {\n\t\tconst fold = corpusOf(options.wiki, universe);\n\t\tconst tier = parts.find((p) => p === \"title\" || p === \"structure\" || p === \"form\");\n\t\tconst tiers = tier ? [tier] : [\n\t\t\t\"title\",\n\t\t\t\"structure\",\n\t\t\t\"form\"\n\t\t];\n\t\tconst out = [];\n\t\tconst seen = /* @__PURE__ */ new Set();\n\t\tfor (const t of tiers) {\n\t\t\tconst hits = t === \"title\" ? (0, lararium_wiki_sense_fold.contentTier)(fold, operand) : t === \"structure\" ? (0, lararium_wiki_sense_fold.structureTier)(fold, operand) : (0, lararium_wiki_sense_fold.formTier)(fold, operand);\n\t\t\tfor (const h of hits) if (!seen.has(h.title)) {\n\t\t\t\tseen.add(h.title);\n\t\t\t\tout.push(h.title);\n\t\t\t}\n\t\t}\n\t\treturn out;\n\t}\n\treturn [`wikisense: unknown verb suffix \"${verb}\" (expected recall|cohere)`];\n}\n//#endregion\nexports.wikisense = wikisense;\n","type":"application/javascript","module-type":"filteroperator"},"lar:///ha.ka.ba/lararium/tw5/modules/worldline-read-vm":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/worldline-read-vm","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/worldline-read-vm\ntype: application/javascript\nmodule-type: startup\n\\*/\n//#region ../lararium-mesh/src/itc.ts\n/**\n* The seed stamp: full ownership (`id=1`), empty history (`event=0`). The root worldline\n* (the operator, the E-cut common cause) starts here; everything else forks from it.\n*/\nfunction itcSeed() {\n\treturn {\n\t\tid: 1,\n\t\tevent: 0\n\t};\n}\n/** Collapse a redundant id pair: `[0,0]→0`, `[1,1]→1`. Keeps ids minimal. */\nfunction normId(i) {\n\tif (i === 0 || i === 1) return i;\n\tconst l = normId(i[0]);\n\tconst r = normId(i[1]);\n\tif (l === 0 && r === 0) return 0;\n\tif (l === 1 && r === 1) return 1;\n\treturn [l, r];\n}\n/** Split an id into two disjoint halves (the fork primitive). */\nfunction splitId(i) {\n\tif (i === 0) return [0, 0];\n\tif (i === 1) return [[1, 0], [0, 1]];\n\tconst [l, r] = i;\n\tif (l === 0) {\n\t\tconst [r1, r2] = splitId(r);\n\t\treturn [[0, r1], [0, r2]];\n\t}\n\tif (r === 0) {\n\t\tconst [l1, l2] = splitId(l);\n\t\treturn [[l1, 0], [l2, 0]];\n\t}\n\treturn [[l, 0], [0, r]];\n}\n/** Sum two disjoint ids back into one (the join primitive on ownership). */\nfunction sumId(a, b) {\n\tif (a === 0) return b;\n\tif (b === 0) return a;\n\tif (a === 1 || b === 1) return 1;\n\treturn normId([sumId(a[0], b[0]), sumId(a[1], b[1])]);\n}\nfunction liftEvent(e, m) {\n\treturn typeof e === \"number\" ? e + m : [\n\t\te[0] + m,\n\t\te[1],\n\t\te[2]\n\t];\n}\nfunction sinkEvent(e, m) {\n\treturn typeof e === \"number\" ? e - m : [\n\t\te[0] - m,\n\t\te[1],\n\t\te[2]\n\t];\n}\n/** The floor (smallest value) of an event tree — its root base. */\nfunction minEvent(e) {\n\treturn typeof e === \"number\" ? e : e[0];\n}\n/** The ceiling (largest value) of an event tree. */\nfunction maxEvent(e) {\n\treturn typeof e === \"number\" ? e : e[0] + Math.max(maxEvent(e[1]), maxEvent(e[2]));\n}\n/**\n* Canonicalize ONE node whose children already stand canonical (each recursive join/fill result does): the\n* canonical rule (collapse equal flat children, sink shared depth into the base) read at the top alone, so a join or fill costs its path, not the tree.\n*/\nfunction normTop(n, l, r) {\n\tif (typeof l === \"number\" && typeof r === \"number\" && l === r) return n + l;\n\tconst m = Math.min(minEvent(l), minEvent(r));\n\treturn [\n\t\tn + m,\n\t\tsinkEvent(l, m),\n\t\tsinkEvent(r, m)\n\t];\n}\n/** Max-join two event histories (the join on history; commutative, idempotent). */\nfunction joinEvent(a, b) {\n\tif (typeof a === \"number\" && typeof b === \"number\") return Math.max(a, b);\n\tif (typeof a === \"number\") return joinEvent([\n\t\ta,\n\t\t0,\n\t\t0\n\t], b);\n\tif (typeof b === \"number\") return joinEvent(a, [\n\t\tb,\n\t\t0,\n\t\t0\n\t]);\n\tif (a[0] > b[0]) return joinEvent(b, a);\n\tconst m = b[0] - a[0];\n\treturn normTop(a[0], joinEvent(a[1], liftEvent(b[1], m)), joinEvent(a[2], liftEvent(b[2], m)));\n}\n/** Partial-order on histories: a ≤ b iff every event a knows, b knows. */\nfunction leqEvent(a, b) {\n\tif (typeof a === \"number\") return typeof b === \"number\" ? a <= b : a <= b[0];\n\tif (typeof b === \"number\") return a[0] <= b && leqEvent(liftEvent(a[1], a[0]), b) && leqEvent(liftEvent(a[2], a[0]), b);\n\treturn a[0] <= b[0] && leqEvent(liftEvent(a[1], a[0]), liftEvent(b[1], b[0])) && leqEvent(liftEvent(a[2], a[0]), liftEvent(b[2], b[0]));\n}\nfunction eventEqual(a, b) {\n\tif (typeof a === \"number\" || typeof b === \"number\") return a === b;\n\treturn a[0] === b[0] && eventEqual(a[1], b[1]) && eventEqual(a[2], b[2]);\n}\n/** Fill: where the id owns the whole interval, flatten the event to its max (cost-free growth). */\nfunction fill(i, e) {\n\tif (i === 0) return e;\n\tif (i === 1) return maxEvent(e);\n\tif (typeof e === \"number\") return e;\n\tconst [il, ir] = i;\n\tconst [n, el, er] = e;\n\tif (il === 1) {\n\t\tconst er2 = fill(ir, er);\n\t\treturn normTop(n, Math.max(maxEvent(el), minEvent(er2)), er2);\n\t}\n\tif (ir === 1) {\n\t\tconst el2 = fill(il, el);\n\t\treturn normTop(n, el2, Math.max(maxEvent(er), minEvent(el2)));\n\t}\n\treturn normTop(n, fill(il, el), fill(ir, er));\n}\n/** A large constant biasing growth toward shallower (lower-cost) branches. */\nvar GROW_DEPTH_COST = 1e3;\n/** Grow: add exactly one event in the id's region, returning the new history + a cost. */\nfunction grow(i, e) {\n\tif (i === 1) return [(typeof e === \"number\" ? e : maxEvent(e)) + 1, 0];\n\tif (typeof e === \"number\") {\n\t\tconst [e2, c] = grow(i, [\n\t\t\te,\n\t\t\t0,\n\t\t\t0\n\t\t]);\n\t\treturn [e2, c + GROW_DEPTH_COST];\n\t}\n\tconst [il, ir] = i;\n\tconst [n, el, er] = e;\n\tif (il === 0) {\n\t\tconst [er2, cr] = grow(ir, er);\n\t\treturn [[\n\t\t\tn,\n\t\t\tel,\n\t\t\ter2\n\t\t], cr + 1];\n\t}\n\tif (ir === 0) {\n\t\tconst [el2, cl] = grow(il, el);\n\t\treturn [[\n\t\t\tn,\n\t\t\tel2,\n\t\t\ter\n\t\t], cl + 1];\n\t}\n\tconst [el2, cl] = grow(il, el);\n\tconst [er2, cr] = grow(ir, er);\n\treturn cl <= cr ? [[\n\t\tn,\n\t\tel2,\n\t\ter\n\t], cl + 1] : [[\n\t\tn,\n\t\tel,\n\t\ter2\n\t], cr + 1];\n}\n/** fork = SPAWN — split the id, both halves inherit the shared event (parent → child). */\nfunction itcFork(s) {\n\tconst [i1, i2] = splitId(s.id);\n\treturn [{\n\t\tid: i1,\n\t\tevent: s.event\n\t}, {\n\t\tid: i2,\n\t\tevent: s.event\n\t}];\n}\n/** 