or.name !== \"tiddlyweb\" || typeof adaptor.saveTiddler !== \"function\") return;\n\tcharmAdaptor(adaptor, (options) => $tw.utils.httpRequest(options));\n}\n//#endregion\nexports.after = after;\nexports.charmAdaptor = charmAdaptor;\nexports.name = name;\nexports.platforms = platforms;\nexports.startup = startup;\nexports.synchronous = synchronous;\n","type":"application/javascript","module-type":"startup"},"lar:///ha.ka.ba/lararium/tw5/modules/meme-face":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/meme-face","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/meme-face\ntype: application/javascript\nmodule-type: startup\n\\*/\nlet lararium_place_meme = require(\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\");\nlet lararium_meme_laws = require(\"lar:///ha.ka.ba/lararium/tw5/modules/meme-laws\");\nlet _lararium_memetic_frame = require(\"lar:///ha.ka.ba/lararium/tw5/lib/memetic-frame\");\nlet lararium_meme_project = require(\"lar:///ha.ka.ba/lararium/tw5/modules/meme-project\");\nlet lararium_meme_ast = require(\"lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\");\nlet lararium_deserializer = require(\"lar:///ha.ka.ba/lararium/tw5/modules/deserializer\");\nlet smol_toml = require(\"lar:///ha.ka.ba/lararium/tw5/lib/smol-toml\");\n//#endregion\n//#region src/meme-ast/diagnostics.ts\nvar MEMETIC_SOURCE = \"text/memetic-wikitext+tiddlywiki\";\n/** Worst severity first, so a grade moves only when the worst class of fault moves. */\nvar SEVERITY_RANK = {\n\terror: 1,\n\twarning: 2,\n\tinfo: 3,\n\thint: 4\n};\n/**\n* The ladder, stated once.\n*\n* `error` names the one fault that costs the operator their bytes: a carrier that stops\n* round-tripping stops saying what their hands left, so the shore refuses it rather than\n* ingesting a lossy render. Every recovery sits below that line, because a recovery keeps the\n* text: the driver stands an unplaceable construct back up verbatim in an Error node, and grades\n* how far it fell. `warning` marks a construct the gram