{
  "name": "@lararium/node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "clean": "node ../../tools/clean-output.mjs dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "build:genesis": "pnpm --filter @lararium/tw5 build:plugin && tsx scripts/build-genesis-island.ts",
    "test:quine": "tsx scripts/test-quine.ts"
  },
  "dependencies": {
    "@automerge/automerge": "3.4.1",
    "@automerge/automerge-repo": "2.6.0-alpha.3",
    "@automerge/automerge-repo-network-messagechannel": "2.6.0-alpha.3",
    "@automerge/automerge-repo-network-websocket": "2.6.0-alpha.3",
    "@automerge/automerge-repo-storage-nodefs": "2.6.0-alpha.3",
    "@automerge/automerge-subduction": "0.16.1",
    "@lararium/keyhive": "workspace:*",
    "@lararium/mempalace": "workspace:*",
    "@lararium/mesh": "workspace:*",
    "@lararium/sensorium": "workspace:*",
    "@lararium/tw5": "workspace:*",
    "@octokit/rest": "22.0.1",
    "@types/ws": "8.18.1",
    "isomorphic-ws": "5.0.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@noble/ed25519": "3.2.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
