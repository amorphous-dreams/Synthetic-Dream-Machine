tags      = ["lar:///ha.ka.ba/lares/api/pono/affordance", "lar:///face.handle.rotates", "candidate"]
title     = "lar:///ha.ka.ba/lares/afford/face.handle.rotates"
type      = "text/memetic-wikitext+tiddlywiki"
uri-path  = "ha.ka.ba/lares/afford/face.handle.rotates"
