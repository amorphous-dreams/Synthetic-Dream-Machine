```toml meta
cacheable = true
l-space   = "stable"
role      = "mint a recovery contact's fresh key for one face, card and offer"
tags      = ["lar:///ha.ka.ba/lares/api/pono/affordance", "lar:///face.recovery.offers", "candidate"]
title     = "lar:///ha.ka.ba/lares/afford/face.recovery.offers"
