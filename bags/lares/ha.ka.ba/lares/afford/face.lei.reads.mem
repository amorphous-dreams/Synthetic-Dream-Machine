tags      = ["lar:///ha.ka.ba/lares/api/pono/affordance", "lar:///face.lei.reads", "candidate"]
title     = "lar:///ha.ka.ba/lares/afford/face.lei.reads"
type      = "text/memetic-wikitext+tiddlywiki"
uri-path  = "ha.ka.ba/lares/afford/face.lei.reads"
