```toml meta
cacheable = true
l-space   = "stable"
role      = "read whether a restored face still waits on a party's view"
tags      = ["lar:///ha.ka.ba/lares/api/pono/affordance", "lar:///face.restore.reads", "candidate"]
title     = "lar:///ha.ka.ba/lares/afford/face.restore.reads"
type      = "text/memetic-wikitext+tiddlywiki"
uri-path  = "ha.ka.ba/lares/afford/face.restore.reads"
