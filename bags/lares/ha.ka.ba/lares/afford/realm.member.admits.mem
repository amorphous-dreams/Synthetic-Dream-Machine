```toml meta
cacheable = true
l-space   = "stable"
role      = "admit a joining operator's per-Nexus leaf and emit the admit bundle"
tags      = ["lar:///ha.ka.ba/lares/api/pono/affordance", "lar:///realm.member.admits", "candidate"]
title     = "lar:///ha.ka.ba/lares/afford/realm.member.admits"
