```toml meta
cacheable = true
l-space   = "stable"
role      = "read an edge partial, and with --act add this vessel's seats"
tags      = ["lar:///ha.ka.ba/lares/api/pono/affordance", "lar:///realm.edge.cosigns", "candidate"]
