touch "${store}/ok" && echo STOREWRITE >> "${log}"
`, { mode: 0o755 });
  writeFileSync(path.join(x.wt, 'package.json'), JSON.stringify({ name: 'p', scripts: { postinstall: `touch ${probe}` } }));
  const seat = { worktree: x.wt, gitDir: x.ctx.gitDir, pnpm: path.join(pnpmBin, 'pnpm'), storeDir: store, iso: x.iso, extraRw: [x.root], protect: [x.control] };
