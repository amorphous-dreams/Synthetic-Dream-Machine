\procedure tag-pill(target)
<$link to=<<target>>>
<span class="sdm-tag-pill">
<$transclude $tiddler=<<target>> $field="caption">
<$text text={{{ [<target>split[/]last[1]] }}}/>
</$transclude>
</span>
</$link>
\end
