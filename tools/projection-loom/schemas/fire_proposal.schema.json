{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amorphous-dreams/Synthetic-Dream-Machine/schema/fire-proposal",
  "title": "Operator-AI Fire to Loom typed relational proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "inscription",
    "folio",
    "source",
    "bindings",
    "alternatives",
    "intent"
  ],
  "properties": {
    "schema": {
      "const": "projection-loom/fire-proposal"
    },
    "inscription": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1024
    },
    "folio": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "study",
              "counterpoint",
              "facture"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "witness_id"
      ],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "witness_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128
        },
        "seed_entity_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "selector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "role",
              "parents",
              "slot",
              "has"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "material",
                  "void",
                  "entity",
                  "location"
                ]
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "parents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "slot": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "has": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "pet_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "oneOf": [
          {
            "required": [
              "selector"
            ]
          },
          {
            "required": [
              "pet_name"
            ]
          }
        ]
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "relation",
          "object",
          "implementation",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "subject": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "bridges",
              "encircles",
              "bears",
              "studies"
            ]
          },
          "object": {
            "type": "string"
          },
          "implementation": {
            "enum": [
              "bridge-between",
              "ring-around",
              "bearing-column",
              "study-only"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 4
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 4
              },
              "clearance": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              }
            }
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "state",
        "read",
        "attribution"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "proposed"
        },
        "read": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "attribution": {
          "enum": [
            "operator-request",
            "ai-interpretation"
          ]
        }
      }
    }
  }
}
