{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projection-loom/solid-project/v2",
  "title": "Projection Loom constructive-solid project",
  "type": "object",
  "required": ["schema","builder","cameras","initial","bounds"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const":"projection-loom/solid-project/v2"},
    "builder": {"type":"string","pattern":"^[^:]+:[A-Za-z_][A-Za-z0-9_]*$"},
    "cameras": {"type":"object","minProperties":1,"additionalProperties":{"type":"object","properties":{"azimuth":{"type":"number"},"elevation":{"type":"number"},"fit":{"enum":["height","bounds"]},"margin":{"type":"number","minimum":0,"maximum":0.45}}}},
    "initial": {"type":"object","minProperties":1,"additionalProperties":{"type":"number"}},
    "bounds": {"type":"object","minProperties":1,"additionalProperties":{"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2}},
    "reference": {"type":"string"},
    "reference_view": {"type":"string"},
    "light_angles": {"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2},
    "render": {"type":"object"}
  }
}
