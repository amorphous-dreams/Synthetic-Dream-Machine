/**
 * vessel-kel — the floor key's own inception: the key revealed and signed by itself, with no next key committed.
 *
 * THE FLOOR STANDS NON-TRANSFERABLE. A vessel's floor key names a place on one device, and it commits no next
 * key-set, so it cannot rotate by construction (KERI's non-transferable identifier). A lost or stolen floor key gets
 * answered by founding the place afresh, never by a rotation. A next-key seed would rest on the same disk as the key
 * it succeeds, so a thief of the disk would take both, and no verb rotates the floor key: such a commitment guards
 * nothing. See lar:///ha.ka.ba/lararium/mesh/identity-classes.
 *
 * NO CLOCK, NO VERSION. The record holds `t` (the event kind), `k` (the key) and `sig`, and nothing beside them: no
 * creation date, no version tag, no sequence counter, no next-key digest and no next threshold. The key signs the
 * canonical bytes under the `vessel-kel` domain; Ed25519 signs deterministically, so one seed mints one byte string.
 *
 * ONE SHAPE, READ STRICTLY. The reader and the check both refuse a record that carries any other field, so an
 * inception that commits a next key, or tells a time, never reads as this one.
 */

import { ed25519 } from "@noble/curves/ed25519.js";
import { canonicalJsonBytes, hex } from "./crypto.js";
import { VESSEL_KEL_DOMAIN } from "./domains.js";
import { verifyEd25519 } from "./ed25519-door.js";

export interface VesselKelInception {
  readonly t:   "icp";
  /** The floor key's public bytes, hex: one key. */
  readonly k:   readonly string[];
  /** The floor key's Ed25519 signature over the signed bytes, hex. */
  readonly sig: string;
}

/** The fields an inception holds, sorted: any record holding others refuses. */
const FIELDS = "k,sig,t";

/** The bytes the key signs: the domain, then the event kind and the key. */
const signedBytes = (t: string, k: readonly string[]): Uint8Array => canonicalJsonBytes({ domain: VESSEL_KEL_DOMAIN, t, k });

/** Mint the inception from the floor seed. Pure: the same seed mints the same bytes. */
export function inceptVesselKel(signingSeed: Uint8Array): { readonly inception: VesselKelInception; readonly bytes: Uint8Array } {
  if (signingSeed.length !== 32) throw new Error("vessel-kel: the floor seed must ride 32 bytes");
  const t = "icp" as const;
  const k = [hex(ed25519.getPublicKey(signingSeed))];
  const inception: VesselKelInception = { t, k, sig: hex(ed25519.sign(signedBytes(t, k), signingSeed)) };
  return { inception, bytes: canonicalJsonBytes(inception) };
}

/** Does the inception hold exactly its own fields, name one key, and carry that key's signature under `vessel-kel`? */
export function verifyVesselKelInception(inception: VesselKelInception): boolean {
  try {
    if (Object.keys(inception).sort().join(",") !== FIELDS) return false;
    if (inception.t !== "icp" || !Array.isArray(inception.k) || inception.k.length !== 1 || typeof inception.k[0] !== "string") return false;
    return verifyEd25519(inception.sig, signedBytes(inception.t, inception.k), inception.k[0]);
  } catch {
    return false;
  }
}

/** Read an inception from its bytes; anything torn, extra or missing reads `null`, a next-key commitment among them. */
export function decodeVesselKelInception(bytes: Uint8Array): VesselKelInception | null {
  try {
    const raw = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes)) as Record<string, unknown>;
    if (!raw || typeof raw !== "object" || Array.isArray(raw)) return null;
    if (Object.keys(raw).sort().join(",") !== FIELDS) return null;
    const strings = (v: unknown): v is string[] => Array.isArray(v) && v.every((s) => typeof s === "string");
    if (raw.t !== "icp" || !strings(raw.k) || typeof raw.sig !== "string") return null;
    return { t: "icp", k: raw.k, sig: raw.sig };
  } catch {
    return null;
  }
}
function fileKeypairStore(keyFile: string, login: string | null): KeypairStore {
  return {
    async load() {
      if (!existsSync(keyFile)) return undefined;
      const raw = JSON.parse(readFileSync(keyFile, "utf8")) as PersistedKey;
      return { verifyingKey: raw.verifyingKey, signingKey: raw.signingKey };
    },
    async save(kp) {
      const persisted: PersistedKey = {
        verifyingKey: kp.verifyingKey,
        signingKey:   kp.signingKey,
        ...(login ? { gitEmail: login } : {}),
      };
      writeFileSync(keyFile, JSON.stringify(persisted, null, 2), { mode: 0o600, encoding: "utf8" });
      chmodSync(keyFile, 0o600);
    },
  };
}

// ── THE INCEPTION: the floor key signed by itself, and no next key ───────────
//
// The floor key stands NON-TRANSFERABLE (lar:///ha.ka.ba/lararium/mesh/identity-classes): it commits no next key, so
// it cannot rotate by construction, and a lost or stolen floor key gets answered by founding the place afresh. Its
// one inception (`packages/lararium-mesh/src/vessel-kel.ts`) names the key and carries the key's own signature, and
// nothing beside: no next-key digest, no next threshold, no clock, no version. The same seed mints the same bytes.
// It rests in the clear beside the key (a `floor` row), and every load of a standing key reads it: an inception that
// fails to prove that key refuses by name (`VesselInceptionRefused`), and nothing writes one over a standing key.
function kelFileName(login: string | null): string {
  return login ? `.vessel-kel-${login}.json` : ".vessel-kel.json";
}

/** A standing vessel key whose own files fail to prove it (its inception, or a seed that derives another key); nothing gets written over either file. */
export class VesselInceptionRefused extends Error {
  override readonly name = "VesselInceptionRefused";
  constructor(readonly kelFile: string, readonly reading: "absent" | "malformed" | "names-another-key" | "signature-fails" | "seed-names-another-key") {
    super(
      `the vessel key's inception at ${kelFile} reads ${reading}: a floor key proves itself by its own inception, ` +
      `and none gets written over a standing key — found the place afresh on a fresh root`,
    );
  }
}

/** Read the inception standing at `kelFile` and hold it to `verifyingKey`; refuse by name where it fails. */
function proveInception(kelFile: string, verifyingKey: string): void {
  if (!existsSync(kelFile)) throw new VesselInceptionRefused(kelFile, "absent");
  const inception = decodeVesselKelInception(readFileSync(kelFile));
  if (inception === null) throw new VesselInceptionRefused(kelFile, "malformed");
  if (inception.k.length !== 1 || inception.k[0] !== verifyingKey) throw new VesselInceptionRefused(kelFile, "names-another-key");
  if (!verifyVesselKelInception(inception)) throw new VesselInceptionRefused(kelFile, "signature-fails");
}

/**
 * Hold the keypair a key file carries to itself and to its inception: the seed derives the public key the file
 * names (`seed-names-another-key` where it does not), and the inception proves that key. Every load of a standing
 * key passes here, so no door signs or derives under a seed its inception never named.
 */
function proveStandingKey(kelFile: string, raw: { readonly verifyingKey?: unknown; readonly signingKey?: unknown }): void {
  if (typeof raw.signingKey !== "string" || !/^[0-9a-f]{64}$/.test(raw.signingKey)
    || typeof raw.verifyingKey !== "string" || verifyingKeyOfSeed(raw.signingKey) !== raw.verifyingKey) {
    throw new VesselInceptionRefused(kelFile, "seed-names-another-key");
  }
  proveInception(kelFile, raw.verifyingKey);
}

/**
 * Land `bytes` at `file` whole or not at all (mode 0o600), and durably: a sidecar written and synced, a rename,
 * then the directory synced. No reader meets half a file, and a file landed here outlives a power loss before the
 * next one lands, so the inception a key answers to never trails the key.
 */
function publishFile(file: string, bytes: string | Uint8Array): void {
  const side = `${file}.landing`;
  const cardFile = join(idDir, cardFileName(hint.login));
  writeFileSync(cardFile, contactCardJson, { mode: 0o600, encoding: "utf8" });
  chmodSync(cardFile, 0o600);
  console.log(`[vessel-identity] persisted ContactCard${hint.login ? ` for ${hint.login}` : ""}`);
}

/**
 * Load the operator's cached ContactCard JSON. Throws when absent — the caller
 * must run `lares vessel found` (which mints + persists it during the founding ceremony).
 */
export async function loadVesselCard(): Promise<string> {
  const hint     = await readLocalOperatorHint().catch(() => ({ login: null, displayName: null }));
  const cardFile = join(identityDir(), cardFileName(hint.login));
  if (!existsSync(cardFile)) {
    throw new Error(
      `[vessel-identity] no ContactCard at ${cardFile} — run \`lares vessel found\` (it mints the card during the founding ceremony)`,
    );
  }
  return readFileSync(cardFile, "utf8");
}

export async function loadVesselSigningSeed(): Promise<Uint8Array> {
  const hint    = await readLocalOperatorHint().catch(() => ({ login: null, displayName: null }));
  const keyFile = join(identityDir(), keyFileName(hint.login));
  if (!existsSync(keyFile)) {
    throw new Error(
      `[vessel-identity] no key file at ${keyFile} — run \`lares vessel found\` first to generate the keypair`,
    );
  }
  const raw = JSON.parse(readFileSync(keyFile, "utf8")) as PersistedKey;
  if (typeof raw.signingKey !== "string" || raw.signingKey.length !== 64) {
    throw new Error(`[vessel-identity] malformed signingKey in ${keyFile}`);
  }
  proveStandingKey(join(identityDir(), kelFileName(hint.login)), raw);
  return signingSeedFromHex(raw.signingKey);
}

