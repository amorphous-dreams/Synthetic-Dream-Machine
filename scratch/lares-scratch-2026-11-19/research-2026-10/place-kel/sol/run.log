  HandleKelEvent,
  | "seq" | "kind" | "prefix" | "handleKeyDid" | "genesisOwnerSetHash" | "ownerSetHash"
  | "recoverySetHash" | "nextRecoverySetHash" | "nextHandleKeyDigest" | "prevEventCid" | "ownerAuthMemberPrefix" | "ownerAuthKeyDid"
