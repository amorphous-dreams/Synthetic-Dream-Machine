function buildTable(): readonly CarrierRow[] {
  const id = (r: IdentityRowSpec): CarrierRow => row({ home: "identity", under: "", ...r });
  return Object.freeze([
    // ── floor: outside the S key ──────────────────────────────────────────────────────────────────
    id({ row: "vessel-key", target: tgt(["S"], LEAD, "place-signer"), match: loginKeyed("vessel-key"), custody: "floor", keyClass: "device-minted",
         writer: "node-vessel-identity (founding)",
         bare: "the floor signs with it before any person unlocks, so no vessel key may stand between a boot and it" }),
    id({ row: "vessel-kel", target: tgt(["F"]), match: loginKeyed("vessel-kel"), custody: "floor", keyClass: null,
         writer: "node-vessel-identity (founding)",
         bare: "the vessel key's own inception names that key and carries its signature: it stands public and proves itself, and a load of the key reads it before any person unlocks" }),
    id({ row: "s-slots", target: tgt(["D", "S"], LEAD, "place-signer"), match: exact(sSlotsPath()), custody: "floor", keyClass: null,
         writer: "vault bind",
         bare: "the slot tree wraps the vessel key under each human route, so the key it wraps cannot seal it" }),
    id({ row: "sk-slots", target: tgt(["S"], LEAD), match: exact(skSlotsPath()), custody: "floor", keyClass: null,
         writer: "custody-session (founding)",
         bare: "the serving tree wraps the serving key under the vessel key's entry, so the key it wraps cannot seal it, and a raise reads it before any key opens" }),
          custody: "floor-plain", keyClass: null, writer: "sealed-store-fs",
          bare: "a note holds opaque ids of the sealed store, a one-byte mark or nothing, under an opaque name, and no secret, name or key" }),
    // The Keyhive chunks a provider tracks per bag (`sealed-store-fs`): one ciphertext per content reference.
    row({ row: "sealed-chunk", target: tgt(["F"]), home: "storage", under: "sealed", match: /^sealed\/keyhive-chunks\/[0-9a-f]{1,128}\/[0-9a-f]{1,128}$/,
          custody: "floor-plain", keyClass: null, writer: "sealed-store-fs",
          bare: "a chunk rests as Keyhive ciphertext under an opaque name, and a blind carrier may hold every one" }),

    // ── hot: sealed under the S key, opened at unlock ─────────────────────────────────────────────
    id({ row: "gate-root", target: tgt(["D"], LEAD), match: exact(custodyRootPath()), custody: "hot", keyClass: "device-minted",
         writer: "custody-root (founding)" }),
    id({ row: "place-archive", target: tgt(["D"], LEAD, "archive-row-selector"), match: exact(archivePath()), custody: "hot", keyClass: "device-minted",
         writer: "identity-anchors" }),
    faceRowOf({ row: "veil-archive", target: tgt(["D"], LEAD, "archive-row-selector"), inner: VEIL_ARCHIVE_FILE, select: (m) => ({ group: m[1]! }), custody: "face-hot", keyClass: "device-minted",
         writer: "identity-anchors", name: (m) => `veil-archive-g${m[1]}`, face: (m) => `group:${m[1]}` }),
    // A group digest owns this local atom row; bundles leave its seed on this vessel.
    faceRowOf({ row: "face-atom", target: tgt(["D"]), inner: FACE_ATOM_GROUP_FILE, select: (m) => ({ group: m[1]! }), custody: "face-hot", keyClass: "device-minted",
  aid?: string;
}): Promise<{ nym: string; sealEpochCid: string; carrierSig: string; floorPin: PlaceFloorPinStatement | null }> {
  const home = charterHomeOrRefuse(opts.sealHome, opts.aid);
  const roster = foundingRoster(readNexusDoc(home));
  if (roster.sealEpochCid.length === 0) {
    throw new NexusContractError("no seated charter epoch to bind carriage to — import the charter (`lares nexus seal import`) first.");
  }
  const nym  = (await loadVesselVerifyingKey()).toLowerCase();
  const seed = await loadVesselSigningSeed();
  const sig  = await signCarrierContract(nym, roster.sealEpochCid, ed25519SignerFromSeed(seed));
  // THE PLACE'S FLOOR PIN AT THIS NEXUS, signed with the same vessel key the carry will name (`place-floor-pin`). It
  // authenticates nothing on its own: a reader files it only once its own replica counts the carry.
  const aid = primaryNexusAid(home);
  let floorPin: PlaceFloorPinStatement | null = null;
  if (aid) {
    const pin = flowFloorPinAt(aid, opts.floorDoor ?? await vesselFloorKeyDoor());
    const signer = ed25519SignerFromSeed(seed);
    floorPin = await signPlaceFloorPin({ placeKey: nym, pin, sign: async (image) => hexToBytes(await signer(image)) });
  }
  return { nym, sealEpochCid: roster.sealEpochCid, carrierSig: sig.sig, floorPin };
}

/** Read a supplied floor-pin statement for a `carry` of `nym` at `aid`: its own pin, signed by its own key. Refuses otherwise. */
function floorPinOrRefuse(raw: string, nym: string, aid: string): PlaceFloorPinStatement {
  let parsed: unknown;
  try { parsed = JSON.parse(raw); } catch { throw new NexusContractError("carry REFUSED: the --floor-pin statement does not parse as JSON — pass the `floorPin` `nexus carry-for --json` printed, whole."); }
  // The carrier set here is the named place alone: this checks the statement's own bytes; the board's readers judge the relation.
  const read = readPlaceFloorPin(parsed, { nexusHex: Buffer.from(aid, "utf8").toString("hex"), route: FLOW_SOCKET_ROUTE, carriers: new Set([nym]) });
  if ("refusal" in read) throw new NexusContractError(`carry REFUSED: the --floor-pin statement does not read for this place at this Nexus (${read.refusal}). Nothing was written.`);
