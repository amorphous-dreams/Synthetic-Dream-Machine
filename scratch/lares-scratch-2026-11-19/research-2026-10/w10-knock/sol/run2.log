   394	/** Encode an invite as the one string a human carries. */
   395	export function encodeInvite(invite: HostingInvite): string {
   396	  const body = {
   397	    nexusAid: normAid(invite.nexusAid), gatePubKey: invite.gatePubKey.toLowerCase(),
   398	    ...(invite.relay ? { relay: invite.relay } : {}), token: invite.token,
   399	  };
   400	  return INVITE_SCHEME + base64UrlEncode(canonicalJsonBytes(body));
   401	}
