   253	    try {
   254	      const dial = noiseInitiate({ prologue: gatePrologue(pin), s: staticPair, rs: hexToBytes(pin.transportKey) });
   255	      await socket.open({ knock: gateKnock(pin), message1: dial.message1 });
   256	      const message2 = await socket.recv();
   257	      if (message2 === null) return { state: "silence" };
   258	      const answered = dial.readMessage2(message2);
   259	      if (answered.payload.length !== 0) return { state: "silence" };
   260	      const transport = answered.transport;
   261	      const presentation = encodePlacePresentation({ placeKey: args.placeKey, arm: args.arm, audience: args.audience });
   262	      const bundleDigest = gateBundleDigest(pin);
   263	      const signature = await args.sign(gatePlaceFinishImage({
   264	        handshakeHash: transport.handshakeHash, bundleDigest, presentationDigest: gatePresentationDigest(presentation), audience: args.audience, placeKey: args.placeKey,
   265	      }));
   266	      for (const part of gateParts(GATE_FRAME.presentationPart, GATE_FRAME.presentationEnd, presentation)) socket.send(transport.send.seal(part));
