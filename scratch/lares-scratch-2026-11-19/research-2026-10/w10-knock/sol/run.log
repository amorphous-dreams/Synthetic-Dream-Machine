   229	/** A place hears `verified` or nothing: it holds no face, so no state of a face's history answers it. */
   230	export type PlaceDialOutcome =
   231	  | { readonly state: "verified"; readonly transport: NoiseTransport }
   232	  | { readonly state: "silence" }
   233	  | { readonly state: "refused"; readonly refusal: "pin-refused" | "pin-other-tier" };
