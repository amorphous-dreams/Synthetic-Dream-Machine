    91	/** The slice of a `ws` socket this adapter reads: its events, its flow control, its send and its terminate. */
    92	export interface GateWire {
    93	  readonly readyState: number;
    94	  on(event: "message", listener: (data: unknown, isBinary: boolean) => void): unknown;
    95	  on(event: "close" | "error", listener: (...args: unknown[]) => void): unknown;
    96	  send(data: Uint8Array, opts: { binary: true }): void;
