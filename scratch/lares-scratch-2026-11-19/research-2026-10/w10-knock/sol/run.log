   212	    !isCarriageDescendant(rollAnchorCid(anchor), contractCid, causal)) return verdict("wrong-epoch", "contract-not-in-anchor-past");
   213	  let closing = false, concurrent = false;
   214	  const denyRosters = new Map(rosters);
   215	  for (const epoch of held ?? []) {
   216	    if (denyRosters.has(epoch.epochCid)) continue;
   217	    const seats = epochSeats(epoch);
   218	    if (seats) denyRosters.set(epoch.epochCid, { keys: [...seats.keys], threshold: seats.threshold, sealEpochCid: epoch.epochCid });
   219	  }
   220	  for (const entry of root.denyBoard) {
   221	    if (entry === null || typeof entry !== "object" || entry.action !== "uncarry" || typeof entry.nym !== "string" || entry.nym.toLowerCase() !== nym) continue;
   222	    const at = denyRosters.get(entry.sealEpochCid);
   223	    if (!at || !(await carriageEntryCounts(entry, at))) continue;
   224	    const cid = carriageEntryActCid(entry);
   225	    if (!causal.has(cid)) causal.set(cid, entry);
   226	    if (isCarriageDescendant(cid, contractCid, causal)) closing = true;
   227	    else if (!isCarriageDescendant(contractCid, cid, causal)) concurrent = true;
   228	  }
   229	  let kapaeHeld = false, kapaeUnsettled = false;
   230	  for (const [antigenNym, reading] of await foldAntigenVerdicts(root.antigen, root.antigenRoster, root.antigenVerifier)) {
   231	    if (antigenNym.toLowerCase() !== nym) continue;
   232	    if (reading === "held") kapaeHeld = true; else if (reading !== "withdrawn") kapaeUnsettled = true;
   233	  }
   234	  if (kapaeHeld) return verdict("denied", "kapae-held");
   235	  if (closing) return verdict("denied", "uncarry-descends-from-contract");
   236	  if (kapaeUnsettled) return verdict("unsettled", "kapae-unsettled");
   237	  if (concurrent) return verdict("unsettled", "uncarry-concurrent-with-contract");
   238	  return verdict("held", "held");
   239	}
