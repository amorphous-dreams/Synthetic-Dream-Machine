   104	function bytesOf(data: unknown): Uint8Array | null {
   105	  if (data instanceof Uint8Array) return Uint8Array.from(data);
   106	  if (data instanceof ArrayBuffer) return new Uint8Array(data.slice(0));
   107	  if (Array.isArray(data) && data.every((part) => part instanceof Uint8Array)) return Uint8Array.from(Buffer.concat(data as Uint8Array[]));
   108	  return null;
   109	}
