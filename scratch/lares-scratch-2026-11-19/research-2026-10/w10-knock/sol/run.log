   194	// ── The session table ───────────────────────────────────────────────────────────────────────────
   195	
   196	/** One seated session the registry opened: the sealed channel and what the gate proved. */
   197	export interface SeatedGateSession {
   198	  readonly channel: GateSessionChannel;
   199	  readonly session: GateSession;
   200	}
   201	
   202	export interface GateSessionRegistry {
   203	  /** The table every gate this vessel stands seats through. */
   204	  readonly table: GateSessionTable;
   205	  /** The sessions opened and not yet closed, in the order they opened. */
   206	  live(): readonly SeatedGateSession[];
   207	  /** Close every live session `which` names (a refold whose standing no longer holds); answers how many it closed. */
   208	  drop(which: (session: GateSession) => boolean): number;
   209	  /** Close every live session. */
   210	  close(): void;
   211	}
   212	
   213	/**
   214	 * The session table over `channelSessionTable`: a verified dial seats a pending sealed channel; once the gate's
   215	 * verdict left and the seat opens, `onOpen` takes the channel and the frozen session exactly once. A throw from
   216	 * `onOpen` closes the channel and the gate cuts the socket.
   217	 */
   218	export function gateSessionRegistry(
   219	  onOpen: (channel: GateSessionChannel, session: GateSession) => void,
   220	  opts: {
   221	    /** How many stranger sessions stand seated at once (`GATE_SERVER_MAX_STRANGERS`). */
   222	    readonly maxStrangers?: number;
   223	    /** The bounds each seat holds to (`gateChannelBoundsFor`). */
   224	    readonly bounds?: (session: GateSession) => GateChannelBounds;
   225	  } = {},
   226	): GateSessionRegistry {
   227	  const maxStrangers = opts.maxStrangers ?? GATE_SERVER_MAX_STRANGERS;
   228	  if (!Number.isInteger(maxStrangers) || maxStrangers < 0) throw new RangeError("face-gate-server: the stranger bound names a count");
   229	  const opened: SeatedGateSession[] = [];
   230	  let closed = false;
   231	  // Stranger seats taken and not yet opened or abandoned: the cap reads them beside the open ones.
   232	  let pendingStrangers = 0;
   233	  const prune = (): void => {
   234	    for (let at = opened.length - 1; at >= 0; at--) if (opened[at]!.channel.state === "closed") opened.splice(at, 1);
   235	  };
   236	  const strangersSeated = (): number => { prune(); return pendingStrangers + opened.filter((o) => o.session.class === "stranger").length; };
   237	  const channels = channelSessionTable((channel, session) => {
   238	    // A seat that opens after the registry closed reaches nobody: its channel closes and the gate cuts the socket.
   239	    if (closed) { channel.close(); throw new Error("face-gate-server: the session registry stands closed"); }
   240	    const seated = Object.freeze({ channel, session });
   241	    opened.push(seated);
   242	    try { onOpen(channel, session); } catch (error) {
   243	      const at = opened.indexOf(seated);
   244	      if (at >= 0) opened.splice(at, 1);
   245	      throw error;
   246	    }
   247	  }, { bounds: opts.bounds ?? gateChannelBoundsFor });
   248	  // THE STRANGER CAP, read at attach, before any verdict leaves: a table that throws draws the dialer silence.
   249	  const table: GateSessionTable = {
   250	    attach(socket, session) {
   251	      if (session.class !== "stranger") return channels.attach(socket, session);
   252	      if (strangersSeated() >= maxStrangers) throw new Error("face-gate-server: the stranger seats stand full");
   253	      pendingStrangers++;
   254	      let pending = true;
   255	      const settle = (): void => { if (pending) { pending = false; pendingStrangers--; } };
   256	      const held = (seat: GateSeat): GateSeat => ({
   257	        open() { settle(); seat.open(); },
   258	        abandon() { settle(); seat.abandon(); },
   259	      });
   260	      let seat: ReturnType<GateSessionTable["attach"]>;
   261	      try { seat = channels.attach(socket, session); } catch (error) { settle(); throw error; }
   262	      return seat instanceof Promise ? seat.then(held, (error: unknown) => { settle(); throw error; }) : held(seat);
   263	    },
   264	  };
   265	  return {
   266	    table,
   267	    live() { prune(); return Object.freeze([...opened]); },
   268	    drop(which) {
   269	      prune();
   270	      let dropped = 0;
   271	      for (const { channel, session } of [...opened]) {
   272	        // A reading that throws cannot say the standing holds: that session closes too.
   273	        let goes: boolean;
   274	        try { goes = which(session); } catch { goes = true; }
   275	        if (!goes) continue;
   276	        channel.close();
   277	        dropped++;
   278	      }
   279	      prune();
   280	      return dropped;
   281	    },
   282	    close() {
   283	      closed = true;
   284	      for (const { channel } of opened.splice(0)) channel.close();
   285	    },
   286	  };
   287	}
