   179	    // The answer, then the gate's signature over it. Anything else, or nothing, reads as silence.
   180	    const reader = gatePartReader(GATE_FRAME.answerPart, GATE_FRAME.answerEnd);
   181	    let answer: Uint8Array | null = null;
   182	    while (answer === null) {
   183	      const frame = await socket.recv();
   184	      if (frame === null) return { state: "silence" };
