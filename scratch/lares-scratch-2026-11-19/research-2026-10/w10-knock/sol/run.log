   240	export async function dialPlaceGate(args: PlaceDialArgs): Promise<PlaceDialOutcome> {
   241	  const pinned = readGateBundlePin(args.pin);
   242	  if (!("pin" in pinned)) return { state: "refused", refusal: "pin-refused" };
   243	  const pin = pinned.pin;
   244	  if (pin.tier !== args.tier) return { state: "refused", refusal: "pin-other-tier" };
   245	  const staticSecret = (args.random ?? defaultCryptoProvider).getRandomValues(new Uint8Array(32));
   246	  const staticPair = noiseKeyPair(staticSecret);
   247	  const wipe = (): void => { staticSecret.fill(0); staticPair.secretKey.fill(0); };
   248	  const { socket } = args;
   249	  let lapse!: (outcome: PlaceDialOutcome) => void;
   250	  const lapsed = new Promise<PlaceDialOutcome>((resolve) => { lapse = resolve; });
   251	  const deadline = args.deadlines.draw(() => { try { socket.close(); } catch { /* already gone */ } wipe(); lapse({ state: "silence" }); });
