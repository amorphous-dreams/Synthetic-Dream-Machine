   197	      case "verified":    return { state: "verified", transport };
   198	      case "unconfirmed": return { state: "unconfirmed", frontier: read.frontier, events: read.events ?? [] };
   199	      case "withdrawn":   return { state: "withdrawn", events: read.events ?? [] };
   200	      case "incomplete":  return { state: "incomplete", frontier: read.frontier };
   201	      case "forked":      return { state: "forked", events: read.events ?? [] };
   202	    }
   203	  } catch {
   204	    // A socket that faults, a frame that opens nothing, a flight no gate answered: all read as silence.
