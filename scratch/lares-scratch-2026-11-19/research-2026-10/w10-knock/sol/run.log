   173	      handshakeHash: transport.handshakeHash, bundleDigest, presentationDigest: gatePresentationDigest(presentation), audience: args.audience,
   174	    }));
   175	    if (!own(signed, "signature")) return refused("signer-refused", true);
   176	    for (const part of gateParts(GATE_FRAME.presentationPart, GATE_FRAME.presentationEnd, presentation)) socket.send(transport.send.seal(part));
   177	    socket.send(transport.send.seal(gateFrame(GATE_FRAME.finish, hexToBytes(signed.signature))));
