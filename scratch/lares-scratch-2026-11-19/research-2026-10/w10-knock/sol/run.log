   169	// ── The deadline ────────────────────────────────────────────────────────────────────────────────
   170	
   171	/** The process timer as a gate's deadline source: one lapse per accept, uniform in [base, 2·base). */
   172	export function timerGateDeadlines(opts: {
   173	  readonly baseMs?: number;
   174	  readonly random?: (min: number, max: number) => number;
   175	  readonly setTimer?: (lapse: () => void, ms: number) => unknown;
   176	  readonly clearTimer?: (timer: unknown) => void;
   177	} = {}): GateDeadlines {
   178	  const base = opts.baseMs ?? 5_000;
   179	  if (!Number.isSafeInteger(base) || base < 1 || base > GATE_DEADLINE_MAX_BASE_MS) {
   180	    throw new RangeError(`face-gate-server: the deadline's base names a whole number of milliseconds from one to ${GATE_DEADLINE_MAX_BASE_MS}`);
   181	  }
   182	  const random = opts.random ?? randomInt;
   183	  const setTimer = opts.setTimer ?? ((lapse: () => void, ms: number) => setTimeout(lapse, ms));
   184	  const clearTimer = opts.clearTimer ?? ((timer: unknown) => clearTimeout(timer as ReturnType<typeof setTimeout>));
   185	  return {
   186	    draw(lapse) {
   187	      const timer = setTimer(lapse, base + random(0, base));
   188	      let live = true;
   189	      return { cancel() { if (live) { live = false; clearTimer(timer); } } };
   190	    },
   191	  };
   192	}
