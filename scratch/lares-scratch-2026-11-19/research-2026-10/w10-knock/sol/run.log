   150	    return refused("signer-other-chain");
   151	  }
   152	
   153	  // A static key for this dial alone: it names nobody, and it drops when the dial ends.
   154	  const staticSecret = (args.random ?? defaultCryptoProvider).getRandomValues(new Uint8Array(32));
   155	  const staticPair = noiseKeyPair(staticSecret);
   156	  keys.wipe = () => { staticSecret.fill(0); staticPair.secretKey.fill(0); };
   157	  const { socket } = args;
   158	  try {
   159	    const dial = noiseInitiate({ prologue: gatePrologue(pin), s: staticPair, rs: hexToBytes(pin.transportKey) });
   160	    await socket.open({ knock: gateKnock(pin), message1: dial.message1 });
   161	    const message2 = await socket.recv();
   162	    if (message2 === null) return { state: "silence" };
   163	    const answered = dial.readMessage2(message2);
   164	    if (answered.payload.length !== 0) return { state: "silence" };      // message two carries nothing: a verdict there reads as no gate's
   165	    const transport = answered.transport;
