   143	  if (!isWithdrawalMemory(args.history)) return refused("history-foreign");
   144	  const certificate = readCertificate(args.certificate);
   145	  if (!own(certificate, "read")) return refused("certificate-refused");
   146	  const scope = certificate.read.scope;
