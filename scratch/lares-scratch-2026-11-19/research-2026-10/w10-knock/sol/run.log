   111	/**
   112	 * One `ws` socket as a gate reads it: the flight its upgrade carried, binary frames in arrival order through a
   113	 * bounded queue, a send that throws once the socket stands closed, and a cut with no close frame.
   114	 */
   115	export function wsGateSocket(ws: GateWire, flight: { readonly knock: string; readonly message1: Uint8Array }, bound = GATE_SOCKET_QUEUE_BOUND, byteBound = GATE_SOCKET_BYTE_BOUND): GateSocket {
   116	  if (!Number.isInteger(bound) || bound < 1) throw new RangeError("face-gate-server: the queue bound names a count of at least one");
   117	  if (!Number.isInteger(byteBound) || byteBound < 1) throw new RangeError("face-gate-server: the byte bound names a count of at least one");
   118	  const queue: Uint8Array[] = [];
   119	  let held = 0;
   120	  const waiters: Array<(frame: Uint8Array | null) => void> = [];
   121	  let ended = false;
   122	  let paused = false;
   123	  const end = (): void => {
   124	    if (ended) return;
   125	    ended = true;
   126	    queue.length = 0;
   127	    held = 0;
   128	    for (const waiter of waiters.splice(0)) waiter(null);
   129	  };
   130	  const cut = (): void => {
   131	    end();
   132	    try { ws.terminate(); } catch { /* already gone */ }
   133	  };
   134	  ws.on("message", (data, isBinary) => {
   135	    if (ended) return;
   136	    const frame = isBinary ? bytesOf(data) : null;
   137	    // A sealed frame rides binary alone: a text frame, or one that reads as no bytes, cuts the socket.
   138	    if (frame === null) { cut(); return; }
   139	    const waiter = waiters.shift();
   140	    if (waiter !== undefined) { waiter(frame); return; }
   141	    queue.push(frame);
   142	    held += frame.length;
   143	    // Past the hard bound the peer flooded through the pause: cut it.
   144	    if (queue.length > bound * 8 || held > byteBound * 4) { cut(); return; }
   145	    if ((queue.length >= bound || held >= byteBound) && !paused) { paused = true; try { ws.pause(); } catch { /* already gone */ } }
   146	  });
   147	  ws.on("close", end);
   148	  ws.on("error", end);
   149	  return Object.freeze({
   150	    flight: Object.freeze({ knock: flight.knock, message1: Uint8Array.from(flight.message1) }),
   151	    send(frame: Uint8Array): void {
   152	      if (ended || ws.readyState !== OPEN) throw new Error("face-gate-server: the socket stands closed");
   153	      ws.send(frame, { binary: true });
   154	    },
   155	    recv(): Promise<Uint8Array | null> {
   156	      const next = queue.shift();
   157	      if (next !== undefined) {
   158	        held -= next.length;
   159	        if (paused && queue.length < bound && held < byteBound) { paused = false; try { ws.resume(); } catch { /* already gone */ } }
   160	        return Promise.resolve(next);
   161	      }
   162	      if (ended) return Promise.resolve(null);
   163	      return new Promise((resolve) => { waiters.push(resolve); });
   164	    },
   165	    cut,
   166	  });
   167	}
