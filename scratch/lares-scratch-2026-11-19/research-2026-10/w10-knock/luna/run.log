   335	export function faceGateServer(opts: FaceGateServerOptions = {}): FaceGateServer {
   336	  const bound = opts.queueBound ?? GATE_SOCKET_QUEUE_BOUND;
   337	  if (!Number.isInteger(bound) || bound < 1) throw new RangeError("face-gate-server: the queue bound names a count of at least one");
   338	  const byteBound = opts.byteBound ?? GATE_SOCKET_BYTE_BOUND;
   339	  if (!Number.isInteger(byteBound) || byteBound < 1) throw new RangeError("face-gate-server: the byte bound names a count of at least one");
   340	  const maxSockets = opts.maxSockets ?? GATE_SERVER_MAX_SOCKETS;
   341	  if (!Number.isInteger(maxSockets) || maxSockets < 1) throw new RangeError("face-gate-server: the socket bound names a count of at least one");
   342	  const heartbeatMs = opts.heartbeatMs ?? GATE_SERVER_HEARTBEAT_MS;
   343	  if (!Number.isSafeInteger(heartbeatMs) || heartbeatMs < 1 || heartbeatMs > GATE_DEADLINE_MAX_BASE_MS) throw new RangeError("face-gate-server: the heartbeat names a whole number of milliseconds");
   344	  const gates = new Map<string, { readonly gate: FaceGate; readonly knock: string }>();
   345	  // Paths this server once stood: a knock on one after the close is claimed and destroyed by name.
   346	  const once = new Set<string>();
   347	  const sockets = new Set<WebSocket>();
   348	  // THE HEARTBEAT: each socket answered a ping since the last beat, or the beat cuts it. The timer stands while a
   349	  // socket does, and never holds the process open.
   350	  const answered = new WeakMap<WebSocket, boolean>();
   351	  let beat: ReturnType<typeof setInterval> | null = null;
   352	  const beatOnce = (): void => {
   353	    for (const ws of sockets) {
   354	      if (answered.get(ws) !== true) { try { ws.terminate(); } catch { /* already gone */ } sockets.delete(ws); continue; }
   355	      answered.set(ws, false);
   356	      try { ws.ping(); } catch { /* the close event takes it */ }
   357	    }
   358	    if (sockets.size === 0 && beat !== null) { clearInterval(beat); beat = null; }
   359	  };
   360	  const follow = (ws: WebSocket): void => {
   361	    answered.set(ws, true);
   362	    ws.on("pong", () => { answered.set(ws, true); });
   363	    if (beat === null) { beat = setInterval(beatOnce, heartbeatMs); beat.unref?.(); }
   364	  };
   365	  // Upgrades claimed and not yet handed a socket: they count against the bound too.
   366	  let upgrading = 0;
   367	  let closed = false;
   368	  const wss = new WebSocketServer({
