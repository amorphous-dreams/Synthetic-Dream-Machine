   299	/** Why a claimed upgrade drew no gate, for the vessel's own log. Nothing of it crosses the wire. */
   300	export type GateUpgradeRefusal = GateFlightRefusal | "server-closed" | "server-full" | "flight-undecrypted";
   301	
   302	export interface FaceGateServerOptions {
   303	  /** How many frames wait unread per socket before it pauses. */
   304	  readonly queueBound?: number;
   305	  /** How many bytes wait unread per socket before it pauses. */
   306	  readonly byteBound?: number;
   307	  /** How many sockets stand upgraded at once. */
   308	  readonly maxSockets?: number;
   309	  /** How often the server pings each socket (`GATE_SERVER_HEARTBEAT_MS`); one that answered no ping since is cut. */
   310	  readonly heartbeatMs?: number;
   311	  /** What each accepted socket came to, by the path it knocked on. */
   312	  readonly onOutcome?: (path: string, outcome: GateOutcome) => void;
   313	  /** A claimed upgrade destroyed before any 101, and why. */
   314	  readonly onRefuse?: (path: string, refusal: GateUpgradeRefusal) => void;
   315	}
   316	
   317	export interface FaceGateServer {
   318	  /** Stand `gate` on the path its pin's knock names. A second gate on a path already stood throws. */
   319	  stand(entry: { readonly gate: FaceGate; readonly pin: GateBundlePin }): StoodGate;
   320	  /** Claim an upgrade whose pathname names a stood gate; false (the socket untouched) for every other. */
   321	  handleUpgrade(req: IncomingMessage, socket: Duplex, head: Buffer): boolean;
   322	  /** The pathnames stood now. */
   323	  paths(): readonly string[];
   324	  /** Stand every gate down and cut every socket this server upgraded. */
   325	  close(): void;
   326	}
