n* Meme: lar:///ha.ka.ba/lares/api/pono/memetic-wikitext-framing\\n*/\\nvar NO_ETX = {\\n\\tkind: \\\"no-etx\\\",\\n\\tmessage: \\\"STX stands without ETX; carrier body is torn\\\"\\n};\\nvar META_BEFORE_STX = {\\n\\tkind: \\\"meta-before-stx\\\",\\n\\tmessage: \\\"a toml meta fence stands before STX — root metadata opens the body, below STX; the frame recovers nothing above it\\\"\\n};\\n/**\\n* Any caret sigil carrying a head or release code, in whatever spelling — wider than the canonical\\n* patterns by design, so a torn spelling is SEEN and named rather than read as no frame at all.\\n*/\\nvar ANY_END_RE = new RegExp(`<<\\\\\\\\^(?:[^>\\\\\\\\n]|>(?!>))*?&#x(${frameHex(\\\"SOH\\\")}|${frameHex(\\\"EOT\\\")});(?:[^>\\\\\\\\n]|>(?!>))*>>`, \\\"g\\\");\\nvar SOH_HEX = new RegExp(`^(?:${frameHex(\\\"SOH\\\")})$`);\\n/** A declaration line, live — the frame's own, whatever it spells. */\\nvar DECLARATION_LINE_RE = /^<<!DOCTYPE[^\\\\n]*/gm;\\n/**\\n* ETB (`&#x0017;`) is no frame mark; `FRAME_MARKS` does not declare it, so this reader matches the\\n* literal directly, and any ETB sigil in a carrier reads as a torn spelling, the same fault class\\n* as a torn declaration or a torn head/release spelling. A mark joins the grammar only through\\n* `FRAME_MARKS`, behind a computed, verified check.\\n*/\\nvar ETB_MARK_RE = /<<\\\\^(?:[^>\\\\n]|>(?!>))*?&#x0017;(?:[^>\\\\n]|>(?!>))*>>/g;\\n/** Each declaration, head and release written in a spelling the frame grammar does not read. */\\nfunction tornSpellings(text, spans) {\\n\\tconst faults = [];\\n\\tfor (const m of maskedExecAll(text, DECLARATION_LINE_RE, spans)) {\\n\\t\\tif (m[0] === \\\"<<!DOCTYPE \\\\\\\"memetic-wikitext+tiddlywiki\\\\\\\" \\\\\\\"lar:///ha.ka.ba/lares/api/pono/memetic-wikitext\\\\\\\">>\\\") continue;\\n\\t\\tfaults.push({\\n\\t\\t\\tkind: \\\"torn-spelling\\\",\\n\\t\\t\\tmessage: `\\\\`${m[0]}\\\\` reads outside the frame grammar — the frame declares \\\\`${CARRIER_DECLARATION}\\\\`; nothing repairs it`\\n\\t\\t});\\n\\t}\\n\\tfor (const m of maskedExecAll(text, ANY_END_RE, spans)) {\\n\\t\\tconst canonical = SOH_HEX.test(m[1]) ? carrierHeadPattern(\\\"y\\\") : carrierReleasePattern(\\\"y\\\");\\n\\t\\tcanonical.lastIndex = m.index;\\n\\t\\tconst hit = canonical.exec(text);\\n\\t\\tif (hit && hit[0] === m[0]) continue;\\n\\t\\tfaults.push({\\n\\t\\t\\tkind: \\\"torn-spelling\\\",\\n\\t\\t\\tmessage: `\\\\`${m[0]}\\\\` reads outside the frame grammar — the ends read \\\\`code=\\\"…\\\" from=\\\"?\\\" -> to=\\\"…\\\"\\\\` and \\\\`-> to=\\\"?\\\"\\\\`, quoted; nothing repairs it`\\n\\t\\t});\\n\\t}\\n\\tfor (const m of maskedExecAll(text, ETB_MARK_RE, spans)) faults.push({\\n\\t\\tkind: \\\"torn-spelling\\\",\\n\\t\\tmessage: `\\\\`${m[0]}\\\\` carries ETB — \\\\`$carrier-sila\\\\` mints the fence only behind a computed, verified check, never this bare literal`\\n\\t});\\n\\treturn faults;\\n}\\nfunction frameShape(text) {\\n\\tconst spans = fencedSpans(text);\\n\\tconst frame = readFrame(text, spans);\\n\\tconst torn = tornSpellings(text, spans);\\n\\tif (!(frame.stx || frame.etx || frame.eot || torn.length > 0 || maskedExec(text, carrierMarkPattern(\\\"head\\\", \\\"g\\\"), spans) || maskedExec(text, carrierMarkPattern(\\\"release\\\", \\\"g\\\"), spans))) return { kind: \\\"bare\\\" };\\n\\tconst faults = [...frame.faults, ...torn];\\n\\tif (frame.stx && !frame.etx) faults.push(NO_ETX);\\n\\tif (frame.stx && maskedExecAll(text, META_OPEN_RE, spans, true).some((m) => m.index < frame.stx.index)) faults.push(META_BEFORE_STX);\\n\\tif (faults.length > 0) return {\\n\\t\\tkind: \\\"torn\\\",\\n\\t\\tfaults\\n\\t};\\n\\tif (!frame.stx || !frame.etx) return { kind: \\\"absent\\\" };\\n\\treturn {\\n\\t\\tkind: \\\"framed\\\",\\n\\t\\tspan: {\\n\\t\\t\\tstart: frame.stx.index,\\n\\t\\t\\tend: frame.etx.end\\n\\t\\t}\\n\\t};\\n}\\n/** The verdict over a shape already read: the digest is the one thing it adds. */\\nfunction verdictOf(text, shape) {\\n\\tif (shape.kind !== \\\"framed\\\") return shape;\\n\\tconst check = standingCheck(text, shape.span);\\n\\tif (!check) return { kind: \\\"absent\\\" };\\n\\treturn check.verifies ? {\\n\\t\\tkind: \\\"match\\\",\\n\\t\\tcheck: check.stored\\n\\t} : {\\n\\t\\tkind: \\\"stale\\\",\\n\\t\\tstored: check.stored,\\n\\t\\tcomputed: check.computed\\n\\t};\\n}\\nfunction verdict(text) {\\n\\treturn verdictOf(text, frameShape(text));\\n}\\n//#endregion\\nexports.BCC_RE = BCC_RE;\\nexports.CARRIER_DECLARATION = CARRIER_DECLARATION;\\nexports.CHECK_ALG = CHECK_ALG;\\nexports.FRAME_CODES = FRAME_CODES;\\nexports.FRAME_MARKS = FRAME_MARKS;\\nexports.META_OPEN_CANON = META_OPEN_CANON;\\nexports.META_OPEN_LINE_RE = META_OPEN_LINE_RE;\\nexports.META_OPEN_RE = META_OPEN_RE;\\nexports.PLAIN_OPEN_RE = PLAIN_OPEN_RE;\\nexports.bccOf = bccOf;\\nexports.bccOfSpan = bccOfSpan;\\nexports.carrierHeadLinePattern = carrierHeadLinePattern;\\nexports.carrierHeadPattern = carrierHeadPattern;\\nexports.carrierMarkPattern = carrierMarkPattern;\\nexports.carrierReleasePattern = carrierReleasePattern;\\nexports.checkSpan = checkSpan;\\nexports.classifyPostEot = classifyPostEot;\\nexports.classifyPostamble = classifyPostamble;\\nexports.fenceLineClose = fenceLineClose;\\nexports.fenceLineOpen = fenceLineOpen;\\nexports.fencedSpans = fencedSpans;\\nexports.frameAlt = frameAlt;\\nexports.frameCarrier = frameCarrier;\\nexports.frameHex = frameHex;\\nexports.frameMark = frameMark;\\nexports.frameMarks = frameMarks;\\nexports.frameShape = frameShape;\\nexports.frameStanding = frameStanding;\\nexports.headSigil = headSigil;\\nexports.headUriOf = headUriOf;\\nexports.inMask = inMask;\\nexports.inMaskInterior = inMaskInterior;\\nexports.isCanonicalMetaOpen = isCanonicalMetaOpen;\\nexports.markCode = markCode;\\nexports.maskedExec = maskedExec;\\nexports.maskedExecAll = maskedExecAll;\\nexports.matchCarrierHead = matchCarrierHead;\\nexports.matchCarrierHeadLine = matchCarrierHeadLine;\\nexports.matchCarrierMark = matchCarrierMark;\\nexports.nihOfSpan = nihOfSpan;\\nexports.readFrame = readFrame;\\nexports.stampCarrier = stampCarrier;\\nexports.verdict = verdict;\\nexports.verdictOf = verdictOf;\\nexports.verifyBcc = verifyBcc;\\n\",\"type\":\"application/javascript\",\"module-type\":\"library\"},\"lar:///ha.ka.ba/lararium/tw5/parsers/memetic-parser\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/parsers/memetic-parser\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/parsers/memetic-parser\\ntype: application/javascript\\nmodule-type: parser\\n\\\\*/\\n//#region ../lararium-mesh/src/carrier-type.ts\\n/**\\n* carrier-type — the media type a `.mem` carries, declared once.\\n*\\n* ── WHY THIS COLLAPSES AND THE PATTERNS AROUND IT DO NOT ────────────────────────────────────────\\n* Four mechanisms dispatch on this string, each a different one: the TW5 parser module exports under\\n* it, the deserializer module exports under it, `registerFileType` binds an extension to it, and a\\n* record's stored `type` field is compared against it. A fifth reads it back off disk from a carrier's\\n* own meta block.\\n*\\n* They agree only by hand. Spelled five ways, a change lands in four of them and the fifth refuses\\n* quietly — a record whose type does not match simply stops projecting, with no throw and no\\n* diagnostic. So the STRINGS collapse here; each mechanism keeps its own binding.\\n*\\n* ── ONE SPELLING, EVERYWHERE ────────────────────────────────────────────────────────────────────\\n* `+tiddlywiki` is an RFC 6839 structured syntax suffix: it states that this syntax is BUILT ON TW5\\n* wikitext, in the form a media-type registry already understands. The registration-track name —\\n* no `x-`, RFC 6838 deprecates that prefix — is the one spelling read and written.\\n*\\n* A `type` outside CARRIER_TYPES surfaces as an unadmitted type, loudly, and the record does not\\n* project — the correct fate for a spelling this grammar does not mint. Admitting near-misses would\\n* trade that loud surface for a silent guess about what the author meant.\\n*\\n* Meme: lar:///ha.ka.ba/lares/api/pono/memetic-wikitext#/media-type\\n*/\\n/** What every carrier declares and every reader dispatches on — the one spelling. */\\nvar CARRIER_TYPE = \\\"text/memetic-wikitext+tiddlywiki\\\";\\n//#endregion\\n//#region src/memetic-parser.ts\\nvar RULES_CONFIG_TIDDLER = \\\"lar:///ha.ka.ba/config/memetic-rules-except\\\";\\nvar DEFAULT_RULES_EXCEPT = /* @__PURE__ */ new Set();\\nvar stdParser = require(\\\"$:/core/modules/parsers/wikiparser/wikiparser.js\\\")[\\\"text/vnd.tiddlywiki\\\"];\\nfunction diagnosticsFrom(uri, text) {\\n\\tconst memeAst = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\\\");\\n\\tconst grammarCache = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/grammar-cache\\\");\\n\\tif (typeof memeAst?.parseMemeText !== \\\"function\\\" || typeof memeAst?.failuresToDiagnostics !== \\\"function\\\") return [];\\n\\tconst failures = memeAst.parseMemeText(uri, text, grammarCache?.getGrammar?.() ?? void 0)?.failures ?? [];\\n\\tconst diagnostics = memeAst.failuresToDiagnostics(failures, text.length);\\n\\tconst make = $tw?.utils?.makeParseDiagnostic;\\n\\tif (!make) return diagnostics;\\n\\treturn diagnostics.map((d) => make(d, {\\n\\t\\tsource: CARRIER_TYPE,\\n\\t\\tsourceLength: text.length\\n\\t}));\\n}\\nfunction MemeticParser(type, text, options) {\\n\\tconst override = (options?.wiki)?.getTiddlerText?.(RULES_CONFIG_TIDDLER, \\\"\\\")?.trim() ?? \\\"\\\";\\n\\tconst denyList = override.length > 0 ? new Set(override.split(/\\\\s+/).filter(Boolean)) : DEFAULT_RULES_EXCEPT;\\n\\tObject.defineProperty(this, \\\"memeticDenyList\\\", {\\n\\t\\tvalue: denyList,\\n\\t\\tenumerable: false,\\n\\t\\tconfigurable: true\\n\\t});\\n\\tstdParser.call(this, type, text, options);\\n\\tconst uri = options?._canonical_uri ?? type;\\n\\tconst inherited = this.diagnostics ?? [];\\n\\ttry {\\n\\t\\tthis.diagnostics = [...inherited, ...diagnosticsFrom(uri, text ?? \\\"\\\")];\\n\\t} catch {\\n\\t\\tthis.diagnostics = inherited;\\n\\t}\\n}\\nMemeticParser.prototype = Object.create(stdParser.prototype);\\n/**\\n* Hand the standard constructor a filtered COPY of the rule-class map, never the shared\\n* `WikiParser.prototype.*RuleClasses` map every `text/vnd.tiddlywiki` parse also reads. This runs\\n* inside `stdParser.call` above, before any rule instantiates or matches, so a denied class never\\n* gets the chance to fire — and it covers every later `instantiateRules` call on this same instance.\\n*/\\nMemeticParser.prototype.instantiateRules = function(classes, type, startPos) {\\n\\tconst denyList = this.memeticDenyList;\\n\\tconst filtered = denyList && denyList.size > 0 ? Object.fromEntries(Object.entries(classes).filter(([name]) => !denyList.has(name))) : classes;\\n\\treturn stdParser.prototype.instantiateRules.call(this, filtered, type, startPos);\\n};\\n//#endregion\\nexports[\\\"text/memetic-wikitext+tiddlywiki\\\"] = MemeticParser;\\n\",\"type\":\"application/javascript\",\"module-type\":\"parser\"},\"lar:///ha.ka.ba/lararium/tw5/modules/nalu-engine\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/nalu-engine\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/nalu-engine\\ntype: application/javascript\\nmodule-type: startup\\n\\\\*/\\n//#region src/modules/nalu-engine.ts\\nvar name = \\\"lararium-nalu-engine\\\";\\nvar after = [\\\"startup\\\"];\\nvar synchronous = true;\\nvar _applying = false;\\nvar _wiki = null;\\n/** The applier ran with no wiki under it: boot the TW5 wiki with this module before landing a change. */\\nvar NaluWikiUnavailableError = class extends Error {\\n\\tname = \\\"NaluWikiUnavailableError\\\";\\n\\tconstructor(title) {\\n\\t\\tsuper(`nalu-engine: no wiki stands to apply \\\"${title}\\\" to — boot the TW5 wiki with this module before landing a change`);\\n\\t}\\n};\\n/**\\n* The wiki fields an inbound change lands as. CRDT records store the title as the doc key, not nested\\n* in `tiddler` — restore it from `change.title` so the wiki tiddler carries its identity.\\n*\\n* Residency Model — every inbound write annotates `$origin-bag` from the ENVELOPE so the operator\\n* can answer \\\"which bag does this come from?\\\" at every read (Anti-pattern #4 defense). `bag` is\\n* user space: an author's own field rides through untouched, as TiddlyWeb's stamp would ride under\\n* theirs — the host's provenance wears a name no author collides with.\\n*/\\nfunction toWikiFields(change) {\\n\\treturn {\\n\\t\\t...change.record.tiddler,\\n\\t\\ttitle: change.title,\\n\\t\\t...change.bag !== void 0 ? { \\\"$origin-bag\\\": change.bag } : {}\\n\\t};\\n}\\n/** Apply ONE inbound change to the wiki, synchronously. */\\nfunction applyNalu(change) {\\n\\tconst Tiddler = $tw?.Tiddler;\\n\\tif (!_wiki || !Tiddler) throw new NaluWikiUnavailableError(change.title);\\n\\tconst outer = _applying;\\n\\t_applying = true;\\n\\ttry {\\n\\t\\tif (change.record === null || change.record.meta?.deleted) _wiki.deleteTiddler(change.title);\\n\\t\\telse _wiki.addTiddler(new Tiddler(toWikiFields(change)));\\n\\t} finally {\\n\\t\\t_applying = outer;\\n\\t}\\n}\\n/** True while an `applyNalu` call runs. */\\nfunction isApplyingNalu() {\\n\\treturn _applying;\\n}\\nfunction startup() {\\n\\tconst wiki = $tw?.wiki;\\n\\tif (!wiki) return;\\n\\t_wiki = wiki;\\n\\tconst lares = $tw.lares ?? {};\\n\\tlares[\\\"applyNalu\\\"] = applyNalu;\\n\\tlares[\\\"isApplyingNalu\\\"] = isApplyingNalu;\\n\\t$tw.lares = lares;\\n}\\n//#endregion\\nexports.NaluWikiUnavailableError = NaluWikiUnavailableError;\\nexports.after = after;\\nexports.applyNalu = applyNalu;\\nexports.isApplyingNalu = isApplyingNalu;\\nexports.name = name;\\nexports.startup = startup;\\nexports.synchronous = synchronous;\\nexports.toWikiFields = toWikiFields;\\n\",\"type\":\"application/javascript\",\"module-type\":\"startup\"},\"lar:///ha.ka.ba/lararium/tw5/routes/native-delete-door\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/routes/native-delete-door\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/routes/native-delete-door\\ntype: application/javascript\\nmodule-type: route\\n\\\\*/\\nlet lararium_place_meme = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\\\");\\n//#region ../lararium-mesh/src/agile-digest.ts\\n/** The algorithm tag of the house's sha256 digests — the one RFC 9530 `Repr-Digest` maps to. */\\nvar SHA256_ALGO = \\\"sha256\\\";\\n/** A 32-byte (SHA-256) digest's hex: exactly 64 hex chars. */\\nvar SHA256_HEX = /^[0-9a-fA-F]{64}$/;\\n/** A digest's hex part (even length ≥ 2) — another algorithm may carry another width. */\\nvar HEX_BYTES = /^(?:[0-9a-fA-F]{2})+$/;\\n/** A valid algorithm tag: lowercase alnum + dashes (blake3, sha512, sha2-256…). */\\nvar ALGO_TAG = /^[a-z0-9][a-z0-9-]*$/;\\n/** The RFC 9530 `Repr-Digest` field value: `sha-256=:<base64>:` (one member, the sf-binary item). */\\nvar REPR_DIGEST = /^(sha-256)=:([A-Za-z0-9+/]+={0,2}):$/;\\nvar B64 = \\\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\\\";\\n/** The lowercase hex of a base64 byte string, or null where the base64 reads torn. Hand-rolled so\\n*  the law runs the same in a browser, a plugin VM and node — no `Buffer`, no `atob`. */\\nfunction hexOfBase64(b64) {\\n\\tconst body = b64.replace(/=+$/, \\\"\\\");\\n\\tif (body.length % 4 === 1) return null;\\n\\tlet bits = 0;\\n\\tlet acc = 0;\\n\\tlet hex = \\\"\\\";\\n\\tfor (const ch of body) {\\n\\t\\tconst v = B64.indexOf(ch);\\n\\t\\tif (v < 0) return null;\\n\\t\\tacc = acc << 6 | v;\\n\\t\\tbits += 6;\\n\\t\\tif (bits >= 8) {\\n\\t\\t\\tbits -= 8;\\n\\t\\t\\thex += (acc >> bits & 255).toString(16).padStart(2, \\\"0\\\");\\n\\t\\t}\\n\\t}\\n\\treturn hex;\\n}\\n/** The base64 of a lowercase hex byte string. */\\nfunction base64OfHex(hex) {\\n\\tlet out = \\\"\\\";\\n\\tlet acc = 0;\\n\\tlet bits = 0;\\n\\tfor (let i = 0; i < hex.length; i += 2) {\\n\\t\\tacc = acc << 8 | parseInt(hex.slice(i, i + 2), 16);\\n\\t\\tbits += 8;\\n\\t\\twhile (bits >= 6) {\\n\\t\\t\\tbits -= 6;\\n\\t\\t\\tout += B64[acc >> bits & 63];\\n\\t\\t}\\n\\t}\\n\\tif (bits > 0) out += B64[acc << 6 - bits & 63];\\n\\twhile (out.length % 4 !== 0) out += \\\"=\\\";\\n\\treturn out;\\n}\\n/**\\n* Parse a digest string into `(algo, hex)`.\\n*\\n*   \\\"sha256:ab…\\\"      → { algo: \\\"sha256\\\", hex: \\\"ab…\\\" }   (tagged, `:`)\\n*   \\\"sha-256=:q80…=:\\\" → { algo: \\\"sha256\\\", hex: \\\"ab…\\\" }   (RFC 9530 Repr-Digest)\\n*   \\\"blake3:cd…\\\"      → { algo: \\\"blake3\\\", hex: \\\"cd…\\\" }   (another scheme rides free)\\n*   \\\"ab…64…\\\"          → throws — a bare hex names no algorithm\\n*\\n* The hex and the algo lowercase. Throws a NAMED error on anything else.\\n*\\n* The split falls on the first `:` only, and holds only when the head reads as an\\n* algorithm tag and the tail as hex — hex holds no `:`, so no value mis-splits.\\n*/\\nfunction parseDigest(digest) {\\n\\tif (typeof digest !== \\\"string\\\" || digest.length === 0) throw new TypeError(`parseDigest: empty or non-string digest`);\\n\\tconst repr = REPR_DIGEST.exec(digest);\\n\\tif (repr) {\\n\\t\\tconst hex = hexOfBase64(repr[2]);\\n\\t\\tif (hex === null || !SHA256_HEX.test(hex)) throw new TypeError(`parseDigest: malformed tagged digest \\\"${digest}\\\"`);\\n\\t\\treturn {\\n\\t\\t\\talgo: SHA256_ALGO,\\n\\t\\t\\thex\\n\\t\\t};\\n\\t}\\n\\tconst sepIndex = digest.indexOf(\\\":\\\");\\n\\tif (sepIndex > 0) {\\n\\t\\tconst algo = digest.slice(0, sepIndex).toLowerCase();\\n\\t\\tconst hex = digest.slice(sepIndex + 1).toLowerCase();\\n\\t\\tif (ALGO_TAG.test(algo) && HEX_BYTES.test(hex)) return {\\n\\t\\t\\talgo,\\n\\t\\t\\thex\\n\\t\\t};\\n\\t\\tthrow new TypeError(`parseDigest: malformed tagged digest \\\"${digest}\\\"`);\\n\\t}\\n\\tif (HEX_BYTES.test(digest)) throw new TypeError(`parseDigest: bare hex \\\"${digest.slice(0, 16)}…\\\" names no algorithm — write it tagged (\\\\`sha256:<hex>\\\\`)`);\\n\\tthrow new TypeError(`parseDigest: not a tagged digest \\\"${digest}\\\"`);\\n}\\n/**\\n* The RFC 9530 `Repr-Digest` field value for a sha256 digest in any of its tagged spellings —\\n* `sha-256=:<base64>:`. An HTTP skin emits it beside the `ETag`, so a client that speaks the\\n* standard field verifies the body without learning the house's tag grammar. Only sha256 carries a\\n* registered RFC 9530 algorithm key here; another algorithm refuses loud.\\n*/\\nfunction reprDigestOf(digest) {\\n\\tconst { algo, hex } = parseDigest(digest);\\n\\tif (algo !== \\\"sha256\\\") throw new TypeError(`reprDigestOf: only sha-256 carries a Repr-Digest key here (got \\\"${algo}\\\")`);\\n\\treturn `sha-256=:${base64OfHex(hex)}:`;\\n}\\n//#endregion\\n//#region src/routes/plain-server.ts\\n/**\\n* THE PLAIN SERVER'S SHORE — what the meme route skins stand on when a plain TiddlyWiki server\\n* (the fork's `--listen`) carries them. One law, inlined into each skin's bundle (the sandbox's web\\n* globals ride the `host-globals` startup module, which runs before any route answers):\\n*\\n* THE CONTAINER LAW. A 1-wiki server holds ONE container, and `recipes/default` and `bags/default`\\n* both name it (TiddlyWeb's own stub). `default` names THE HOST'S ANCHOR — the one wiki here; @daemon\\n* on a lares island — and any other recipe or bag is a name the server cannot resolve. A bag the\\n* server cannot name MUST NOT swallow a write, so the skins answer 404 with a one-line body before\\n* the path is read.\\n*\\n* THE DIGEST PAIR. A response that carries a canonical hash carries it twice: `ETag` (the house's\\n* `sha256:hex`, the merge base a writer hands back as `If-Match`) and `Repr-Digest` (RFC 9530,\\n* `sha-256=:<base64>:`, the standard field a client verifies the body against). One digest, two\\n* spellings; `digestsEqual` reads either.\\n*/\\n/** The `ETag` + `Repr-Digest` pair for a canonical hash; empty where no hash stands (a refusal). */\\nfunction digestHeaders(canonicalHash) {\\n\\tif (!canonicalHash) return {};\\n\\treturn {\\n\\t\\t\\\"ETag\\\": `\\\"${canonicalHash}\\\"`,\\n\\t\\t\\\"Repr-Digest\\\": reprDigestOf(canonicalHash)\\n\\t};\\n}\\n//#endregion\\n//#region src/routes/native-delete-door.ts\\n/**\\n* DELETE /bags/default/tiddlers/:title — the NATIVE DELETE DOOR, gated by the plugin before stock answers.\\n*\\n* THE GROUP LEAVES TOGETHER. `removeMeme` is the one removal law every skin calls: a meme's root, its\\n* `#slot` fragments and its `/path` children go as ONE act, because a fragment left standing is a record\\n* no door can reach — `memes.json` never lists it, `GET /memes/` answers 404 over it, and it re-cuts the\\n* next founding at the same uri. The stock tiddlyweb syncadaptor deletes ONE title\\n* (`tiddlywebadaptor.js` `deleteTiddler` → `DELETE /bags/<bag>/tiddlers/<title>`), so a trash-icon\\n* delete of a meme root in a browser leaves its whole split behind. This skin stands in front of stock's\\n* route at a higher priority and reads the standing record: a MEME ROOT (`isMemeRoot` — the listing's own\\n* law) leaves through `removeMeme`; every other title reaches stock's handler untouched.\\n*\\n* The answer stays stock's `204` either way — the syncer reads a status, never a receipt — and the\\n* client learns the group left on its next `syncFromServer`, which deletes what the server stopped\\n* listing. An `If-Match` rides here as it does on `DELETE …/memes/…`: a base the records moved past\\n* answers `412` and removes nothing.\\n*\\n*   204 · the group left, or stock removed the plain title\\n*   412 · the records moved past the writer's base\\n*/\\nvar methods = [\\\"DELETE\\\"];\\n/** Stock's own path, so the two skins answer the same addresses. */\\nvar path = /^\\\\/bags\\\\/default\\\\/tiddlers\\\\/(.+)$/;\\n/** Above stock's 100, so the server asks this skin first. */\\nvar info = { priority: 110 };\\nvar STOCK_DELETE = \\\"$:/core/modules/server/routes/delete-tiddler.js\\\";\\n/** Strip the entity-tag quotes and any weak marker: `W/\\\"abc\\\"` → `abc`. */\\nfunction baseHashOf(header) {\\n\\tconst raw = Array.isArray(header) ? header[0] : header;\\n\\tif (!raw) return null;\\n\\tconst bare = raw.trim().replace(/^W\\\\//, \\\"\\\").replace(/^\\\"(.*)\\\"$/, \\\"$1\\\");\\n\\treturn bare === \\\"\\\" || bare === \\\"*\\\" ? null : bare;\\n}\\nfunction handler(request, response, state) {\\n\\tconst title = $tw.utils.decodeURIComponentSafe(state.params[0] ?? \\\"\\\");\\n\\tconst standing = state.wiki.getTiddler(title)?.fields;\\n\\tif (!(0, lararium_place_meme.isMemeRoot)(title, standing)) {\\n\\t\\t$tw.modules.execute(STOCK_DELETE).handler(request, response, state);\\n\\t\\treturn;\\n\\t}\\n\\t(0, lararium_place_meme.removeMeme)({\\n\\t\\turi: title,\\n\\t\\tbaseHash: baseHashOf(request.headers[\\\"if-match\\\"])\\n\\t}, (0, lararium_place_meme.wikiMemeSink)(state.wiki)).then((receipt) => {\\n\\t\\tif (receipt.decision === \\\"conflict\\\") {\\n\\t\\t\\tresponse.writeHead(412, {\\n\\t\\t\\t\\t\\\"Content-Type\\\": \\\"application/json\\\",\\n\\t\\t\\t\\t...digestHeaders(receipt.canonicalHash)\\n\\t\\t\\t});\\n\\t\\t\\tresponse.end(JSON.stringify({\\n\\t\\t\\t\\turi: title,\\n\\t\\t\\t\\tdecision: \\\"conflict\\\",\\n\\t\\t\\t\\treason: \\\"If-Match — the records moved past the base the writer read\\\"\\n\\t\\t\\t}));\\n\\t\\t\\treturn;\\n\\t\\t}\\n\\t\\tresponse.writeHead(204, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\t\\tresponse.end();\\n\\t}, (err) => {\\n\\t\\tresponse.writeHead(500, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\t\\tresponse.end(err instanceof Error ? err.message : String(err));\\n\\t});\\n}\\n//#endregion\\nexports.handler = handler;\\nexports.info = info;\\nexports.methods = methods;\\nexports.path = path;\\n\",\"type\":\"application/javascript\",\"module-type\":\"route\"},\"lar:///ha.ka.ba/lararium/tw5/routes/native-door\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/routes/native-door\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/routes/native-door\\ntype: application/javascript\\nmodule-type: route\\n\\\\*/\\nlet lararium_place_meme = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\\\");\\n//#region src/native-door-gate.ts\\n/**\\n* native-door-gate — the pure law the native `PUT /recipes/default/tiddlers/:title` skin applies\\n* before the stock route lands the body. Reads the TiddlyWeb JSON once, answers either a refusal\\n* (status + JSON body) or the body stock may land.\\n*\\n* THE ENVELOPE LAW. A top-level `bag` naming the host's anchor reads as TiddlyWeb's envelope — the\\n* stamp `get-tiddler.js` lays over every record it serves — never as the author's field. It never\\n* lands; the standing record's own `bag` rides through the save. A `bag` of any other value lands as\\n* written. A body that fails to parse passes through untouched: stock answers it as stock does.\\n*\\n* THE TWO DOORS. A FRAMED MEME ROOT — the carrier type, a SOH head still in its text — belongs to the\\n* `/memes/` door, where the Confluence splits it into its records. Landed here it would sit whole and\\n* unsplit, so the gate refuses it: 422, the body naming the door for that URI. A plain tiddler, a split\\n* root and a slot child pass.\\n*/\\n/** The TiddlyWeb shape pulled flat: `fields.*` up beside the known fields, for inspection alone. */\\nfunction flatten(body) {\\n\\tconst { fields, ...known } = body;\\n\\treturn {\\n\\t\\t...known,\\n\\t\\t...fields && typeof fields === \\\"object\\\" ? fields : {}\\n\\t};\\n}\\nfunction nativeDoorGate(data, standing, anchor) {\\n\\tlet body;\\n\\ttry {\\n\\t\\tconst parsed = JSON.parse(data);\\n\\t\\tif (!parsed || typeof parsed !== \\\"object\\\" || Array.isArray(parsed)) return {\\n\\t\\t\\tkind: \\\"pass\\\",\\n\\t\\t\\tdata\\n\\t\\t};\\n\\t\\tbody = parsed;\\n\\t} catch {\\n\\t\\treturn {\\n\\t\\t\\tkind: \\\"pass\\\",\\n\\t\\t\\tdata\\n\\t\\t};\\n\\t}\\n\\tconst uri = (0, lararium_place_meme.framedRootOf)(flatten(body));\\n\\tif (uri !== null) {\\n\\t\\tconst door = (0, lararium_place_meme.memePathOf)(uri, {\\n\\t\\t\\tkind: \\\"recipes\\\",\\n\\t\\t\\tname: anchor\\n\\t\\t}) ?? `/recipes/${anchor}/memes/<scheme>/<path>`;\\n\\t\\treturn {\\n\\t\\t\\tkind: \\\"refuse\\\",\\n\\t\\t\\tstatus: 422,\\n\\t\\t\\tbody: {\\n\\t\\t\\t\\turi,\\n\\t\\t\\t\\tdoor,\\n\\t\\t\\t\\treason: `a framed meme root lands through PUT ${door} — the native tiddler door never splits it`\\n\\t\\t\\t}\\n\\t\\t};\\n\\t}\\n\\tif (body[\\\"bag\\\"] === anchor) {\\n\\t\\tconst next = { ...body };\\n\\t\\tdelete next[\\\"bag\\\"];\\n\\t\\tconst own = standing?.[\\\"bag\\\"];\\n\\t\\tif (typeof own === \\\"string\\\") next[\\\"bag\\\"] = own;\\n\\t\\treturn {\\n\\t\\t\\tkind: \\\"pass\\\",\\n\\t\\t\\tdata: JSON.stringify(next)\\n\\t\\t};\\n\\t}\\n\\treturn {\\n\\t\\tkind: \\\"pass\\\",\\n\\t\\tdata\\n\\t};\\n}\\n//#endregion\\n//#region src/routes/plain-server.ts\\n/** The one container name a plain server resolves. */\\nvar HOST_ANCHOR = \\\"default\\\";\\n//#endregion\\n//#region src/routes/native-door.ts\\n/**\\n* PUT /recipes/default/tiddlers/:title — the NATIVE DOOR, gated by the plugin before stock answers.\\n*\\n* The stock route (`$:/core/modules/server/routes/put-tiddler.js`) stays untouched; this skin stands\\n* in front of it at a higher priority, reads the body once, and hands stock the body it may land.\\n* Two laws ride the seam:\\n*\\n* THE ENVELOPE LAW. `bag` IS USER SPACE. Stock's `get-tiddler.js` stamps `bag: \\\"default\\\"` over the\\n* JSON it serves — TiddlyWeb's envelope, the container the record came from — and a stock client\\n* hands that stamp back on save. A `bag` naming THE HOST'S ANCHOR (`default`) reads as the envelope,\\n* never as a field: it never lands, and the standing record's own `bag` survives the save. Any other\\n* value reads as the author's and lands as written. The one value an author cannot claim through\\n* this door is the container's own name.\\n*\\n* (The refusal of a framed meme root rides the same seam — see `nativeDoorGate`.)\\n*/\\nvar methods = [\\\"PUT\\\"];\\nvar path = /^\\\\/recipes\\\\/default\\\\/tiddlers\\\\/(.+)$/;\\n/** Above stock's 100, so the server asks this skin first. */\\nvar info = { priority: 110 };\\nvar bodyFormat = \\\"string\\\";\\nvar STOCK_PUT = \\\"$:/core/modules/server/routes/put-tiddler.js\\\";\\nfunction handler(request, response, state) {\\n\\tconst title = $tw.utils.decodeURIComponentSafe(state.params[0] ?? \\\"\\\");\\n\\tconst standing = state.wiki.getTiddler(title)?.fields;\\n\\tconst gate = nativeDoorGate(state.data, standing, HOST_ANCHOR);\\n\\tif (gate.kind === \\\"refuse\\\") {\\n\\t\\tresponse.writeHead(gate.status, { \\\"Content-Type\\\": \\\"application/json\\\" });\\n\\t\\tresponse.end(JSON.stringify(gate.body));\\n\\t\\treturn;\\n\\t}\\n\\tstate.data = gate.data;\\n\\t$tw.modules.execute(STOCK_PUT).handler(request, response, state);\\n}\\n//#endregion\\nexports.bodyFormat = bodyFormat;\\nexports.handler = handler;\\nexports.info = info;\\nexports.methods = methods;\\nexports.path = path;\\n\",\"type\":\"application/javascript\",\"module-type\":\"route\"},\"lar:///ha.ka.ba/lararium/tw5/routes/native-skinny-door\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/routes/native-skinny-door\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/routes/native-skinny-door\\ntype: application/javascript\\nmodule-type: route\\n\\\\*/\\n//#region src/routes/native-skinny-door.ts\\nvar methods = [\\\"GET\\\"];\\n/** Stock's own path, so the two skins answer the same address. */\\nvar path = /^\\\\/recipes\\\\/default\\\\/tiddlers.json$/;\\n/** Above stock's 100, so the server asks this skin first. */\\nvar info = { priority: 110 };\\nvar STOCK_JSON = \\\"$:/core/modules/server/routes/get-tiddlers-json.js\\\";\\n/** The dial, and the one value that turns it off. */\\nvar FAT_CHILDREN = \\\"$:/config/lares/memes/fat-children\\\";\\n/** A record that carries a parent is a SLOT CHILD — the listing's own reading of the group law. */\\nfunction isSlotChild(fields) {\\n\\treturn fields !== void 0 && typeof fields[\\\"$fragment-parent\\\"] === \\\"string\\\";\\n}\\n/**\\n* Put each slot child's `text` back into the answer stock built. A body that is not a JSON array of\\n* objects passes through untouched — stock answers an error as stock does.\\n*/\\nfunction fattenChildren(body, read) {\\n\\tlet rows;\\n\\ttry {\\n\\t\\trows = JSON.parse(body);\\n\\t} catch {\\n\\t\\treturn body;\\n\\t}\\n\\tif (!Array.isArray(rows)) return body;\\n\\tlet moved = false;\\n\\tfor (const row of rows) {\\n\\t\\tif (!row || typeof row !== \\\"object\\\" || Array.isArray(row)) continue;\\n\\t\\tconst entry = row;\\n\\t\\tif (typeof entry[\\\"title\\\"] !== \\\"string\\\" || entry[\\\"text\\\"] !== void 0) continue;\\n\\t\\tconst fields = read(entry[\\\"title\\\"]);\\n\\t\\tif (!isSlotChild(fields)) continue;\\n\\t\\tconst text = fields[\\\"text\\\"];\\n\\t\\tif (typeof text !== \\\"string\\\") continue;\\n\\t\\tentry[\\\"text\\\"] = text;\\n\\t\\tmoved = true;\\n\\t}\\n\\treturn moved ? JSON.stringify(rows) : body;\\n}\\nfunction handler(request, response, state) {\\n\\tconst stock = $tw.modules.execute(STOCK_JSON);\\n\\tconst asked = state.queryParameters[\\\"exclude\\\"] !== void 0;\\n\\tconst off = (state.wiki.getTiddlerText(\\\"$:/config/lares/memes/fat-children\\\", \\\"yes\\\") ?? \\\"yes\\\").trim() === \\\"no\\\";\\n\\tif (asked || off) {\\n\\t\\tstock.handler(request, response, state);\\n\\t\\treturn;\\n\\t}\\n\\tconst skin = {\\n\\t\\t...state,\\n\\t\\tsendResponse: (status, headers, body, encoding) => {\\n\\t\\t\\tconst out = status === 200 ? fattenChildren(body, (t) => state.wiki.getTiddler(t)?.fields) : body;\\n\\t\\t\\tstate.sendResponse(status, headers, out, encoding);\\n\\t\\t}\\n\\t};\\n\\tstock.handler(request, response, skin);\\n}\\n//#endregion\\nexports.FAT_CHILDREN = FAT_CHILDREN;\\nexports.fattenChildren = fattenChildren;\\nexports.handler = handler;\\nexports.info = info;\\nexports.methods = methods;\\nexports.path = path;\\n\",\"type\":\"application/javascript\",\"module-type\":\"route\"},\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/place-meme\\ntype: application/javascript\\nmodule-type: library\\n\\\\*/\\nlet lararium_deserializer = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/deserializer\\\");\\nlet lararium_meme_ast = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\\\");\\nlet _lararium_memetic_frame = require(\\\"lar:///ha.ka.ba/lararium/tw5/lib/memetic-frame\\\");\\nlet smol_toml = require(\\\"lar:///ha.ka.ba/lararium/tw5/lib/smol-toml\\\");\\n//#region ../lararium-mesh/src/agile-digest.ts\\n/** The algorithm tag of the house's sha256 digests — the one RFC 9530 `Repr-Digest` maps to. */\\nvar SHA256_ALGO = \\\"sha256\\\";\\n/** A 32-byte (SHA-256) digest's hex: exactly 64 hex chars. */\\nvar SHA256_HEX = /^[0-9a-fA-F]{64}$/;\\n/** A digest's hex part (even length ≥ 2) — another algorithm may carry another width. */\\nvar HEX_BYTES = /^(?:[0-9a-fA-F]{2})+$/;\\n/** A valid algorithm tag: lowercase alnum + dashes (blake3, sha512, sha2-256…). */\\nvar ALGO_TAG = /^[a-z0-9][a-z0-9-]*$/;\\n/** The RFC 9530 `Repr-Digest` field value: `sha-256=:<base64>:` (one member, the sf-binary item). */\\nvar REPR_DIGEST = /^(sha-256)=:([A-Za-z0-9+/]+={0,2}):$/;\\nvar B64 = \\\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\\\";\\n/** The lowercase hex of a base64 byte string, or null where the base64 reads torn. Hand-rolled so\\n*  the law runs the same in a browser, a plugin VM and node — no `Buffer`, no `atob`. */\\nfunction hexOfBase64(b64) {\\n\\tconst body = b64.replace(/=+$/, \\\"\\\");\\n\\tif (body.length % 4 === 1) return null;\\n\\tlet bits = 0;\\n\\tlet acc = 0;\\n\\tlet hex = \\\"\\\";\\n\\tfor (const ch of body) {\\n\\t\\tconst v = B64.indexOf(ch);\\n\\t\\tif (v < 0) return null;\\n\\t\\tacc = acc << 6 | v;\\n\\t\\tbits += 6;\\n\\t\\tif (bits >= 8) {\\n\\t\\t\\tbits -= 8;\\n\\t\\t\\thex += (acc >> bits & 255).toString(16).padStart(2, \\\"0\\\");\\n\\t\\t}\\n\\t}\\n\\treturn hex;\\n}\\n/**\\n* Parse a digest string into `(algo, hex)`.\\n*\\n*   \\\"sha256:ab…\\\"      → { algo: \\\"sha256\\\", hex: \\\"ab…\\\" }   (tagged, `:`)\\n*   \\\"sha-256=:q80…=:\\\" → { algo: \\\"sha256\\\", hex: \\\"ab…\\\" }   (RFC 9530 Repr-Digest)\\n*   \\\"blake3:cd…\\\"      → { algo: \\\"blake3\\\", hex: \\\"cd…\\\" }   (another scheme rides free)\\n*   \\\"ab…64…\\\"          → throws — a bare hex names no algorithm\\n*\\n* The hex and the algo lowercase. Throws a NAMED error on anything else.\\n*\\n* The split falls on the first `:` only, and holds only when the head reads as an\\n* algorithm tag and the tail as hex — hex holds no `:`, so no value mis-splits.\\n*/\\nfunction parseDigest(digest) {\\n\\tif (typeof digest !== \\\"string\\\" || digest.length === 0) throw new TypeError(`parseDigest: empty or non-string digest`);\\n\\tconst repr = REPR_DIGEST.exec(digest);\\n\\tif (repr) {\\n\\t\\tconst hex = hexOfBase64(repr[2]);\\n\\t\\tif (hex === null || !SHA256_HEX.test(hex)) throw new TypeError(`parseDigest: malformed tagged digest \\\"${digest}\\\"`);\\n\\t\\treturn {\\n\\t\\t\\talgo: SHA256_ALGO,\\n\\t\\t\\thex\\n\\t\\t};\\n\\t}\\n\\tconst sepIndex = digest.indexOf(\\\":\\\");\\n\\tif (sepIndex > 0) {\\n\\t\\tconst algo = digest.slice(0, sepIndex).toLowerCase();\\n\\t\\tconst hex = digest.slice(sepIndex + 1).toLowerCase();\\n\\t\\tif (ALGO_TAG.test(algo) && HEX_BYTES.test(hex)) return {\\n\\t\\t\\talgo,\\n\\t\\t\\thex\\n\\t\\t};\\n\\t\\tthrow new TypeError(`parseDigest: malformed tagged digest \\\"${digest}\\\"`);\\n\\t}\\n\\tif (HEX_BYTES.test(digest)) throw new TypeError(`parseDigest: bare hex \\\"${digest.slice(0, 16)}…\\\" names no algorithm — write it tagged (\\\\`sha256:<hex>\\\\`)`);\\n\\tthrow new TypeError(`parseDigest: not a tagged digest \\\"${digest}\\\"`);\\n}\