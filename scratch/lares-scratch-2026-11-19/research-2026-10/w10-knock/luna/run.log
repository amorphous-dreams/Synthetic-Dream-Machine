   380	      const entry = Object.freeze({ gate, knock: gateKnock(pin) });
   381	      gates.set(path, entry);
   382	      once.add(path);
   383	      return Object.freeze({
   384	        path,
   385	        unstand() { if (gates.get(path) === entry) gates.delete(path); },
   386	      });
   387	    },
   388	    handleUpgrade(req, socket, head) {
