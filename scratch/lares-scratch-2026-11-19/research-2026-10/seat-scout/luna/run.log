   319	      if (!verdict.ok) {
   320	        console.log(`[daemon] face-join grant record REFUSED (${title.slice(-16)}): ${verdict.reason} — no binding moves`);
   321	        continue;
   322	      }
   323	      // THE KIT'S OWN ACT: take the cap events (live) and persist them (boot re-hydrates the seat).
   324	      // Ingest is also the READING — the vessel's own handler stamps the true variant and island on the
   325	      // events keyhive accepts, so it must reach the store before any backstop row masks them.
   326	      const events = rec.capEvents.map(base64ToBytes);
   327	      try { await absorbCapEvents(veilKh, new DaemonEventStore({ daemon: ctx.composite }), events); } catch (err) { console.log(`[daemon] face-join grant: atom ingest faulted: ${(err as Error)?.message ?? err}`); }
   328	      const seated = await veilKh.knowsAgent(group);
   329	      console.log(`[daemon] face-join grant record taken from the PersonaGroup plane (${events.length} cap events, ${rec.reSealed.length} chunks re-sealed) — face ${seated ? "SEATED" : "still unseated after ingest"}`);
   330	      if (seated) return true;
   331	    }
   332	    return false;
   333	  };
   334	
   335	  let slotDocs: SlotDocResolver | null = null;
   336	  let floorLifted = false;
   337	  const slotDocsOf = (ctx: IslandContext): SlotDocResolver => {
   338	    if (slotDocs) return slotDocs;
   339	    if (!kh) throw new Error("keyhive not booted");
   340	    slotDocs = makeSlotDocResolver({
   341	      repo: restDocuments ? restingMinter(ctx.repo, (ids) => restDocuments(ids,
   342	        gateCleared ? undefined : gateClear)) : ctx.repo,
   343	      daemonStore: ctx.composite, keyhive: kh,
   344	      catalog: ctx.catalogUrl ? makeCatalogAccessor(ctx.repo, ctx.catalogUrl) : null,
   345	      vesselDid: () => didFromVerifyingKey(daemonAuth.atom?.key ?? daemonAuth.vesselVerifyingKey),
   346	      mintedByHex: () => mintedByHex,
   347	      ...(daemonAuth.personaGroupId ? { personaGroupId: daemonAuth.personaGroupId } : {}),
   348	      ...(faceDoor() ? { faceDoor: faceDoor()! } : {}),
   349	      faceSeated: async () => {
   350	        const agent = daemonAuth.personaGroupId;
   351	        if (!agent) return false;
   352	        let seated = veilKh ? await veilKh.knowsAgent(agent) : false;
   353	        // THE LATER GRANT (basket-one #/the-later-grant): not seated → read the PersonaGroup plane for a grant
   354	        // record naming this vessel, verify it OFFLINE against the published seal, and take the seat by this
   355	        // kit's own act. Reading alone re-cuts nothing — a record that fails stays a record.
   356	        if (!seated) seated = await takeFaceGrantIfPublished(ctx);
   357	        if (!seated) console.log(`[daemon] face ${agent.slice(0, 16)}… pinned, not yet seated — bindings mint vessel-only until a face-join lands`);
   358	        // THE ANON-VEIL LIFT runs ONCE per process, the first time this vessel reads as seated: at the seat's landing, or at a
   359	        // boot that finds the face already seated. The join is the gate; nothing asks per item.
   360	        if (seated && !floorLifted) {
   361	          floorLifted = true;
   362	          try {
   363	            const lifted = await slotDocs!.liftFloor();
   364	            if (lifted.moved.length + lifted.finished.length > 0) console.log(`[daemon] the seat landed: ${lifted.moved.length} floor record(s) moved under the face, ${lifted.finished.length} burn(s) finished`);
   365	          } catch (err) { floorLifted = false; console.log(`[daemon] the anon-veil lift faulted (${(err as Error)?.message ?? err}) — it runs again at the next seat read`); }
   366	        }
   367	        return seated;
   368	      },
   369	    });
   370	    return slotDocs;
   371	  };
   372	
   373	  // Every write made by the daemon wiki, including its receipts and audit records, lands in its working
   374	  // layer. The daemon bag beneath holds only records the daemon wiki names explicitly.
   375	  const attachDaemonWorking = async (ctx: IslandContext): Promise<void> => {
   376	    const slug = ctx.recipe.wikiSlug;
   377	    const working = wikiSlotUri(slug, "working");
   378	    try {
   379	      if (ctx.composite.hasBag(working)) {
   380	        if (ctx.composite.defaultWritableBagId() !== working) throw new Error("the working layer is not the default writable");
   381	        return;
   382	      }
   383	      const daemonUrl = ctx.handles.get(wikiBagUri(slug))?.url;
   384	      if (!daemonUrl) throw new Error(`daemon bag ${wikiBagUri(slug)} is unavailable`);
   385	      if (!kh) throw new Error("Keyhive is unavailable in the daemon boot");
   386	      const recipeTrace = { wikiDocId: daemonUrl, libraryBagDocIds: [] as readonly string[] };
   387	      const fingerprint = await computeRecipeFingerprint(recipeTrace);
   388	      const { workingUrl } = await slotDocsOf(ctx).bindings(fingerprint, recipeTrace, slug);
   389	      const handle = await findOrThrow(ctx.repo, workingUrl, `${working} (the daemon's working layer)`, { timeoutMs: DOCUMENT_HANG_BOUND_MS });
   390	      const store = new AutomergeDocStore(handle, working);
   138	    // document through its seat in the group, so it adopts nothing.
   139	    if (fields?.["face-reach"] === "face" && args.faceDoor) {
   140	      const docId = fields["keyhive-doc-id"];
   141	      if (typeof docId !== "string" || !docId) throw new BindingRegistrationRefusal(key, existing);
   142	      args.faceDoor.adopt(existing, docId);
   143	    }
   144	    // A VESSEL-ONLY RECORD ASKS THE SEAT. The later grant lands as a record on the PersonaGroup plane, and the seat is taken
   145	    // where the daemon reads it (`faceSeated`); the lift pass runs inside that read and moves the record under the face. This
   146	    // call re-reads the record after the ask, so a binding the lift moved returns its new document.
   147	    if (fields?.["face-reach"] === "vessel-only" && args.personaGroupId && args.faceSeated && await args.faceSeated()) {
   148	      const moved = await args.daemonStore.get(key);
   149	      const movedFields = moved?.tiddler as Record<string, unknown> | undefined;
   150	      const movedUrl = tiddlerText(moved);
   151	      if (movedUrl && movedFields?.["face-reach"] === "face") {
   152	        const docId = movedFields["keyhive-doc-id"];
   153	        if (typeof docId === "string" && docId && args.faceDoor) args.faceDoor.adopt(movedUrl, docId);
   154	        return { url: movedUrl, minted: false };
   155	      }
   156	    }
   157	    return { url: existing, minted: false };
   158	  }
   159	
   160	  // Mint-on-absent: a binding never names a document before it rests durably.
   161	  const handle = args.repo.create<LarDoc>(emptyLarDoc());
   162	
   163	  // The provider mapping is process-local, so the binding carries its document ID for reuse.
   164	  const seated = !!(args.personaGroupId && args.faceDoor && await (args.faceSeated?.() ?? Promise.resolve(true)));
   165	  const { docId: keyhiveDocId } = seated
   166	    ? await args.faceDoor!.mint(handle.url, "admin")

