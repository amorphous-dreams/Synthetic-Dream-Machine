inned ${pin.check} -->`,\\n\\t\\t...(pin.body ?? \\\"\\\").split(\\\"\\\\n\\\"),\\n\\t\\t`<!-- /${headWord} -->`\\n\\t] };\\n}\\n/**\\n* Transpose a memetic-wikitext body to markdown. Side-channel captures (address, check, meta fence)\\n* ride the returned record; {@link projectSubmission} folds them into the meta.\\n*/\\nfunction transposeMarkdown(text, profile = PROFILES.CommonMark, resolve, tongue) {\\n\\tconst out = [];\\n\\tlet fence = null;\\n\\tlet ordinal = 0;\\n\\tlet metaFence = null;\\n\\tlet metaFenceDone;\\n\\tlet inMetaFence = false;\\n\\tlet uri;\\n\\tlet check;\\n\\tlet tableRow = 0;\\n\\tlet sigilBuf = null;\\n\\tlet proseBuf = null;\\n\\tlet hanaBuf = null;\\n\\tlet hanaKey = null;\\n\\tconst references = /* @__PURE__ */ new Map();\\n\\tconst flushProse = () => {\\n\\t\\tif (proseBuf === null) return;\\n\\t\\tconst spans = [];\\n\\t\\tconst NUL = String.fromCharCode(0);\\n\\t\\tconst mask = (rendered) => {\\n\\t\\t\\tspans.push(rendered);\\n\\t\\t\\treturn NUL + String(spans.length - 1) + NUL;\\n\\t\\t};\\n\\t\\tconst rendered = restore(emphasize(proseBuf.map((line) => maskLine(line, mask)).join(\\\"\\\\n\\\")), spans, NUL);\\n\\t\\tout.push(...rendered.split(\\\"\\\\n\\\"));\\n\\t\\tproseBuf = null;\\n\\t};\\n\\tconst pushProse = (line) => {\\n\\t\\t(proseBuf ??= []).push(line);\\n\\t};\\n\\tfor (const line of text.split(\\\"\\\\n\\\")) {\\n\\t\\tif (hanaBuf) {\\n\\t\\t\\tif (HANA_CLOSE.test(line)) {\\n\\t\\t\\t\\tconst joined = hanaBuf.join(\\\"\\\\n\\\");\\n\\t\\t\\t\\tconst longestRun = Math.max(0, ...(joined.match(/`+/g) ?? []).map((s) => s.length));\\n\\t\\t\\t\\tconst fenceStr = \\\"`\\\".repeat(Math.max(3, longestRun + 1));\\n\\t\\t\\t\\tout.push(fenceStr + hanaKey, ...hanaBuf, fenceStr);\\n\\t\\t\\t\\thanaBuf = null;\\n\\t\\t\\t\\thanaKey = null;\\n\\t\\t\\t\\tcontinue;\\n\\t\\t\\t}\\n\\t\\t\\thanaBuf.push(line);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif (inMetaFence) {\\n\\t\\t\\tif ((0, _lararium_memetic_frame.fenceLineClose)(line, META_