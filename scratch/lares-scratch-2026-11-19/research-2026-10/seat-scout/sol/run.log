\\t\\t\\t\\t}\\n\\t\\t\\t\\tconst cut = a.fragment.lastIndexOf(\\\"/\\\");\\n\\t\\t\\t\\tconst bare = title.slice(0, title.indexOf(\\\"#\\\"));\\n\\t\\t\\t\\tresults.push(cut < 0 ? bare : `${bare}#${a.fragment.slice(0, cut)}`);\\n\\t\\t\\t\\treturn;\\n\\t\\t\\t}\\n\\t\\t\\tcase \\\"bare\\\":\\n\\t\\t\\t\\tresults.push(a.fragment === \\\"\\\" ? title : title.slice(0, title.indexOf(\\\"#\\\")));\\n\\t\\t\\t\\treturn;\\n\\t\\t\\tcase \\\"depth\\\":\\n\\t\\t\\t\\tresults.push(String(a.fragment === \\\"\\\" ? 0 : a.fragment.split(\\\"/\\\").length));\\n\\t\\t\\t\\treturn;\\n\\t\\t\\tcase \\\"scheme\\\":\\n\\t\\t\\t\\tresults.push(a.lar ? \\\"lar\\\" : \\\"\\\");\\n\\t\\t\\t\\treturn;\\n\\t\\t\\tcase \\\"authority\\\":\\n\\t\\t\\t\\tresults.push(a.authority);\\n\\t\\t\\t\\treturn;\\n\\t\\t\\tcase \\\"root\\\":\\n\\t\\t\\t\\tresults.push(a.root);\\n\\t\\t\\t\\treturn;\\n\\t\\t\\tcase \\\"path\\\":\\n\\t\\t\\t\\tresults.push(a.path);\\n\\t\\t\\t\\treturn;\\n\\t\\t\\tdefault:\\n\\t\\t\\t\\tresults.push(a.fragment);\\n\\t\\t\\t\\treturn;\\n\\t\\t}\\n\\t});\\n\\treturn results;\\n}\\n//#endregion\\nexports[\\\"lar-uri\\\"] = larUri;\\nexports.larUri = larUri;\\n\",\"type\":\"application/javascript\",\"module-type\":\"filteroperator\"},\"lar:///ha.ka.ba/lararium/tw5/routes/list-memes\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/routes/list-memes\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/routes/list-memes\\ntype: application/javascript\\nmodule-type: route\\n\\\\*/\\nlet lararium_place_meme = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\\\");\\n//#region src/routes/plain-server.ts\\n/** The one container name a plain server resolves. */\\nvar HOST_ANCHOR = \\\"default\\\";\\n/** The refusal for a container the server cannot name, or null when `default` is named. A skin that\\n*  addresses one container kind alone (DELETE writes a BAG, as stock's `delete-tiddler.js` does) names\\n*  it in `kinds`; the other kind then reads as a container the skin cannot resolve. */\\nfunction containerRefusal(params, kinds = [\\\"recipes\\\", \\\"bags\\\"]) {\\n\\tconst [kind, name] = params;\\n\\tif (kind === void 0 || !kinds.includes(kind)) return `no route under /${kind ?? \\\"\\\"}/ (this skin addresses /${kinds.join(\\\"/ and /\\\")}/ alone)`;\\n\\tif (name === \\\"default\\\") return null;\\n\\treturn `no such ${kind === \\\"recipes\\\" ? \\\"recipe\\\" : \\\"bag\\\"}: ${name ?? \\\"\\\"} (this server names only ${HOST_ANCHOR})`;\\n}\\n/** Answer a refused container: 404 with the one-line body. */\\nfunction refuseContainer(response, body) {\\n\\tresponse.writeHead(404, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\tresponse.end(body);\\n}\\n//#endregion\\n//#region src/routes/list-memes.ts\\n/**\\n* GET /{recipes|bags}/:name/memes.json — every meme ROOT the container holds, with the canonical hash\\n* a writer hands back as `If-Match`; `?tree=1` nests each root's slot tree beneath it.\\n*\\n* The listing skin of `listMemes`, a sibling of stock's `get-tiddlers-json.js` (`tiddlers.json`): the\\n* same container law (`default` names THE HOST'S ANCHOR; any other name answers 404 with a one-line\\n* body), the same `$:/` posture (a system-titled root rides only while\\n* `$:/config/SyncSystemTiddlersFromServer` reads `yes`), a JSON array in title order.\\n*\\n*   [ { \\\"uri\\\": \\\"lar:///…\\\", \\\"canonicalHash\\\": \\\"sha256:…\\\" }, … ]                        by default\\n*   [ { \\\"uri\\\", \\\"canonicalHash\\\", \\\"slots\\\": [ { \\\"slot\\\": \\\"#/a\\\", \\\"uri\\\": \\\"lar:///…#/a\\\", \\\"slots\\\": [] } ] } ]   ?tree=1\\n*\\n* A slot child, a carriage part and a plain tiddler never list as roots.\\n*/\\nvar methods = [\\\"GET\\\"];\\nvar path = /^\\\\/(recipes|bags)\\\\/([^/]+)\\\\/memes\\\\.json$/;\\nvar info = { priority: 100 };\\nvar SYNC_SYSTEM = \\\"$:/config/SyncSystemTiddlersFromServer\\\";\\n/** `?tree=1` — any value but an empty one, `0` or `false` asks for the tree. */\\nfunction wantsTree(query) {\\n\\tconst raw = query?.[\\\"tree\\\"];\\n\\treturn raw !== void 0 && raw !== \\\"\\\" && raw !== \\\"0\\\" && raw !== \\\"false\\\";\\n}\\n/** Stock's posture: a `$:/` title leaves the answer unless the sync switch reads yes. */\\nfunction systemTitlesRide(wiki) {\\n\\tconst configured = wiki.getTiddlerText?.(SYNC_SYSTEM, \\\"\\\") ?? wiki.getTiddler(SYNC_SYSTEM)?.fields?.text ?? \\\"\\\";\\n\\treturn String(configured).trim() === \\\"yes\\\";\\n}\\nfunction handler(_request, response, state) {\\n\\tconst refusal = containerRefusal(state.params);\\n\\tif (refusal !== null) {\\n\\t\\trefuseContainer(response, refusal);\\n\\t\\treturn;\\n\\t}\\n\\tconst system = systemTitlesRide(state.wiki);\\n\\t(0, lararium_place_meme.listMemes)((0, lararium_place_meme.wikiMemeSink)(state.wiki), { tree: wantsTree(state.queryParameters) }).then((roots) => {\\n\\t\\tconst listed = system ? roots : roots.filter((r) => !r.uri.startsWith(\\\"$:/\\\"));\\n\\t\\tresponse.writeHead(200, { \\\"Content-Type\\\": \\\"application/json\\\" });\\n\\t\\tresponse.end(JSON.stringify(listed));\\n\\t}, (err) => {\\n\\t\\tresponse.writeHead(500, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\t\\tresponse.end(err instanceof Error ? err.message : String(err));\\n\\t});\\n}\\n//#endregion\\nexports.handler = handler;\\nexports.info = info;\\nexports.methods = methods;\\nexports.path = path;\\n\",\"type\":\"application/javascript\",\"module-type\":\"route\"},\"lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\\ntype: application/javascript\\nmodule-type: library\\n\\\\*/\\nlet _lararium_memetic_frame = require(\\\"lar:///ha.ka.ba/lararium/tw5/lib/memetic-frame\\\");\\n//#region src/meme-ast/grammar-table.generated.ts\\nvar GENERATED_SIGILS = [\\n\\t{\\n\\t\\tname: \\\"ahu\\\",\\n\\t\\tkind: \\\"child-slot\\\",\\n\\t\\topenPattern: \\\"<<~[^>]*\\\\\\\\bahu\\\\\\\\s+(#