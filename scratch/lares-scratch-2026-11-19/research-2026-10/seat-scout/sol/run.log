"edge-alias\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*guard\\\\\\\\s+([^\\\\\\\\n>]*)\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"kapu\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"hana\\\",\\n\\t\\tkind: \\\"guest-grammar\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*hana\\\\\\\\s+([^\\\\\\\\n>]+?)\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/hana\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"has\\\",\\n\\t\\tkind: \\\"relation\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*has\\\\\\\\s+([\\\\\\\\w-]+)(?:\\\\\\\\s+([\\\\\\\\w.-]+))?(?:\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"]|\\\\\\\"(?!\\\\\\\\s*>>))*)\\\\\\\"?)?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"heihei\\\",\\n\\t\\tkind: \\\"control\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*heihei\\\\\\\\s+([^>]+?)\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/heihei\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"helu\\\",\\n\\t\\tkind: \\\"pragma\\\",\\n\\t\\topenPattern: \\\"<<~!?\\\\\\\\s*helu\\\\\\\\s+([\\\\\\\\w-]+)(?:\\\\\\\\s*\\\\\\\\(([^)]*)\\\\\\\\))?(?:\\\\\\\\s+([^>]*?))?\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/helu\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"holo\\\",\\n\\t\\tkind: \\\"concurrency\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*holo\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/holo\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"hoolele\\\",\\n\\t\\tkind: \\\"concurrency\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*hoolele\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"\\\\\\\\s>]|>(?!>))+)\\\\\\\"?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"hud\\\",\\n\\t\\tkind: \\\"metadata\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*hud\\\\\\\\b([\\\\\\\\s\\\\\\\\S]*?)>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"hui\\\",\\n\\t\\tkind: \\\"concurrency\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*hui\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/hui\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"huli\\\",\\n\\t\\tkind: \\\"control\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*huli\\\\\\\\s+([^>]+?)\\\\\\