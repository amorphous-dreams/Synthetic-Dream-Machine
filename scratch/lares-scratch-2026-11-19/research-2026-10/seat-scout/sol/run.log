 r = reader(carriageUri(carrierUri, part));\\n\\treturn r && typeof r[\\\"text\\\"] === \\\"string\\\" ? r[\\\"text\\\"] : \\\"\\\";\\n}\\n/**\\n* Splice child definition blocks back over their kahea markers, full depth.\\n* Quoted markers (fenced/inline-code) stay verbatim — the operator SHOWS\\n* the grammar there, the recompose never expands inside the mask.\\n*/\\nfunction expandRefs(reader, rootUri, text, parentFields) {\\n\\tconst mask = (0, _lararium_memetic_frame.fencedSpans)(text);\\n\\treturn text.replace(lararium_meme_ast.KAHEA_REF_RE, (marker, slot, offset) => {\\n\\t\\tif ((0, _lararium_memetic_frame.inMask)(mask, offset)) return marker;\\n\\t\\tconst slotPath = slot;\\n\\t\\tconst child = reader(rootUri + slotPath);\\n\\t\\tif (!child) return marker;\\n\\t\\tconst meta = emitMetaToml(child, CHILD_META_DENY, parentFields);\\n\\t\\tconst inner = expandRefs(reader, rootUri, String(child[\\\"text\\\"] ?? \\\"\\\"), child);\\n\\t\\tconst pre = carriageText(reader, rootUri + slotPath, \\\"preamble\\\");\\n\\t\\tconst post = carriageText(reader, rootUri + slotPath, \\\"postamble\\\");\\n\\t\\tconst metaBlock = meta ? \\\"```toml meta\\\\n\\\" + meta + \\\"```\\\" : \\\"\\\";\\n\\t\\tconst rest = stripEdgeNewlines(inner + post);\\n\\t\\tconst hasPre = pre.trim() !== \\\"\\\";\\n\\t\\tlet opened;\\n\\t\\tif (hasPre) opened = `\\\\n\\\\n${stripEdgeNewlines(pre + (metaBlock ? \\\"\\\\n\\\\n\\\" + metaBlock : \\\"\\\") + (rest ? \\\"\\\\n\\\\n\\\" + rest : \\\"\\\"))}`;\\n\\t\\telse if (metaBlock) opened = `\\\\n${metaBlock}${rest ? \\\"\\\\n\\\\n\\\" + rest : \\\"\\\"}`;\\n\\t\\telse opened = rest ? `\\\\n\\\\n${rest}` : \\\"\\\";\\n\\t\\tconst spelt = slot;\\n\\t\\tconst open = carriageText(reader, rootUri + slotPath, \\\"worksite-open\\\");\\n\\t\\tconst close = carriageText(reader, rootUri + slotPath, \\\"worksite-close\\\");\\n\\t\\treturn `${open || `<<~ ahu ${spelt}>>`}${opened}\\\\n\\\\n${close || \\\"<<~/ahu>>\\\"}`;\\n\\t});\\n}\\n/**\\n* Recompose one whole carrier from its record group.\\n*\\n* Returns null when the parent record is absent or not memetic-wikitext —\\n* the caller falls back to its own law (exportMemeText returns raw text).\\n*/\\nfunction expandMemeRefs(reader, memeUri) {\\n\\tconst f = reader(memeUri);\\n\\tif (!f) return null;\\n\\tif (!isCarrierType(f.type)) {\\n\\t\\tif (typeof f[\\\"type\\\"] === \\\"string\\\" && f[\\\"type\\\"].includes(\\\"memetic-wikitext\\\")) console.warn(`[memetic-deserializer] ${memeUri} declares type \\\"${f[\\\"type\\\"]}\\\" — not a spelling this reader admits (${CARRIER_TYPES.join(\\\" · \\\")}); it will not project`);\\n\\t\\treturn null;\\n\\t}\\n\\tconst str = (k) => typeof f[k] === \\\"string\\\" ? f[k] : \\\"\\\";\\n\\tconst meta = emitMetaToml(f, META_DENY);\\n\\tconst carriedRootContent = [carriageText(reader, memeUri, \\\"preamble\\\"), expandRefs(reader, memeUri, carriageText(reader, memeUri, \\\"header-text\\\"), f)].filter((s) => s.trim() !== \\\"\\\").join(\\\"\\\\n\\\\n\\\");\\n\\tconst body = (meta ? \\\"```toml meta\\\\n\\\" + meta + \\\"```\\\\n\\\\n\\\" : \\\"\\\") + (carriedRootContent ? carriedRootContent + \\\"\\\\n\\\\n\\\" : \\\"\\\") + expandRefs(reader, memeUri, String(f.text ?? \\\"\\\"), f);\\n\\treturn (0, _lararium_memetic_frame.frameCarrier)({\\n\\t\\thead: {\\n\\t\\t\\turi: memeUri,\\n\\t\\t\\tnamespace: str(\\\"namespace\\\"),\\n\\t\\t\\tkapu: f[\\\"$carrier-soh\\\"] === \\\"0011\\\"\\n\\t\\t},\\n\\t\\tbody,\\n\\t\\tprologue: carriageText(reader, memeUri, \\\"prologue\\\"),\\n\\t\\tpostamble: carriageText(reader, memeUri, \\\"postamble\\\")\\n\\t});\\n}\\n//#endregion\\nexports.BARE_DATA_TYPE = BARE_DATA_TYPE;\\nexports.CARRIAGE_PARTS = CARRIAGE_PARTS;\\nexports.QUOTEBLOCKED_CODE = QUOTEBLOCKED_CODE;\\nexports.QUOTEBLOCKED_FIELD = QUOTEBLOCKED_FIELD;\\nexports.TORN_FIELD = TORN_FIELD;\\nexports.carriageUri = carriageUri;\\nexports.carrierText = carrierText;\\nexports.deserializeCarrier = deserializeCarrier;\\nexports.divideCarrier = divideCarrier;\\nexports.expandMemeRefs = expandMemeRefs;\\nexports.findMetaFence = findMetaFence;\\nexports.getGrammar = getGrammar;\\nexports.memeticWikitextDeserializer = memeticWikitextDeserializer;\\nexports[\\\"text/memetic-wikitext+tiddlywiki\\\"] = memeticWikitextDeserializer;\\nexports.quoteblockFence = quoteblockFence;\\nexports.quoteblockFloor = quoteblockFloor;\\nexports.resetGrammar = resetGrammar;\\nexports.splitBodyTiddler = splitBodyTiddler;\\n\",\"type\":\"application/javascript\",\"module-type\":\"tiddlerdeserializer\"},\"lar:///ha.ka.ba/lararium/tw5/modules/draft-compare\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/draft-compare\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/draft-compare\\ntype: application/javascript\\nmodule-type: startup\\n\\\\*/\\n//#region src/envelope-fields.ts\\n/** Fields carried by the landing envelope rather than by a tiddler's content. */\\nvar ENVELOPE_FIELDS = [\\\"$origin-bag\\\"];\\n//#endregion\\n//#region src/modules/draft-compare.ts\\n/**\\n* draft-compare — a draft reads modified by what it SAYS, never by where it landed from.\\n*\\n* TiddlyWiki's `isDraftModified` compares a draft with its target field by field, less the five fields a\\n* draft always differs in. A landed tiddler also carries the envelope stamp of the bag it landed from, and\\n* a draft lands from the draft layer while its target lands from another, so the stock comparison reads\\n* every landed draft as modified and Cancel asks to confirm an untouched one. This module installs the\\n* same comparison with the envelope fields (`ENVELOPE_FIELDS`, the one spelling) joined to the ignored\\n* list; every other answer matches TiddlyWiki's own.\\n*/\\nvar name = \\\"lar-draft-compare\\\";\\nvar synchronous = true;\\nvar before = [\\\"startup\\\"];\\nfunction isDraftModified(title) {\\n\\tconst draft = this.getTiddler(title);\\n\\tif (!draft || !draft.isDraft()) return false;\\n\\tconst target = this.getTiddler(String(draft.fields[\\\"draft.of\\\"])) ?? new $tw.Tiddler({\\n\\t\\ttext: \\\"\\\",\\n\\t\\ttags: []\\n\\t});\\n\\tconst ignored = [\\n\\t\\t\\\"created\\\",\\n\\t\\t\\\"modified\\\",\\n\\t\\t\\\"title\\\",\\n\\t\\t\\\"draft.title\\\",\\n\\t\\t\\\"draft.of\\\",\\n\\t\\t...ENVELOPE_FIELDS\\n\\t];\\n\\treturn draft.fields[\\\"draft.title\\\"] !== draft.fields[\\\"draft.of\\\"] || !draft.isEqual(target, ignored);\\n}\\nfunction startup() {\\n\\t$tw.Wiki.prototype.isDraftModified = isDraftModified;\\n}\\n//#endregion\\nexports.before = before;\\nexports.name = name;\\nexports.startup = startup;\\nexports.synchronous = synchronous;\\n\",\"type\":\"application/javascript\",\"module-type\":\"startup\"},\"lar:///ha.ka.ba/lararium/tw5/routes/get-meme\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/routes/get-meme\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/routes/get-meme\\ntype: application/javascript\\nmodule-type: route\\n\\\\*/\\nlet lararium_place_meme = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\\\");\\n//#region ../lararium-mesh/src/agile-digest.ts\\n/** The algorithm tag of the house's sha256 digests — the one RFC 9530 `Repr-Digest` maps to. */\\nvar SHA256_ALGO = \\\"sha256\\\";\\n/** A 32-byte (SHA-256) digest's hex: exactly 64 hex chars. */\\nvar SHA256_HEX = /^[0-9a-fA-F]{64}$/;\\n/** A digest's hex part (even length ≥ 2) — another algorithm may carry another width. */\\nvar HEX_BYTES = /^(?:[0-9a-fA-F]{2})+$/;\\n/** A valid algorithm tag: lowercase alnum + dashes (blake3, sha512, sha2-256…). */\\nvar ALGO_TAG = /^[a-z0-9][a-z0-9-]*$/;\\n/** The RFC 9530 `Repr-Digest` field value: `sha-256=:<base64>:` (one member, the sf-binary item). */\\nvar REPR_DIGEST = /^(sha-256)=:([A-Za-z0-9+/]+={0,2}):$/;\\nvar B64 = \\\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\\\";\\n/** The lowercase hex of a base64 byte string, or null where the base64 reads torn. Hand-rolled so\\n*  the law runs the same in a browser, a plugin VM and node — no `Buffer`, no `atob`. */\\nfunction hexOfBase64(b64) {\\n\\tconst body = b64.replace(/=+$/, \\\"\\\");\\n\\tif (body.length % 4 === 1) return null;\\n\\tlet bits = 0;\\n\\tlet acc = 0;\\n\\tlet hex = \\\"\\\";\\n\\tfor (const ch of body) {\\n\\t\\tconst v = B64.indexOf(ch);\\n\\t\\tif (v < 0) return null;\\n\\t\\tacc = acc << 6 | v;\\n\\t\\tbits += 6;\\n\\t\\tif (bits >= 8) {\\n\\t\\t\\tbits -= 8;\\n\\t\\t\\thex += (acc >> bits & 255).toString(16).padStart(2, \\\"0\\\");\\n\\t\\t}\\n\\t}\\n\\treturn hex;\\n}\\n/** The base64 of a lowercase hex byte string. */\\nfunction base64OfHex(hex) {\\n\\tlet out = \\\"\\\";\\n\\tlet acc = 0;\\n\\tlet bits = 0;\\n\\tfor (let i = 0; i < hex.length; i += 2) {\\n\\t\\tacc = acc << 8 | parseInt(hex.slice(i, i + 2), 16);\\n\\t\\tbits += 8;\\n\\t\\twhile (bits >= 6) {\\n\\t\\t\\tbits -= 6;\\n\\t\\t\\tout += B64[acc >> bits & 63];\\n\\t\\t}\\n\\t}\\n\\tif (bits > 0) out += B64[acc << 6 - bits & 63];\\n\\twhile (out.length % 4 !== 0) out += \\\"=\\\";\\n\\treturn out;\\n}\\n/**\\n* Parse a digest string into `(algo, hex)`.\\n*\\n*   \\\"sha256:ab…\\\"      → { algo: \\\"sha256\\\", hex: \\\"ab…\\\" }   (tagged, `:`)\\n*   \\\"sha-256=:q80…=:\\\" → { algo: \\\"sha256\\\", hex: \\\"ab…\\\" }   (RFC 9530 Repr-Digest)\\n*   \\\"blake3:cd…\\\"      → { algo: \\\"blake3\\\", hex: \\\"cd…\\\" }   (another scheme rides free)\\n*   \\\"ab…64…\\\"          → throws — a bare hex names no algorithm\\n*\\n* The hex and the algo lowercase. Throws a NAMED error on anything else.\\n*\\n* The split falls on the first `:` only, and holds only when the head reads as an\\n* algorithm tag and the tail as hex — hex holds no `:`, so no value mis-splits.\\n*/\\nfunction parseDigest(digest) {\\n\\tif (typeof digest !== \\\"string\\\" || digest.length === 0) throw new TypeError(`parseDigest: empty or non-string digest`);\\n\\tconst repr = REPR_DIGEST.exec(digest);\\n\\tif (repr) {\\n\\t\\tconst hex = hexOfBase64(repr[2]);\\n\\t\\tif (hex === null || !SHA256_HEX.test(hex)) throw new TypeError(`parseDigest: malformed tagged digest \\\"${digest}\\\"`);\\n\\t\\treturn {\\n\\t\\t\\talgo: SHA256_ALGO,\\n\\t\\t\\thex\\n\\t\\t};\\n\\t}\\n\\tconst sepIndex = digest.indexOf(\\\":\\\");\\n\\tif (sepIndex > 0) {\\n\\t\\tconst algo = digest.slice(0, sepIndex).toLowerCase();\\n\\t\\tconst hex = digest.slice(sepIndex + 1).toLowerCase();\\n\\t\\tif (ALGO_TAG.test(algo) && HEX_BYTES.test(hex)) return {\\n\\t\\t\\talgo,\\n\\t\\t\\thex\\n\\t\\t};\\n\\t\\tthrow new TypeError(`parseDigest: malformed tagged digest \\\"${digest}\\\"`);\\n\\t}\\n\\tif (HEX_BYTES.test(digest)) throw new TypeError(`parseDigest: bare hex \\\"${digest.slice(0, 16)}…\\\" names no algorithm — write it tagged (\\\\`sha256:<hex>\\\\`)`);\\n\\tthrow new TypeError(`parseDigest: not a tagged digest \\\"${digest}\\\"`);\\n}\\n/**\\n* The RFC 9530 `Repr-Digest` field value for a sha256 digest in any of its tagged spellings —\\n* `sha-256=:<base64>:`. An HTTP skin emits it beside the `ETag`, so a client that speaks the\\n* standard field verifies the body without learning the house's tag grammar. Only sha256 carries a\\n* registered RFC 9530 algorithm key here; another algorithm refuses loud.\\n*/\\nfunction reprDigestOf(digest) {\\n\\tconst { algo, hex } = parseDigest(digest);\\n\\tif (algo !== \\\"sha256\\\") throw new TypeError(`reprDigestOf: only sha-256 carries a Repr-Digest key here (got \\\"${algo}\\\")`);\\n\\treturn `sha-256=:${base64OfHex(hex)}:`;\\n}\\n//#endregion\\n//#region src/routes/plain-server.ts\\n/**\\n* THE PLAIN SERVER'S SHORE — what the meme route skins stand on when a plain TiddlyWiki server\\n* (the fork's `--listen`) carries them. One law, inlined into each skin's bundle (the sandbox's web\\n* globals ride the `host-globals` startup module, which runs before any route answers):\\n*\\n* THE CONTAINER LAW. A 1-wiki server holds ONE container, and `recipes/default` and `bags/default`\\n* both name it (TiddlyWeb's own stub). `default` names THE HOST'S ANCHOR — the one wiki here; @daemon\\n* on a lares island — and any other recipe or bag is a name the server cannot resolve. A bag the\\n* server cannot name MUST NOT swallow a write, so the skins answer 404 with a one-line body before\\n* the path is read.\\n*\\n* THE DIGEST PAIR. A response that carries a canonical hash carries it twice: `ETag` (the house's\\n* `sha256:hex`, the merge base a writer hands back as `If-Match`) and `Repr-Digest` (RFC 9530,\\n* `sha-256=:<base64>:`, the standard field a client verifies the body against). One digest, two\\n* spellings; `digestsEqual` reads either.\\n*/\\n/** The one container name a plain server resolves. */\\nvar HOST_ANCHOR = \\\"default\\\";\\n/** The refusal for a container the server cannot name, or null when `default` is named. A skin that\\n*  addresses one container kind alone (DELETE writes a BAG, as stock's `delete-tiddler.js` does) names\\n*  it in `kinds`; the other kind then reads as a container the skin cannot resolve. */\\nfunction containerRefusal(params, kinds = [\\\"recipes\\\", \\\"bags\\\"]) {\\n\\tconst [kind, name] = params;\\n\\tif (kind === void 0 || !kinds.includes(kind)) return `no route under /${kind ?? \\\"\\\"}/ (this skin addresses /${kinds.join(\\\"/ and /\\\")}/ alone)`;\\n\\tif (name === \\\"default\\\") return null;\\n\\treturn `no such ${kind === \\\"recipes\\\" ? \\\"recipe\\\" : \\\"bag\\\"}: ${name ?? \\\"\\\"} (this server names only ${HOST_ANCHOR})`;\\n}\\n/** Answer a refused container: 404 with the one-line body. */\\nfunction refuseContainer(response, body) {\\n\\tresponse.writeHead(404, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\tresponse.end(body);\\n}\\n/** The `ETag` + `Repr-Digest` pair for a canonical hash; empty where no hash stands (a refusal). */\\nfunction digestHeaders(canonicalHash) {\\n\\tif (!canonicalHash) return {};\\n\\treturn {\\n\\t\\t\\\"ETag\\\": `\\\"${canonicalHash}\\\"`,\\n\\t\\t\\\"Repr-Digest\\\": reprDigestOf(canonicalHash)\\n\\t};\\n}\\n//#endregion\\n//#region src/routes/get-meme.ts\\n/**\\n* GET /bags/:bag/memes/:scheme/:path — the whole meme as text, children recomposed inline.\\n* `recipes` reads the same (the native read/write pair); the path grammar lives in `MEME_PATH`.\\n*\\n* The read half of the PUT contract: the `ETag` carries the canonical hash of what the records\\n* render now, and a writer hands it back as `If-Match` so the gate can tell an edit over a stale\\n* read from a clean one; `Repr-Digest` (RFC 9530) carries the same hash in the standard field.\\n* 404 when the wiki holds no record under the URI.\\n*\\n* `:bag` names a container the server resolves. `default` names THE HOST'S ANCHOR — the one wiki on a\\n* plain server; @daemon on a lares island. Any other recipe or bag answers 404 with a one-line body.\\n*\\n* ── A RECIPE READS ITS STACK ────────────────────────────────────────────────────────────────────\\n* On a plain server the wiki IS the stack: `recipes/default` reads the one wiki, top to bottom, and\\n* that is the whole recipe. On an island a recipe is a stack of bags (canon ← working ← draft ←\\n* temp), and `meme get --recipe <slug>` reads it the same way — top-down, the first live record\\n* wins — while `meme put --recipe <slug>` writes the recipe's designated writable bag. The two doors\\n* answer the same bytes and the same `canonicalHash` for the same recipe; `tests/e2e/recipe-parity`\\n* witnesses it over a live fork server and a staged island.\\n*/\\n/** The marker the handler threads for a pointer whose body this wiki holds none of. */\\nvar POINTER = \\\"unread-pointer\\\";\\nvar methods = [\\\"GET\\\"];\\nvar path = lararium_place_meme.MEME_PATH;\\nvar info = { priority: 100 };\\nfunction handler(_request, response, state) {\\n\\tconst refusal = containerRefusal(state.params);\\n\\tif (refusal !== null) {\\n\\t\\trefuseContainer(response, refusal);\\n\\t\\treturn;\\n\\t}\\n\\tconst uri = (0, lararium_place_meme.memeUriOfParams)(state.params);\\n\\tif (uri === null) {\\n\\t\\tresponse.writeHead(400, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\t\\tresponse.end(\\\"malformed meme path\\\");\\n\\t\\treturn;\\n\\t}\\n\\tconst sink = (0, lararium_place_meme.wikiMemeSink)(state.wiki);\\n\\tconst read = async () => await (0, lararium_place_meme.holdsUnreadPointer)(uri, sink) ? POINTER : (0, lararium_place_meme.readMeme)(uri, sink);\\n\\tread().then((meme) => {\\n\\t\\tif (meme === POINTER) {\\n\\t\\t\\tresponse.writeHead(422, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\t\\t\\tresponse.end(`${lararium_place_meme.POINTER_BODY_CODE}: ${uri} holds a pointer whose body rests in the content tier; this door reads no pointer body`);\\n\\t\\t\\treturn;\\n\\t\\t}\\n\\t\\tif (!meme) {\\n\\t\\t\\tresponse.writeHead(404, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\t\\t\\tresponse.end();\\n\\t\\t\\treturn;\\n\\t\\t}\\n\\t\\tresponse.writeHead(200, {\\n\\t\\t\\t\\\"Content-Type\\\": \\\"text/memetic-wikitext+tiddlywiki; charset=utf-8\\\",\\n\\t\\t\\t...digestHeaders(meme.canonicalHash)\\n\\t\\t});\\n\\t\\tresponse.end(meme.text);\\n\\t}, (err) => {\\n\\t\\tresponse.writeHead(500, { \\\"Content-Type\\\": \\\"text/plain\\\" });\\n\\t\\tresponse.end(err instanceof Error ? err.message : String(err));\\n\\t});\\n}\\n//#endregion\\nexports.handler = handler;\\nexports.info = info;\\nexports.methods = methods;\\nexports.path = path;\\n\",\"type\":\"application/javascript\",\"module-type\":\"route\"},\"lar:///ha.ka.ba/lararium/tw5/modules/grammar-cache\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/grammar-cache\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/grammar-cache\\ntype: application/javascript\\nmodule-type: startup\\n\\\\*/\\nvar LAR_PREFIX = `lar:///ha.ka.ba/`;\\nvar TAG_PREFIX = `${LAR_PREFIX}tags/`;\\nvar VOLATILE_VM_PREFIX = `lar:///lararium.local.vm/`;\\nfunction volatileVmUri(path) {\\n\\treturn `${VOLATILE_VM_PREFIX}${path.replace(/^\\\\/+/, \\\"\\\")}`;\\n}\\nfunction stableLarUri(path) {\\n\\