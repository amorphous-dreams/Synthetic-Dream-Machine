n\\t\\t\\t\\tanchorIdx = ai;\\n\\t\\t\\t\\tbreak;\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif (anchorIdx === -1) continue;\\n\\t\\tconst anchor = skeletal[anchorIdx];\\n\\t\\tconst floatDock = direction === \\\"rightward\\\" && strata.some((b) => b.frame && b.span[0] >= s.span[1] && b.span[0] < anchor.span[0]);\\n\\t\\tassociations.push({\\n\\t\\t\\tstratum: si,\\n\\t\\t\\tanchor: anchorIdx,\\n\\t\\t\\trelation: s.head,\\n\\t\\t\\tdirection,\\n\\t\\t\\tcrossBand: s.band !== anchor.band,\\n\\t\\t\\tfloatDock,\\n\\t\\t\\tdefaultFill: false\\n\\t\\t});\\n\\t}\\n\\treturn {\\n\\t\\tsourceCid,\\n\\t\\tskeletal,\\n\\t\\tstrata,\\n\\t\\tassociations\\n\\t};\\n}\\n//#endregion\\n//#region src/wiki-sense-fold.ts\\n/** Pull the body text — the `text` field read as ONE field among many (the current lens's probe). */\\nfunction senseBodyOf(fields) {\\n\\tconst text = fields[\\\"text\\\"];\\n\\treturn typeof text === \\\"string\\\" ? text : \\\"\\\";\\n}\\n/** The shingle width the form lens mines — a small char k-gram, cheap and deterministic. */\\nvar FORM_SHINGLE_K = 6;\\n/** Per-doc shingle budget — a megabyte-scale tiddler contributes a BOUNDED, deterministic census\\n*  (measured unguarded: a 2.3MB tiddler minted ~298k shingles / ~37MB heap). */\\nvar MAX_DOC_SHINGLES = 4096;\\n/**\\n* Shred a text into its DISTINCT char k-gram shingles (the form lens's atomic patterns).\\n* A doc whose position count exceeds `cap` samples at a FIXED stride — deterministic (the same\\n* text always yields the same census on every face; the cross-beat agreement rides that).\\n*/\\nfunction shingles(text, k = 6, cap = MAX_DOC_SHINGLES) {\\n\\tconst out = /* @__PURE__ */ new Set();\\n\\tconst t = text.replace(/\\\\s+/g, \\\" \\\").trim();\\n\\tif (t.length === 0) return out;\\n\\tif (t.length <= k) {\\n\\t\\tout.add(t);\\n\\t\\treturn out;\\n\\t}\\n\\tconst positions = t.length - k + 1;\\n\\tconst stride = positions > cap ? Math.ceil(positions / cap) : 1;\\n\\tfor (let i = 0; i + k <= t.length; i += stride) out.add(t.slice(i, i + k));\\n\\treturn out;\\n}\\n/**\\n* The STRUCTURE-plane salience of one text [0,1] — the meme-ast RED register load. A text carrying\\n* at least one `<<~…>>` sigil island reads structurally load-bearing (1); bare prose reads 0. The\\n* load indicator stays deterministic and cheap (the graded-density refinement awaits real grounds).\\n*/\\nfunction structureSalience(text) {\\n\\treturn (0, lararium_meme_ast.collectEvents)(text).length >= 1 ? 1 : 0;\\n}\\n/**\\n* Derive one title's stalk from its body text — the unit of per-title work. In the VM face this\\n* derivation rides `wiki.getCacheForTiddler`, so TW5's own per-title invalidation law carries it.\\n*/\\nfunction deriveDocStalk(text) {\\n\\tconst headCounts = /* @__PURE__ */ new Map();\\n\\tfor (const s of stratify(text, \\\"wiki-sense-stalk\\\").strata) {\\n\\t\\tif (s.frame) continue;\\n\\t\\tconst key = s.head.toLowerCase();\\n\\t\\theadCounts.set(key, (headCounts.get(key) ?? 0) + 1);\\n\\t}\\n\\treturn {\\n\\t\\tshingleSet: shingles(text),\\n\\t\\theadCounts,\\n\\t\\tstructure: structureSalience(text)\\n\\t};\\n}\\n/**\\n* Fold a corpus of sensed entities. `stalkOf` shores the per-title derivation so a caller with its\\n* own cache law (the VM indexer's `getCacheForTiddler`) supplies cached stalks; absent, the fold\\n* derives fresh.\\n*/\\nfunction foldCorpus(docs, stalkOf = (d) => deriveDocStalk(senseBodyOf(d.fields))) {\\n\\tconst folded = docs.map((d) => ({\\n\\t\\t...d,\\n\\t\\tbody: senseBodyOf(d.fields),\\n\\t\\tstalk: stalkOf(d)\\n\\t}));\\n\\tconst shingleDocFreq = /* @__PURE__ */ new Map();\\n\\tfor (const d of folded) for (const s of d.stalk.shingleSet) shingleDocFreq.set(s, (shingleDocFreq.get(s) ?? 0) + 1);\\n\\treturn {\\n\\t\\tdocs: folded,\\n\\t\\tshingleDocFreq\\n\\t};\\n}\\n/**\\n* Project a fold into the sensed planes. Structure reads per title (the RED register load); form reads\\n* corpus-aware — a title participates in the recurring grammar when ANY of its shingles occurs in\\n* ≥2 docs (load indicator), EXCLUDING stop-shingles: a shingle carried by more than half the corpus\\n* (floor 2) reads as ambient texture, not grammar — the idf-lite saturation tourniquet (probed: 10k\\n* plain-prose docs otherwise read radius=1 with EVERY title in the locus). Both planes key EVERY\\n* title, so the engineered stalk carries a genuine overlap — the radius reads non-vacuous by construction.\\n*/\\nfunction corpusPlanes(fold) {\\n\\tconst structureVal = /* @__PURE__ */ new Map();\\n\\tconst formVal = /* @__PURE__ */ new Map();\\n\\tconst stopAbove = Math.max(2, fold.docs.length / 2);\\n\\tfor (const d of fold.docs) {\\n\\t\\tstructureVal.set(d.title, d.stalk.structure);\\n\\t\\tlet recurring = 0;\\n\\t\\tfor (const s of d.stalk.shingleSet) {\\n\\t\\t\\tconst df = fold.shingleDocFreq.get(s) ?? 0;\\n\\t\\t\\tif (df >= 2 && df <= stopAbove) {\\n\\t\\t\\t\\trecurring = 1;\\n\\t\\t\\t\\tbreak;\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tformVal.set(d.title, d.stalk.shingleSet.size > 0 ? recurring : 0);\\n\\t}\\n\\tconst restrictions = [{\\n\\t\\tplane: \\\"structure\\\",\\n\\t\\tvariance: \\\"sheaf\\\",\\n\\t\\tvalue: structureVal\\n\\t}, {\\n\\t\\tplane: \\\"form\\\",\\n\\t\\tvariance: \\\"sheaf\\\",\\n\\t\\tvalue: formVal\\n\\t}];\\n\\treturn {\\n\\t\\tstalk: { units: fold.docs.map((d) => d.title) },\\n\\t\\trestrictions\\n\\t};\\n}\\n/** Fold cohere — one assignment through the Robinson radius AND the H¹ gate. */\\nfunction cohereFold(fold) {\\n\\tconst planes = corpusPlanes(fold);\\n\\tconst consistency = consistencyRadius(planes.restrictions, planes.stalk);\\n\\tconst obs = cohomologyObstruction({\\n\\t\\trestrictions: planes.restrictions,\\n\\t\\tstalk: planes.stalk\\n\\t});\\n\\treturn {\\n\\t\\tconsistency,\\n\\t\\tgate: {\\n\\t\\t\\tkind: obs.kind,\\n\\t\\t\\tdimH1: obs.dimH1,\\n\\t\\t\\tcost: obs.cost\\n\\t\\t},\\n\\t\\tcorpusSize: fold.docs.length,\\n\\t\\tasOf: [...new Set(fold.docs.flatMap((d) => d.heads ?? []))].sort()\\n\\t};\\n}\\n/** Map a named universe onto its narrowing designations — \\\"ordinary\\\" = non-shadow, non-system. */\\nfunction universeOptions(universe) {\\n\\treturn universe === \\\"ordinary\\\" ? {\\n\\t\\texcludeShadows: true,\\n\\t\\texcludeSystem: true\\n\\t} : {};\\n}\\n/**\\n* Enumerate a TW5 wiki's sensed universe — the WHOLE wiki by default: ordinary tiddlers PLUS\\n* shadow/plugin-bundled tiddlers, INCLUDING `$:/` system titles (plugin tiddlers bundling code\\n* count as sensed entities like any other). Narrowing happens ONLY by designation. Each tiddler\\n* crosses as its WHOLE field record, untouched.\\n*/\\nfunction readTw5Universe(wiki, opts = {}) {\\n\\tconst docs = [];\\n\\tconst visit = (tiddler, title) => {\\n\\t\\tif (opts.excludeSystem && wiki.isSystemTiddler(title)) return;\\n\\t\\tdocs.push({\\n\\t\\t\\ttitle,\\n\\t\\t\\tfields: tiddler.fields,\\n\\t\\t\\theads: null\\n\\t\\t});\\n\\t};\\n\\tif (opts.excludeShadows) wiki.each(visit);\\n\\telse wiki.eachTiddlerPlusShadows(visit);\\n\\treturn docs;\\n}\\n/** The boundary loci budget — every SERIALIZED surface (filter wire, proof record, indicator frame)\\n*  caps the obstruction locus here and carries the true count as `lociTotal`; in-process verbs keep\\n*  the full read. */\\nvar LOCI_CAP = 32;\\n/** Cap a locus list for a serialized boundary — deterministic head slice (the loci arrive sorted\\n*  from the radius read); the caller carries the true total alongside. */\\nfunction capLoci(loci, cap = 32) {\\n\\treturn loci.length > cap ? loci.slice(0, cap) : loci;\\n}\\n/** Compact a verdict for the filter-operator wire (JSON-clean, deterministic key order). */\\nfunction summarizeCoherence(v) {\\n\\treturn {\\n\\t\\tradius: v.consistency.radius,\\n\\t\\tglues: v.consistency.glues,\\n\\t\\tvacuous: v.consistency.vacuous,\\n\\t\\tobstructionLocus: capLoci(v.consistency.obstructionLocus),\\n\\t\\tlociTotal: v.consistency.obstructionLocus.length,\\n\\t\\tgate: v.gate,\\n\\t\\tcorpusSize: v.corpusSize,\\n\\t\\tbindingPairs: v.consistency.pairs.filter((p) => !p.vacuous).length\\n\\t};\\n}\\n/** Default per-tier recall cap. */\\nvar RECALL_LIMIT = 10;\\n/** Sort hits score-desc, title-asc (deterministic), then cap at the tier limit. */\\nfunction rankHits(hits, limit) {\\n\\treturn hits.sort((a, b) => b.score - a.score || (a.title < b.title ? -1 : a.title > b.title ? 1 : 0)).slice(0, limit);\\n}\\n/** content floor — the probe matches TITLES (the pet-name key); exact 1 · prefix 0.75 · substring 0.5. */\\nfunction contentTier(fold, probe, limit = 10) {\\n\\tif (probe.length === 0) return [];\\n\\tconst p = probe.toLowerCase();\\n\\tconst hits = [];\\n\\tfor (const d of fold.docs) {\\n\\t\\tconst t = d.title.toLowerCase();\\n\\t\\tconst score = t === p ? 1 : t.startsWith(p) ? .75 : t.includes(p) ? .5 : 0;\\n\\t\\tif (score > 0) hits.push({\\n\\t\\t\\ttitle: d.title,\\n\\t\\t\\tscore\\n\\t\\t});\\n\\t}\\n\\treturn rankHits(hits, limit);\\n}\\n/** structure — the sigil-head strata the memetic-wikitext reader typed; score = matching-strata count, max-normalized. */\\nfunction structureTier(fold, sigilHead, limit = 10) {\\n\\tif (sigilHead.length === 0) return [];\\n\\tconst head = sigilHead.toLowerCase();\\n\\tconst counts = fold.docs.map((d) => ({\\n\\t\\ttitle: d.title,\\n\\t\\tn: d.stalk.headCounts.get(head) ?? 0\\n\\t})).filter((x) => x.n > 0);\\n\\tconst maxN = Math.max(1, ...counts.map((x) => x.n));\\n\\treturn rankHits(counts.map((x) => ({\\n\\t\\ttitle: x.title,\\n\\t\\tscore: x.n / maxN\\n\\t})), limit);\\n}\\n/** form — the seed title's shingle neighbors, ranked by Jaccard SIMILARITY; the seed stays out. */\\nfunction formTier(fold, likeTitle, limit = 10) {\\n\\tconst seed = fold.docs.find((d) => d.title === likeTitle);\\n\\tif (!seed) return [];\\n\\tconst hits = [];\\n\\tfor (const d of fold.docs) {\\n\\t\\tif (d.title === seed.title) continue;\\n\\t\\tconst sim = 1 - jaccardDistance(seed.stalk.shingleSet, d.stalk.shingleSet);\\n\\t\\tif (sim > 0) hits.push({\\n\\t\\t\\ttitle: d.title,\\n\\t\\t\\tscore: sim\\n\\t\\t});\\n\\t}\\n\\treturn rankHits(hits, limit);\\n}\\n//#endregion\\nexports.FORM_SHINGLE_K = FORM_SHINGLE_K;\\nexports.LOCI_CAP = LOCI_CAP;\\nexports.MAX_DOC_SHINGLES = MAX_DOC_SHINGLES;\\nexports.RECALL_LIMIT = RECALL_LIMIT;\\nexports.capLoci = capLoci;\\nexports.cohereFold = cohereFold;\\nexports.contentTier = contentTier;\\nexports.corpusPlanes = corpusPlanes;\\nexports.deriveDocStalk = deriveDocStalk;\\nexports.foldCorpus = foldCorpus;\\nexports.formTier = formTier;\\nexports.rankHits = rankHits;\\nexports.readTw5Universe = readTw5Universe;\\nexports.senseBodyOf = senseBodyOf;\\nexports.shingles = shingles;\\nexports.structureSalience = structureSalience;\\nexports.structureTier = structureTier;\\nexports.summarizeCoherence = summarizeCoherence;\\nexports.universeOptions = universeOptions;\\n\",\"type\":\"application/javascript\",\"module-type\":\"library\"},\"lar:///ha.ka.ba/lararium/tw5/modules/wiki-sense-indexer\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/wiki-sense-indexer\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/wiki-sense-indexer\\ntype: application/javascript\\nmodule-type: indexer\\n\\\\*/\\nlet lararium_wiki_sense_fold = require(\\\"lar:///ha.ka.ba/lararium/tw5/lib/wiki-sense-fold\\\");\\n//#region src/modules/wiki-sense-indexer.ts\\n/** The per-title cache key the stalk derivation rides (cleared by TW5 on that title's change). */\\nvar STALK_CACHE = \\\"lararium-wiki-sense-stalk\\\";\\n/**\\n* The indexer — TW5 constructs one per wiki (`new WikiSenseIndexer(wiki)`), then drives\\n* init/rebuild/update; lookups reach it through `wiki.getIndexer(\\\"WikiSenseIndexer\\\").fold(...)`.\\n*/\\nvar WikiSenseIndexer = class {\\n\\twiki;\\n\\t/** the volatile corpus memo, one fold per named universe — dies on ANY update, rebuilds on lookup. */\\n\\tfolds = {};\\n\\tconstructor(wiki) {\\n\\t\\tthis.wiki = wiki;\\n\\t}\\n\\tinit() {\\n\\t\\tthis.folds = {};\\n\\t}\\n\\trebuild() {\\n\\t\\tthis.folds = {};\\n\\t}\\n\\t/** Fires SYNCHRONOUSLY inside addTiddler/deleteTiddler — invalidate cheap, rebuild on lookup. */\\n\\tupdate(_updateDescriptor) {\\n\\t\\tthis.folds = {};\\n\\t}\\n\\t/** The lookup — the memoized corpus fold over the designated universe (default: the WHOLE wiki). */\\n\\tfold(universe = \\\"whole\\\") {\\n\\t\\treturn this.folds[universe] ??= this.buildFold(universe);\\n\\t}\\n\\tbuildFold(universe) {\\n\\t\\tconst docs = (0, lararium_wiki_sense_fold.readTw5Universe)(this.wiki, (0, lararium_wiki_sense_fold.universeOptions)(universe));\\n\\t\\treturn (0, lararium_wiki_sense_fold.foldCorpus)(docs, (d) => this.wiki.getCacheForTiddler(d.title, STALK_CACHE, () => (0, lararium_wiki_sense_fold.deriveDocStalk)((0, lararium_wiki_sense_fold.senseBodyOf)(d.fields))));\\n\\t}\\n};\\n//#endregion\\nexports.WikiSenseIndexer = WikiSenseIndexer;\\n\",\"type\":\"application/javascript\",\"module-type\":\"indexer\"},\"lar:///ha.ka.ba/lararium/tw5/filters/wikisense\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/filters/wikisense\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/filters/wikisense\\ntype: application/javascript\\nmodule-type: filteroperator\\n\\\\*/\\nlet lararium_wiki_sense_fold = require(\\\"lar:///ha.ka.ba/lararium/tw5/lib/wiki-sense-fold\\\");\\n//#region src/filters/wikisense.ts\\n/** Reach the corpus fold — the indexer's held fold when it enumerates, else the direct fold. */\\nfunction corpusOf(wiki, universe) {\\n\\tconst indexer = typeof wiki.getIndexer === \\\"function\\\" ? wiki.getIndexer(\\\"WikiSenseIndexer\\\") : null;\\n\\tif (indexer && typeof indexer.fold === \\\"function\\\") return indexer.fold(universe);\\n\\treturn (0, lararium_wiki_sense_fold.foldCorpus)((0, lararium_wiki_sense_fold.readTw5Universe)(wiki, (0, lararium_wiki_sense_fold.universeOptions)(universe)));\\n}\\n/** [wikisense:<verb>[:tier][:ordinary][operand]] — the sensorium spoken from wikitext-land. */\\nfunction wikisense(_source, operator, options) {\\n\\tconst parts = (operator.suffix ?? \\\"\\\").split(\\\":\\\").filter((p) => p.length > 0);\\n\\tconst verb = parts[0] ?? \\\"\\\";\\n\\tconst universe = parts.includes(\\\"ordinary\\\") ? \\\"ordinary\\\" : \\\"whole\\\";\\n\\tconst operand = operator.operand ?? \\\"\\\";\\n\\tconst residual = parts.slice(1).find((p) => p !== \\\"title\\\" && p !== \\\"structure\\\" && p !== \\\"form\\\" && p !== \\\"ordinary\\\");\\n\\tif (residual !== void 0) return [`wikisense: unknown suffix token \\\"${residual}\\\" (expected title|structure|form|ordinary)`];\\n\\tif (verb === \\\"cohere\\\") {\\n\\t\\tconst verdict = (0, lararium_wiki_sense_fold.cohereFold)(corpusOf(options.wiki, universe));\\n\\t\\treturn [JSON.stringify((0, lararium_wiki_sense_fold.summarizeCoherence)(verdict))];\\n\\t}\\n\\tif (verb === \\\"recall\\\") {\\n\\t\\tconst fold = corpusOf(options.wiki, universe);\\n\\t\\tconst tier = parts.find((p) => p === \\\"title\\\" || p === \\\"structure\\\" || p === \\\"form\\\");\\n\\t\\tconst tiers = tier ? [tier] : [\\n\\t\\t\\t\\\"title\\\",\\n\\t\\t\\t\\\"structure\\\",\\n\\t\\t\\t\\\"form\\\"\\n\\t\\t];\\n\\t\\tconst out = [];\\n\\t\\tconst seen = /* @__PURE__ */ new Set();\\n\\t\\tfor (const t of tiers) {\\n\\t\\t\\tconst hits = t === \\\"title\\\" ? (0, lararium_wiki_sense_fold.contentTier)(fold, operand) : t === \\\"structure\\\" ? (0, lararium_wiki_sense_fold.structureTier)(fold, operand) : (0, lararium_wiki_sense_fold.formTier)(fold, operand);\\n\\t\\t\\tfor (const h of hits) if (!seen.has(h.title)) {\\n\\t\\t\\t\\tseen.add(h.title);\\n\\t\\t\\t\\tout.push(h.title);\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn out;\\n\\t}\\n\\treturn [`wikisense: unknown verb suffix \\\"${verb}\\\" (expected recall|cohere)`];\\n}\\n//#endregion\\nexports.wikisense = wikisense;\\n\",\"type\":\"application/javascript\",\"module-type\":\"filteroperator\"},\"lar:///ha.ka.ba/lararium/tw5/modules/worldline-read-vm\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/worldline-read-vm\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/worldline-read-vm\\ntype: application/javascript\\nmodule-type: startup\\n\\\\*/\\n//#region ../lararium-mesh/src/itc.ts\\n/**\\n* The seed stamp: full ownership (`id=1`), empty history (`event=0`). The root worldline\\n* (the operator, the E-cut common cause) starts here; everything else forks from it.\\n*/\\nfunction itcSeed() {\\n\\treturn {\\n\\t\\tid: 1,\\n\\t\\tevent: 0\\n\\t};\\n}\\n/** Collapse a redundant id pair: `[0,0]→0`, `[1,1]→1`. Keeps ids minimal. */\\nfunction normId(i) {\\n\\tif (i === 0 || i === 1) return i;\\n\\tconst l = normId(i[0]);\\n\\tconst r = normId(i[1]);\\n\\tif (l === 0 && r === 0) return 0;\\n\\tif (l === 1 && r === 1) return 1;\\n\\treturn [l, r];\\n}\\n/** Split an id into two disjoint halves (the fork primitive). */\\nfunction splitId(i) {\\n\\tif (i === 0) return [0, 0];\\n\\tif (i === 1) return [[1, 0], [0, 1]];\\n\\tconst [l, r] = i;\\n\\tif (l === 0) {\\n\\t\\tconst [r1, r2] = splitId(r);\\n\\t\\treturn [[0, r1], [0, r2]];\\n\\t}\\n\\tif (r === 0) {\\n\\t\\tconst [l1, l2] = splitId(l);\\n\\t\\treturn [[l1, 0], [l2, 0]];\\n\\t}\\n\\treturn [[l, 0], [0, r]];\\n}\\n/** Sum two disjoint ids back into one (the join primitive on ownership). */\\nfunction sumId(a, b) {\\n\\tif (a === 0) return b;\\n\\tif (b === 0) return a;\\n\\tif (a === 1 || b === 1) return 1;\\n\\treturn normId([sumId(a[0], b[0]), sumId(a[1], b[1])]);\\n}\\nfunction liftEvent(e, m) {\\n\\treturn typeof e === \\\"number\\\" ? e + m : [\\n\\t\\te[0] + m,\\n\\t\\te[1],\\n\\t\\te[2]\\n\\t];\\n}\\nfunction sinkEvent(e, m) {\\n\\treturn typeof e === \\\"number\\\" ? e - m : [\\n\\t\\te[0] - m,\\n\\t\\te[1],\\n\\t\\te[2]\\n\\t];\\n}\\n/** The floor (smallest value) of an event tree — its root base. */\\nfunction minEvent(e) {\\n\\treturn typeof e === \\\"number\\\" ? e : e[0];\\n}\\n/** The ceiling (largest value) of an event tree. */\\nfunction maxEvent(e) {\\n\\treturn typeof e === \\\"number\\\" ? e : e[0] + Math.max(maxEvent(e[1]), maxEvent(e[2]));\\n}\\n/** Canonicalize an event tree: collapse equal flat children, sink shared depth into the base. */\\nfunction normEvent(e) {\\n\\tif (typeof e === \\\"number\\\") return e;\\n\\tconst n = e[0];\\n\\tconst l = normEvent(e[1]);\\n\\tconst r = normEvent(e[2]);\\n\\tif (typeof l === \\\"number\\\" && typeof r === \\\"number\\\" && l === r) return n + l;\\n\\tconst m = Math.min(minEvent(l), minEvent(r));\\n\\treturn [\\n\\t\\tn + m,\\n\\t\\tsinkEvent(l, m),\\n\\t\\tsinkEvent(r, m)\\n\\t];\\n}\\n/** Max-join two event histories (the join on history; commutative, idempotent). */\\nfunction joinEvent(a, b) {\\n\\tif (typeof a === \\\"number\\\" && typeof b === \\\"number\\\") return Math.max(a, b);\\n\\tif (typeof a === \\\"number\\\") return joinEvent([\\n\\t\\ta,\\n\\t\\t0,\\n\\t\\t0\\n\\t], b);\\n\\tif (typeof b === \\\"number\\\") return joinEvent(a, [\\n\\t\\tb,\\n\\t\\t0,\\n\\t\\t0\\n\\t]);\\n\\tif (a[0] > b[0]) return joinEvent(b, a);\\n\\tconst m = b[0] - a[0];\\n\\treturn normEvent([\\n\\t\\ta[0],\\n\\t\\tjoinEvent(a[1], liftEvent(b[1], m)),\\n\\t\\tjoinEvent(a[2], liftEvent(b[2], m))\\n\\t]);\\n}\\n/** Partial-order on histories: a ≤ b iff every event a knows, b knows. */\\nfunction leqEvent(a, b) {\\n\\tif (typeof a === \\\"number\\\") return typeof b === \\\"number\\\" ? a <= b : a <= b[0];\\n\\tif (typeof b === \\\"number\\\") return a[0] <= b && leqEvent(liftEvent(a[1], a[0]), b) && leqEvent(liftEvent(a[2], a[0]), b);\\n\\treturn a[0] <= b[0] && leqEvent(liftEvent(a[1], a[0]), liftEvent(b[1], b[0])) && leqEvent(liftEvent(a[2], a[0]), liftEvent(b[2], b[0]));\\n}\\nfunction eventEqual(a, b) {\\n\\tif (typeof a === \\\"number\\\" || typeof b === \\\"number\\\") return a === b;\\n\\treturn a[0] === b[0] && eventEqual(a[1], b[1]) && eventEqual(a[2], b[2]);\\n}\\n/** Fill: where the id owns the whole interval, flatten the event to its max (cost-free growth). */\\nfunction fill(i, e) {\\n\\tif (i === 0) return e;\\n\\tif (i === 1) return maxEvent(e);\\n\\tif (typeof e === \\\"number\\\") return e;\\n\\tconst [il, ir] = i;\\n\\tconst [n, el, er] = e;\\n\\tif (il === 1) {\\n\\t\\tconst er2 = fill(ir, er);\\n\\t\\treturn normEvent([\\n\\t\\t\\tn,\\n\\t\\t\\tMath.max(maxEvent(el), minEvent(er2)),\\n\\t\\t\\ter2\\n\\t\\t]);\\n\\t}\\n\\tif (ir === 1) {\\n\\t\\tconst el2 = fill(il, el);\\n\\t\\treturn normEvent([\\n\\t\\t\\tn,\\n\\t\\t\\tel2,\\n\\t\\t\\tMath.max(maxEvent(er), minEvent(el2))\\n\\t\\t]);\\n\\t}\\n\\treturn normEvent([\\n\\t\\tn,\\n\\t\\tfill(il, el),\\n\\t\\tfill(ir, er)\\n\\t]);\\n}\\n/** A large constant biasing growth toward shallower (lower-cost) branches. */\\nvar GROW_DEPTH_COST = 1e3;\\n/** Grow: add exactly one event in the id's region, returning the new history + a cost. */\\nfunction grow(i, e) {\\n\\tif (i === 1) return [(typeof e === \\\"number\\\" ? e : maxEvent(e)) + 1, 0];\\n\\tif (typeof e === \\\"number\\\") {\\n\\t\\tconst [e2, c] = grow(i, [\\n\\t\\t\\te,\\n\\t\\t\\t0,\\n\\t\\t\\t0\\n\\t\\t]);\\n\\t\\treturn [e2, c + GROW_DEPTH_COST];\\n\\t}\\n\\tconst [il, ir] = i;\\n\\tconst [n, el, er] = e;\\n\\tif (il === 0) {\\n\\t\\tconst [er2, cr] = grow(ir, er);\\n\\t\\treturn [[\\n\\t\\t\\tn,\\n\\t\\t\\tel,\\n\\t\\t\\ter2\\n\\t\\t], cr + 1];\\n\\t}\\n\\tif (ir === 0) {\\n\\t\\tconst [el2, cl] = grow(il, el);\\n\\t\\treturn [[\\n\\t\\t\\tn,\\n\\t\\t\\tel2,\\n\\t\\t\\ter\\n\\t\\t], cl + 1];\\n\\t}\\n\\tconst [el2, cl] = grow(il, el);\\n\\tconst [er2, cr] = grow(ir, er);\\n\\treturn cl <= cr ? [[\\n\\t\\tn,\\n\\t\\tel2,\\n\\t\\ter\\n\\t], cl + 1] : [[\\n\\t\\tn,\\n\\t\\tel,\\n\\t\\ter2\\n\\t], cr + 1];\\n}\\n/** fork = SPAWN — split the id, both halves inherit the shared event (parent → child). */\\nfunction itcFork(s) {\\n\\tconst [i1, i2] = splitId(s.id);\\n\\treturn [{\\n\\t\\tid: i1,\\n\\t\\tevent: s.event\\n\\t}, {\\n\\t\\tid: i2,\\n\\t\\tevent: s.event\\n\\t}];\\n}\\n/** event = INJECT — advance this stamp's history by one (fill if free, else grow). */\\nfunction itcEvent(s) {\\n\\tconst filled = fill(s.id, s.event);\\n\\tif (!eventEqual(filled, s.event)) return {\\n\\t\\tid: s.id,\\n\\t\\tevent: filled\\n\\t};\\n\\tconst [grown] = grow(s.id, s.event);\\n\\treturn {\\n\\t\\tid: s.id,\\n\\t\\tevent: grown\\n\\t};\\n}\\n/** join = HANDBACK — sum the ids, max-join the histories (the merge). */\\nfunction itcJoin(a, b) {\\n\\treturn {\\n\\t\\tid: normId(sumId(a.id, b.id)),\\n\\t\\tevent: joinEvent(a.event, b.event)\\n\\t};\\n}\\n/**\\n* The concurrent-capable causal verdict. Two stamps sharing no merge-ancestry —\\n* neither's history ≤ the other's — read \\\"concurrent\\\" (the lightcone \\\"elsewhere\\\").\\n*/\\nfunction itcCompare(a, b) {\\n\\tconst ab = leqEvent(a.event, b.event);\\n\\tconst ba = leqEvent(b.event, a.event);\\n\\tif (ab && ba) return \\\"equal\\\";\\n\\tif (ab) return \\\"before\\\";\\n\\tif (ba) return \\\"after\\\";\\n\\treturn \\\"concurrent\\\";\\n}\\n//#endregion\\n//#region ../lararium-mesh/src/worldline-causal.ts\\n/**\\n* worldline-causal — the worldline's CAUSAL partial-order, an in-memory ITC registry keyed on\\n* (handle × FRONTIER). SEPARATE from the rhythmic clocks (worldline-clock.ts) by the PATH-B cut:\\n* causal rides ITC / the edge-DAG, the FfzClock stays purely rhythmic.\\n*\\n* Happened-before projects from the spawn/inject/handback structure, so the order is\\n* concurrent-capable: siblings of one spawn with no join between them read \\\"concurrent\\\"\\n* (agent-worldline #time, #attribution). Keyed turn-DAG (the operator's C-cut) — handles\\n* survive rewind/fork because the turn-DAG node does.\\n*\\n* ## The (handle, frontier) address (slice-3)\\n*\\n* The registry key is `${handle}@${frontier}` — address = handle × FRONTIER, the frontier keyed\\n* BY the handle, never smuggled INSIDE it. The handle stays a RIGID designator (baptized-fixed at\\n* spawn); the frontier is the MOVING antichain — a short hash of the ITC event heads (the causal\\n* history), so it advances on every inject/handback and holds across a bare fork. This fixes the\\n* same-session-fork collision: two spawns of one child handle across a rewind carry DIFFERENT\\n* re-projected histories → different frontiers → distinct keys, so `worldlineSpawn` no longer\\n* throws when a handle re-appears on a rewound-then-re-forked branch. The frontier is DERIVED from\\n* the stamp — never authoritative state, so the composite key holds only because causal-order rides\\n* a re-derivable projection (else the global-now sneaks back in).\\n*\\n* NOTE — the edge-DAG home LANDED (slice-2): the same spawn/inject/handback persist as\\n* mempalace-KG triples (prov:Delegation + prov:Communication via kg_add / `kg_io.py`), and\\n* kapae (rewind) closes them via kg_invalidate (valid_to set, never deleted). This in-memory\\n* ITC registry stays the live causal READ; the persisted edge-DAG is the durable home, and the\\n* ITC verdict re-projects from those triples via worldline-trajectory's worldlineCausalFromEdges.\\n*\\n* Meme: lar:///ha.ka.ba/lararium/api/agent-worldline#/time\\n*/\\n/** The shore a frontier is appended on — the handle stays rigid, the frontier rides after this mark. */\\nvar FRONTIER_SEP = \\\"@\\\";\\n/**\\n* FNV-1a/32 → 8 hex — a short, stable, dependency-free fingerprint (twin of build-patch's fnv1a8,\\n* inlined here so this module — and the pure `@lararium/mesh/worldline` VM subpath it feeds — pulls\\n* in NOTHING heavier). NOT cryptographic; it only DISTINGUISHES frontiers deterministically.\\n*/\\nfunction fnv1a8(s) {\\n\\tlet h = 2166136261;\\n\\tfor (let i = 0; i < s.length; i++) {\\n\\t\\th ^= s.charCodeAt(i);\\n\\t\\th = Math.imul(h, 16777619) >>> 0;\\n\\t}\\n\\treturn h.toString(16).padStart(8, \\\"0\\\");\\n}\\n/**\\n* The stamp's CAUSAL FRONTIER fingerprint — a short, stable hash of its ITC event heads (the causal\\n* history). The MOVING antichain: it advances on every inject/handback and holds across a bare fork\\n* (which leaves the event unchanged). Two spawns of one handle across a rewind carry different\\n* re-projected histories → different frontiers. Derived, never authoritative (the guard).\\n*/\\nfunction frontierOf(stamp) {\\n\\treturn fnv1a8(canonEvent(stamp.event));\\n}\\n/** Canonical string of an ITC event tree — a deterministic fold (arrays + numbers only, JSON-safe). */\\nfunction canonEvent(e) {\\n\\treturn typeof e === \\\"number\\\" ? String(e) : `[${e[0]},${canonEvent(e[1])},${canonEvent(e[2])}]`;\\n}\\n/**\\n* The composite registry key: address = handle × frontier. Keyed BY the handle (rigid, baptized-\\n* fixed), the frontier riding as a suffix over the value's moving history — NOT inside the handle.\\n*/\\nfunction stampKey(handle, stamp) {\\n\\treturn `${handle}${FRONTIER_SEP}${frontierOf(stamp)}`;\\n}\\n/**\\n* Split a composite key back into its rigid handle (everything before the LAST `@`). A lineage-path\\n* handle carries no `@` of its own (dotted form: `run.child`); the frontier suffix always does, so the\\n* LAST `@` is the shore. A key with no `@` reads as a bare handle (defensive).\\n*/\\nfunction handleFromKey(key) {\\n\\tconst at = key.lastIndexOf(FRONTIER_SEP);\\n\\treturn at < 0 ? key : key.slice(0, at);\\n}\\n/**\\n* Resolve a reference — an EXACT composite key if one is present, else a bare HANDLE → its (latest)\\n* live entry (the last-inserted `${handle}@…`, the current frontier of that handle). Returns undefined\\n* when neither hits. Insertion order = event order, so \\\"latest\\\" reads the handle's most-advanced\\n* frontier — the one an inject/handback/compare means by a bare handle.\\n*/\\nfunction resolveRef(c, ref) {\\n\\tconst exact = c.stamps[ref];\\n\\tif (exact) return {\\n\\t\\tkey: ref,\\n\\t\\tstamp: exact\\n\\t};\\n\\tconst prefix = ref + FRONTIER_SEP;\\n\\tlet found;\\n\\tfor (const key of Object.keys(c.stamps)) if (key.startsWith(prefix)) found = {\\n\\t\\tkey,\\n\\t\\tstamp: c.stamps[key]\\n\\t};\\n\\treturn found;\\n}\\n/** Set a stamp under its composite