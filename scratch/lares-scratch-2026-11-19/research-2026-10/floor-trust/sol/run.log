    90	    return first
    91	      ? { ok: false, reason: first.reason, ...(first.detail ? { detail: first.detail } : {}), refused: standing.refused }
    92	      : { ok: false, reason: "no-release", refused: standing.refused };
    93	  }
    94	  const floor = await resolveFloor(standing.head.body.manifest, manifestBytesOf);
    95	  if ("refusal" in floor) return { ok: false, reason: floor.refusal, detail: floor.reason, refused: standing.refused };
    96	  return { ok: true, nexus: args.nexus, head: standing.head, manifest: floor.manifest, lares: floor.lares, lararium: floor.lararium, refused: standing.refused };
    97	}

