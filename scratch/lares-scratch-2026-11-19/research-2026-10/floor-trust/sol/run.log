    80	  const refresh = async (): Promise<void> => {
    81	    for (const r of await deps.readings()) {
    82	      const url = carriageDocUrl(r.island) as AutomergeUrl;
    83	      const board = await deps.openBoard(url);
    84	      const ancestry = carriageAncestryFromBoard(r.sealLineage, board);
    85	      const carriers = await foldCarrierSet(r.denyBoard, r.roster, ancestry);
    86	      if (deps.placeClass === "herm" && r.via === "carrier-seal" && carriers.has(placeKey) && deps.ownFloorPin && deps.layStatement) {
    87	        const pin = await deps.ownFloorPin(r.aid);
    88	        if (pin !== null) await deps.layStatement(url, await signPlaceFloorPin({ placeKey, pin, sign: deps.sign }));
    89	      }
    90	      const nexusHex = Buffer.from(r.aid, "utf8").toString("hex");
    91	      const statements = placeFloorPinsFromBoard(board);
    92	      // WHICH READING READ WHICH BOARD: the reading's way in, its board, the carriers its own replica counts and the
    93	      // places whose statements that board holds, so a refused pin names the relation it missed.
    94	      const named = (keys: Iterable<string>): string => [...keys].map((k) => k.slice(0, 8)).sort().join(",") || "none";
    95	      const stated = statements.map((s) => (typeof s === "object" && s !== null && typeof (s as { placeKey?: unknown }).placeKey === "string" ? (s as { placeKey: string }).placeKey : "?"));
    96	      const acts = [...r.denyBoard].filter((e) => e.action === "carry" || e.action === "uncarry")
    97	        .map((e) => `${e.action}:${e.nym.slice(0, 8)}@${e.sealEpochCid.slice(-8)}`).sort().join(",") || "none";
    98	      const { filed, refused } = filePlaceFloorPins(deps.pins, statements, { nexusHex, route: FLOW_SOCKET_ROUTE, carriers });
    99	      if (refused.length > 0 && deps.onLog) {
   100	        const folded = await foldCarriageDetails(r.denyBoard, r.roster, ancestry);
   101	        const reasons = folded.entries.filter((e) => (e.action === "carry" || e.action === "uncarry") && stated.includes(e.nym))
   102	          .map((e) => `${e.action}:${e.nym.slice(0, 8)}=${e.reason}`).join(",") || "no matching carry act";
   103	        deps.onLog(`${r.aid}: refresh ${deps.placeClass} via=${r.via} board=${url} head=${r.roster.sealEpochCid.slice(-8)} lineage=${String(r.sealLineage.length)} acts=[${acts}] carriers=[${named(carriers)}] statements=[${named(stated)}] fold=[${reasons}]`);
   104	      }
   105	      if (refused.length > 0) deps.onLog?.(`${r.aid.slice(0, 18)}…: ${refused.length} place floor pin(s) refused (${[...new Set(refused)].join(", ")})`);
   106	      if (filed.length > 0) deps.onLog?.(`${r.aid.slice(0, 18)}…: ${filed.length} place floor pin(s) read`);
   107	    }
   108	  };
   109	  return gateNativeCarriagePull<T>({
   110	    pins: deps.pins,
   111	    nexuses: async () => {
   112	      const own = deps.placeClass === "herm" ? null : deps.ownNexus();
   113	      return [...new Set([...(own ? [own] : []), ...(await standing()).map((r) => r.aid)])];
   114	    },
   115	    refresh,
   116	    presentationFor: async (nexus, pin) => {
   117	      const aid = nexus.trim().toLowerCase();
   118	      const reading = (await standing()).find((r) => r.aid.toLowerCase() === aid);
   119	      const arm = reading ? await placeArmFor(reading.denyBoard, reading.roster, placeKey,
   120	        carriageAncestryFromBoard(reading.sealLineage, await deps.openBoard(carriageDocUrl(reading.island) as AutomergeUrl))) : null;
   121	      if (reading && arm !== null) {
   122	        return { kind: "place", placeKey, sign: deps.sign, arm };
   123	      }
   124	      // A place presents its contract or nothing: it wears no face.
   125	      if (deps.placeClass === "herm" || !deps.facePresentation) return null;
   126	      return deps.facePresentation(pin);
   127	    },
   128	    audience: deps.audience,
   129	    deadlines: deps.deadlines,
   130	    ...(deps.dialSocket ? { dialSocket: deps.dialSocket } : {}),
   131	    ...(deps.onLog ? { onLog: deps.onLog } : {}),
   132	  });
   133	}

