   601	/** What one step of a two-vault roll anchor answers: the partial as it stands, the judge's verdict over it here, and the anchor it landed. */
   602	export interface NexusRollAnchorPartialResult {
   603	  readonly partial: NexusActPartial;
   604	  readonly verdict: PartialVerdict;
   605	  /** The seats of the head (opened) roster whose signature the partial carries, sorted. */
   606	  readonly signed:  readonly string[];
   607	  /** The landed anchor, once the partial read `complete` here and counted; null short of the threshold. */
   608	  readonly landed:  NexusRollAnchorResult | null;
   609	}
   610	
   611	/**
   612	 * The two rosters a rolled head joins, read off this vessel's OWN verified lineage, never off a file: the head opens,
   613	 * the epoch before it closes. FAIL CLOSED: an unseated head, or a head that rolled from nothing (a genesis), names
   614	 * no anchor.
   615	 */
   616	function rolledRostersOrRefuse(home: string): { readonly opened: KahuQuorumSeats; readonly closing: KahuQuorumSeats } {
   617	  const doc = readNexusDoc(home);
   618	  const opened = foundingRoster(doc);
   619	  if (opened.sealEpochCid.length === 0 || opened.keys.length < opened.threshold) {
   620	    throw new NexusContractError("no seated head to anchor a roll under — the charter's lineage roots no roster here.");
   621	  }
   622	  const lineage = doc!.sealLineage!;
   623	  const head = lineage[lineage.length - 1]!;
   624	  // The head names what it closed: one predecessor, looked up by its address, never by its place in the array.
   625	  if (head.predecessors.length === 0) throw new NexusContractError("the head closes no epoch (a genesis), so no roll anchor joins it to one.");
   626	  if (head.predecessors.length !== 1) throw new NexusContractError("the head joins two branches (a reunion), and no two-vault anchor joins a reunion yet.");
   627	  const prev = lineage.find((e) => e.epochCid === head.predecessors[0]) ?? null;
   628	  const seats = prev ? epochSeats(prev) : null;
   629	  if (!prev || !seats) throw new NexusContractError("the epoch the head closed reads no seats in this vessel's lineage, so no anchor joins it.");
   630	  return { opened, closing: { keys: [...seats.keys], threshold: seats.threshold, sealEpochCid: prev.epochCid } };
   631	}
   632	
   633	/**
   634	 * The carriage board a roll anchor rides. The board keys on the charter's genesis island — a rotating vessel holds a
   635	 * charter, and a charter outranks every lower rung of the gradient. The vessel key rides in only as that gradient's
   636	 * floor, so a seal home whose vessel holds no key of its own still anchors on its charter's board.
   637	 */
   638	async function rollAnchorBoardFor(repo: Repo, sealHome: string): Promise<Pick<ContractCore, "boardUrl" | "handle">> {
   639	  const ownVesselKey = await loadVesselVerifyingKey().catch(() => "");
   640	  const boardIsland  = nodeNexusIsland({ ownVesselKey, sealHome });
   641	  const boardUrl     = carriageDocUrl(boardIsland);
   642	  return { boardUrl, handle: await materializeSharedLarDoc(repo, boardUrl, "board:carriage-contracts") };
   643	}
   644	
   645	/** What the roll's open reads of the head's own roll: no prior roll (a genesis), no anchor owed, or the counted anchor that stands. */
   646	export interface NexusRollPriorAnchor {
   647	  readonly state:      "no-prior-roll" | "nothing-to-anchor" | "anchored";
   648	  /** The counted anchor that joins the head to the epoch it closed, once one stands. */
   649	  readonly anchorCid?: string;
   650	}
   651	
   652	/**
   653	 * A ROLL WAITS ON ITS PRIOR ANCHOR (operator ruling 2026-10-15; roadmap `#/rulings`). A seal roll refuses by name
   654	 * while the head's own roll stands with no counted anchor on this vessel's carriage board: an admit carries across a
   655	 * roll only through its roll anchors, and a roll laid over an anchorless one strands every admit between them. The
   656	 * roll's open (`lares nexus seal rotate`, `seal roll open`) asks here before any card reads or any seat signs, and the
   657	 * custody door's two roll opens (`seat.arm-roll`, `roll-circle.open`) ask again against the store their door lends.
   658	 *
   659	 * A genesis closes no roll, so the first roll opens. A head that closed an epoch reading no seats, or a reunion
   660	 * head joining two branches, carries no anchor this door can ask for, so neither waits. The single-vault rotate
   661	 * anchors inside itself and so leaves a counted anchor for the next open to find.
   662	 */
   663	export async function runNexusRollPriorAnchorCheck(opts: { readonly sealHome: string; readonly repo: Repo; readonly aid?: string }):
   664	  Promise<NexusRollPriorAnchor> {
   665	  const home = charterHomeOrRefuse(opts.sealHome, opts.aid);
   666	  const doc = readNexusDoc(home);
   667	  const lineage = doc?.sealLineage ?? [];
   668	  const head = lineage[lineage.length - 1];
   669	  if (!head || head.predecessors.length === 0) return { state: "no-prior-roll" };
   670	  const opened = foundingRoster(doc);
   671	  const closed = head.predecessors.length === 1 ? lineage.find((e) => e.epochCid === head.predecessors[0]) : undefined;
   672	  if (!closed || !epochSeats(closed) || opened.sealEpochCid.length === 0 || opened.keys.length < opened.threshold) return { state: "nothing-to-anchor" };
   673	  try {
   674	    const { handle } = await rollAnchorBoardFor(opts.repo, home);
   675	    for (const a of rollAnchorsFromBoard(handle.doc())) {
   676	      if (a.prevEpochCid === closed.epochCid && a.sealEpochCid === opened.sealEpochCid && await rollAnchorCounts(a, opened)) {
   677	        return { state: "anchored", anchorCid: rollAnchorCid(a) };
   678	      }
   679	    }
   680	  } finally {
   681	    await opts.repo.flush().catch(() => { /* best-effort final flush */ });
   682	  }
   683	  throw new NexusContractError(
   684	    "roll REFUSED (prior-roll-unanchored): the head's own roll stands with no counted anchor on this board, so a roll laid " +
   685	    "over it would strand every admit between them. Land the head's anchor first (`lares nexus seal anchor`), then roll.");
   686	}
