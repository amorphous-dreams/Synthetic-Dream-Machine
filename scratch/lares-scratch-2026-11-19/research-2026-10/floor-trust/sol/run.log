     3	 *
     4	 * The browser holds the Nexus AID on its own trust line (the hearth floor card the arrival URL carried, or the admit that made
     5	 * it a member) and nothing else. It fetches `GET <hearth>/floor/<AID>` (the release rows the board carries, each with the
     6	 * charter's epoch lineage) and the head's blobs by CID from `<hearth>/cas/<cid>`, and `readFloorAnswer` refuses at each
     7	 * step before the floor is used: the genesis epoch must re-derive the AID, each epoch step must verify, each release must
     8	 * seal as a seat of ITS epoch and carry the cabal's approval over the manifest's exact bytes, and every fetched blob must hash
     9	 * to the CID it was fetched by.
    10	 *
    11	 * It records NO acceptance. The browser's running floor stays the genesis floor it booted on; a face accepts a release by a
    12	 * person's own act (W26 slice 5, the face's D row), on top of this read.
    13	 *
    14	 * WHAT STAYS OPEN. The AID itself rides the same-origin trust line, and nothing here proves the card's freshness: the signed
    15	 * floor card (`W14`), the pin's causal position (`W15`) and the carry-floor convergence (`W16`) stay owed.
    16	 *
    17	 * Meme: lar:///ha.ka.ba/lares/docs/pono/w26-floor-lane#/the-slices
    18	 */
    19	import { NEXUS_AID_PATTERN, nexusAidOfPin, readFloorAnswer, type FloorRead } from "@lararium/mesh";
    20	
    21	export type HearthFloorRead =
    22	  | FloorRead
    23	  | { readonly ok: false; readonly reason: "no-nexus" | "porch-silent"; readonly detail?: string; readonly refused: readonly [] };
    24	
    25	/** The Nexus AID a pin-spelled Nexus (hex of the AID's UTF-8) names, or null where it reads as no AID. */
    26	export function floorNexusOf(pinNexus: string | null | undefined): string | null {
    27	  if (!pinNexus) return null;
    28	  const aid = nexusAidOfPin({ nexus: pinNexus });
    29	  return aid !== null && NEXUS_AID_PATTERN.test(aid) ? aid : null;
    30	}
    31	
    32	/** The http(s) origin a hearth answers its porch on, from the URL a page or a relay names it by (`ws(s)` reads as `http(s)`). */
    33	export function porchOriginOf(url: string): string | null {
    34	  try {
    35	    const u = new URL(url);
    36	    if (u.protocol === "https:" || u.protocol === "wss:") return `https://${u.host}`;
    37	    if (u.protocol === "http:" || u.protocol === "ws:") return `http://${u.host}`;
    38	    return null;
    39	  } catch { return null; }
    40	}
    41	
    42	/** Read the floor off the porch at `baseUrl`, under the Nexus the page holds (`nexusPin`, pin-spelled). Never throws. */
    43	export async function readHearthFloor(args: {
    44	  readonly baseUrl:   string;
    45	  readonly nexusPin:  string | null | undefined;
    46	  readonly fetchFn?:  typeof fetch;
    47	}): Promise<HearthFloorRead> {
    48	  const nexus = floorNexusOf(args.nexusPin);
    49	  const origin = porchOriginOf(args.baseUrl);
    50	  if (nexus === null || origin === null) {
    51	    return { ok: false, reason: "no-nexus", detail: "no Nexus AID is known for this hearth: the URL carries no floor card, and no face joined here names one", refused: [] };
    52	  }
    53	  const doFetch = args.fetchFn ?? globalThis.fetch.bind(globalThis);
    54	  let answer: unknown;
    55	  try {
    56	    const res = await doFetch(`${origin}/floor/${nexus}`);
    57	    if (!res.ok) return { ok: false, reason: "porch-silent", detail: `the porch answered ${res.status}`, refused: [] };
    58	    answer = await res.json();
    59	  } catch (err) {
    60	    return { ok: false, reason: "porch-silent", detail: err instanceof Error ? err.message : String(err), refused: [] };
    61	  }
    62	  return readFloorAnswer({
    63	    nexus, answer,
    64	    fetchCas: async (cid) => {
    65	      const res = await doFetch(`${origin}/cas/${cid}`);
    66	      return res.ok ? new Uint8Array(await res.arrayBuffer()) : null;
    67	    },
    68	  });
    69	}

