   168	/** The membership door's sub-quorum refusal — it names the act a short quorum would have minted. */
   169	const subQuorum = (held: number, k: number): NexusContractError => new NexusContractError(
   170	  `sub-quorum REFUSED (fail-closed): the vessel holds ${held} seat key(s) of the seated roster, but a valid membership act carries ${k} distinct founding-kahu signatures. ` +
   171	  `Where the other seats rest in another vault, the act crosses as a partial: \`lares nexus contract <nym> --nexus <aid> --out <file>\` here, then \`--from <file>\` there.`,
   172	);
