   543	/** What a landed roll anchor reports: the anchor, its act CID, the heads it cites, and the board it rides. */
   544	export interface NexusRollAnchorResult {
   545	  readonly anchor:    RollAnchor;
   546	  readonly anchorCid: string;
   547	  readonly parents:   readonly string[];
   548	  readonly boardUrl:  string;
   549	}
