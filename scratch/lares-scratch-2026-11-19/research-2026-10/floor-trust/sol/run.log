    62	/** Read the Nexus's floor off a porch answer, verifying every step; `fetchCas` fetches bytes by CID (the reader re-hashes). */
    63	export async function readFloorAnswer(args: {
    64	  readonly nexus:    string;
    65	  readonly answer:   unknown;
    66	  readonly fetchCas: (cid: string) => Promise<Uint8Array | null>;
    67	}): Promise<FloorRead> {
    68	  const none: readonly FloorReleaseRefused[] = [];
    69	  const a = args.answer as Partial<FloorAnswer> | null;
    70	  if (a === null || typeof a !== "object" || a.format !== FLOOR_ANSWER_FORMAT || typeof a.nexus !== "string" || !Array.isArray(a.releases)) {
    71	    return { ok: false, reason: "answer-malformed", refused: none };
    72	  }
    73	  if (a.nexus !== args.nexus) return { ok: false, reason: "foreign-nexus", refused: none };
    74	  const rows: Array<{ keyCid: string; record: unknown }> = [];
    75	  for (const row of a.releases) {
    76	    if (row === null || typeof row !== "object") return { ok: false, reason: "answer-malformed", refused: none };
    77	    const r = row as { keyCid?: unknown; record?: unknown };
    78	    if (typeof r.keyCid !== "string" || !HEX64.test(r.keyCid)) return { ok: false, reason: "answer-malformed", refused: none };
