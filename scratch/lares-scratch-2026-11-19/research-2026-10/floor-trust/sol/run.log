   208	/**
   209	 * Obtain a PLACE's carrier seal for a `carry`. ONE path, and deliberately only one: the token the place
   210	 * signed with its own vessel key, handed over out of band.
   211	 *
   212	 * NO SELF-SIGN ARM, AND THAT IS THE POINT. The admit path above may self-sign because the vessel may hold
   213	 * the admitted operator's persona seed (the multitude-of-one). A place's seed is its VESSEL identity, which
   214	 * lives on the place's own device and nowhere else — there is nothing here to reach for, and a path that
   215	 * reached would be a founder minting a crossroads' identity for it. So: supplied, or REFUSE.
   216	 */
   217	async function resolveCarrierIn(
   218	  opts: NexusContractOptions, nym: string, sealEpochCid: string,
   219	): Promise<QuorumSignature> {
   220	  const sig = opts.carrierSig?.trim().toLowerCase() ?? "";
   221	  if (!sig) {
   222	    throw new NexusContractError(
   223	      "carry REFUSED (fail-closed): no carrier seal. The place must sign 'I carry for this Nexus' with its OWN " +
   224	      "vessel key (`lares nexus carry-for` on that vessel) and supply the token via --carrier. A Nexus never " +
   225	      "conscripts a crossroads, and it never mints one's identity for it.",
   226	    );
   227	  }
   228	  // Never write an entry the fold would ignore — prove the seal against the epoch BEFORE any board write.
   229	  if (!(await verifyCarrierContract({ nym, sealEpochCid, sig }))) {
   230	    throw new NexusContractError(
   231	      "carry REFUSED (fail-closed): the carrier seal does not verify over this charter epoch under the named " +
   232	      "vessel key. A seal minted for another epoch, or by another hand, grants nothing.",
   233	    );
   234	  }
   235	  return { signer: nym, sig };
   236	}
