   153	  if (roster.sealEpochCid.length === 0 || roster.keys.length < roster.threshold) {
   154	    throw new NexusContractError(
   155	      "no seated founding-kahu quorum to root an admit on — run `lares nexus seal seat` first (the carriage-contracts board stays inert until a quorum stands).",
   156	    );
   157	  }
   158	  return roster;
   159	}
