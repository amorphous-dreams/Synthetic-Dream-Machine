    68	/** Lay a herm's statement onto a board handle's doc, once, and again only when it moved. */
    69	export function layStatementOn(handle: { doc(): LarDoc | undefined; change(fn: (d: LarDoc) => void): void }, statement: PlaceFloorPinStatement): boolean {
    70	  const standing = tiddlerText(handle.doc()?.tiddlers?.[placeFloorPinKey(statement.placeKey)]);
    71	  if (standing === JSON.stringify(statement)) return false;
    72	  handle.change((d) => { writePlaceFloorPin(d, statement); });
