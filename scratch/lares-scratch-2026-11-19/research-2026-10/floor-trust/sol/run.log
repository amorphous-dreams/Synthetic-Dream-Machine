   790	// ── the realm edge anchors across two vaults (kapae#/rolls) ───────────────────────────────────────────────
   791	
   792	/** What one realm's step of a two-vault edge roll anchor answers: the partial as it stands, the judge's verdict over it
   793	 *  here, and the anchor it landed on the realm's edge board. */
   794	export interface NexusEdgeRollAnchorPartialResult {
   795	  readonly realm:   string;
   796	  readonly partial: NexusActPartial;
   797	  readonly verdict: PartialVerdict;
   798	  /** The seats of the head (opened) roster whose signature the partial carries, sorted. */
   799	  readonly signed:  readonly string[];
   800	  readonly landed:  { readonly anchor: EdgeRollAnchor; readonly anchorCid: string; readonly parents: readonly string[]; readonly boardUrl: string } | null;
   801	}
   802	
   803	/** Where one realm's anchor stands on this vessel: landed on its edge board, or owed. */
   804	export interface NexusEdgeRollAnchorStanding {
   805	  readonly realm:      string;
   806	  readonly state:      "anchored" | "owed";
   807	  readonly anchorCid?: string;
   808	}
   809	
   810	/** One realm's edge board as a roll's reader holds it: the replica, the ledger, the board counted under the CLOSED charter. */
   811	interface EdgeRollView {
   812	  readonly handle:  Awaited<ReturnType<typeof materializeSharedLarDoc>>;
   813	  readonly ledger:  Awaited<ReturnType<typeof materializeSharedLarDoc>>;
   814	  readonly counted: CountedEdgeBoard;
   815	  readonly anchors: readonly EdgeRollAnchor[];
   816	}
   817	
   818	/** The worn face's atom key names that face's own edge ledger (no board address); empty where the face holds none. */
   819	const edgeLedgerKey = (): Promise<string> => loadWornFaceAtomKey().catch(() => "");
   820	
   821	async function edgeVesselKeyOrRefuse(): Promise<string> {
   822	  const key = await edgeLedgerKey();
   823	  if (!key) throw new NexusContractError("this vessel surfaces no verifying key — it keeps no ledger to read an edge board against.");
   824	  return key;
   825	}
   826	
   827	/**
   828	 * Read one realm's edge board where the roll stands: the board counts under the charter as it stood BEFORE the head's
   829	 * roll (the lineage less its head), so the quorum acts of the closed epoch stand as the anchor's parents. The read
   830	 * writes nothing: a vessel that first meets an act after its epoch rolled earns no seen-at-head mark from it.
   831	 */
   832	async function edgeBoardAtClosing(repo: Repo, home: string, vesselKey: string, realm: string, closing: KahuQuorumSeats): Promise<EdgeRollView> {
   833	  const handle = await materializeSharedLarDoc(repo, realmEdgeBoardDocUrl(realm), "board:edge-kapae");
   834	  const ledger = await materializeSharedLarDoc(repo, edgeLedgerDocUrl(vesselKey), "ledger:edge");
   835	  const kept = keptFromLedger(ledger.doc(), realm);
