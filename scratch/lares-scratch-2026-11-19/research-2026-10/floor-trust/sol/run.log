   238	/**
   239	 * Mint THIS vessel's own carrier seal — run by the joining PLACE, on itself. Reads the vessel verifying key
   240	 * and signs the act-independent carrier token for the charter epoch standing in its seal home; the
   241	 * founding kahu supply the token to `runNexusContract({ action: "carry", carrierSig })`.
   242	 *
   243	 * IT TOUCHES NO PERSONA. A Herm holds none by law, and this is the whole door that fact required.
   244	 */
   245	export async function runNexusCarryFor(opts: {
   246	  sealHome: string;
   247	  /** The floor key door the place's floor pin derives from; absent → this vessel's own (`vesselFloorKeyDoor`). */
   248	  floorDoor?: FloorKeyDoor;
   249	  /** The Nexus to sign at: the carried charter this AID names (`charterHomeFor`, as `carry` reads it). Absent → the primary charter's. */
   250	  aid?: string;
   251	}): Promise<{ nym: string; sealEpochCid: string; carrierSig: string; floorPin: PlaceFloorPinStatement | null }> {
   252	  const home = charterHomeOrRefuse(opts.sealHome, opts.aid);
   253	  const roster = foundingRoster(readNexusDoc(home));
   254	  if (roster.sealEpochCid.length === 0) {
   255	    throw new NexusContractError("no seated charter epoch to bind carriage to — import the charter (`lares nexus seal import`) first.");
   256	  }
   257	  const nym  = (await loadVesselVerifyingKey()).toLowerCase();
   258	  const seed = await loadVesselSigningSeed();
   259	  const sig  = await signCarrierContract(nym, roster.sealEpochCid, ed25519SignerFromSeed(seed));
   260	  // THE PLACE'S FLOOR PIN AT THIS NEXUS, signed with the same vessel key the carry will name (`place-floor-pin`). It
   261	  // authenticates nothing on its own: a reader files it only once its own replica counts the carry.
   262	  const aid = primaryNexusAid(home);
   263	  let floorPin: PlaceFloorPinStatement | null = null;
   264	  if (aid) {
   265	    const pin = flowFloorPinAt(aid, opts.floorDoor ?? await vesselFloorKeyDoor());
   266	    const signer = ed25519SignerFromSeed(seed);
   267	    floorPin = await signPlaceFloorPin({ placeKey: nym, pin, sign: async (image) => hexToBytes(await signer(image)) });
   268	  }
   269	  return { nym, sealEpochCid: roster.sealEpochCid, carrierSig: sig.sig, floorPin };
   270	}
