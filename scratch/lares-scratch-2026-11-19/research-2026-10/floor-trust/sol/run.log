   688	/** The reader one vessel judges a roll-anchor partial with: the head it holds, the epoch that head closed, and its board. */
   689	function anchorReader(home: string, handle: ContractCore["handle"]): NexusPartialReader {
   690	  const aid = nexusAidOrRefuse(home);
   691	  const { opened, closing } = rolledRostersOrRefuse(home);
   692	  const doc = handle.doc();
   693	  return { aid, head: opened, closing, board: { carriage: carriageEntriesFromBoard(doc), anchors: rollAnchorsFromBoard(doc), antigen: [] } };
   694	}
   695	
   696	/**
   697	 * OPEN a two-vault roll anchor (kapae#/rolls): the head this vessel holds has already rolled, and every seat of that
   698	 * head's roster this vessel holds signs the anchor that joins it to the epoch it closed, citing the board's causal
   699	 * heads there. The act leaves as a PARTIAL for the vault that holds the other new seats; nothing lands here. Where
   700	 * the seats rest in two vaults no rotate signs its anchor whole, so the anchor follows the rolled head rather than
   701	 * preceding it: an admit made at the closed epoch reads stranger at the new head until the anchor lands. The door
   702	 * anchors the head to the ONE epoch it closed, so a second roll before this anchor lands would leave the first roll
   703	 * unanchored for good: the next roll's open refuses by name until this anchor lands (`runNexusRollPriorAnchorCheck`).
   704	 * It anchors the carriage board alone; the realm edge boards the single-vault rotate also anchors (`runEdgeRollAnchors`)
   705	 * cross as their own partials, one for each realm (`runEdgeRollAnchorOpen` / `runEdgeRollAnchorPartial`). A vessel
   706	 * that holds the whole new quorum anchors through `runNexusRollAnchor`, inside its rotate.
   707	 */
   708	export async function runNexusRollAnchorOpen(opts: { readonly sealHome: string; readonly repo: Repo; readonly aid?: string }):
   709	  Promise<NexusRollAnchorPartialResult> {
   710	  const home = charterHomeOrRefuse(opts.sealHome, opts.aid);
   711	  const { opened, closing } = rolledRostersOrRefuse(home);
   712	  const held = heldSeatSigners(opened);
   713	  if (held.length === 0) throw new NexusContractError("this vessel holds no seat of the head roster, so it opens no anchor for it.");
   714	  if (held.length >= opened.threshold) {
   715	    throw new NexusContractError("this vessel holds the whole new quorum: the anchor lands here whole, inside the rotate, and no partial crosses.");
   716	  }
   717	  const repo = opts.repo;
   718	  try {
   719	    const { handle } = await carriageBoardFor(repo, home);
   720	    // No seat signs an anchor this board already holds for the same roll: a counted anchor from the closed epoch
   721	    // to the head refuses here, before any custody opens.
   722	    for (const a of rollAnchorsFromBoard(handle.doc())) {
   723	      if (a.prevEpochCid === closing.sealEpochCid && a.sealEpochCid === opened.sealEpochCid && await rollAnchorCounts(a, opened)) {
   724	        throw new NexusContractError("this board already holds a counted anchor for this roll; nothing signs.");
   725	      }
   726	    }
   727	    const parents = await rollAnchorParents(carriageEntriesFromBoard(handle.doc()), rollAnchorsFromBoard(handle.doc()), closing);
   728	    const anchor = await signRollAnchor({
   729	      prevEpochCid: closing.sealEpochCid, sealEpochCid: opened.sealEpochCid, prevKeys: closing.keys, prevThreshold: closing.threshold, parents,
   730	    }, held.map((s) => ({ signer: s.verifyingKey, sign: s.sign })));
   731	    const aid = nexusAidOrRefuse(home);
   732	    const partial = nexusActPartial(aid, { family: "roll-anchor", anchor });
   733	    const judged = await judgeNexusActPartial(partial, anchorReader(home, handle));
   734	    if (judged.verdict !== "ready") throw new NexusContractError(`the partial this vessel signed reads ${judged.verdict} here${judged.why ? `: ${judged.why}` : ""}; nothing crosses.`);
   735	    return { partial, verdict: judged.verdict, signed: judged.signed, landed: null };
   736	  } finally {
   737	    await repo.flush().catch(() => { /* best-effort final flush */ });
   738	  }
   739	}
   740	
   741	/**
   742	 * Take a roll-anchor partial another vault opened or cosigned. The judge reads it against this vessel's own rolled
   743	 * head, the epoch that head closed and its own board BEFORE any signature: `ready` takes the signature of every seat
   744	 * of the head this vessel holds that has not signed; `complete` lands the anchor once a fresh judgement against the
   745	 * head and the board as they stand at the write still reads `complete`. Any other verdict refuses by name, and
   746	 * nothing signs or lands.
   747	 */
   748	export async function runNexusRollAnchorPartial(opts: { readonly partial: unknown; readonly sealHome: string; readonly repo: Repo }):
   749	  Promise<NexusRollAnchorPartialResult> {
   750	  const read = readNexusActPartial(opts.partial);
   751	  if (!read || read.act.family !== "roll-anchor") throw new NexusContractError("the file reads as no roll-anchor partial");
   752	  const home = charterHomeOrRefuse(opts.sealHome, read.aid);
   753	  const { opened } = rolledRostersOrRefuse(home);
   754	  const repo = opts.repo;
   755	  try {
   756	    const { boardUrl, handle } = await carriageBoardFor(repo, home);
   757	    let partial: NexusActPartial = read;
   758	    let judged = await judgeNexusActPartial(partial, anchorReader(home, handle));
   759	    if (judged.verdict === "ready") {
   760	      const hands = heldSeatSigners(opened, new Set(judged.signed));
   761	      if (hands.length === 0) throw new NexusContractError("the partial waits on a seat this vessel does not hold; carry it to the vault that holds one.");
   762	      try { partial = await cosignNexusActPartial(partial, anchorReader(home, handle), hands.map((h) => ({ signer: h.verifyingKey, sign: h.sign }))); }
   763	      catch (err) { if (err instanceof NexusPartialRefusal) throw new NexusContractError(`the partial refuses a cosign here: ${err.message}`); throw err; }
   764	      judged = await judgeNexusActPartial(partial, anchorReader(home, handle));
   765	    }
   766	    if (judged.verdict === "ready") return { partial, verdict: judged.verdict, signed: judged.signed, landed: null };
   767	    if (judged.verdict !== "complete") {
   768	      throw new NexusContractError(`the partial reads ${judged.verdict} on this vessel${judged.why ? `: ${judged.why}` : ""}; nothing signs or lands.`);
   769	    }
   770	    const anchor = (partial.act as Extract<NexusActPartial["act"], { family: "roll-anchor" }>).anchor;
   771	    if (!(await rollAnchorCounts(anchor, rolledRostersOrRefuse(home).opened))) {
   772	      throw new NexusContractError("refusing to write: the roll anchor does not count under the head roster (fail-closed).");
   773	    }
   774	    await judgeStillBeforeWrite({
   775	      mark: () => {
   776	        const doc = handle.doc();
   777	        return `${rolledRostersOrRefuse(home).opened.sealEpochCid}|${carriageEntriesFromBoard(doc).map(carriageEntryActCid).sort().join(",")}|${rollAnchorsFromBoard(doc).map(rollAnchorCid).sort().join(",")}`;
   778	      },
   779	      judge: () => judgeNexusActPartial(partial, anchorReader(home, handle)),
   780	      refuse: (message) => new NexusContractError(message),
   781	    });
   782	    handle.change((d) => writeRollAnchor(d, anchor));
   783	    await repo.flush();
   784	    return { partial, verdict: judged.verdict, signed: judged.signed, landed: { anchor, anchorCid: rollAnchorCid(anchor), parents: anchor.parents, boardUrl } };
   785	  } finally {
   786	    await repo.flush().catch(() => { /* best-effort final flush */ });
   787	  }
   788	}
