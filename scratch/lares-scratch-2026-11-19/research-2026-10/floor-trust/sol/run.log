   842	
   843	const anchoredAtHead = async (anchors: readonly EdgeRollAnchor[], closing: KahuQuorumSeats, opened: KahuQuorumSeats): Promise<EdgeRollAnchor | null> => {
   844	  for (const a of anchors) if (a.prevEpochCid === closing.sealEpochCid && a.sealEpochCid === opened.sealEpochCid && await edgeRollAnchorCounts(a, opened)) return a;
   845	  return null;
   846	};
   847	
   848	/**
   849	 * OPEN the realm edge anchors of a rolled head (kapae#/rolls), one PARTIAL for each realm board this vessel keeps a
   850	 * quorum act for under this Nexus. The OPENER reads each board counted at the closed epoch, cites its causal heads, and
   851	 * signs with every seat of the head roster it holds; nothing lands here. A realm whose edge board already carries a
   852	 * counted anchor for this roll takes no second one. Where this vessel keeps no quorum act for any realm, the list stands
   853	 * empty. A vessel that holds the whole new quorum anchors through `runEdgeRollAnchors`, inside its rotate.
   854	 */
   855	export async function runEdgeRollAnchorOpen(opts: { readonly sealHome: string; readonly repo: Repo; readonly aid?: string }):
   856	  Promise<readonly NexusEdgeRollAnchorPartialResult[]> {
   857	  const home = charterHomeOrRefuse(opts.sealHome, opts.aid);
   858	  const { opened, closing } = rolledRostersOrRefuse(home);
   859	  const aid = nexusAidOrRefuse(home);
   860	  const vesselKey = await edgeVesselKeyOrRefuse();
   861	  const repo = opts.repo;
   862	  const ledger = await materializeSharedLarDoc(repo, edgeLedgerDocUrl(vesselKey), "ledger:edge");
   863	  const realms = edgeRollAnchorRealms(ledger.doc(), aid);
   864	  if (realms.length === 0) return [];
   865	  const held = heldSeatSigners(opened);
   866	  if (held.length === 0) throw new NexusContractError("this vessel holds no seat of the head roster, so it opens no edge anchor for it.");
   867	  if (held.length >= opened.threshold) {
   868	    throw new NexusContractError("this vessel holds the whole new quorum: the edge anchors land here whole, inside the rotate, and no partial crosses.");
   869	  }
   870	  const out: NexusEdgeRollAnchorPartialResult[] = [];
   871	  try {
   872	    for (const realm of realms) {
   873	      const view = await edgeBoardAtClosing(repo, home, vesselKey, realm, closing);
   874	      if (await anchoredAtHead(view.anchors, closing, opened)) continue;
   875	      const anchor = await signEdgeRollAnchor({
   876	        scope: realm, prevEpochCid: closing.sealEpochCid, sealEpochCid: opened.sealEpochCid, prevKeys: closing.keys, prevThreshold: closing.threshold,
   877	        parents: edgeRollAnchorParents(view.counted, closing.sealEpochCid),
   878	      }, held.map((s) => ({ signer: s.verifyingKey, sign: s.sign })));
   879	      const partial = nexusActPartial(aid, { family: "edge-roll-anchor", anchor });
   880	      const { reader } = await edgeAnchorReader(home, repo, vesselKey, partial);
   881	      const judged = await judgeNexusActPartial(partial, reader);
   882	      if (judged.verdict !== "ready") throw new NexusContractError(`the partial this vessel signed for realm ${realm.slice(0, 12)}… reads ${judged.verdict} here${judged.why ? `: ${judged.why}` : ""}; nothing crosses.`);
