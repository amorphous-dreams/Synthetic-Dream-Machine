   283	/** The charter home an act reads: the carried charter `aid` names, else the primary. Refuses an AID this vessel never carried. */
   284	function charterHomeOrRefuse(sealHome: string, aid: string | undefined): string {
   285	  if (aid === undefined) return sealHome;
   286	  const home = charterHomeFor(sealHome, aid.trim().toLowerCase());
   287	  if (home === null) throw new NexusContractError(`this vessel holds no charter for ${aid.slice(0, 18)}… — import or found it first.`);
   288	  return home;
   289	}
