   551	/**
   552	 * Land a seal roll's ANCHOR on this Nexus's carriage board — called by the rotate BEFORE it writes the new
   553	 * head, so a roll whose anchor cannot land writes nothing at all. That order holds where one vessel holds the whole
   554	 * new quorum; where the seats rest in two vaults, the anchor follows the filed head as a partial instead
   555	 * (`runNexusRollAnchorOpen` / `runNexusRollAnchorPartial`). The anchor names the epoch `closing` heads
   556	 * and the epoch `opened` heads, carries `closing`'s public key-set, cites the board's causal heads at the roll
   557	 * (`rollAnchorParents`: the acts and anchors that count at the closing epoch and nothing cites), and is signed
   558	 * by `opened`'s quorum out of the held seat keys it seats. The closing keys never sign it.
   559	 *
   560	 * FAIL CLOSED, before any write: fewer than `opened.threshold` held roots seated in `opened` → REFUSE; an
   561	 * anchor that does not count under `opened` → REFUSE. An anchor that lands for a head the rotate then fails
   562	 * to write names an epoch no charter lineage holds, and no verifier walks it.
   563	 */
   564	export async function runNexusRollAnchor(opts: {
   565	  readonly sealHome:    string;
   566	  /** The roster at the head the roll closes. */
   567	  readonly closing:     KahuQuorumSeats;
   568	  /** The roster the roll seats, rooted on the new head's epoch cid. */
   569	  readonly opened:      KahuQuorumSeats;
   570	  /** The store's one holder: the standing vessel's own Repo, or the direct holder's (`ownedStore`). */
   571	  readonly repo:        Repo;
   572	}): Promise<NexusRollAnchorResult> {
   573	  const selected = await selectHeldQuorumSigners(opts.opened, (held, k) => new NexusContractError(
   574	    `roll anchor REFUSED (fail-closed): the vessel holds ${held} seat key(s) the new roster seats, but the anchor ` +
   575	    `carries ${k} distinct signatures of the NEW quorum — the closing keys never sign it.`,
   576	  ));
   577	  const repo         = opts.repo;
   578	  try {
   579	    const { boardUrl, handle } = await rollAnchorBoardFor(repo, opts.sealHome);
   580	    const parents = await rollAnchorParents(
   581	      carriageEntriesFromBoard(handle.doc()), rollAnchorsFromBoard(handle.doc()), opts.closing);
   582	    const signers = selected.map((s) => ({ signer: s.verifyingKey, sign: s.sign }));
   583	    const anchor = await signRollAnchor({
   584	      prevEpochCid:  opts.closing.sealEpochCid,
   585	      sealEpochCid:  opts.opened.sealEpochCid,
   586	      prevKeys:      opts.closing.keys,
   587	      prevThreshold: opts.closing.threshold,
   588	      parents,
   589	    }, signers);
   590	    if (!(await rollAnchorCounts(anchor, opts.opened))) {
   591	      throw new NexusContractError("refusing to write: the roll anchor does not count under the new roster (fail-closed).");
   592	    }
   593	    handle.change((d) => writeRollAnchor(d, anchor));
   594	    await repo.flush();
   595	    return { anchor, anchorCid: rollAnchorCid(anchor), parents, boardUrl };
   596	  } finally {
   597	    await repo.flush().catch(() => { /* best-effort final flush */ });
   598	  }
   599	}
