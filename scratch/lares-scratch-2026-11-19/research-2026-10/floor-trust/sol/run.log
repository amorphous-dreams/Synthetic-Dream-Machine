   161	/** The Nexus AID a subject's leaf derives under — the charter's genesis epoch, fixed across rotation. */
   162	function nexusAidOrRefuse(sealHome: string): string {
   163	  const aid = primaryNexusAid(sealHome);
   164	  if (aid) return aid;
   165	  throw new NexusContractError("no seated charter to name the Nexus by — a per-Nexus leaf derives from the charter's genesis epoch.");
   166	}
