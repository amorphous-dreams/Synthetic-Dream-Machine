   272	/** Read a supplied floor-pin statement for a `carry` of `nym` at `aid`: its own pin, signed by its own key. Refuses otherwise. */
   273	function floorPinOrRefuse(raw: string, nym: string, aid: string): PlaceFloorPinStatement {
   274	  let parsed: unknown;
   275	  try { parsed = JSON.parse(raw); } catch { throw new NexusContractError("carry REFUSED: the --floor-pin statement does not parse as JSON — pass the `floorPin` `nexus carry-for --json` printed, whole."); }
   276	  // The carrier set here is the named place alone: this checks the statement's own bytes; the board's readers judge the relation.
   277	  const read = readPlaceFloorPin(parsed, { nexusHex: Buffer.from(aid, "utf8").toString("hex"), route: FLOW_SOCKET_ROUTE, carriers: new Set([nym]) });
   278	  if ("refusal" in read) throw new NexusContractError(`carry REFUSED: the --floor-pin statement does not read for this place at this Nexus (${read.refusal}). Nothing was written.`);
   279	  if (read.placeKey !== nym) throw new NexusContractError("carry REFUSED: the --floor-pin statement names another place than the carry. Nothing was written.");
   280	  return parsed as PlaceFloorPinStatement;
   281	}
