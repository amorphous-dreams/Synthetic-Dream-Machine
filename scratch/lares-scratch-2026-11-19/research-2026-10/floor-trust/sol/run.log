   291	/** Everything an act needs before its seats sign: the subject, the charter home and roster, the subject's own seal,
   292	 *  the board it lands on and the causal heads it cites there. */
   293	interface ContractCore {
   294	  readonly nym:      string;
   295	  readonly home:     string;
   296	  readonly roster:   KahuQuorumSeats;
   297	  readonly contract: { contractSig: QuorumSignature; how: "supplied" | "self" } | null;
   298	  readonly gateKey:  string;
   299	  readonly boardUrl: string;
   300	  readonly handle:   Awaited<ReturnType<typeof materializeSharedLarDoc>>;
   301	  readonly parents:  readonly string[];
   302	  /** An admit's carriage opening: this hearth's full sovereign sync pin and the canon documents it names, under a fresh
   303	   *  salt. The quorum signs its commitment; the board never holds the opening. Null for every other act. */
   304	  readonly opening:  AdmitOpening | null;
   305	  /** A carry's supplied floor-pin statement, read whole for the named place at this Nexus; null otherwise. */
   306	  readonly floorPin: PlaceFloorPinStatement | null;
   307	}
   308	
   309	/** The carriage board one charter home's island names on this vessel, with the gate key that resolved the island. */
   310	async function carriageBoardFor(repo: Repo, home: string): Promise<Pick<ContractCore, "gateKey" | "boardUrl" | "handle">> {
   311	  const gateKey  = await loadVesselVerifyingKey();
   312	  const boardUrl = carriageDocUrl(nodeNexusIsland({ ownVesselKey: gateKey, sealHome: home }));
   313	  const handle   = await materializeSharedLarDoc(repo, boardUrl, "board:carriage-contracts");
   314	  return { gateKey, boardUrl, handle };
   315	}
   316	
   317	async function contractCore(opts: NexusContractOptions): Promise<ContractCore> {
   318	  const nym = opts.nym.trim().toLowerCase();
   319	  if (!NYM_RE.test(nym)) {
   320	    throw new NexusContractError(`"${opts.nym}" reads as no operator nym — expected a 64-hex ed25519 verifying key.`);
   321	  }
   322	  const home = charterHomeOrRefuse(opts.sealHome, opts.aid);
   323	  const roster = seatedRosterOrRefuse(home);
   324	  const homed = { ...opts, sealHome: home };
   325	  // The subject's own wax-seal — an ADMIT takes the operator's persona-signed contract-in, a CARRY takes the
   326	  // place's vessel-signed carrier seal, and a REVOKE / UNCARRY takes none.
   327	  let contract: ContractCore["contract"] = null;
   328	  if (opts.action === "admit") contract = await resolveContractIn(homed, nym, roster.sealEpochCid);
   329	  else if (opts.action === "carry") contract = { contractSig: await resolveCarrierIn(homed, nym, roster.sealEpochCid), how: "supplied" };
   330	  const { gateKey, boardUrl, handle } = await carriageBoardFor(opts.repo, home);
   331	  const board = handle.doc();
   332	  const boardFold = await foldCarriageDetails(carriageEntriesFromBoard(board), roster,
   333	    carriageAncestryFromBoard(readNexusDoc(home)?.sealLineage, board));
   334	  const parents  = causalHeadsForNym(boardFold.entries, nym, opts.action);
   335	  // THE ADMIT SIGNS WHAT IT CARRIES (face-proof#/the-gate-exchange, step 5): the joinee takes this hearth's gate pin
   336	  // and canon list off the admit's own signed bytes, never off a field beside them.
   337	  const opening: AdmitOpening | null = opts.action === "admit"
   338	    ? openAdmitCarriage({ gatePin: hearthSovereignPin(nexusAidOrRefuse(home), opts.gateDoor), canon: opts.catalogUrl ? await admitCanonDocs(opts.repo, opts.catalogUrl) : {} })
   339	    : null;
   340	  const floorPin = opts.action === "carry" && opts.floorPin ? floorPinOrRefuse(opts.floorPin, nym, nexusAidOrRefuse(home)) : null;
   341	  return { nym, home, roster, contract, gateKey, boardUrl, handle, parents, opening, floorPin };
   342	}
   343	
   344	/**
   345	 * Land one signed entry on the board: it must COUNT against the roster first (a dead admit would read as enforced
   346	 * while granting nothing), then one fold of the written board answers both projections and, for an admit, the
   347	 * carried bundle.
   348	 */
   349	async function landEntry(core: ContractCore, repo: Repo, action: CarriageAction, entry: CarriageEntry, signers: readonly string[],
   350	  beforeWrite?: () => Promise<void>, syncUrl?: string): Promise<NexusContractResult> {
   351	  if (!(await carriageEntryCounts(entry, core.roster))) {
   352	    throw new NexusContractError(
   353	      action === "admit"
   354	        ? "refusing to write: the signed admit does not COUNT (the kahu quorum or the operator contract-in failed to verify against the seated roster)."
   355	        : action === "carry"
   356	        ? "refusing to write: the signed carry does not COUNT (the kahu quorum or the place's own carrier seal failed to verify against the seated roster)."
   357	        : "refusing to write: the signed removal does not verify against the seated roster (fail-closed).",
   358	    );
   359	  }
   360	  const { handle, nym, roster } = core;
   361	  // The last check reads the board as it stands at the write; the write follows it with no await between.
   362	  if (beforeWrite) await beforeWrite();
   363	  handle.change((d) => {
   364	    writeCarriageEntry(d, entry);
   365	    if (core.floorPin) writePlaceFloorPin(d, core.floorPin);
   366	  });
   367	  await repo.flush();
   368	
   369	  // ONE FOLD OF THE WRITTEN BOARD, TWO PROJECTIONS. THE TWO FOLDS STAY TWO: members and carriers read as
   370	  // separate sets and never union. A `carry` moves the carrier observation and never `memberHeld` — the
   371	  // structural half of the class law, reported so a caller reads which relation it actually landed.
   372	  const board       = handle.doc();
   373	  const after       = await foldCarriageDetails(carriageEntriesFromBoard(board), roster,
   374	    carriageAncestryFromBoard(readNexusDoc(core.home)?.sealLineage, board));
   375	  const memberHeld  = holdsCarriage(nym, after.members);
   376	  const carrierHeld = holdsCarrier(nym, after.carriers);
   377	
   378	  // THE BUNDLE. The admit just signed cites every causal head for the nym, so it stands as the board's one
   379	  // admit head for that nym; its lineage comes off the board it landed on. A head that reads otherwise
   380	  // (nothing presents, or another act heads the relation) emits no bundle rather than a different admit.
   381	  let bundle: AdmitBundle | null = null;
   382	  let findings: readonly PresentationFinding[] = [];
   383	  if (action === "admit") {
   384	    const read = await presentationFromBoardDoc(handle.doc(), nym, roster, readNexusDoc(core.home)?.sealLineage);
   385	    findings = read.findings;
   386	    const presented = read.presentation;
   387	    // The bundle names the hearth the admit committed to as its pin (the vault that opened the act, wherever it
   388	    // lands) and carries the opening to the subject's hands alone; an opening the act never committed to emits none.
   389	    const opening = core.opening;
   390	    if (presented && opening && admitCarriageCommit(opening) === presented.admit.carriageCommit &&
   391	        carriageEntryActCid(presented.admit) === carriageEntryActCid(entry)) {
   392	      bundle = { aid: nexusAidOrRefuse(core.home), gatePubKey: opening.carriage.gatePin.signingKey, admit: presented.admit, lineage: presented.lineage, opening, ...(syncUrl ? { syncUrl } : {}) };
   393	    }
   394	  }
   395	  const carryBundle = action === "carry"
   396	    ? await carryBundleFrom({ aid: nexusAidOrRefuse(core.home), nym, board: handle.doc(), roster,
   397	      sealLineage: readNexusDoc(core.home)?.sealLineage })
   398	    : null;
   399	  return {
   400	    action, nym, parents: entry.parents, evidenceCid: carriageEntryActCid(entry),
   401	    sealEpochCid: roster.sealEpochCid, threshold: roster.threshold, signers,
   402	    contractIn: entry.contractSig ? (core.contract?.how ?? "supplied") : "n/a",
   403	    boardUrl: core.boardUrl, memberHeld, carrierHeld, bundle, findings, carryBundle,
   404	  };
   405	}
   406	
   407	/**
   408	 * ADMIT (`admit`) or REVOKE (`revoke`) an operator nym — sign a causal membership act with ≥ threshold held
   409	 * founding seat keys (plus, for admit, the operator's contract-in) and LAND it on the always-carried members
   410	 * board. FAILS CLOSED before any write. The act names every locally observed causal head for this relation family;
   411	 * it never derives authority from a scalar counter.
   412	 */
   413	export async function runNexusContract(opts: NexusContractOptions): Promise<NexusContractResult> {
   414	  const nym = opts.nym.trim().toLowerCase();
   415	  if (!NYM_RE.test(nym)) {
   416	    throw new NexusContractError(`"${opts.nym}" is not a valid operator nym — expected a 64-hex ed25519 verifying key.`);
   417	  }
   418	  const selected = await selectHeldQuorumSigners(seatedRosterOrRefuse(charterHomeOrRefuse(opts.sealHome, opts.aid)), subQuorum);
   419	  const repo = opts.repo;
   420	  try {
   421	    const core = await contractCore(opts);
   422	    // The quorum signs with the seats' own keys: each hand opens its one cold row for its one signature.
   423	    const entry: CarriageEntry = await signCarriageQuorum(
   424	      { nym: core.nym, action: opts.action, parents: core.parents, sealEpochCid: core.roster.sealEpochCid, ...(core.opening ? { carriageCommit: admitCarriageCommit(core.opening) } : {}) },
   425	      selected.map((s) => ({ signer: s.verifyingKey, sign: s.sign })),
   426	      core.contract?.contractSig,
   427	    );
   428	    return await landEntry(core, repo, opts.action, entry, selected.map((s) => s.verifyingKey), undefined, opts.syncUrl);
   429	  } finally {
   430	    await repo.flush().catch(() => { /* best-effort final flush */ });
   431	  }
   432	}
