   434	/** What a partial step answers: the partial as it stands, the judge's verdict over it here, and the act it landed. */
   435	export interface NexusContractPartialResult {
   436	  readonly partial: NexusActPartial;
   437	  readonly verdict: PartialVerdict;
   438	  /** The seats of the head roster whose signature the partial carries, sorted. */
   439	  readonly signed:  readonly string[];
   440	  /** The landed act, once the partial read `complete` here and its entry counted; null short of the threshold. */
   441	  readonly landed:  NexusContractResult | null;
   442	}
   443	
   444	/** The reader one vessel judges a partial with: its charter's AID and head roster, and its own board. */
   445	function partialReader(aid: string, core: Pick<ContractCore, "roster" | "handle">): NexusPartialReader {
   446	  const doc = core.handle.doc();
   447	  return { aid, head: core.roster, board: { carriage: carriageEntriesFromBoard(doc), anchors: rollAnchorsFromBoard(doc), antigen: [] } };
   448	}
   449	
   450	const partialFamily = (action: CarriageAction): "admit" | "revoke" => {
   451	  if (action === "admit" || action === "revoke") return action;
   452	  throw new NexusContractError(`a ${action} crosses no vaults as a partial: only an admit and a revoke ride the two-vault door.`);
   453	};
   454	
   455	/**
   456	 * OPEN a two-vault act: every seat of the head roster this vessel holds signs the admit or revoke (an admit with
   457	 * its operator's contract-in), and the act leaves as a PARTIAL for the vault that holds the other seats. Nothing
   458	 * lands on any board here. A vessel that holds the whole quorum lands the act through `runNexusContract` instead.
   459	 */
   460	export async function runNexusContractOpen(opts: NexusContractOptions): Promise<NexusContractPartialResult> {
   461	  const family = partialFamily(opts.action);
   462	  const home = charterHomeOrRefuse(opts.sealHome, opts.aid);
   463	  const roster = seatedRosterOrRefuse(home);
   464	  const held = heldSeatSigners(roster);
   465	  if (held.length === 0) throw new NexusContractError("this vessel holds no seat of the head roster, so it opens no act for it.");
   466	  if (held.length >= roster.threshold) {
   467	    throw new NexusContractError("this vessel holds the whole quorum: the act lands here whole (`nexus contract`), and no partial crosses.");
   468	  }
   469	  const repo = opts.repo;
   470	  try {
   471	    const core = await contractCore(opts);
   472	    const entry = await signCarriageQuorum(
   473	      { nym: core.nym, action: family, parents: core.parents, sealEpochCid: core.roster.sealEpochCid, ...(core.opening ? { carriageCommit: admitCarriageCommit(core.opening) } : {}) },
   474	      held.map((s) => ({ signer: s.verifyingKey, sign: s.sign })),
   475	      core.contract?.contractSig,
   476	    );
   477	    const aid = nexusAidOrRefuse(core.home);
   478	    // The opening crosses with the partial, so whichever vault lands the act hands the subject its bundle.
   479	    const partial = nexusActPartial(aid, { family, entry, ...(core.opening ? { opening: core.opening } : {}) });
   480	    const judged = await judgeNexusActPartial(partial, partialReader(aid, core));
   481	    if (judged.verdict !== "ready") throw new NexusContractError(`the partial this vessel signed reads ${judged.verdict} here${judged.why ? `: ${judged.why}` : ""}; nothing crosses.`);
   482	    return { partial, verdict: judged.verdict, signed: judged.signed, landed: null };
   483	  } finally {
   484	    await repo.flush().catch(() => { /* best-effort final flush */ });
   485	  }
   486	}
   487	
   488	/**
   489	 * Take a partial another vault opened or cosigned. The judge runs against this vessel's own charter head and board
   490	 * BEFORE any signature: a partial that reads `ready` takes the signature of every seat this vessel holds that has
   491	 * not signed it; one that reads `complete` (here, or after those signatures) lands on this vessel's board. Any
   492	 * other verdict refuses by name, and nothing signs or lands.
   493	 */
   494	export async function runNexusContractPartial(opts: { readonly partial: unknown; readonly sealHome: string; readonly repo: Repo }):
   495	  Promise<NexusContractPartialResult> {
   496	  const read = readNexusActPartial(opts.partial);
   497	  if (!read || read.act.family === "kapae" || read.act.family === "roll-anchor" || read.act.family === "edge-roll-anchor") {
   498	    throw new NexusContractError("the file reads as no admit or revoke partial");
   499	  }
   500	  const entry0 = read.act.entry;
   501	  const home = charterHomeOrRefuse(opts.sealHome, read.aid);
   502	  const roster = seatedRosterOrRefuse(home);
   503	  const repo = opts.repo;
   504	  try {
   505	    const { gateKey, boardUrl, handle } = await carriageBoardFor(repo, home);
   506	    const core: ContractCore = { nym: entry0.nym, home, roster, contract: null, gateKey, boardUrl, handle, parents: entry0.parents,
   507	      opening: read.act.family === "admit" ? read.act.opening ?? null : null,
   508	      // A partial carries the act alone: a two-vault carry lands no floor-pin statement (the herm's own replica lays it).
   509	      floorPin: null };
   510	    const reader = partialReader(read.aid, core);
   511	    let partial: NexusActPartial = read;
   512	    let judged = await judgeNexusActPartial(partial, reader);
   513	    if (judged.verdict === "ready") {
   514	      const hands = heldSeatSigners(roster, new Set(judged.signed));
   515	      if (hands.length === 0) throw new NexusContractError("the partial waits on a seat this vessel does not hold; carry it to the vault that holds one.");
   516	      try { partial = await cosignNexusActPartial(partial, reader, hands.map((h) => ({ signer: h.verifyingKey, sign: h.sign }))); }
   517	      catch (err) { if (err instanceof NexusPartialRefusal) throw new NexusContractError(`the partial refuses a cosign here: ${err.message}`); throw err; }
   518	      judged = await judgeNexusActPartial(partial, reader);
   519	    }
   520	    if (judged.verdict === "ready") return { partial, verdict: judged.verdict, signed: judged.signed, landed: null };
   521	    if (judged.verdict !== "complete") {
   522	      throw new NexusContractError(`the partial reads ${judged.verdict} on this vessel${judged.why ? `: ${judged.why}` : ""}; nothing signs or lands.`);
   523	    }
   524	    const act = partial.act as Extract<NexusActPartial["act"], { family: "admit" | "revoke" }>;
   525	    // A seat's signature awaits custody, and the board or the charter head may move meanwhile: the act lands only
   526	    // where it still reads `complete` against the head and the board as they stand at the write.
   527	    const fresh: ContractCore = { ...core, roster: seatedRosterOrRefuse(home) };
   528	    // The judge itself awaits, so it runs again until the board AND the charter head hold still across one whole
   529	    // judgement (`partial-landing`): the write follows the last judge with no await between, and a count bounds it.
   530	    const mark = (): string =>
   531	      `${seatedRosterOrRefuse(home).sealEpochCid}|${carriageEntriesFromBoard(fresh.handle.doc()).map(carriageEntryActCid).sort().join(",")}`;
   532	    const landed = await landEntry(fresh, repo, act.family, act.entry, judged.signed, () => judgeStillBeforeWrite({
   533	      mark,
   534	      judge: () => judgeNexusActPartial(partial, partialReader(read.aid, { ...fresh, roster: seatedRosterOrRefuse(home) })),
