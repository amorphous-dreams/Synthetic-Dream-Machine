    41	  | "foreign-nexus"
    42	  | "no-release"
    43	  | "release-unsettled"
    44	  | "floor-absent" | "floor-manifest-format" | "floor-manifest-malformed" | "floor-snapshot-cid-mismatch" | "floor-snapshot-malformed"
