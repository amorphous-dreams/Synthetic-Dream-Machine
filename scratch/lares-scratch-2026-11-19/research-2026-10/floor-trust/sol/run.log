   174	/**
   175	 * Obtain the operator's "accepts carriage" contract-sig for an ADMIT. Two paths, fail-closed:
   176	 *   · a `--contract <hex>` token supplied out-of-band → wrap it { signer: nym, sig } (the fold verifies it).
   177	 *   · else, if the nym is the per-Nexus leaf of a persona this vessel HOLDS (multitude-of-one) → self-sign the
   178	 *     carriage token with that leaf. A root nym matches no leaf, so it never self-signs.
   179	 * Neither → REFUSE (never admit an operator that has not consented to carriage).
   180	 */
   181	async function resolveContractIn(
   182	  opts: NexusContractOptions, nym: string, sealEpochCid: string,
   183	): Promise<{ contractSig: QuorumSignature; how: "supplied" | "self" }> {
   184	  if (opts.contractSig) {
   185	    // Prove the operator's consent BEFORE any seat signs: no seat signs an admit its operator never consented to.
   186	    const sig = opts.contractSig.trim().toLowerCase();
   187	    if (!(await verifyCarriageConsent({ nym, sealEpochCid, contractSig: sig }))) {
   188	      throw new NexusContractError(
   189	        "admit REFUSED (fail-closed): the supplied contract-in does not verify as this operator's 'accepts carriage' " +
   190	        "for the head epoch, so no seat signs.",
   191	      );
   192	    }
   193	    return { contractSig: { signer: nym, sig }, how: "supplied" };
   194	  }
   195	  // multitude-of-one: is the admitted nym one of this vessel's leaves for this Nexus? Then self-sign with it.
   196	  for (const leaf of await heldNexusLeaves(nexusAidOrRefuse(opts.sealHome))) {
   197	    if (leaf.verifyingKey !== nym) continue;
   198	    const contractSig = await signCarriageContract(nym, sealEpochCid, ed25519SignerFromSeed(leaf.seed));
   199	    return { contractSig, how: "self" };
   200	  }
   201	  throw new NexusContractError(
   202	    "admit REFUSED (fail-closed): no operator contract-in. The joining operator must sign 'accepts carriage' " +
   203	    "(`lares nexus accept-carriage` on their vessel) and supply the token via --contract, OR the nym must be the " +
   204	    "per-Nexus leaf of a persona this vessel holds. A Nexus never conscripts an operator into carriage.",
   205	  );
   206	}
