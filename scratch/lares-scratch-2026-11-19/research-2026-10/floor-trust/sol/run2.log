    34	/** The bytes the key signs: the domain, then the event kind and the key. */
    35	const signedBytes = (t: string, k: readonly string[]): Uint8Array => canonicalJsonBytes({ domain: VESSEL_KEL_DOMAIN, t, k });
    36	
    37	/** Mint the inception from the floor seed. Pure: the same seed mints the same bytes. */
    38	export function inceptVesselKel(signingSeed: Uint8Array): { readonly inception: VesselKelInception; readonly bytes: Uint8Array } {
    39	  if (signingSeed.length !== 32) throw new Error("vessel-kel: the floor seed must ride 32 bytes");
