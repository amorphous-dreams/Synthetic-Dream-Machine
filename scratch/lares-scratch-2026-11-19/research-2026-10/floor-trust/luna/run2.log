    57	/** Read an inception from its bytes; anything torn, extra or missing reads `null`, a next-key commitment among them. */
    58	export function decodeVesselKelInception(bytes: Uint8Array): VesselKelInception | null {
    59	  try {
    60	    const raw = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes)) as Record<string, unknown>;
    61	    if (!raw || typeof raw !== "object" || Array.isArray(raw)) return null;
    62	    if (Object.keys(raw).sort().join(",") !== FIELDS) return null;
    63	    const strings = (v: unknown): v is string[] => Array.isArray(v) && v.every((s) => typeof s === "string");
    64	    if (raw.t !== "icp" || !strings(raw.k) || typeof raw.sig !== "string") return null;
    65	    return { t: "icp", k: raw.k, sig: raw.sig };
    66	  } catch {
    67	    return null;
    68	  }
    69	}
     1	/**
     2	 * gate-bundle — the keys ONE gate holds for ONE Nexus on ONE route: derived, never stored.
     3	 *
     4	 * A vessel that stands in two Nexuses stands two gates per route, and the two share nothing a peer can
     5	 * compare. Each gate holds a BUNDLE: an X25519 transport key that answers the dialer's first flight, and an
     6	 * Ed25519 signing key that signs the gate's verdict. Both derive from one root, the Nexus and the route,
     7	 * each under its own name, so no key of one bundle stands in another and neither key of a bundle equals
     8	 * the other.
     9	 *
    10	 *     seed            = the tier's child of its root: the floor key's (GATE_FLOOR_BUNDLE_INFO) for a floor
    11	 *                       route, the sealed custody root's (GATE_BUNDLE_INFO) for a sovereign route
    12	 *     transport secret = HKDF-SHA256(seed, info = fields(GATE_TRANSPORT_KEY_INFO, tier, nexus, route))
    13	 *     signing seed     = HKDF-SHA256(seed, info = fields(GATE_SIGNING_KEY_INFO,   tier, nexus, route))
    14	 *
    15	 * TWO TIERS, TWO ROOTS. A floor route answers at a locked vessel, so its bundle derives from the floor key. A
    16	 * sovereign route seats a face's session, so its bundle derives from the sealed custody root and stands
    17	 * only while the vessel stands unlocked. A route carries its tier in its typed name, a pin states it and
    18	 * the pin's digest binds it; a route asked of the other tier's root refuses by name.
    19	 *
    20	 * What a dialer holds is the PIN: the Nexus, the route and the two public keys. The pin's DIGEST names the
    21	 * bundle wherever a signature binds it. The KNOCK derives from that digest, so a gate's knock, its pin, its
    22	 * verdict and its posture all read per Nexus exactly. The handshake's PROLOGUE holds the digest too, so a
    23	 * first flight decrypts only at the gate whose pin its dialer held.
    24	 *
    25	 * The invariants:
    26	 *   · NOTHING RESTS. A bundle lives in memory from a derivation to a `drop`. No row, no file and no cache
    27	 *     holds a bundle's key: a restart derives it again from the same three inputs.
    28	 *   · THE ROOT STAYS WITH ITS OWNER. This module asks a `GateBundleRoot` for ONE child, under one registered
    29	 *     name, and reads no root bytes. The custody seat's own derive door answers it.
    30	 *   · THE NEXUS RIDES AS OPAQUE BYTES. How a Nexus names itself belongs to its charter; a bundle binds the
    31	 *     bytes and parses nothing in them.
    32	 *   · NO SECRET LEAVES. A bundle answers a first flight and signs an image; it hands out neither secret.
    33	 *   · THE SIGNING KEY SIGNS A GATE'S PURPOSES ALONE. An image that leads with any other name draws no
    34	 *     signature, and a reader holds a signature to the same list.
    35	 *
    36	 * The floor's announcement signs under this same signing key: its image leads with the announcement's own
    37	 * name, which joins `GATE_SIGNING_PURPOSES` in the commit that builds the announcement
    38	 * (lar:///ha.ka.ba/lares/api/pono/waking-floor#/the-announcement). A peer reads it under the pin it holds
    39	 * for that Nexus, so a gate and its announcement never sign under two keys.
    40	 *
    41	 * Pure but for the keys it derives: no I/O, no clock, no timer, no randomness.
    42	 * The package barrel names it for its callers: the node's gate server, the gate composer and every dialer.
   200	* ''A face's secrets never rest clear, even at a first join'' (operator, 2026-10-18, approving the house lean). A fresh device's fleet join binds a passphrase or paper slot before the join lands, since every face secret refuses to rest outside the slot tree. Row `B1`.
   201	* ''On the node, the boot marks the unlock and the session marks the face'' (operator, 2026-10-18, approving the house reading). The per-tab ask binds browser tabs; a node unlocks once per boot through its custody door, and every CLI run, MCP seat and watcher proves its own face at the gate without asking again (<<~ loulou "lar:///ha.ka.ba/lares/docs/research/session-unlock-2026">> #/the-node-scope).
   202	* ''The last tab closes, and the browser rests at its floor'' (operator, 2026-10-18, approving the house lean). The unlock lives in page memory alone, so the browser vessel's sovereign composition ends with its last tab and the next tab asks again. Row `B1`.
   203	* ''One Keyhive identity per PersonaGroup, none above them'' (operator ruling, 2026-10-18: //"it's the only way to retain control over faces that don't know about each other"//). Each face's PersonaGroup owns its Keyhive identity, its event store, its registry, its archive and its content-key seat; no vessel-wide identity registers a face's bags, delegates them, or holds a face's group. Two faces of one vessel then never link on the wire, a removal from one face rolls that face's bags alone, and a bundle restores one face and nothing of another. Today the vessel's own identity registers every bag and delegates each face's bags through itself, and the vessel and every face share one event store and one content-key holder (<<~ loulou "lar:///ha.ka.ba/lares/docs/research/keyhive-per-persona-group-2026">>). House readings under the operator's confidence, each naming what flips it: a herm keeps a floor-only transport key, behind a red test that it can neither author, resolve nor observe a face's capabilities, and holds no Keyhive identity if that test fails; several face hives share one process only after a substrate probe reads them isolated, and each face's hive runs in its own worker otherwise; co-mingled history migrates by fresh identities and an old mixed archive refuses by name, with no bridge; a founder that cannot leave its group leaves by a fresh PersonaGroup. Row `K15` carries the build, folding `W25` and `K12`; `W26`'s slice 3 waits on its face context.
   204	* ''A cabal shares through the faces its members choose'' (operator ruling, 2026-10-18, on the Teshima Family Council story). Kalani founds a private family council; Leilani, already standing on the DreamNet with several faces, chooses which of them join it, and a face she keeps back never learns the council exists. The council's hive reads as a Keyhive group with no key of its own: its members act through their own faces' identities, so nothing stands above them, and a presentation reads valid against the current set without naming which member made it (<<~ loulou "lar:///ha.ka.ba/lararium/mesh/identity-classes">> #/the-handle-chain). Any current member's face promotes into the council's canon; a graft takes the threshold; a face leaves by its own act, and another's removal rides `kapae` at the threshold or a fork that omits the captor (<<~ loulou "lar:///ha.ka.ba/lares/api/pono/cabal-realm">> #/the-unswept-corner); members read the owner-set as faces, never as humans. A private council declares no heraldry and lives in its members' address books under pet-names (cabal-realm #/heraldry). Row `K16` carries the story as `K15`'s acceptance.
   205	* ''The asker seals'' (operator ruling, 2026-10-19, F6's custody fork). Once the browser holder owns the Repo and the daemon kernel, it routes each sealed write to the admitted tab whose session caused it, else to any admitted, unlocked tab of that write's face; with no awake admitted tab, the write waits, named `seal-awaits-session`, never silent and never decided by a clock. No key material leaves a tab, and each sealer holds the row-class key the occupied carrier's overwrite proof opens. A SharedWorker carries no promise to run while its tabs freeze, and no `MessagePort` event reports a peer's death (round one, 2026-10-19), so a seal that waits names its wait.
   206	* ''A face's custody rows seal under its own key'' (operator ruling, 2026-10-19). Each PersonaGroup holds an independent random face custody key (FCK) that only its own slot tree opens (passphrase, paper or PRF), never wrapped under the vessel key, so a holder of the S key or of another face's unlock opens none of its rows. Face-private rows: each face's veil archive, face-key custody, guardian sets, face-provisional, the fleet-join address secret and record, a pending join bound to its target face, the per-face device shares, and each face's partition of the handle book and roster; the vessel Keyhive archive splits per PersonaGroup under `K15`. A face bundle carries that face's identity, archive, FCK recovery route and guardian set, and nothing of a sibling. Today every hot and cold custody row seals under one S key (`vault-carriers.ts`, `browser-custody.ts`), so face isolation reads as routing alone until this lands. Row `K15` carries the build, and `F6` slice three lands with its step 3. How a vessel-common act unlocks dissolves (next ruling).
   207	* ''A shared act never makes a shared secret'' (operator ruling, 2026-10-19; four ratcheted research rounds, <<~ loulou "lar:///ha.ka.ba/lares/docs/research/custody-per-face-2026">>). Every act that touches more than one face sorts one of three ways: its private bytes DISSOLVE into the owning face's rows (D), its public bytes stand at the FLOOR by design (F), or it names a vessel SECRET (S) whose principal and opener the house names row by row. A mixed carrier splits before it sorts. The browser holds no vessel key: founding, fleet join, slot changes, roster, archives, handle book, dyads, restore and clear sort D or F, so each tab asks only its own face's unlock and public floor work asks nothing. Phones, installed web apps, probes, the CLI, MCP and watcher seats and a native shell hold no S. A tablet waking floor carries ciphertext and public rows unattended and decrypts no face's row. A container restarts at its floor and nothing unlocks it unattended. A guest island that owns a key store stands as its own vessel. A node holds S only for rows it names: the serving key has no row yet, so it guards nothing today. * ''The place signs by a scoped signer under a pre-rotated KEL'' (operator ruling, 2026-10-19; a fifth research round, <<~ loulou "lar:///ha.ka.ba/lares/docs/research/custody-per-face-2026">> #/the-place-signer). A node's place identity keeps a KEL whose inception commits the next key, and that next key rides the founding card beside the seed charter's cold next key, offline; the online place signer runs unattended for an enumerated allowlist of floor duties alone (the KEL's own events excepted, which the card's key signs), rests under the host's TPM-bound credential where the host offers one and an owner-only file elsewhere, and never rides an environment, an image or a log. A stolen online signer rotates away by the card; a lost card beside a stolen signer re-founds. The floor holds no custody key; it holds its own named place signer. The format change rides the founding bake (`X0`). Today the place KEL commits no next key and the seed reaches past the floor (`vessel-kel.ts`; `node-vessel-identity.ts`).
   208	* ''Custody and identity read by capability, never by host'' (operator ruling, 2026-10-19: //"I consider node and browser isomorphic-by-intent. Eventually, a browser-vessel somewhere may grow comparable capabilities to a node vessel, and this pattern cascades outwards to all future vessels."//). Three rules hold on every vessel, present and planned: a vessel meets each face through that face's atom alone, its veil signing every dial, join, enrolment, sibling channel and daemon proof made on that face's behalf, never one device-wide key; a vessel holds a place signer exactly while it stands a floor, for the floor's allowlisted duties, under the pre-rotated place KEL; and a faceless vessel reading another's floor proves nothing private, reading the public shelf under the floor card's pin. A node's daemon auth, device-key signer, sibling enrolment and group-secret opener read the one vessel seed today (`open-node-vessel.ts`), and a browser's do the same (`open-browser-vessel.ts`); each is a bond owed, carried by `K15`.
   209	* ''Identity enacts a bond'' (operator ruling, 2026-10-19). Lineage stays within a root, and covenant joins roots: a root (a compartment seed, a vessel key, a face custody key, a charter seat, a content key) derives children for its own duties alone, and any identity spanning two roots is a bond, an act both ends sign that seats a fresh key of its own, resting with the end whose privacy it serves and lapsing by its own act; no closure holds a root (<<~ loulou "lar:///ha.ka.ba/lares/api/pono/identity-enacts-relation">> #/identity-as-bond, its seven laws and bond table).
   210	* ''A face's device veil is its own random key'' (operator ruling, 2026-10-19, re-reading the 2026-09-05 veil ruling). Each PersonaGroup's veil on a device mints at random when the device joins that face and rests under that face's FCK, so no device seed stands as an ancestor of any face's veil; it stays vessel-local, never presents, and reads mint-shaped to every observer. The group-secret opener follows it.
   211	* ''Each realm stands under one charter, a seed's or a Nexus's'' (operator ruling, 2026-10-18). A council that meets at one hearth stands under that hearth's seed charter, and its guests' chosen faces walk there with no Nexus founded; a council two hearths carry stands under the Nexus those two found fresh, since a Nexus names the operators' relationship (<<~ loulou "lar:///ha.ka.ba/lares/api/pono/kapae">> #/edge-hands). A guest sees every realm its worn face stands in.
   212	* ''A write lands on a working layer, and canon takes it by promotion'' (operator ruling, 2026-10-18). A `LOAD` lands on a wiki's working slot alone; canon takes content only by the cap-gated promotion `MOVE` (<<~ loulou "lar:///ha.ka.ba/lares/docs/pono/wiki-layer-ontology">>), and genesis and founding seed canon through their own named door. An act aimed at a wiki no island mounts asks the vessel to mount it, and refuses gracefully, naming the cause, when the mount cannot stand. Row `W27` carries the build.
   213	* ''Every bag opens as its own wiki'' (operator ruling, 2026-10-18). The floor recipe names the bag alone over `@oracle`, derived and never minted, and an absent record reads as that floor, never as "no such wiki"; a composed wiki's record, which a hand authors, lays several bags and plugin offerings beneath the wiki's own canon bag (<<~ loulou "lar:///ha.ka.ba/lares/docs/pono/wiki-layer-ontology">> #/quine). No act enumerates bags to mint wikis. Row `W27` carries the build.
   214	* ''One owner per registry; the floor reads by CID'' (operator ruling, 2026-10-18: //"Architecture stands, leans stand"//). The `@oracle` document as a registry every vessel writes retires: one id carried one `lares` and one `lararium` pointer for the whole fleet, and a joined vessel's pointer replaced its hearth's, a shape a two-vessel probe and three shard runs measured. `@oracle` stands as the floor's read-face over a manifest CID, which a wiki mounts read-only by the pin its face accepted. Each registry carries only what its scope's owner writes: a vessel's bootstrap holds its own document pointers and its accepted floor pins; `@catalog` the operator's documents; the Kahu realm the live `lares` and `lararium` documents and their drafts; the crossroads board the Nexus's one public answer. The leans the ruling adopts: the Kahu realm holds the live system documents, with `bags/` projected on the Kahu's vessel alone; a one-seat founding lands a counted 1-of-1 Kahu-cabal admission for persona zero's group, so one predicate decides every hand's reach into system canon; the release answer, the Nexus's one public answer, names the Nexus AID, the charter epoch, the release before it and the floor manifest CID, sealed by the steward, with the promotion approval over the manifest's exact bytes riding attached; a vessel records an accepted release as a sealed hot row per (face, Nexus) that only a person's act moves; genesis bakes the first floor, a corpus CID in the seed. A signing domain of its own carries the release, `floor-release`, so no seal over another shape verifies as one (operator-approved, 2026-10-18). The shape and its slices stand at <<~ loulou "lar:///ha.ka.ba/lares/docs/pono/w26-floor-lane">>; rows `W26`, `W21` and `P8` carry the build.
