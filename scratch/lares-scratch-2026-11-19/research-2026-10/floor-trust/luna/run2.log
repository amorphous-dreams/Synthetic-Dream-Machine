    62	
    63	/** The exact bytes a place signs over its floor pin: the domain, its key, and the pin's coordinates and digest. */
    64	export function placeFloorPinImage(placeKey: string, pin: GateBundlePin): Uint8Array {
    65	  return canonicalJsonBytes({
    66	    kind: PLACE_FLOOR_PIN_KIND, placeKey: placeKey.toLowerCase(),
    67	    nexus: pin.nexus, route: pin.route, tier: pin.tier, digest: gateBundleDigest(pin),
    68	  });
    69	}
    70	
    71	/** Sign a place's floor pin with the place's own signing door. */
    72	export async function signPlaceFloorPin(args: {
    73	  readonly placeKey: string;
    74	  readonly pin:      GateBundlePin;
    75	  readonly sign:     (image: Uint8Array) => Promise<Uint8Array> | Uint8Array;
    76	}): Promise<PlaceFloorPinStatement> {
    77	  const placeKey = args.placeKey.toLowerCase();
    78	  const read = readGateBundlePin(args.pin);
    79	  if (!("pin" in read)) throw new Error("signPlaceFloorPin: the pin does not read whole");
    80	  const sig = await args.sign(placeFloorPinImage(placeKey, read.pin));
