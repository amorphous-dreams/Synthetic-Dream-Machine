    18	import { ed25519 } from "@noble/curves/ed25519.js";
    19	import { canonicalJsonBytes, hex } from "./crypto.js";
    20	import { VESSEL_KEL_DOMAIN } from "./domains.js";
    21	import { verifyEd25519 } from "./ed25519-door.js";
    22	
    23	export interface VesselKelInception {
    24	  readonly t:   "icp";
    25	  /** The floor key's public bytes, hex: one key. */
    26	  readonly k:   readonly string[];
    27	  /** The floor key's Ed25519 signature over the signed bytes, hex. */
    28	  readonly sig: string;
    29	}
