    83	
    84	/**
    85	 * Read one statement for a reader at `nexusHex` (the Nexus as a pin carries it), on `route`, against the carrier set the
    86	 * reader's own held root folds. Never throws.
    87	 */
    88	export function readPlaceFloorPin(raw: unknown, at: {
    89	  readonly nexusHex: string;
    90	  readonly route:    string;
    91	  readonly carriers: ReadonlySet<string>;
    92	}): { readonly placeKey: string; readonly pin: GateBundlePin } | { readonly refusal: PlaceFloorPinRefusal } {
    93	  try {
    94	    if (typeof raw !== "object" || raw === null || Array.isArray(raw)) return { refusal: "statement-malformed" };
    95	    const keys = Object.keys(raw).sort();
    96	    if (keys.join(",") !== "kind,pin,placeKey,sig") return { refusal: "statement-malformed" };
    97	    const s = raw as Record<string, unknown>;
    98	    if (s["kind"] !== PLACE_FLOOR_PIN_KIND || typeof s["placeKey"] !== "string" || !KEY_RE.test(s["placeKey"])
    99	      || typeof s["sig"] !== "string" || !SIG_RE.test(s["sig"])) return { refusal: "statement-malformed" };
   100	    const read = readGateBundlePin(s["pin"]);
   101	    if (!("pin" in read)) return { refusal: "pin-unreadable" };
   102	    const pin = read.pin;
   103	    if (pin.tier !== "floor") return { refusal: "pin-not-floor" };
   104	    if (pin.nexus !== at.nexusHex) return { refusal: "pin-other-nexus" };
   105	    if (pin.route !== at.route) return { refusal: "pin-other-route" };
   106	    const placeKey = s["placeKey"];
   107	    if (!verifyEd25519(hexToBytes(s["sig"]), placeFloorPinImage(placeKey, pin), placeKey)) return { refusal: "signature-refused" };
