   114	/** The board tiddler one place's statement rides under. */
   115	export function placeFloorPinKey(placeKey: string): string {
   116	  return `${PLACE_FLOOR_PIN_PREFIX}${placeKey.toLowerCase()}`;
   117	}
   118	
   119	/** Land a statement onto a carriage board draft. Call INSIDE a `handle.change()` callback. Writes no trust: the reader decides. */
   120	export function writePlaceFloorPin(draft: LarDoc, statement: PlaceFloorPinStatement): void {
   121	  const key = placeFloorPinKey(statement.placeKey);
   122	  draft.tiddlers[key] = storedLarRecord(key, { text: JSON.stringify(statement) }, PLACE_FLOOR_PIN_KIND);
   123	}
   124	
   125	/** Every statement-shaped payload a carriage board carries under the sidecar prefix, unread. */
   126	export function placeFloorPinsFromBoard(doc: LarDoc | undefined | null): unknown[] {
   127	  const out: unknown[] = [];
   128	  for (const [title, record] of Object.entries(doc?.tiddlers ?? {})) {
   129	    if (!title.startsWith(PLACE_FLOOR_PIN_PREFIX)) continue;
   130	    const text = tiddlerText(record);
   131	    if (text === null) continue;
   132	    try { out.push(JSON.parse(text) as unknown); } catch { /* a torn sidecar files nothing */ }
   133	  }
   134	  return out;
   135	}
   136	
   137	/**
   138	 * File every statement that reads at `at` into a pair index, each under its place key (the name a carriage peer's dial
   139	 * carries). Returns what filed and why each other one did not.
   140	 */
   141	export function filePlaceFloorPins(
   142	  index: { put(hearth: string, pin: unknown): boolean },
   143	  statements: readonly unknown[],
   144	  at: { readonly nexusHex: string; readonly route: string; readonly carriers: ReadonlySet<string> },
   145	): { readonly filed: readonly string[]; readonly refused: readonly PlaceFloorPinRefusal[] } {
   146	  const filed: string[] = [];
   147	  const refused: PlaceFloorPinRefusal[] = [];
   148	  for (const raw of statements) {
   149	    const read = readPlaceFloorPin(raw, at);
   150	    if ("refusal" in read) { refused.push(read.refusal); continue; }
   151	    if (index.put(read.placeKey, read.pin)) filed.push(read.placeKey);
   152	  }
   153	  return { filed, refused };
   154	}
