    46	/** Does the inception hold exactly its own fields, name one key, and carry that key's signature under `vessel-kel`? */
    47	export function verifyVesselKelInception(inception: VesselKelInception): boolean {
    48	  try {
    49	    if (Object.keys(inception).sort().join(",") !== FIELDS) return false;
    50	    if (inception.t !== "icp" || !Array.isArray(inception.k) || inception.k.length !== 1 || typeof inception.k[0] !== "string") return false;
