\n\tlet causal = worldlineCausalSeed(root);\n\tconst spawned = /* @__PURE__ */ new Set();\n\tconst activePairs = /* @__PURE__ */ new Set();\n\tconst finished = new Set(invalid);\n\tconst failed = new Set(invalid);\n\twhile (ready.length > 0) {\n\t\tconst ev = ready.shift();\n\t\tconst deps = dependencies.get(ev);\n\t\tdependencies.delete(ev);\n\t\tfinished.add(ev);\n\t\tfor (const next of dependents.get(ev) ?? []) {\n\t\t\tconst left = waiting.get(next) - 1;\n\t\t\twaiting.set(next, left);\n\t\t\tif (left === 0) enqueue(next);\n\t\t}\n\t\tif ([...deps].some((d) => failed.has(d))) {\n\t\t\tskipped.push({\n\t\t\t\t...ev,\n\t\t\t\treason: \"dependency-unapplied\"\n\t\t\t});\n\t\t\tfailed.add(ev);\n\t\t\tcontinue;\n\t\t}\n\t\tconst pair = JSON.stringify([ev.subject, ev.object]);\n\t\ttry {\n\t\t\tif (!ev.subject || !ev.object || ev.subject === ev.object) {\n\t\t\t\tskipped.push({\n\t\t\t\t\t...ev,\n\t\t\t\t\treason: \"malformed\"\n\t\t\t\t});\n\t\t\t\tfailed.add(ev);\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tif (ev.op === \"spawn\") {\n\t\t\t\tif (spawned.has(ev.object) || worldlineStampFor(causal, ev.object)) {\n\t\t\t\t\tskipped.push({\n\t\t\t\t\t\t...ev,\n\t\t\t\t\t\treason: \"child-already-spawned\"\n\t\t\t\t\t});\n\t\t\t\t\tfailed.add(ev);\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tif (!worldlineStampFor(causal, ev.subject) && !spawnedObjects.has(ev.subject)) causal = mergeSeed(causal, ev.subject);\n\t\t\t\tcausal = worldlineSpawn(causal, ev.subject, ev.object);\n\t\t\t\tspawned.add(ev.object);\n\t\t\t\tactivePairs.add(pair);\n\t\t\t} else if (ev.op === \"inject\") {\n\t\t\t\tif (!worldlineStampFor(causal, ev.object)) {\n\t\t\t\t\tskipped.push({\n\t\t\t\t\t\t...ev,\n\t\t\t\t\t\treason: \"target-unspawned\"\n\t\t\t\t\t});\n\t\t\t\t\tfailed.add(ev);\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tcausal = worldlineInject(causal, ev.object);\n\t\t\t} else {\n\t\t\t\tif (!activePairs.has(pair) || !worldlineStampFor(causal, ev.subject) || !worldlineStampFor(causal, ev.object)) {\n\t\t\t\t\tskipped.push({\n\t\t\t\t\t\t...ev,\n\t\t\t\t\t\treason: \"pair-unknown\"\n\t\t\t\t\t});\n\t\t\t\t\tfailed.add(ev);\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tcausal = worldlineHandback(causal, ev.subject, ev.object);\n\t\t\t\tactivePairs.delete(pair);\n\t\t\t}\n\t\t} catch {\n\t\t\tskipped.push({\n\t\t\t\t...ev,\n\t\t\t\treason: \"malformed\"\n\t\t\t});\n\t\t\tfailed.add(ev);\n\t\t}\n\t}\n\tfor (const ev of [...dependencies.keys()].sort(compareEvent)) skipped.push({\n\t\t...ev,\n\t\treason: \"cycle\"\n\t});\n\tskipped.sort((a, b) => compareEvent(a, b) || (a.reason < b.reason ? -1 : a.reason > b.reason ? 1 : 0));\n\treturn {\n\t\tcausal,\n\t\tskipped\n\t};\n}\n/** Seed an extra root-like handle into an existing registry (a fresh full-ownership stamp). */\nfunction mergeSeed(c, handle) {\n\tconst seeded = worldlineCausalSeed(handle);\n\treturn { stamps: {\n\t\t...c.stamps,\n\t\t...seeded.stamps\n\t} };\n}\n//#endregion\n//#region src/worldline-read-vm.ts\n/**\n* worldline-read-vm — TW5 startup module: the IN-VM worldline reads (the permainan substrate, the\n* flow-lens foundation), homed in the sovereign daemon worker.\n*\n* The reads live in this island VM, off the node coordinator,\n* under strict sovereign-worker primacy — the cap-stack lifts WHOLE, no coordinator carve-out. The\n* worker holds the LIVE ITC registry and runs every read's COMPUTE; the host ships only external data\n* (edges derived from a transcript, form-vector bytes from the python form store the worker can't\n* reach), exactly as the recall query-derive (`query-derive-vm`) ships its query string IN. This is\n* the worldline twin of that derive module — same one-runtime lock, same pure-subpath idiom.\n*\n* Three wells, two reads:\n*   Well 1 (the TIME axis) — `worldlineCompareVm({ a, b, opens, closes, root })` projects the\n*     WorldlineCausal registry from the carried edge-DAG (worldlineCausalFromEdges), HOLDS it in\n*     module state (so a future read→filter-compute chain can read it), then answers the\n*     concurrent-capable causal verdict (before / after / concurrent / equal) the rhythmic clock\n*     can never give. An unknown handle THROWS (the host surfaces the helpful error).\n*   Well 3 (the CORE) + Well 4 (NULL-READY) — `worldlineTrajectoryVm({ handle, stubs, joinForm,\n*     includeNull, seed, window })` runs the pure Turn→Trajectory functor (orderTrajectory) over the\n*     handle's captured turns, joins each turn's move-space position from the form-vectors the host\n*     shipped (joinFormVectors — a miss leaves a null slot, never drops a turn), and optionally rides\n*     the SAME path through the seeded `shuffleTrajectory` null baseline.\n*\n* ## The temp-tids / TW5-filter pattern (FLAGGED, not built — the enabling design)\n*\n* The operator's vision: a future `lares` CLI read → TW5-filter-compute-on-temp-tids chain, the whole\n* stack lifting in-VM. The clean alignment with THIS module: instead of the JS reads below, write the\n* edge-DAG + the captured turns as TEMP TIDDLERS into the daemon wikistore (titles like\n* `$:/temp/worldline/edge/<n>` and `$:/temp/worldline/turn/<sha>`), then compute compare/trajectory\n* with TW5 filter language over them — so a CLI read could land rows as temp tids and a filter\n* pipeline could chain straight on. Why FLAGGED, not built here: the ITC partial-order (compare) and\n* the happened-before ordering (trajectory) do not map onto stock TW5 filter operators — they'd need\n* two CUSTOM filter operators (`worldline-compare[<a>,<b>]` and `worldline-order[<handle>]`, each a\n* `filteroperator` module reading the temp tids and calling these SAME pure libs), plus a temp-tid\n* writer and a teardown sweep. That is a larger reshaping; the operator's brief sanctions homing the\n* JS reads in the VM module NOW (done) and flagging the temp-tids pattern with this concrete sketch.\n* When that lands, these pure `computeWorldline*` functions become the filter operators' kernel — the\n* compute already lives in-VM, so the move is additive (a tid projection + 2 filter ops), never a\n* second migration.\n*\n* PURE subpath (no Automerge) — the barrel `@lararium/mesh` drags in wasm the plugin build can't bundle.\n*\n* Meme: lar:///ha.ka.ba/lararium/api/agent-worldline#/time\n*/\nvar _causal = null;\nvar _skipped = [];\n/**\n* Well 1 — the ITC LIVE-READ. Project the registry from the edge-DAG (HOLD it), then compare.\n* `ingestEdges` + `compare` fuse into one read (the registry persists as a side\n* effect). THROWS when either handle is unknown to the registry (the host wraps the helpful error).\n*/\nfunction computeWorldlineCompare(input) {\n\tif (input.opens.length > 0 || !_causal) {\n\t\tconst replay = replayWorldlineEdges(input.root ?? \"operator\", input.opens, input.closes ?? []);\n\t\t_causal = replay.causal;\n\t\t_skipped = replay.skipped;\n\t}\n\treturn {\n\t\torder: worldlineCompare(_causal, input.a, input.b),\n\t\tskipped: _skipped\n\t};\n}\n/** The held registry snapshot (read-only) — for inspection / a downstream re-projection. */\nfunction worldlineRegistry() {\n\treturn _causal;\n}\n/**\n* Well 3 (THE CORE) + Well 4 (NULL-READY) — order a handle's captured turns by happened-before, join\n* their move-space positions (from the shipped form-vectors), and optionally ride the SAME path\n* through the seeded null shuffle. PURE relative to its input (the host did the form-store I/O).\n*/\nfunction computeWorldlineTrajectory(input) {\n\tconst steps = input.stubs.map((s) => ({\n\t\tverbatimSha: s.verbatimSha,\n\t\ttickCounter: s.tickCounter\n\t}));\n\tconst ordered = orderTrajectory(input.handle, steps);\n\tconst byKey = /* @__PURE__ */ new Map();\n\tfor (const s of input.stubs) if (!byKey.has(s.verbatimSha)) byKey.set(s.verbatimSha, s.formVector ?? null);\n\tconst trajectory = input.joinForm === false ? ordered : joinFormVectors(ordered, (sha) => byKey.get(sha) ?? null);\n\tif (!input.includeNull) return { trajectory };\n\treturn {\n\t\ttrajectory,\n\t\tnullBaseline: shuffleTrajectory(trajectory, mulberry32(input.seed ?? 1), input.window ?? Number.POSITIVE_INFINITY)\n\t};\n}\nvar name = \"lararium-worldline-read-vm\";\nfunction startup() {\n\tif (!$tw) return;\n\tconst t = $tw;\n\tt.lares ??= {};\n\tt.lares.worldlineCompareVm = (input) => computeWorldlineCompare(input);\n\tt.lares.worldlineTrajectoryVm = (input) => computeWorldlineTrajectory(input);\n}\n//#endregion\nexports.computeWorldlineCompare = computeWorldlineCompare;\nexports.computeWorldlineTrajectory = computeWorldlineTrajectory;\nexports.name = name;\nexports.startup = startup;\nexports.worldlineRegistry = worldlineRegistry;\n","type":"application/javascript","module-type":"startup"},"lar:///ha.ka.ba/lararium/tw5/styles/memetic-gradient":{"title":"lar:///ha.ka.ba/lararium/tw5/styles/memetic-gradient","tags":"$:/tags/Stylesheet","text":"/* Memetic-wikitext parse gradient, made visible in a live wiki.\n   A degraded sigil renders verbatim inside a marked span instead of a silent literal — so pasting turn\n   text into a tiddler and saving SHOWS its parse grade (graceful-parsing#sigil-self-defined-gradient).\n   partial = a recognized sigil in a novel param shape (best-effort); water = an unrecognized form. */\n\n.lar-sigil-degraded {\n\tborder-radius: 0.2em;\n\tpadding: 0 0.15em;\n\tcursor: help;\n\tfont-family: var(--lar-mono, monospace);\n}\n\n/* partial — recognized sigil, novel form: amber, dotted (it almost parsed). */\n.lar-sigil-partial {\n\tcolor: <<colour muted-foreground>>;\n\tbackground: rgba(220, 160, 40, 0.12);\n\tborder-bottom: 1px dotted rgba(200, 140, 30, 0.8);\n}\n\n/* water — unrecognized form: cooler, the inert floor (verbatim, never lost). */\n.lar-sigil-water {\n\tcolor: <<colour muted-foreground>>;\n\tbackground: rgba(120, 140, 170, 0.10);\n\tborder-bottom: 1px dotted rgba(110, 130, 160, 0.7);\n}\n\n/* lar-pin-card / lar-pin-frozen — the shared aka/kanawai pin render (templates/pin/html): a\n   reference meme's citation card, or a content slot's frozen image. lar-pin-digest marks the\n   ni: check badge a frozen image always carries. */\n.lar-pin-card,\n.lar-pin-frozen {\n\tborder: 1px solid <<colour tiddler-border>>;\n\tborder-radius: 0.3em;\n\tpadding: 0.5em 0.75em;\n\tmargin: 0.5em 0;\n}\n\n.lar-pin-digest {\n\tfont-family: var(--lar-mono, monospace);\n\tcolor: <<colour muted-foreground>>;\n\tfont-size: 0.85em;\n}\n"}}}
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/cabal-realm.mem:249:''What each fusion costs, priced elsewhere first.'' Seal ⊗ face: every rotation leaks to shelf readers, and an editor updating a display bearing writes to the object holding the pre-rotation commitment. Face ⊗ compact: a published grant that binds permanently ''freezes the group at founding'' unless it ships its own amendment rule — and fusing outward purpose into internal rules destroys //acted outside its purpose// as a nameable wrong. Compact ⊗ founding act: a founding with no amendment rule yields ''a FORK, never an amendment'', and a fork splits the shelter.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/cabal-realm.mem:253:''ONE JOINT REMAINS, and it reads as the one that mattered'': the split runs through STORAGE, never through AUTHORITY. No threshold, quorum or signature gates any of the three writes, and one operator command still moves ''kahu and seal together'' — a fusion the ruling forbids and the code still owes. ''The kahu quorum (the seal lineage, k-of-n) and the engine CADENCE stand as separate joints'': a cadence threshold seated apart from the kahu quorum — a self-governing lineage with its own inception, its own per-seat pre-rotation and its own seat events, held by those who bear the reboot cost (operators whose places run the engine) — offers the engine and advances the Nexus's rolling window of admitted engines; each device moves only by its own adoption; the kahu quorum never offers an engine, and the cadence threshold never admits anyone. The grammar holds no cadence at all — it lives by use (<<~ loulou "lar:///ha.ka.ba/lararium/mesh/kahu#/contract">>). So the warning this section opens with stands undischarged — //a quorum that rotates keys can silently move the admission price// — because the costs that differ by orders still answer to one hand. Splitting the ceremony is the next act, and it waits on the FORUM below: a threshold gate names who may object, and nobody has said who holds standing.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/cabal-realm.mem:289:The charter reads as a ''pre-rotated, hash-linked, content-addressed epoch chain'' (TUF ≈ KERI, one shape): the genesis commits its signed inception image, with every seat, its rule and successor commitments; each later epoch names its authorizing key-set/quorum AND ''pre-commits one digest per seat of the next epoch's keys'' — so stealing today's council keys ''cannot forge tomorrow's charter.'' ''The mechanism: the keys a roll reveals SIGN it.'' At least threshold of the revealed keys — the ones the prior epoch committed — sign the prior epoch's CID, the seated key-set, the threshold and one next digest per seat (the `charter-seat-roll` domain); a key a seat change adds signs the same bytes as proof of possession; and the lineage verifier checks those signatures at every step. Today's keys cannot sign tomorrow's roll, and tomorrow's PUBLIC keys, once revealed, sign nothing — only the private halves of a committed set move the chain. The commitment runs per seat (`nextKeyDigests[]` · `nextThreshold`, <<~ loulou "lar:///ha.ka.ba/lararium/mesh/kahu#/nexus-scale">>). The per-seat commitment and the signed roll stand in code (`wax-stamp.ts`). It names the seated keys and thresholds; the genesis image carries every seat's signature. A wax-stamp on posted data reads `{artifact-hash · epoch-CID · sealed-at (an ITC/logical BOUND-PAST) · signature by an epoch-N key}` — inline, self-verifying ''island-locally'' (no global read, pono with #causal-islands). The reader trichotomy ''falls out mechanically'': epoch == head & sig ok → ''CURRENT'' · epoch ∈ prev-reachable ancestors & sig ok vs that epoch's key-state → ''PAST-authentic'' · no match / sig fails → ''SPOOF''.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/lararium-identity.mem:187:(certificate-cap revocation needs external state); we follow their concap. KERI pre-rotation rides
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/lararium-identity.mem:505:rotation/recovery rides ''KERI-style pre-rotation'' + ''Kintsugi-style'' guardian-threshold
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/lararium-identity.mem:524:* ''The identity MODEL — RULED (operator, 2026-06-24): Goblins/OCapN capability-is-identity + petnames'' (see #capability-and-petnames). The capability IS the identity; petnames ride the `lar:` l-space regions (stable `ha.ka.ba` / unstable `t1.t2.t3`, ± authority chunk). ''KERI pre-rotation is retained as a sub-lever'' — not the base model, but the tool for rotating the place's //secret root// (the hearth's private face) in the rare root ceremony; it composes under capability-is-identity (rotate the root, keep the capabilities). did:peer's pairwise-root idea folds into unstable petnames.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/research/custody-per-face-2026.mem:59:A YANG scout read the code and a YIN scout read the field, then they traded. The node's place seed rests clear as hex JSON, mode `0600`, and loads at boot with no hand; it signs the place KEL's inception, `carry-for` seals and floor pins, carriage presentations, the floor card and the floor-gate children (through a domain-registered door that never hands out the seed), and it reaches past the floor: the relay gate, the daemon's auth, internal asks, the device-key signer, `deriveDyadVeil` for every face's device veil, and `groupSecretOpenerFromSeed`. The place KEL commits no next key, so a stolen seed re-founds. SSH host keys, the Tor onion master key, WireGuard and ACME account keys load unattended under file permissions; systemd encrypted credentials with TPM2 bind release to the host and its boot state; Vault auto-unseal and Kubernetes secrets move trust to a machine identity; KERI pre-rotation alone makes a theft recoverable. Both scouts ranked a pre-rotated place KEL with a scoped online signer first, a named protected signer second, and a boot door third. The operator ruled the first, its next key riding the founding card, and ruled each face's device veil a random key of its own under that face's FCK. The four handbacks rest verbatim at <<~ loulou "lar:///ha.ka.ba/lares/docs/history/spirit-handback-custody-per-face">> #/r5-yin-wave1-yin-wave-one-internet-scout-place-signer onward.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/research/edge-frontier-2026.mem:20:! The edge frontier, 2026 ~ absence needs a signed boundary
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/face-proof.mem:116:''Each derivation takes the tier, the Nexus and the route under its own name.'' No pin, key, digest or knock of one tier, one Nexus or one route links to another for an outsider: one vessel's floor pin and its sovereign pin for one Nexus share nothing.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/face-proof.mem:372:* ''The sealed frames' layout'': the frame that carries the gate's handshake reply, and the frames that carry a presentation, a frontier and the events beside it. They ride binary WebSocket messages no proxy reads; the layout in `gate-exchange.ts` stands as the house's own; the cutover has landed, and roadmap row `W28` freezes it before the founding bake.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/api/pono/identity-enacts-relation.mem:53:| place signer (a vessel standing a floor) | the vessel, while it stands a floor, whatever its host | its own floor-gate children through the domain-registered door, for the floor's allowlisted duties, and nothing naming a face | under the host's TPM-bound credential where one stands, an owner-only file elsewhere | the place KEL, its next key on the founding card |
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:195:* ''The system wikis release; every other wiki reads the floor'' (operator ruling, 2026-10-16). Only each Nexus's Kahu cabal writes the `lares` and `lararium` wikis and bags live. Every other wiki, and every other hand, mounts them read-only by CID: the latest release that cabal approved. The release rides the Nexus's crossroads board as its public answer, naming the floor CID under the Kahu steward's seal. The cabal approves the exact bytes under its charter's threshold, and a herm carries the answer without signing it. Every wiki mounts that floor through `@oracle`, which never writes. A vessel moves its floor pin only when it accepts a newer signed release. With no Nexus speaking, it stands on its last accepted floor, or on genesis. A face's wikis follow the floor of the Nexus that face stands in, so one vessel may hold two floors and never ties its faces together. An edit aimed at the floor copies up into the wiki's own working layer, and an offering back travels as a draft into the cabal's realm. A lone hearth is a Nexus of one, so its operator stands as its own Kahu. Row `W26` carries the build.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:207:* ''A shared act never makes a shared secret'' (operator ruling, 2026-10-19; four ratcheted research rounds, <<~ loulou "lar:///ha.ka.ba/lares/docs/research/custody-per-face-2026">>). Every act that touches more than one face sorts one of three ways: its private bytes DISSOLVE into the owning face's rows (D), its public bytes stand at the FLOOR by design (F), or it names a vessel SECRET (S) whose principal and opener the house names row by row. A mixed carrier splits before it sorts. The browser holds no vessel key: founding, fleet join, slot changes, roster, archives, handle book, dyads, restore and clear sort D or F, so each tab asks only its own face's unlock and public floor work asks nothing. Phones, installed web apps, probes, the CLI, MCP and watcher seats and a native shell hold no S. A tablet waking floor carries ciphertext and public rows unattended and decrypts no face's row. A container restarts at its floor and nothing unlocks it unattended. A guest island that owns a key store stands as its own vessel. A node holds S only for rows it names: the serving key has no row yet, so it guards nothing today. * ''The place signs by a scoped signer under a pre-rotated KEL'' (operator ruling, 2026-10-19; a fifth research round, <<~ loulou "lar:///ha.ka.ba/lares/docs/research/custody-per-face-2026">> #/the-place-signer). A node's place identity keeps a KEL whose inception commits the next key, and that next key rides the founding card beside the seed charter's cold next key, offline; the online place signer runs unattended for an enumerated allowlist of floor duties alone (the KEL's own events excepted, which the card's key signs), rests under the host's TPM-bound credential where the host offers one and an owner-only file elsewhere, and never rides an environment, an image or a log. A stolen online signer rotates away by the card; a lost card beside a stolen signer re-founds. The floor holds no custody key; it holds its own named place signer. The format change rides the founding bake (`X0`). Today the place KEL commits no next key and the seed reaches past the floor (`vessel-kel.ts`; `node-vessel-identity.ts`).
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:208:* ''Custody and identity read by capability, never by host'' (operator ruling, 2026-10-19: //"I consider node and browser isomorphic-by-intent. Eventually, a browser-vessel somewhere may grow comparable capabilities to a node vessel, and this pattern cascades outwards to all future vessels."//). Three rules hold on every vessel, present and planned: a vessel meets each face through that face's atom alone, its veil signing every dial, join, enrolment, sibling channel and daemon proof made on that face's behalf, never one device-wide key; a vessel holds a place signer exactly while it stands a floor, for the floor's allowlisted duties, under the pre-rotated place KEL; and a faceless vessel reading another's floor proves nothing private, reading the public shelf under the floor card's pin. A node's daemon auth, device-key signer, sibling enrolment and group-secret opener read the one vessel seed today (`open-node-vessel.ts`), and a browser's do the same (`open-browser-vessel.ts`); each is a bond owed, carried by `K15`.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:214:* ''One owner per registry; the floor reads by CID'' (operator ruling, 2026-10-18: //"Architecture stands, leans stand"//). The `@oracle` document as a registry every vessel writes retires: one id carried one `lares` and one `lararium` pointer for the whole fleet, and a joined vessel's pointer replaced its hearth's, a shape a two-vessel probe and three shard runs measured. `@oracle` stands as the floor's read-face over a manifest CID, which a wiki mounts read-only by the pin its face accepted. Each registry carries only what its scope's owner writes: a vessel's bootstrap holds its own document pointers and its accepted floor pins; `@catalog` the operator's documents; the Kahu realm the live `lares` and `lararium` documents and their drafts; the crossroads board the Nexus's one public answer. The leans the ruling adopts: the Kahu realm holds the live system documents, with `bags/` projected on the Kahu's vessel alone; a one-seat founding lands a counted 1-of-1 Kahu-cabal admission for persona zero's group, so one predicate decides every hand's reach into system canon; the release answer, the Nexus's one public answer, names the Nexus AID, the charter epoch, the release before it and the floor manifest CID, sealed by the steward, with the promotion approval over the manifest's exact bytes riding attached; a vessel records an accepted release as a sealed hot row per (face, Nexus) that only a person's act moves; genesis bakes the first floor, a corpus CID in the seed. A signing domain of its own carries the release, `floor-release`, so no seal over another shape verifies as one (operator-approved, 2026-10-18). The shape and its slices stand at <<~ loulou "lar:///ha.ka.ba/lares/docs/pono/w26-floor-lane">>; rows `W26`, `W21` and `P8` carry the build.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:244:* ''The floor announcement'' (house ruling under the operator's delegation, 2026-10-15). `waking-floor-announce` signs one canonical body per carried Nexus under that Nexus's floor bundle signing key: version, Nexus AID, floor route pin digest, floor standing and causal position. It travels only inside an authenticated socket or relay relation. The reader checks the already pinned floor pin, domain, Nexus, route and causal order, and treats the body as a peer hint alone. The reason: a floor hint must neither bootstrap its own trust nor replay across Nexuses. The ruling flips on a smaller body that still refuses cross-Nexus replay, stale replacement and first-contact self-certification.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:256:* ''The edge frontier'' (operator, 2026-10-20, approving the controller's leans after the research at <<~ loulou "lar:///ha.ka.ba/lares/docs/research/edge-frontier-2026">>). Nothing signed today lets a reader tell a device never set aside from a raise erased or withheld, so the house adds a signed ''edge frontier'' per board, its own domain-separated certificate type, the persona KEL resolving its signer's key. Every hand that can raise on a board signs its own stream's frontier (a fleet board's root; a realm board's charter quorum, with its holder where vouch edges raise), and a frontier commits its counted acts through its boundary as a content-addressed snapshot, its parent frontier, and its roster and epoch lineage. A raise shadows its target at once for every reader that sees it, and counts toward widening once its signer registers it into the next frontier. Sync always carries acts, frontiers and snapshots. A widening act (admit, grant, a content key sealed or re-sealed to a reader) reads its target against a frontier of every raising hand that extends any head the reader pinned and includes every raise it has seen; it acts as of that frontier, its receipt naming it, and waits as unknown where none qualifies. Every fleet and realm founds with a signed empty genesis frontier, and an admit bundle carries the current frontier and its snapshot. Until the row stands built, absence reads clear for sync and for widening alike, the gap named. Row `K17`.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:363:''R-CHARTER, the one AID train.'' Its first stage stands landed (train K of #/the-trains): the chairs sign with seat keys of their own and pre-rotate on cold cards, a Nexus answers to `nexus-<sha>`, the floor key commits no next key, per-Nexus keys mint at random, the PersonaGroup stands as a Keyhive group, and the Stable founding act founds a hearth (`lares vessel found --hearth`): the place, persona zero and a PRIVATE seed charter at one seat, with no keyring, every fleet relation bound to that charter's AID, and every harness that founds a hearth founding through it (<<~ loulou "lar:///ha.ka.ba/lararium/mesh/founding-runbook#/found">>). What stays owed:
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:481:* `K17` The edge frontier (#/rulings, the edge frontier, 2026-10-20). Red-first: the frontier certificate and its verifier on node and browser alike; the signed empty genesis at every founding; registration of a raise into its signer's next frontier; the widening reader (admit, grant, a content-key seal) acting as of a qualifying frontier and waiting as unknown otherwise; the admit bundle carrying the frontier and its snapshot; the reader persisting its highest accepted head. Reds: a withheld first raise, a deleted local raise, a stale clean frontier, two conflicting frontiers, a missing snapshot, a concurrent raise and lower, an epoch rollover. Beside Wave C, on the spine. K.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:506:* ''Integrity owed: the floor's trust chain'' (`W14`, `W15`, `W16`: the signed floor card, the pin's causal position, carry-floor convergence). Its witness: a rotation-and-carry storm that accepts no stale pin and converges the same way on every carrier.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:512:* `W14` The floor card a banner carries in its `#floor=` link reads unsigned, on origin trust; a signed card stays owed. The floor read by release (`W26` slice 4) adds one rung and closes nothing here: a browser holding the Nexus AID verifies the epoch lineage, the head release and the floor bytes itself (`browser-floor-read`), anchored to the AID alone, since the genesis epoch re-derives it. The lineage rides the release record and the porch answer, never the card (a card holds 4096 characters, and the lineage self-certifies); that carrier changes nothing about trust, because the AID that anchors it comes from the card or the genesis CID the reader already pins and never from the answer, and an answer self-consistent for another AID refuses (`floor-answer.test`). The AID itself still rides the same-origin trust line, and nothing proves the card's freshness: the signed card (`W14`), the pin's causal position (`W15`) and the carry-floor convergence (`W16`) stay owed for anchoring the AID and the card. W.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:513:* `W15` A floor pin statement carries no causal position, and `hearthPinIndex` files first-wins, so a rotated floor key re-files only on restart (`admit-gate-pin.ts`, `place-floor-pin.ts`). W.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:514:* `W16` Two-vault carry: the carry partials land no floor pin, so a cofounded Nexus carries no herm yet (`nexus-contract.ts`). W.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:524:* `W28` The sealed channel's frame layout (`gate-exchange.ts` `GATE_FRAME`, tags `0x01` to `0x13`) still reads "provisional", owned by no row, while both operators' vessels speak it on every dial (`face-dial.ts`, `face-gate.ts`). It freezes before the bake: the tag table, the fragment bound and the verdict length, with a reserved-tag rule so a later frame adds a tag and moves none. Pairs with the `W10` research pair, since both move the dial's bytes once. W.
/home/joshu/Synthetic-Dream-Machine/bags/lares/ha.ka.ba/lares/docs/stable-founding-road.mem:544:* `X0` The founding bake: one deliberate re-genesis before a second operator stands, after which CIDs are meant to last because another operator pins them. It moves together `K15` step 6 (identity bytes, split stores, slot trees and FCKs, archive and custody formats, each face's random device veil), the place KEL's pre-rotation and the scoped place signer (the signer frames each duty's domain itself, signing `len(D) ‖ D ‖ preimage` and its verifiers the same, so no signed floor image carries its own separation; until then each of the five floor duties binds its domain by an exact head matcher), `W26`'s closing bake (the floor release), and `G37`'s preimage and format renames (`engine/v1` and its kin, the floor announcement's kind, the genesis seed and CAS formats). Each member carries its own readiness red, so the bake waits on the slowest by name, never on a date; the bake's own red: a fresh genesis founds, no CID from before the bake verifies after it, and a mixed old archive refuses by name. The gate it opens: a second operator may found a Nexus fresh at two of two. X.
