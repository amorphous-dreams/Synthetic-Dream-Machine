106:function setOrRemove(element: HTMLElement, name: string, value: string | null): void {
107:  if (value === null) element.removeAttribute(name);
108:  else element.setAttribute(name, value);
109:}
110:
111:/** Paint the vessel's replica of its current relay state; this reports the adapter's causal edges. */
112:export function mountLiveStatus(parent: HTMLElement, state: BrowserConnectionState): () => void {
113:  const connectionRow = makeRow(parent, "crossing", "connection");
114:  const modeRow = makeRow(parent, "mode", "mode");
