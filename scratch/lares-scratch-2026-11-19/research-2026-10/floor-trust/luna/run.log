nvar methods = [\"GET\"];\n/** Stock's own path, so the two skins answer the same address. */\nvar path = /^\\/recipes\\/default\\/tiddlers.json$/;\n/** Above stock's 100, so the server asks this skin first. */\nvar info = { priority: 110 };\nvar STOCK_JSON = \"$:/core/modules/server/routes/get-tiddlers-json.js\";\n/** The dial, and the one value that turns it off. */\nvar FAT_CHILDREN = \"$:/config/lares/memes/fat-children\";\n/** A record that carries a parent is a SLOT CHILD — the listing's own reading of the group law. */\nfunction isSlotChild(fields) {\n\treturn fields !== void 0 && typeof fields[\"$fragment-parent\"] === \"string\";\n}\n/**\n* Put each slot child's `text` back into the answer stock built. A body that is not a JSON array of\n* objects passes through untouched — stock answers an error as stock does.\n*/\nfunction fattenChildren(body, read) {\n\tlet rows;\n\ttry {\n\t\trows = JSON.parse(body);\n\t} catch {\n\t\treturn body;\n\t}\n\tif (!Array.isArray(rows)) return body;\n\tlet moved = false;\n\tfor (const row of rows) {\n\t\tif (!row || typeof row !== \"object\" || Array.isArray(row)) continue;\n\t\tconst entry = row;\n\t\tif (typeof entry[\"title\"] !== \"string\" || entry[\"text\"] !== void 0) continue;\n\t\tconst fields = read(entry[\"title\"]);\n\t\tif (!isSlotChild(fields)) continue;\n\t\tconst text = fields[\"text\"];\n\t\tif (typeof text !== \"string\") continue;\n\t\tentry[\"text\"] = text;\n\t\tmoved = true;\n\t}\n\treturn moved ? JSON.stringify(rows) : body;\n}\nfunction handler(request, response, state) {\n\tconst stock = $tw.modules.execute(STOCK_JSON);\n\tconst asked = state.queryParameters[\"exclude\"] !== void 0;\n\tconst off = (state.wiki.getTiddlerText(\"$:/config/lares/memes/fat-children\", \"yes\") ?? \"yes\").trim() === \"no\";\n\tif (asked || off) {\n\t\tstock.handler(request, response, state);\n\t\treturn;\n\t}\n\tconst skin = {\n\t\t...state,\n\t\tsendResponse: (status, headers, body, encoding) => {\n\t\t\tconst out = status === 200 ? fattenChildren(body, (t) => state.wiki.getTiddler(t)?.fields) : body;\n\t\t\tstate.sendResponse(status, headers, out, encoding);\n\t\t}\n\t};\n\tstock.handler(request, response, skin);\n}\n//#endregion\nexports.FAT_CHILDREN = FAT_CHILDREN;\nexports.fattenChildren = fattenChildren;\nexports.handler = handler;\nexports.info = info;\nexports.methods = methods;\nexports.path = path;\n","type":"application/javascript","module-type":"route"},"lar:///ha.ka.ba/lararium/tw5/modules/place-meme":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/place-meme","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/place-meme\ntype: application/javascript\nmodule-type: library\n\\*/\nlet lararium_deserializer = require(\"lar:///ha.ka.ba/lararium/tw5/modules/deserializer\");\nlet lararium_meme_ast = require(\"lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\");\nlet _lararium_memetic_frame = require(\"lar:///ha.ka.ba/lararium/tw5/lib/memetic-frame\");\nlet smol_toml = require(\"lar:///ha.ka.ba/lararium/tw5/lib/smol-toml\");\n//#region ../lararium-mesh/src/agile-digest.ts\n/** The algorithm tag of the house's sha256 digests — the one RFC 9530 `Repr-Digest` maps to. */\nvar SHA256_ALGO = \"sha256\";\n/** A 32-byte (SHA-256) digest's hex: exactly 64 hex chars. */\nvar SHA256_HEX = /^[0-9a-fA-F]{64}$/;\n/** A digest's hex part (even length ≥ 2) — another algorithm may carry another width. */\nvar HEX_BYTES = /^(?:[0-9a-fA-F]{2})+$/;\n/** A valid algorithm tag: lowercase alnum + dashes (blake3, sha512, sha2-256…). */\nvar ALGO_TAG = /^[a-z0-9][a-z0-9-]*$/;\n/** The RFC 9530 `Repr-Digest` field value: `sha-256=:<base64>:` (one member, the sf-binary item). */\nvar REPR_DIGEST = /^(sha-256)=:([A-Za-z0-9+/]+={0,2}):$/;\nvar B64 = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n/** The lowercase hex of a base64 byte string, or null where the base64 reads torn. Hand-rolled so\n*  the law runs the same in a browser, a plugin VM and node — no `Buffer`, no `atob`. */\nfunction hexOfBase64(b64) {\n\tconst body = b64.replace(/=+$/, \"\");\n\tif (body.length % 4 === 1) return null;\n\tlet bits = 0;\n\tlet acc = 0;\n\tlet hex = \"\";\n\tfor (const ch of body) {\n\t\tconst v = B64.indexOf(ch);\n\t\tif (v < 0) return null;\n\t\tacc = acc << 6 | v;\n\t\tbits += 6;\n\t\tif (bits >= 8) {\n\t\t\tbits -= 8;\n\t\t\thex += (acc >> bits & 255).toString(16).padStart(2, \"0\");\n\t\t}\n\t}\n\treturn hex;\n}\n/**\n* Parse a digest string into `(algo, hex)`.\n*\n*   \"sha256:ab…\"      → { algo: \"sha256\", hex: \"ab…\" }   (tagged, `:`)\n*   \"sha-256=:q80…=:\" → { algo: \"sha256\", hex: \"ab…\" }   (RFC 9530 Repr-Digest)\n*   \"blake3:cd…\"      → { algo: \"blake3\", hex: \"cd…\" }   (another scheme rides free)\n*   \"ab…64…\"          → throws — a bare hex names no algorithm\n*\n* The hex and the algo lowercase. Throws a NAMED error on anything else.\n*\n* The split falls on the first `:` only, and holds only when the head reads as an\n* algorithm tag and the tail as hex — hex holds no `:`, so no value mis-splits.\n*/\nfunction parseDigest(digest) {\n\tif (typeof digest !== \"string\" || digest.length === 0) throw new TypeError(`parseDigest: empty or non-string digest`);\n\tconst repr = REPR_DIGEST.exec(digest);\n\tif (repr) {\n\t\tconst hex = hexOfBase64(repr[2]);\n\t\tif (hex === null || !SHA256_HEX.test(hex)) throw new TypeError(`parseDigest: malformed tagged digest \"${digest}\"`);\n\t\treturn {\n\t\t\talgo: SHA256_ALGO,\n\t\t\thex\n\t\t};\n\t}\n\tconst sepIndex = digest.indexOf(\":\");\n\tif (sepIndex > 0) {\n\t\tconst algo = digest.slice(0, sepIndex).toLowerCase();\n\t\tconst hex = digest.slice(sepIndex + 1).toLowerCase();\n\t\tif (ALGO_TAG.test(algo) && HEX_BYTES.test(hex)) return {\n\t\t\talgo,\n\t\t\thex\n\t\t};\n\t\tthrow new TypeError(`parseDigest: malformed tagged digest \"${digest}\"`);\n\t}\n\tif (HEX_BYTES.test(digest)) throw new TypeError(`parseDigest: bare hex \"${digest.slice(0, 16)}…\" names no algorithm — write it tagged (\\`sha256:<hex>\\`)`);\n\tthrow new TypeError(`parseDigest: not a tagged digest \"${digest}\"`);\n}\n/** Emit the canonical tagged form `algo:hex`. Lowercases both; validates the\n*  algo tag and the hex so a producer never writes a malformed value. */\nfunction formatDigest(algo, hex) {\n\tconst a = algo.toLowerCase();\n\tconst h = hex.toLowerCase();\n\tif (!ALGO_TAG.test(a)) throw new TypeError(`formatDigest: bad algorithm tag \"${algo}\"`);\n\tif (!HEX_BYTES.test(h)) throw new TypeError(`formatDigest: bad hex \"${hex}\"`);\n\treturn `${a}:${h}`;\n}\n/**\n* Two digests name the SAME content iff both parse and carry the same algorithm and the same hex,\n* whichever accepted spelling each rides in. A side that does not parse — a bare hex among them —\n* reads NOT-equal and never throws: a comparator on a hot path surfaces a mismatch, it does not crash\n* ingest. A caller that wants the refusal named calls `parseDigest`.\n*/\nfunction digestsEqual(a, b) {\n\tlet pa;\n\tlet pb;\n\ttry {\n\t\tpa = parseDigest(a);\n\t} catch {\n\t\treturn false;\n\t}\n\ttry {\n\t\tpb = parseDigest(b);\n\t} catch {\n\t\treturn false;\n\t}\n\treturn pa.algo === pb.algo && pa.hex === pb.hex;\n}\n//#endregion\n//#region src/meme-ast/diagnostics.ts\nvar MEMETIC_SOURCE = \"text/memetic-wikitext+tiddlywiki\";\n/** Worst severity first, so a grade moves only when the worst class of fault moves. */\nvar SEVERITY_RANK = {\n\terror: 1,\n\twarning: 2,\n\tinfo: 3,\n\thint: 4\n};\n/**\n* The ladder, stated once.\n*\n* `error` names the one fault that costs the operator their bytes: a carrier that stops\n* round-tripping no longer says what their hands left, so the shore refuses it rather than\n* ingesting a lossy render. Every recovery sits below that line, because a recovery keeps the\n* text: the driver stands an unplaceable construct back up verbatim in an Error node, and grades\n* how far it fell. `warning` marks a construct the grammar could not place; `info` marks one it\n* repaired at lower standing. Refusing a recovery would drop the bytes to protect the grammar,\n* which inverts what the shore exists to do.\n*/\nfunction severityOf(failure) {\n\treturn severityOfRung(failure.recoveredAs);\n}\nfunction severityOfRung(rung) {\n\tswitch (rung) {\n\t\tcase \"missing\": return \"warning\";\n\t\tcase \"water\": return \"warning\";\n\t\tcase \"partial\": return \"info\";\n\t\tcase \"repaired\": return \"info\";\n\t\tdefault: return \"warning\";\n\t}\n}\n/** The shore's fault: the carrier stopped round-tripping, so ingesting it would lose the bytes. */\nvar SHORE_FAULT_CODE = \"shore-round-trip\";\nfunction shoreDiagnostic(message, sourceLength) {\n\treturn {\n\t\tfrom: 0,\n\t\tto: sourceLength,\n\t\tseverity: \"error\",\n\t\tsource: MEMETIC_SOURCE,\n\t\tcode: SHORE_FAULT_CODE,\n\t\tmessage\n\t};\n}\nfunction clamp(value, low, high) {\n\treturn Math.max(low, Math.min(value, high));\n}\nfunction failuresToDiagnostics(failures, sourceLength, source = MEMETIC_SOURCE) {\n\treturn failures.map((failure) => {\n\t\tconst from = clamp(failure.pos, 0, sourceLength);\n\t\treturn {\n\t\t\tfrom,\n\t\t\tto: clamp(failure.pos + failure.raw.length, from, sourceLength),\n\t\t\tseverity: severityOf(failure),\n\t\t\tsource,\n\t\t\tcode: failure.reason,\n\t\t\tmessage: failure.sigilName ? `The ${failure.sigilName} sigil recovered as ${failure.recoveredAs}: ${failure.reason}` : `The parser recovered this span as ${failure.recoveredAs}: ${failure.reason}`\n\t\t};\n\t});\n}\n/** The carrier's grade: the worst severity it carries, or `clean` when it carries none. */\nfunction gradeOf(diagnostics) {\n\tlet worst = \"clean\";\n\tfor (const diagnostic of diagnostics) if (worst === \"clean\" || SEVERITY_RANK[diagnostic.severity] < SEVERITY_RANK[worst]) worst = diagnostic.severity;\n\treturn worst;\n}\nvar LAR_PREFIX = `lar:///ha.ka.ba/`;\nvar TAG_PREFIX = `${LAR_PREFIX}tags/`;\nvar VOLATILE_VM_PREFIX = `lar:///lararium.local.vm/`;\nfunction volatileVmUri(path) {\n\treturn `${VOLATILE_VM_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableLarUri(path) {\n\treturn `${LAR_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableTagUri(name) {\n\treturn `${TAG_PREFIX}${name.replace(/^\\/+/, \"\")}`;\n}\nvolatileVmUri(\"verb/\");\nvar BAGS_SEGMENT = \"bags\";\n/** Mint the canonical URI of a BAG (a composable recipe piece; mutable, the IPNS plane). */\nfunction bagUri(slug) {\n\treturn stableLarUri(`${BAGS_SEGMENT}/${slug}`);\n}\nbagUri(\"oracle\");\nbagUri(\"lararium\");\nvar CATALOG_DOC_URI = bagUri(\"catalog\");\nbagUri(\"lares\");\nbagUri(\"crossroads\");\nstableLarUri(\"lararium/plugins/lares/memetic-wikitext\");\nvar GRAMMAR_TAG = stableTagUri(\"SharktoothSigil\");\nstableTagUri(\"lararium-parse-warnings\");\nstableTagUri(\"lararium-bag-mirror\");\nstableTagUri(\"lares-verb\");\nstableTagUri(\"lares-verb-event\");\nstableTagUri(\"lares-pin\");\nstableTagUri(\"cap-event\");\nstableTagUri(\"cap-event/prekey\");\nstableTagUri(\"cap-event/cgka\");\nstableTagUri(\"cap-event/delegation\");\nstableTagUri(\"cap-event/revocation\");\nstableLarUri(\"state/boot-splash/active\");\nbagUri(\"identities\");\nbagUri(\"circles\");\nbagUri(\"sessions\");\n`${CATALOG_DOC_URI}`;\n/** Daemon wiki bag id — the lararium's own central daemon `daemon` bag (one-recipe model).\n*  SOVEREIGN-per-vessel: this vessel's own control-plane, never shared across vessels. */\nvar DAEMON_BAG_ID = bagUri(\"daemon\");\n/** The persona NAMESPACE — two jobs, and a reader who fuses them will look for a bag that does not exist.\n*\n*  The word is deliberate. SDSI's ruling on this exact shape reads \"a NAMESPACE, not a super-key\" — a place\n*  local names hang from, carrying no authority of its own. Calling it a ROOT would claim the opposite and\n*  name the very thing canon forbids above a person's compartments.\n*\n*  ① The TITLE prefix every PersonaGroup plane uses INSIDE its own document: the signer pin, the KEL\n*     prefix, the selves, the binding records all spell `pers