*   - lar-kind == \\\"family\\\" → FamilyRule\\n*\\n* Grammar fully self-hosted: every sigil and family rule carries as a tiddler.\\n* The `toml` data-fence sigil lives at lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-toml.\\n*/\\nfunction buildGrammarFromWiki(wiki) {\\n\\tconst titles = wiki.filterTiddlers(`[all[shadows+tiddlers]tag[${GRAMMAR_TAG}]]`);\\n\\tconst sigils = [];\\n\\tconst families = [];\\n\\tfor (const title of titles) {\\n\\t\\tconst fields = wiki.getTiddler(title)?.fields ?? {};\\n\\t\\tconst family = familyFromFields(title, fields);\\n\\t\\tif (family) {\\n\\t\\t\\tfamilies.push(family);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tconst rule = sigilFromFields(title, fields);\\n\\t\\tif (rule) sigils.push(rule);\\n\\t}\\n\\tif (sigils.length === 0 && families.length === 0) return null;\\n\\treturn {\\n\\t\\tsigils,\\n\\t\\tfamilies\\n\\t};\\n}\\n//#endregion\\nexports.GRAMMAR_TAG = GRAMMAR_TAG;\\nexports.after = after;\\nexports.familyFromFields = familyFromFields;\\nexports.getGrammar = getGrammar;\\nexports.name = name;\\nexports.nameFromTitle = nameFromTitle;\\nexports.resetGrammar = resetGrammar;\\nexports.sigilFromFields = sigilFromFields;\\nexports.startup = startup;\\nexports.vocabularyCidOf = vocabularyCidOf;\\n\",\"type\":\"application/javascript\",\"module-type\":\"startup\"},\"lar:///ha.ka.ba/lararium/tw5/modules/host-globals\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/host-globals\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/host-globals\\ntype: application/javascript\\nmodule-type: startup\\n\\\\*/\\n//#region src/host-globals-lend.ts\\n/** Define one global where the sandbox lacks it — non-enumerable, so a leak check never lists it. */\\nfunction lend(g, name, value) {\\n\\tif (g[name] !== void 0 && g[name] !== null) return;\\n\\tObject.defineProperty(g, name, {\\n\\t\\tvalue,\\n\\t\\twritable: true,\\n\\t\\tconfigurable: true,\\n\\t\\tenumerable: false\\n\\t});\\n}\\n/**\\n* Lend `TextEncoder`, `TextDecoder` and `crypto` into `g` where they stand absent. Idempotent; silent\\n* where `process.getBuiltinModule` stands out of reach (a browser, a worker, an older Node).\\n*/\\nfunction lendHostGlobals(g = globalThis, host) {\\n\\tif (g.TextEncoder && g.TextDecoder && g.crypto) return;\\n\\tconst builtin = host?.getBuiltinModule;\\n\\tif (typeof builtin !== \\\"function\\\") return;\\n\\tconst util = builtin(\\\"node:util\\\");\\n\\tconst nodeCrypto = builtin(\\\"node:crypto\\\");\\n\\tlend(g, \\\"TextEncoder\\\", util.TextEncoder);\\n\\tlend(g, \\\"TextDecoder\\\", util.TextDecoder);\\n\\tlend(g, \\\"crypto\\\", nodeCrypto.webcrypto);\\n}\\n//#endregion\\n//#region src/modules/host-globals.ts\\n/**\\n* host-globals — lend the module sandbox the web globals the host already holds.\\n*\\n* A plain TiddlyWiki server executes every module in ONE shared `vm.createContext({})`\\n* (`boot.js` `$tw.utils.sandbox`), lending it `Buffer`, `process`, timers and `$tw` — no `TextEncoder`,\\n* no `crypto`. The meme gate hashes through `new TextEncoder()`, so without this shore every hashing\\n* module (the routes, the grammar cache, the deserializer past boot) dies on a plain server with\\n* `TextEncoder is not defined`. Node ≥ 24 hands the host's own copies back through\\n* `process.getBuiltinModule`; `??=` respects any global the runtime already holds, so a browser or a\\n* lararium worker (both already carry them) reads this as a no-op.\\n*\\n* The lend itself lives in `host-globals-lend` and defines each global NON-ENUMERABLE, so the fork's\\n* per-module `globalCheck` never reports it as a leak. The deserializer calls the same lend at its own\\n* entry, so a reader reached before this startup module runs holds too.\\n*/\\nvar name = \\\"lar-host-globals\\\";\\nvar synchronous = true;\\nvar before = [\\\"startup\\\"];\\nfunction startup() {\\n\\tlendHostGlobals(globalThis, typeof process === \\\"undefined\\\" ? void 0 : process);\\n}\\n//#endregion\\nexports.before = before;\\nexports.name = name;\\nexports.startup = startup;\\nexports.synchronous = synchronous;\\n\",\"type\":\"application/javascript\",\"module-type\":\"startup\"},\"lar:///ha.ka.ba/lararium/tw5/modules/import-floor-upgrader\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/import-floor-upgrader\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/import-floor-upgrader\\ntype: application/javascript\\nmodule-type: upgrader\\n\\\\*/\\nlet lararium_deserializer = require(\\\"lar:///ha.ka.ba/lararium/tw5/modules/deserializer\\\");\\n//#region src/modules/import-floor-upgrader.ts\\n/**\\n* import-floor-upgrader — the quoteblock floor, made visible where TiddlyWiki's own import doors land.\\n*\\n* Import, drag-drop, paste and the boot-folder load all read a carrier through the registered\\n* `text/memetic-wikitext+tiddlywiki` deserializer, which lays the floor (`ahu.mem#/quoteblock-floor`)\\n* and holds a torn frame verbatim. Import and drop then stage every incoming record in `$:/Import` for\\n* the operator to review, and TiddlyWiki hands that staging to every `upgrader` module: a message an\\n* upgrader answers for a title stands beside that title in the import listing (`message-<title>`).\\n*\\n* So the fence speaks there, before anything lands. A fenced carrier names the faults its fence holds;\\n* a torn carrier names the frame faults it was held verbatim under. Nothing is unchecked or changed —\\n* the operator reads the account and decides; an upgrader that edited the payload would decide for them.\\n*/\\n/** TiddlyWiki's upgrader contract: incoming titles and their fields in, a message per title out. */\\nfunction upgrade(_wiki, titles, tiddlers) {\\n\\tconst messages = {};\\n\\tfor (const title of titles) {\\n\\t\\tconst fields = tiddlers[title];\\n\\t\\tif (!fields) continue;\\n\\t\\tconst torn = fields[lararium_deserializer.TORN_FIELD];\\n\\t\\tconst fenced = fields[lararium_deserializer.QUOTEBLOCKED_FIELD];\\n\\t\\tif (typeof torn === \\\"string\\\" && torn !== \\\"\\\") messages[title] = `Torn frame — held verbatim as plain text, never read as a meme: ${torn}`;\\n\\t\\telse if (typeof fenced === \\\"string\\\" && fenced !== \\\"\\\") messages[title] = `Quoteblocked — ${fenced}`;\\n\\t}\\n\\treturn messages;\\n}\\n//#endregion\\nexports.upgrade = upgrade;\\n\",\"type\":\"application/javascript\",\"module-type\":\"upgrader\"},\"lar:///ha.ka.ba/lararium/tw5/wikirules/lar-declaration\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/wikirules/lar-declaration\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/wikirules/lar-declaration\\ntype: application/javascript\\nmodule-type: wikirule\\n\\\\*/\\n//#region src/wikirules/lar-declaration.ts\\n/** `<<!WORD …>>` at line start — the whole declaration class, one rule. */\\nvar DECLARATION_RE = /<<![A-Z][A-Z0-9-]*\\\\s[^>]*>>/g;\\nvar name = \\\"lar-declaration\\\";\\nvar types = { block: true };\\nfunction init(parser) {\\n\\tthis.parser = parser;\\n}\\nfunction findNextMatch(startPos) {\\n\\tconst source = this.parser.source;\\n\\tDECLARATION_RE.lastIndex = startPos;\\n\\tconst m = DECLARATION_RE.exec(source);\\n\\tif (!m) return void 0;\\n\\tthis.matchPos = m.index;\\n\\tthis.matchEnd = DECLARATION_RE.lastIndex;\\n\\tthis.attrs = { __literal__: m[0] };\\n\\treturn m.index;\\n}\\nfunction parse() {\\n\\tconst parser = this.parser;\\n\\tparser.pos = this.matchEnd;\\n\\treturn [{\\n\\t\\ttype: \\\"text\\\",\\n\\t\\ttext: this.attrs[\\\"__literal__\\\"]\\n\\t}];\\n}\\n//#endregion\\nexports.findNextMatch = findNextMatch;\\nexports.init = init;\\nexports.name = name;\\nexports.parse = parse;\\nexports.types = types;\\n\",\"type\":\"application/javascript\",\"module-type\":\"wikirule\"},\"lar:///ha.ka.ba/lararium/tw5/filters/lar-kind\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/filters/lar-kind\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/filters/lar-kind\\ntype: application/javascript\\nmodule-type: filteroperator\\n\\\\*/\\n//#region src/filters/lar-kind.ts\\n/**\\n* The view-state titles that follow a person rather than a device or a wiki. TiddlyWiki names no\\n* predicate for this set; the house names it here and the bag-paths cascade reads it through this\\n* operator, so the set has one spelling.\\n*/\\nvar PERSONAL_TITLE_EXACT = [\\\"$:/StoryList\\\", \\\"$:/palette\\\"];\\nvar PERSONAL_TITLE_PREFIXES = [\\\"$:/state/folded/\\\", \\\"$:/state/tab-\\\"];\\nfunction isPersonalTitle(title) {\\n\\treturn PERSONAL_TITLE_EXACT.includes(title) || PERSONAL_TITLE_PREFIXES.some((p) => title.startsWith(p));\\n}\\n/** The kind of one tiddler, reading TiddlyWiki's own predicates in their order of specificity. */\\nfunction kindOf(wiki, title, tiddler) {\\n\\tif (wiki.isVolatileTiddler(title)) return \\\"volatile\\\";\\n\\tif (wiki.isTemporaryTiddler(title)) return \\\"temporary\\\";\\n\\tif (tiddler?.isDraft?.() === true) return \\\"draft\\\";\\n\\tif (isPersonalTitle(title)) return \\\"personal\\\";\\n\\tif (wiki.isSystemTiddler(title)) return \\\"system\\\";\\n\\treturn \\\"content\\\";\\n}\\nfunction larKind(source, _operator, options) {\\n\\tconst results = [];\\n\\tsource(function(tiddler, title) {\\n\\t\\tresults.push(kindOf(options.wiki, title, tiddler));\\n\\t});\\n\\treturn results;\\n}\\n//#endregion\\nexports.PERSONAL_TITLE_EXACT = PERSONAL_TITLE_EXACT;\\nexports.PERSONAL_TITLE_PREFIXES = PERSONAL_TITLE_PREFIXES;\\nexports.isPersonalTitle = isPersonalTitle;\\nexports.kindOf = kindOf;\\nexports[\\\"lar-kind\\\"] = larKind;\\nexports.larKind = larKind;\\n\",\"type\":\"application/javascript\",\"module-type\":\"filteroperator\"},\"lar:///ha.ka.ba/lararium/tw5/modules/lar-root-services\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/lar-root-services\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/lar-root-services\\ntype: application/javascript\\nmodule-type: startup\\n\\\\*/\\n//#region src/modules/lar-root-services.ts\\n/**\\n* lar-root-services — the root `tm-*` messages a worker island answers itself, and the host doors it asks the\\n* surface to open (dreamdom#/host-services; open ruling 9 as the house reads it).\\n*\\n* Stock TW5 binds these root-widget listeners under `platforms: [\\\"browser\\\"]` alone, so an island that renders\\n* through a fake document heard none of them. This module binds them where no browser stands, in two halves:\\n*\\n*   PURE WIKI LOGIC, run here.\\n*     tm-rename-tiddler · tm-relink-tiddler   stock's own handler, over `$tw.wiki`.\\n*     tm-home                                 the story from `$:/DefaultTiddlers`, through the stock hook.\\n*     tm-modal · tm-show-switcher             a record under `$:/temp/lares/modal/`, painted by the root layer\\n*                                             as an `aria-modal` dialog; its own close message removes it.\\n*     tm-notify                               a record under `$:/temp/lares/notify/`, painted by the root layer,\\n*                                             removed after the notification duration.\\n*     tm-scroll · tm-focus-selector           HINTS the frame carries: `$:/temp/lares/hint/{scroll,focus}` with a\\n*                                             selector and a rising number, painted as `data-lar-scroll-to` /\\n*                                             `data-lar-focus` beside `data-lar-hint`. The page scrolls and\\n*                                             focuses; the island never measures.\\n*\\n*   HOST DOORS, asked through `$tw.lares.serviceDoor` (the mounted camera posts `lar:service` on `ctx.post`).\\n*     tm-copy-to-clipboard → clipboard {text}            the success or failure notification on the answer\\n*     tm-download-file     → download {filename, text, type}   the template rendered here, as stock saves it\\n*     tm-open-window       → open-surface {title, …}\\n*     tm-open-external-window → open-external {url, …}\\n*     tm-print             → print {}\\n*     tm-full-screen       → fullscreen {mode}\\n*   A refusal, at once or on the answer, raises `$:/temp/lares/alert/refused/<kind>` tagged `$:/tags/Alert`.\\n*\\n*   REFUSED BY NAME.\\n*     tm-http-request      the Web3-only law: an island makes no HTTP request; `$:/temp/lares/alert/refused/http-request`.\\n*\\n* A browser page that runs stock TW5 keeps stock's own listeners: this module binds nothing there.\\n*/\\nvar name = \\\"lar-root-services\\\";\\nvar after = [\\\"startup\\\"];\\nvar synchronous = true;\\nvar ALERT_REFUSED_PREFIX = \\\"$:/temp/lares/alert/refused/\\\";\\nvar NOTIFY_PREFIX = \\\"$:/temp/lares/notify/\\\";\\nvar MODAL_PREFIX = \\\"$:/temp/lares/modal/\\\";\\nvar HINT_SCROLL = \\\"$:/temp/lares/hint/scroll\\\";\\nvar HINT_FOCUS = \\\"$:/temp/lares/hint/focus\\\";\\nvar COPY_OK = \\\"$:/language/Notifications/CopiedToClipboard/Succeeded\\\";\\nvar COPY_FAILED = \\\"$:/language/Notifications/CopiedToClipboard/Failed\\\";\\nvar SWITCHER = \\\"$:/core/ui/SwitcherModal\\\";\\nvar DEFAULT_SAVE_TEMPLATE = \\\"$:/core/save/all\\\";\\nvar DEFAULT_EXTERNAL = \\\"https://tiddlywiki.com/\\\";\\nfunction startup() {\\n\\tif (!$tw || $tw.browser || !$tw.rootWidget) return;\\n\\tinstallRootServices($tw);\\n}\\n/** Bind every root listener this module names on `tw.rootWidget`. Exported so a vector binds a wiki it built. */\\nfunction installRootServices(tw) {\\n\\tconst root = tw.rootWidget;\\n\\tconst wiki = tw.wiki;\\n\\tlet seq = 0;\\n\\tconst next = () => String(++seq).padStart(6, \\\"0\\\");\\n\\tconst variablesOf = (event) => JSON.stringify(event.paramObject ?? {});\\n\\tconst alert = (kind, text) => {\\n\\t\\twiki.addTiddler({\\n\\t\\t\\ttitle: ALERT_REFUSED_PREFIX + kind,\\n\\t\\t\\ttext,\\n\\t\\t\\ttags: [\\\"$:/tags/Alert\\\"],\\n\\t\\t\\tcomponent: name,\\n\\t\\t\\tmodified: /* @__PURE__ */ new Date()\\n\\t\\t});\\n\\t};\\n\\tconst notify = (title, variables = \\\"{}\\\") => {\\n\\t\\tconst record = NOTIFY_PREFIX + next();\\n\\t\\twiki.addTiddler({\\n\\t\\t\\ttitle: record,\\n\\t\\t\\ttext: title,\\n\\t\\t\\t\\\"lar-variables\\\": variables\\n\\t\\t});\\n\\t\\tsetTimeout(() => wiki.deleteTiddler(record), tw.config?.preferences?.notificationDuration ?? 3e3);\\n\\t};\\n\\t/** Ask the surface for a door; the answer runs `then` with the status, and a refusal raises the kind's alert. */\\n\\tconst ask = (message, kind, args, then = () => {}) => {\\n\\t\\tconst door = tw.lares?.[\\\"serviceDoor\\\"];\\n\\t\\tconst settle = (status) => {\\n\\t\\t\\tif (status !== \\\"ok\\\") alert(kind, `This surface opens no ${kind} door: ${message} refused (${status}).`);\\n\\t\\t\\tthen(status);\\n\\t\\t};\\n\\t\\tif (!door) {\\n\\t\\t\\tsettle(\\\"page-action-unavailable\\\");\\n\\t\\t\\treturn;\\n\\t\\t}\\n\\t\\tdoor.ask(kind, args, settle);\\n\\t};\\n\\t/** Only the named fields that stand, as strings. */\\n\\tconst present = (from, names) => Object.fromEntries(names.filter((n) => from?.[n] !== void 0 && from[n] !== \\\"\\\").map((n) => [n, String(from[n])]));\\n\\tconst rename = (method) => (event) => {\\n\\t\\tconst p = event.paramObject ?? {};\\n\\t\\tconst from = p[\\\"from\\\"] ?? event.tiddlerTitle;\\n\\t\\tif (!from || !p[\\\"to\\\"]) return;\\n\\t\\twiki[method](from, p[\\\"to\\\"], {\\n\\t\\t\\tdontRenameInTags: p[\\\"renameInTags\\\"] === \\\"false\\\" || p[\\\"renameInTags\\\"] === \\\"no\\\",\\n\\t\\t\\tdontRenameInLists: p[\\\"renameInLists\\\"] === \\\"false\\\" || p[\\\"renameInLists\\\"] === \\\"no\\\"\\n\\t\\t});\\n\\t};\\n\\troot.addEventListener(\\\"tm-rename-tiddler\\\", rename(\\\"renameTiddler\\\"));\\n\\troot.addEventListener(\\\"tm-relink-tiddler\\\", rename(\\\"relinkTiddler\\\"));\\n\\troot.addEventListener(\\\"tm-home\\\", () => {\\n\\t\\tconst story = tw.hooks.invokeHook(\\\"th-opening-default-tiddlers-list\\\", wiki.filterTiddlers(wiki.getTiddlerText(\\\"$:/DefaultTiddlers\\\") ?? \\\"\\\"));\\n\\t\\twiki.addTiddler({\\n\\t\\t\\ttitle: \\\"$:/StoryList\\\",\\n\\t\\t\\ttext: \\\"\\\",\\n\\t\\t\\tlist: story,\\n\\t\\t\\t...wiki.getModificationFields()\\n\\t\\t});\\n\\t\\tif (story[0]) wiki.addToHistory(story[0]);\\n\\t});\\n\\tconst modal = (title, event) => {\\n\\t\\twiki.addTiddler({\\n\\t\\t\\ttitle: MODAL_PREFIX + next(),\\n\\t\\t\\ttext: title,\\n\\t\\t\\t\\\"lar-variables\\\": variablesOf(event)\\n\\t\\t});\\n\\t};\\n\\troot.addEventListener(\\\"tm-modal\\\", (event) => {\\n\\t\\tif (event.param) modal(event.param, event);\\n\\t});\\n\\troot.addEventListener(\\\"tm-show-switcher\\\", (event) => modal(SWITCHER, event));\\n\\troot.addEventListener(\\\"tm-notify\\\", (event) => {\\n\\t\\tif (event.param) notify(event.param, variablesOf(event));\\n\\t});\\n\\tconst ridSelector = (event) => {\\n\\t\\tconst rid = event.target?.attributes?.[\\\"data-lar-rid\\\"] ?? event.event?.target?.attributes?.[\\\"data-lar-rid\\\"];\\n\\t\\treturn rid === void 0 ? void 0 : `[data-lar-rid=\\\"${rid}\\\"]`;\\n\\t};\\n\\troot.addEventListener(\\\"tm-scroll\\\", (event) => {\\n\\t\\tconst selector = event.paramObject?.[\\\"selector\\\"] || ridSelector(event);\\n\\t\\tif (selector) wiki.addTiddler({\\n\\t\\t\\ttitle: HINT_SCROLL,\\n\\t\\t\\tselector,\\n\\t\\t\\tseq: next()\\n\\t\\t});\\n\\t});\\n\\troot.addEventListener(\\\"tm-focus-selector\\\", (event) => {\\n\\t\\tif (!event.param) return;\\n\\t\\twiki.addTiddler({\\n\\t\\t\\ttitle: HINT_FOCUS,\\n\\t\\t\\tselector: event.param,\\n\\t\\t\\tseq: next(),\\n\\t\\t\\t...present(event.paramObject, [\\\"preventScroll\\\"])\\n\\t\\t});\\n\\t});\\n\\troot.addEventListener(\\\"tm-copy-to-clipboard\\\", (event) => {\\n\\t\\tconst p = event.paramObject ?? {};\\n\\t\\task(event.type, \\\"clipboard\\\", {\\n\\t\\t\\ttext: event.param ?? \\\"\\\",\\n\\t\\t\\t...p[\\\"plainText\\\"] ? { plainText: true } : {}\\n\\t\\t}, (status) => {\\n\\t\\t\\tnotify(status === \\\"ok\\\" ? p[\\\"successNotification\\\"] || COPY_OK : p[\\\"failureNotification\\\"] || COPY_FAILED);\\n\\t\\t});\\n\\t});\\n\\troot.addEventListener(\\\"tm-download-file\\\", (event) => {\\n\\t\\tconst template = event.param || DEFAULT_SAVE_TEMPLATE;\\n\\t\\t