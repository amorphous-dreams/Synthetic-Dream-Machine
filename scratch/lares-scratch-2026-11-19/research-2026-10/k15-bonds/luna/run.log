    76	async function checkpointKey(seed: Uint8Array, domain: string): Promise<CryptoKey> {
    77	  const material = await crypto.subtle.importKey("raw", Uint8Array.from(seed), "HKDF", false, ["deriveKey"]);
    78	  return crypto.subtle.deriveKey(
    79	    { name: "HKDF", hash: "SHA-256", salt: new Uint8Array(0), info: new TextEncoder().encode(domain) },
    80	    material, { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"],
    81	  );
    82	}
    83	
    84	export async function sealCheckpoint(value: unknown, seed: Uint8Array, domain: string = FACE_CHECKPOINT_INFO): Promise<string> {
    85	  const nonce = crypto.getRandomValues(new Uint8Array(12));
    86	  const plaintext = new TextEncoder().encode(JSON.stringify(value));
    87	  const data = new Uint8Array(await crypto.subtle.encrypt({ name: "AES-GCM", iv: nonce, additionalData: new TextEncoder().encode(domain) }, await checkpointKey(seed, domain), plaintext));
    88	  return JSON.stringify({ nonce: bytesToBase64(nonce), data: bytesToBase64(data) });
    89	}
    90	
    91	export async function openCheckpoint<T>(text: string, seed: Uint8Array, domain: string = FACE_CHECKPOINT_INFO): Promise<T> {
    92	  try {
    93	    const sealed = JSON.parse(text) as { nonce: string; data: string };
    94	    const plaintext = await crypto.subtle.decrypt({ name: "AES-GCM", iv: Uint8Array.from(base64ToBytes(sealed.nonce)), additionalData: new TextEncoder().encode(domain) }, await checkpointKey(seed, domain), Uint8Array.from(base64ToBytes(sealed.data)));
    95	    return JSON.parse(new TextDecoder().decode(plaintext)) as T;
    96	  } catch { throw new Error("[ceremony] checkpoint does not open for this atom"); }
    97	}
