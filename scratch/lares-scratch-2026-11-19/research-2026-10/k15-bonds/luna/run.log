    41	export function scanText(file, text) {
    42	  const found = [];
    43	  let block = false;
    44	  text.split(/\r?\n/).forEach((raw, index) => {
    45	    let code = '';
    46	    for (let i = 0; i < raw.length; i++) {
    47	      if (block) { if (raw[i] === '*' && raw[i + 1] === '/') { block = false; i++; } continue; }
    48	      if (raw[i] === '/' && raw[i + 1] === '*') { block = true; i++; continue; }
    49	      if (raw[i] === '/' && raw[i + 1] === '/') break;
    50	      code += raw[i];
    51	    }
    52	    if (TOKEN.test(code) || (file === 'packages/lararium-browser/src/browser-vessel-identity.ts' && /signingSeedFromHex\(existing\.signingKey\)/.test(code))) {
    53	      found.push({ file, line: index + 1, text: code.trim() });
    54	    }
    55	  });
    56	  return found;
    57	}
    58	
    59	function walk(root, dir = join(root, 'packages')) {
    60	  const files = [];
    61	  for (const item of readdirSync(dir, { withFileTypes: true })) {
    62	    const path = join(dir, item.name);
    63	    if (item.isDirectory()) {
    64	      if (item.name === 'node_modules' || item.name === 'dist') continue;
    65	      files.push(...walk(root, path));
    66	    } else if (item.isFile()) {
    67	      const rel = relative(root, path).replaceAll('\\', '/');
    68	      if (/^packages\/[^/]+\/src\//.test(rel) && SOURCE.test(rel) && !SELF.has(rel)) files.push(rel);
    69	    }
    70	  }
    71	  return files;
    72	}
    73	
    74	export function census(root, entries = ENTRIES) {
    75	  const files = walk(root);
    76	  const findings = files.flatMap(file => scanText(file, readFileSync(join(root, file), 'utf8')));
    77	  const used = entries.map(() => 0), open = [];
    78	  for (const finding of findings) {
    79	    const index = entries.findIndex((entry, i) => entry.file === finding.file && finding.text.includes(entry.match)
    80	      && entry.reason?.trim() && used[i] < entry.count);
    81	    if (index < 0) open.push(finding);
    82	    else used[index]++;
    83	  }
    84	  const stale = entries.filter((entry, i) => used[i] !== entry.count || !entry.match || !entry.reason?.trim() || !['allowed', 'K15'].includes(entry.rule));
    85	  return { files: files.length, findings, open, stale, used };
    86	}
    87	
    88	if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
    89	  const args = process.argv.slice(2);
    90	  let root = REPO;
    91	  if (args[0] === '--root' && args[1]) { root = resolve(args[1]); args.splice(0, 2); }
    92	  if (args.length && args[0] !== '--list') throw new Error(`unknown argument: ${args.join(' ')}`);
    93	  const result = census(root);
    94	  if (args[0] === '--list') for (const f of result.findings) console.log(`${f.file}:${f.line}: ${f.text}`);
    95	  for (const f of result.open) console.error(`OPEN ${f.file}:${f.line}: ${f.text}`);
    96	  for (const e of result.stale) console.error(`STALE ${e.rule} ${e.file} ${e.match} (${e.count})`);
    97	  const green = result.files > 0 && result.open.length === 0 && result.stale.length === 0;
    98	  console.log(`seed-census ${green ? 'GREEN' : 'RED'}: ${result.files} files, ${result.findings.length} consumers, ${result.open.length} open, ${result.stale.length} stale`);
    99	  if (!green) process.exitCode = 1;
   100	}
