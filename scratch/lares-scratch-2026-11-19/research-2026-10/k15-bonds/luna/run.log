   221	/** FNV-1a 32-bit over a string → a STABLE non-negative index label. Deterministic per axis-id, so
   222	 *  the SAME axis id maps to the SAME index in EVERY turn's vector — the cross-turn alignment a sparse
   223	 *  form-vector needs. (A dense global basis index would be exact, but the stored `document` does not
   224	 *  carry it — see parseFormVector; this keeps the axis IDENTITY instead of discarding it.) */
   225	function axisIdToIndex(id: string): number {
   226	  let h = 0x811c9dc5;
   227	  for (let i = 0; i < id.length; i++) {
   228	    h ^= id.charCodeAt(i);
   229	    h = Math.imul(h, 0x01000193);
   230	  }
   231	  return h >>> 0;   // unsigned 32-bit
   232	}
