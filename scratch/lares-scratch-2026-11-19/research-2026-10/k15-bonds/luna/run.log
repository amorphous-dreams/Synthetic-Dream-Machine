   108	// ---------------------------------------------------------------------------
   109	// Founding ceremony
   110	// ---------------------------------------------------------------------------
   111	
   112	/**
   113	 * How a founding binds its device to its hearth — the two modes, made explicit rather than inferred.
   114	 *
   115	 * SELF-STOOD carries a seed that SIGNS: the vessel builds its own device-delegation and seats a fresh
   116	 * persona-KEL inception. It never inits Keyhive with that seed (the per-vessel key stays the Individual).
   117	 *
   118	 * CONTRACTED carries no seed at all. A trusted operator, already contracted with the kahu, signed the edge
   119	 * on THEIR vessel; this one carries the edge, the pinned identifier prefix, and the operator's KEL chain.
   120	 * The chain rides ALONG because the Binding Gate walks it from the LOCAL replica — a vessel that founded
   121	 * without it would boot fail-closed with no head to reach, waiting on a federation it cannot yet perform.
   122	 * Carried, never fetched: a crossroads that holds no human key also holds no way to go ask for one.
   123	 */
   124	export type FoundingBinding =
   125	  | {
   126	      readonly mode:       "self-stood";
   127	      /** The 32-byte seed that SIGNS the edge — a persona root, or the vessel's own for an anon. */
   128	      readonly signerSeed: Uint8Array;
   129	    }
   130	  | {
   131	      readonly mode:             "contracted";
   132	      /** The edge the contracting operator signed elsewhere — this vessel holds it, never the seed behind it. */
   133	      readonly edge:             DeviceDelegationRootHalf;
   134	      /** The identifier PREFIX the Binding Gate pins — the contracting operator's, not this vessel's. */
   135	      readonly personaKelPrefix: string;
   136	      /** That operator's KEL, carried so the first boot walks prefix→head off its own replica. */
   137	      readonly personaKelChain:  readonly PersonaKelEvent[];
   138	      /** The PersonaGroup secret the contracting root sealed to THIS device beside the edge, in the same act. */
   139	      readonly groupSecretSeal:  GroupSecretSeal;
   140	    };
   141	
   142	export interface FoundingCeremonyInput {
   143	  repo:                Repo;
   144	  /** The PER-VESSEL device signing seed — inits Keyhive (this vessel IS the Individual). */
   145	  vesselSeed:        Uint8Array;
   146	  /** Hex-encoded verifying key of the place. */
   147	  vesselVerifyingKey: string;
   148	  /** Display name for the device identity tiddler. */
   149	  vesselDisplayName:  string;
   150	  /** HOW this founding binds its device — the two modes `vessel-standing` names. REQUIRED: every
   151	   *  founding binds, and the mode says whether this vessel signs its own binding or carries one. */
   152	  binding: FoundingBinding;
   153	  /** The hearth true-name (engine content-CID) this vessel binds TO — the place in (vessel × hearthTrueName).
   154	   *  REQUIRED: a founding with no place to bind to is no founding. */
   155	  hearthTrueName:      string;
   156	  /** The Nexus pubkey (this node's own gate key) the per-Nexus persona-KEL board derives from. The founding
   157	   *  seats the KEL INCEPTION onto that board so the very first boot walks the identifier→head mapping locally.
   158	   *  REQUIRED: a founding that seats no inception leaves the Binding Gate with no head to walk (it fails closed). */
   159	  nexusPubkey:         string;
   160	  /** The face atom's seed; a fresh founding mints one when absent. */
   161	  atomSeed?:           Uint8Array;
   162	}
   163	
   164	export interface FoundingCeremonyResult {
   165	  /** Automerge URL strings — vessel-agnostic, serializable into the bootstrap artifact. */
   166	  identitiesUrl:         string;
   167	  circlesUrl:            string;
   168	  sessionsUrl:           string;
   169	  daemonUrl:              string;
   170	  /** The mounted PersonaGroup plane's doc URL — founded alongside the daemon bag. */
   171	  personaUrl:             string;
   172	  /** That plane's BAG ID, derived from the PersonaGroup's own id. One name, everywhere it is reached. */
   173	  personaBagId:           string;
   174	  personaGroupId:   string;
   175	  meshCabalDocIdHex:     string;
   176	  /** The operator's self-certifying ContactCard JSON, minted once during the
   177	   *  ceremony. The caller caches it for the light leaf-identity path (OP-AP5). */
   178	  contactCardJson:       string;
   179	  /** The PINNED signer DID ("0x"+hex) — provenance (the founding op-key = the KEL inception op-key). The
   180	   *  Binding Gate pins `personaKelPrefix` instead and walks the KEL to the current head (no raw-pin hybrid). */
   181	  signerDid:       string;
   182	  /** The persona-KEL identifier PREFIX (AID) the Binding Gate PINS — stable across every op-key rotation.
   183	   *  Its inception seats the founding op-key; a later Reading-B rotation advances the head beneath it. */
   184	  personaKelPrefix:      string;
   185	  /** The root-signed and atom-countersigned face delegation. */
   186	  founderEdge:           DeviceDelegationTiddler;
   187	  /** The atom seed handed to the shore for custody. */
   188	  atomSeed:              Uint8Array;
   189	  /** The vessel's own keyhive Archive as the place founding left it. RAW SECRET material; the shore keeps it. */
   190	  archive:               Uint8Array;
   191	  /** The creator-veil's keyhive Archive (see `FaceFoundingResult.veilArchive`). */
   192	  veilArchive:           Uint8Array;
   193	}
   194	
   195	// ── THE TWO HALVES OF A FOUNDING ───────────────────────────────────────────────────────────────
   196	// A founding stands TWO things, and canon keeps them apart: a PLACE (a somewhere — addressable,
   197	// carriable, vouchable) and a FACE (a someone — a persona root, its key-event-log, the edge binding
   198	// a device to it). `identity-classes#herm-establishment` rules the separation outright: the Herm
   199	// "boots permissionlessly on its own key… it asks no blessing to exist", and "NO civic identity mints
   200	// into the Herm" — only the wax-sealed contract edges.
   201	//
   202	// So the place founds ALONE and the face lands on top of it, by a later operator act. Fusing them made
   203	// every vessel mint a human's root before it could carry a single byte, which is the one thing a
   204	// crossroads exists not to do.
   205	//
   206	// WHERE THE CABAL SITS, AND WHY NOT THE PLACE: a MeshCabal holds MEMBERS, and its members read as
   207	// PersonaGroups — faces. `IdentityAnchors` already files it that way, keyed by handle-index beside the
   208	// persona ids, and the boot path calls cabal membership AFFILIATION rather than identity (a PersonaGroup
   209	// belongs to many cabals or none). So a cabal seeded on a place identifier would hold a membership
   210	// structure with nothing that can be a member.
   211	//
   212	// A faceless place carries by CONTRACT instead — the wax-sealed carriage edge canon gives the Herm:
   213	// "No civic identity mints into the Herm — only the wax-sealed contract/edges." Carry ⊥ read holds
   214	// without a cabal, because the edge carries the authority a seat would have.
   215	//
   216	// Canon: lar:///ha.ka.ba/lares/api/pono/waking-floor · lar:///ha.ka.ba/lararium/mesh/identity-classes
   217	
   218	/** What a place-founding needs: a key, a name, and the hearth it stands at. No persona anywhere. */
   219	export interface PlaceFoundingInput {
   220	  repo:               Repo;
     1	/**
     2	 * leaf-identity — the LIGHT sovereign identity a short-lived leaf actor carries.
     3	 *
     4	 * A one-shot `lares` CLI run (or an AI-agent turn) acts as a sovereign peer
     5	 * WITHOUT booting keyhive (operator-peer #actor-parity OP-AP5, meme
     6	 * lar:///ha.ka.ba/lararium/mesh/operator-peer). It holds only:
     7	 *   - the operator Ed25519 seed → a bare signer (no keyhive), and
     8	 *   - the cached ContactCard JSON minted once at `lares vessel found`.
     9	 * With these it presents a self-certifying identity at a peer's gate (the
    10	 * carriage's gate-native pull reads it through `open-node-vessel`), and never
    11	 * boots the keyhive engine.
    12	 *
    13	 * The ContactCard carries no expiry/nonce — re-presented forever; proof freshness
    14	 * rides the gate's own handshake, never the cached card.
    15	 *
    16	 * Meme: lar:///ha.ka.ba/lararium/node/leaf-identity
    17	 */
    18	
    19	import { ed25519SignerFromSeed } from "@lararium/mesh";
    20	import type { LeafIdentity } from "@lararium/mesh";
    21	import { loadVesselSigningSeed, loadVesselVerifyingKey } from "./node-vessel-identity.js";
    22	import { requirePlaceCardOfOwnSeed } from "./place-card.js";
    23	import { loadFaceAtomOfGroup } from "./face-atom-store.js";
    24	import { loadVeilArchive } from "./identity-anchors.js";
    25	import { faceAtomKeyFromSeed } from "@lararium/mesh";
    26	import { KeyhiveProvider, InMemoryEventStore } from "@lararium/keyhive";
    27	
    28	// LeafIdentity lifted to platform-blind mesh (both vessels + the isomorphic adapter share it);
    29	// re-exported here for node consumers.
    30	export type { LeafIdentity } from "@lararium/mesh";
    31	
    32	/**
    33	 * Load the operator's light leaf identity from disk (seed + cached card). Throws
    34	 * when either artifact is absent — the caller must run `lares vessel found` first (it
    35	 * generates the keypair and mints + caches the ContactCard).
    36	 */
    37	export async function loadLeafIdentity(arm: "place" | "face" = "place", face?: { handleIndex: number; personaGroupId: string }): Promise<LeafIdentity> {
    38	  if (arm === "face") {
    39	    if (!face) throw new Error("a face leaf names its worn handle and PersonaGroup");
    40	    const seed = await loadFaceAtomOfGroup(face.personaGroupId);
    41	    if (!seed) throw new Error("this face holds no atom; re-found or re-admit it");
    42	    const archiveBytes = await loadVeilArchive(face.personaGroupId);
    43	    if (!archiveBytes) throw new Error("this face holds no atom archive; re-found or re-admit it");
    44	    const atom = faceAtomKeyFromSeed(seed, face.personaGroupId);
    45	    const provider = new KeyhiveProvider();
    46	    try {
    47	      await provider.init({ seed, archiveBytes, eventStore: new InMemoryEventStore() });
    48	      const contactCard = new TextDecoder().decode(await provider.contactCard());
    49	      return { arm: "face", contactCard, peerPubKey: atom.key, sign: atom.sign };
    50	    } finally { await provider.dispose(); }
    51	  }
    52	  const [seed, peerPubKey, contactCard] = await Promise.all([
    53	    loadVesselSigningSeed(),
    54	    loadVesselVerifyingKey(),
    55	    requirePlaceCardOfOwnSeed(),
    56	  ]);
    57	  return { arm: "place", contactCard, peerPubKey, sign: ed25519SignerFromSeed(seed) };
    58	}
     1	/**
     2	 * carriage-relay — the CARRIAGE capability as a live, registrable service: the herm's relay port (persona-KEL
     3	 * drops over plain HTTP; every WebSocket upgrade meets silence) PLUS the DHT-free `cid → holders` bag-tracker,
     4	 * composed into one startable unit.
     5	 *
     6	 * WHAT IT HOLDS, WHAT IT NEVER HOLDS. The port carries no envelope, so the tracker's announce sniff hears nothing and
     7	 * the HINT index (cids + holder handles, secret-free) stands empty. It carries NO read-cap, reads NO plaintext, keeps
     8	 * NO charter / content key / roster — a compromised carriage leaks nothing (carry ⊥ read ⊥ contract). It stands from a
     9	 * 32-byte gate seed + a bound port and nothing else, so a bare hearth stands one with a single call.
    10	 *
    11	 * TWO PORTS STAY TWO. This relay port SEPARATES from the Automerge `/ws` doc relay (Socket A, cleartext
    12	 * CRDT behind the face gate) — cleartext CRDT never routes through here, so carry ⊥ read holds at the transport.
    13	 *
    14	 * ISOMORPHISM BY COMPOSITION. It re-uses `startHermRelayPort` (the herm's drop port) and `makeBagTracker` (the
    15	 * discovery index) VERBATIM — it re-derives no gate, no crypto, no index.
    16	 *
    17	 * NO-GLOBAL-NOW: the bag-tracker reads "holders as the relay last heard", never a global truth; a member re-verifies
    18	 * every fetched byte itself (`verifyCiphertextCid`), so the tracker stays a hint, never an authority on the bytes.
    19	 *
    20	 * Meme: lar:///ha.ka.ba/lararium/node/carriage-relay
    21	 */
    22	
    23	import { RELAY_GATE_INFO } from "@lararium/mesh";
    24	import { createHmac } from "node:crypto";
    25	import * as ed from "@noble/ed25519";
    26	import { hex, type MembershipEnvelope } from "@lararium/mesh";
    27	import {
    28	  startHermRelayPort,
    29	  type HermRelayPort, type RelayAnnounceObserver,
    30	} from "./herm-relay-port.js";
    31	import { CAS_HAVE } from "./cas-wire.js";
    32	import { makeBagTracker, type BagTracker } from "./bag-tracker.js";
    33	
    34	/** A running carriage relay — the authenticated transport, its bound port, and the DHT-free discovery index. */
    35	export interface CarriageRelay {
    36	  /** The bound port the members dial (`ws://<host>:<port>`). */
    37	  readonly port: number;
    38	  /** The relay's gate verifying-key hex — a dialing hearth binds its proof-of-possession to THIS key (out-of-band,
    39	   *  never trusted from the wire). An operator hands it to a hearth alongside the `ws://` URL so it dials the RIGHT
    40	   *  crossroads. STABLE across restarts because the gate seed is (the Herm's own key / a configured seed). */
    41	  readonly gatePubKey: string;
    42	  /** The `cid → holders` hint index the Nexus discovers sealed bodies through (secret-free, plaintext-blind). */
    43	  readonly tracker: BagTracker;
    44	  /** Tear the transport down (closes the WS server + every peer socket). */
    45	  close(): Promise<void>;
    46	}
    47	
    48	/** Domain separation for the relay gate. The house's rule, stated where it binds: an HKDF/HMAC `info`
    49	 *  IS the separation, so two purposes never share key bytes however convenient the sharing looks.
    50	 *  Node's own HMAC rather than a bundled one — this module starts a WS server and is node-only by
    51	 *  construction, so reaching for the platform adds no dependency to carry. */
    52	const RELAY_GATE_DOMAIN = RELAY_GATE_INFO;
    53	
    54	/**
    55	 * Resolve the relay's gate seed the way a vessel boot does: a configured 32-byte hex seed when one rides the config,
    56	 * else a DOMAIN-SEPARATED derivation from the vessel's own identity seed. Deterministic in BOTH arms — the same
    57	 * inputs yield the same gate key across restarts, so a family's hearths keep dialing the same crossroads (NEVER a
    58	 * fresh random per boot). The one shore the boot's relay-standing gate reads for its seed.
    59	 *
    60	 * ── WHY A DERIVATION AND NOT THE SEED ITSELF ────────────────────────────────────────────────────
    61	 * Returning `vesselSeed` unchanged would make a Herm's relay gate key its vessel identity key — the same Ed25519
    62	 * pair signing device delegations and board writes, published to every hearth that dials the crossroads. Nothing
    63	 * would leak (Ed25519 over domain-separated messages is safe under key reuse), and two costs would still land:
    64	 *
    65	 *   · IT WOULD LINK TWO TRUST DOMAINS PERMANENTLY. The transport identity and the vessel identity would be one
    66	 *     correlatable key, which is exactly the join the veil model spends its whole design preventing.
    67	 *   · IT WOULD BREAK THE HOUSE'S OWN CRYPTO RULE. One key, two purposes, no `info` between them.
    68	 *
    69	 * The runbook says the gate key "derives from this Herm's OWN identity", and the derivation matches the words.
    70	 *
    71	 * HMAC-SHA256 yields exactly the 32 bytes an Ed25519 seed takes, and the same domain-tagged-MAC shape
    72	 * `persona-scope` uses one level down, so the house carries ONE separation idiom rather than a second one.
    73	 */
    74	export function resolveRelayGateSeed(vesselSeed: Uint8Array, seedHex?: string | null): Uint8Array {
    75	  if (seedHex && seedHex.length > 0) return Uint8Array.from(Buffer.from(seedHex, "hex"));
    76	  return new Uint8Array(createHmac("sha256", RELAY_GATE_DOMAIN).update(vesselSeed).digest());
    77	}
    78	
    79	/**
    80	 * Stand a carriage relay: the authenticated membership transport bound to `port` (0 → an OS-assigned free port),
    81	 * plus an empty bag-tracker. The gate seed binds the proof-of-possession challenge (a peer proves it holds its key
    82	 * before any envelope crosses); it grants NO read-cap and names NO roster — the member gate lives on the cas-wire
    83	 * SERVE side (in the vessels), never here.
    84	 */
    85	export function startCarriageRelay(cfg: {
    86	  gateSeed: Uint8Array;
    87	  port?: number;
    88	  /** Every sibling frame the relay carries, exactly as it carries it — the herm's whole sight of a channel. */
    89	  onSiblingFrame?: RelayAnnounceObserver["onSiblingFrame"];
    90	  /** Where the relay journals the successor drops it verified, so a restarted herm keeps them. */
    91	  dropJournalPath?: string;
    92	}): Promise<CarriageRelay> {
    93	  return (async (): Promise<CarriageRelay> => {
    94	    const tracker = makeBagTracker();
    95	    // Per-holder cid set — so a DEPARTED holder's every announced cid prunes at once (the tracker forgets by
    96	    // {cid, holder}, holding no holder→cids reverse index; this sniff-local map supplies it, tracker unchanged).
    97	    const heldByHolder = new Map<string, Set<string>>();
    98	
    99	    // The RE-SHARE sniff: a PROVEN peer's `cas-have(cid)` announce lands `cid → holder` in the bag-tracker FROM
   100	    // THE WIRE (the leg that stood empty). A departure prunes every cid that holder announced. The tracker stays
   101	    // a HINT — a member re-verifies `verifyCiphertextCid` on the fetched bytes, so a stale/hostile hint is caught.
   102	    const relay: HermRelayPort = await startHermRelayPort(cfg.gateSeed, cfg.port ?? 0, {
   103	      onEnvelope: (env: MembershipEnvelope) => {
   104	        if (env.kind !== CAS_HAVE) return;                                  // only the announce leg feeds discovery
   105	        const cid = typeof (env.payload as { cid?: unknown })?.cid === "string" ? (env.payload as { cid: string }).cid : "";
   106	        if (!cid) return;
   107	        tracker.note(cid, env.from);                                        // env.from is the relay-PROVEN key (never spoofable)
   108	        let held = heldByHolder.get(env.from);
   109	        if (!held) { held = new Set<string>(); heldByHolder.set(env.from, held); }
   110	        held.add(cid);
   111	      },
   112	      onLeave: (from: string) => {
   113	        const held = heldByHolder.get(from);
   114	        if (!held) return;
   115	        for (const cid of held) tracker.forget(cid, from);                  // prune every cid this holder announced
   116	        heldByHolder.delete(from);
   117	      },
   118	      ...(cfg.onSiblingFrame ? { onSiblingFrame: cfg.onSiblingFrame } : {}),
   119	    }, cfg.dropJournalPath ? { dropJournalPath: cfg.dropJournalPath } : {});
   120	    const gatePubKey = hex(await ed.getPublicKeyAsync(cfg.gateSeed));
   121	    return {
   122	      port: relay.port,
   123	      gatePubKey,
   124	      tracker,
   125	      close: () => relay.close(),
   126	    };
   127	  })();
   128	}

