   234	// R3/M1 — "plugins load by recipe" (node). `resolveNodeIslandPluginCids` and `nodeOfferingLookup`
   235	// now live in `node-plugin-resolution.ts` — the ONE node resolver module BOTH node paths (the
   236	// daemon VM and the wiki island pool, below) import, instead of each call site reproducing or
   237	// re-deriving the combinator. See that module's docblock.
   238	
   239	/**
   240	 * Pull a sparse form-vector out of a form-store entry's stored `document` (the move-space position
   241	 * the worldline-trajectory read joins). The python store keeps the dense embedding internally; the
   242	 * JSON `document` carries the axis activation. The host fetches this node-side (the form store is a
   243	 * node child_process the worker can't reach) and SHIPS it to the in-VM trajectory read. An absent /
   244	 * unparseable document yields null (the worker keeps the turn's TIME slot, form null). The node-side
   245	 * reads live here; the trajectory read itself runs in the sovereign worker.
   246	 *
   247	 * The stored `document` carries `axis_activation` as an axis-ID-KEYED map (`{ "voice:council": 0.9, … }`).
   248	 * Each key IS the axis identity — it MUST determine the sparse index, else two turns whose active-axis
   249	 * SETS differ get misaligned indices (a positional counter maps `voice:council`→0 in one turn and →1 in
   250	 * another, silently corrupting every cross-turn comparison). We derive a stable index per axis-id so the
   251	 * axis KEY survives. When the encoder's canonical `form_vector` rides the document (the exact indices),
   252	 * we prefer it verbatim.
   253	 */
   254	export function parseFormVector(document: string): SparseFormVector | null {
   255	  try {
   256	    const obj = JSON.parse(document) as Record<string, unknown>;
   257	    // Preferred: the encoder's canonical sparse vector, if the store persisted it — exact basis indices.
   258	    const fv = obj["form_vector"];
   259	    if (fv && typeof fv === "object") {
   260	      const rec = fv as Record<string, unknown>;
   261	      const idx = rec["indices"];
   262	      const val = rec["values"];
   263	      if (Array.isArray(idx) && Array.isArray(val) && idx.length === val.length
   264	          && idx.every((n) => typeof n === "number") && val.every((n) => typeof n === "number")) {
   265	        return { indices: idx as number[], values: val as number[] };
   266	      }
   267	    }
   268	    const act = obj["axis_activation"];
   269	    if (act && typeof act === "object") {
   270	      const entries = Object.entries(act as Record<string, unknown>).filter(([, v]) => typeof v === "number");
   271	      if (entries.length === 0) return { indices: [], values: [] };
   272	      // Index by the axis KEY (not by position) so the identity survives + aligns across turns; sort
   273	      // by the derived index so the pairing stays deterministic.
   274	      const pairs = entries
   275	        .map(([k, v]) => [axisIdToIndex(k), v as number] as const)
   276	        .sort((a, b) => a[0] - b[0]);
   277	      return {
   278	        indices: pairs.map(([i]) => i),
   279	        values: pairs.map(([, v]) => v),
   280	      };
   281	    }
   282	    return { indices: [], values: [] };
   283	  } catch {
   284	    return null;
   285	  }
   286	}
