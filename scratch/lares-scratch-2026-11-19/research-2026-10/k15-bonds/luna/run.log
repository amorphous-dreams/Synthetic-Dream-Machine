   288	/**
   289	 * Upstream's NodeWSServerAdapter declares ready only on its FIRST client
   290	 * connection — un-pono for a local-first vessel: readiness reads from local
   291	 * state (the server listens), never from a peer's arrival (no global now).
   292	 * Upstream's own CLIENT adapter force-readies on a 1s timer for the same
   293	 * reason. Without this, a zero-client vessel parks every storage-miss
   294	 * repo.find() at networkSubsystem.whenReady() and the island→main→island
   295	 * doc relay deadlocks silently (no reply, not even doc-unavailable).
   296	 */
   297	class ListeningWSServerAdapter extends NodeWSServerAdapter {
   298	  override isReady(): boolean { return true; }
   299	  override whenReady(): Promise<void> { return Promise.resolve(); }
   300	}
     1	/**
     2	 * openBrowserVessel — local-first browser vessel factory.
     3	 *
     4	 * A thin RECIPE over the composable vessel keel — the BROWSER
