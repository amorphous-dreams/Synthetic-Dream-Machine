   146	  /** The HEARTH's daemon url — the door this vessel knocks on for its seat. Null/absent when it founded
   147	   *  its own face; such a vessel IS the hearth. Persisted at admission, re-read on every later boot. */
   148	  hearthDaemonUrl?:      string | null;
   149	  /** The gate key of the HEARTH that admitted this vessel, as its admit named it. Null/absent when the vessel
   150	   *  founded its own face. A crossing pinned to this key reaches the vessel's own hearth (`hearth-canon`). */
   151	  hearthGatePubKey?:     string | null;
   152	  /** The hearth's FULL sovereign sync pin its admit carried (the pin whose `signingKey` is `hearthGatePubKey`): what the relay dial files in the pair index and knocks with. */
   153	  hearthGatePin?:        GateBundlePin | null;
   154	  /** The hearth's FLOOR pins at that pin's Nexus, which the root-signed fleet-join answer carried (house ruling "Floor
   155	   *  pins", carrier (b)): the oracle read at the vessel's own hearth files them beside the sovereign pin. */
   156	  hearthFloorPins?:      readonly GateBundlePin[] | null;
   157	  /** The canon documents that hearth's admit named (canon title → document url). A crossing to the vessel's
   158	   *  own hearth federates exactly these, and the vessel's oracle replica points at them. */
   159	  hearthCanonDocs?:      HearthCanonDocs;
   160	}
   161	
   162	// The oracle doc needs no IDB rendezvous key: it lives under the DETERMINISTIC
   163	// doc id (oracleGenesisDocUrl), so a reboot RELOADS it by find-first from IndexedDB and
   164	// a peer SYNCS the same address — no stored island-doc-url, mirroring the node path.
   165	interface BootKeyReads {
   166	  bootstrap:       BrowserBootstrap | undefined;
   167	  catalogUrl:      string | undefined;
   168	}
   169	
   170	async function readBootKeys(idbName: string): Promise<BootKeyReads> {
   171	  const idb = await openVesselIdb(idbName);
   172	  try {
   173	    const [bootstrap, catalogUrl] = await Promise.all([
   174	      idbGet<BrowserBootstrap>(idb, "bootstrap", BOOTSTRAP_KEY),
   175	      idbGet<string>(idb, "keystore", "catalog-url"),
   176	    ]);
   177	    return { bootstrap, catalogUrl };
   178	  } finally {
   179	    idb.close();
   180	  }
   181	}
   182	
   183	interface BootKeyWrites { bootstrap?: BrowserBootstrap; catalogUrl?: string }
   184	
   185	async function writeBootKeys(idbName: string, writes: BootKeyWrites): Promise<void> {
   186	  if (!writes.bootstrap && !writes.catalogUrl) return;
   187	  const idb = await openVesselIdb(idbName);
   188	  try {
   189	    await Promise.all([
   190	      ...(writes.bootstrap  ? [idbPut(idb, "bootstrap", BOOTSTRAP_KEY,  writes.bootstrap)]  : []),
   191	      ...(writes.catalogUrl ? [idbPut(idb, "keystore",  "catalog-url",  writes.catalogUrl)] : []),
   192	    ]);
   193	  } finally {
   194	    idb.close();
   195	  }
   196	}
