     1	/**
     2	 * place-card — the vessel's own self-certifying ContactCard, which a place-arm presentation cannot go without.
     3	 *
     4	 * The card is minted from THE VESSEL'S OWN SEED (`foundThePlace` at a place founding, `mintPlaceCard` here) and rests as the
     5	 * F-class public row `vessel-card`. A joinee node founds no place, so its admit supplies the BINDING and this supplies the
     6	 * SELF: a vessel that reaches the place arm with no card, or with a card of another seed, refuses by name.
     7	 *
     8	 * Meme: lar:///ha.ka.ba/lares/docs/pono/face-proof#/the-place-arm
     9	 */
    10	import { mintPlaceCard, placeCardIsOf } from "@lararium/keyhive";
    11	import { loadVesselCard, loadVesselSigningSeed, loadVesselVerifyingKey, persistVesselCard } from "./node-vessel-identity.js";
    12	import { loadIdentityArchive, persistIdentityArchive } from "./identity-anchors.js";
    13	
    14	export class PlaceCardRefused extends Error {
    15	  constructor(readonly why: "absent" | "not-own-seed", detail: string) { super(`[place-card] ${why}: ${detail}`); this.name = "PlaceCardRefused"; }
    16	}
    17	
    18	async function readCard(): Promise<string | null> {
    19	  try { return await loadVesselCard(); } catch (e) { if ((e as Error).message.includes("no ContactCard")) return null; throw e; }
    20	}
    21	
    22	/** The place card this vessel presents: present and of its own seed, else a named refusal. */
    23	export async function requirePlaceCardOfOwnSeed(): Promise<string> {
    24	  const card = await readCard();
    25	  if (card === null) throw new PlaceCardRefused("absent", "this vessel holds no place card; a joinee mints one from its own seed at its landing (`ensurePlaceCard`)");
    26	  if (!(await placeCardIsOf(card, await loadVesselVerifyingKey()))) throw new PlaceCardRefused("not-own-seed", "the place card at rest names another key than this vessel's own");
    27	  return card;
    28	}
    29	
    30	/** Mint the place card from this vessel's own seed where none rests; a card at rest of another seed refuses and is never replaced. */
    31	export async function ensurePlaceCard(): Promise<"kept" | "minted"> {
    32	  const card = await readCard();
    33	  if (card !== null) {
    34	    if (!(await placeCardIsOf(card, await loadVesselVerifyingKey()))) throw new PlaceCardRefused("not-own-seed", "the place card at rest names another key than this vessel's own");
    35	    return "kept";
    36	  }
    37	  const standingArchive = await loadIdentityArchive();
    38	  const minted = await mintPlaceCard({ vesselSeed: await loadVesselSigningSeed(), ...(standingArchive ? { archiveBytes: standingArchive } : {}) });
    39	  await persistVesselCard(minted.contactCardJson);
    40	  if (!standingArchive) await persistIdentityArchive(minted.archive);
    41	  return "minted";
    42	}
     1	/**
     2	 * ceremony-core — isomorphic DreamNet founding and vessel-admission ceremonies.
     3	 *
     4	 * This module contains zero vessel-specific code. It runs identically in:
     5	 *   - Node vessel (lararium-node wraps it with NodeFS + disk keypair)
     6	 *   - Browser vessel (lararium-browser wraps it with IndexedDB + WebCrypto keypair)
     7	 *   - Mobile vessel (any future vessel with its own storage adapter)
     8	 *
     9	 * The four vessel-specific shores the caller provides:
    10	 *   repo         — Automerge Repo backed by any StorageAdapter
    11	 *   vesselSeed — the PLACE's own 32-byte Ed25519 seed, from any secure store
    12	 *   (founding ceremony also needs verifyingKey + displayName for identity tiddler)
    13	 *
    14	 * The result types carry all minted data; the caller decides where to persist
    15	 * the bootstrap artifact (disk, IndexedDB, stdout, etc.).
    16	 *
    17	 * Identity lattice produced by runFoundingCeremony:
    18	 *   Vessel Individual (from seed)
    19	 *     └─▶ PersonaGroup, a Keyhive GROUP (the Binding Gate proves the vessel at boot; a seat's revocation rolls
    20	 *         the key of every bag the group reaches)
    21	 *              └─▶ MeshCabal sentinel Document (Gate C: cabal membership, owed at canon access, never at boot)
    22	 *
    23	 * At t=0, founding operator's PersonaGroup is the only MeshCabal member.
    24	 * the carriage contract adds co-operators. The MeshCabal grows; this path never re-runs.
    25	 *
    26	 * The TRUE NAME MODEL the ceremony enacts — two DISTINCT keys, one signed edge:
    27	 *   · `vesselSeed` carries the PLACE's own key — minted per-install,
    28	 *     never copied to another vessel. It mints the Vessel Individual and inits Keyhive.
    29	 *   · `binding` carries the PERSONA ROOT's authority — the HUMAN's side. A SELF-STOOD binding holds
    30	 *     that root's seed, which ONLY signs and never inits Keyhive; a CONTRACTED binding holds no seed
    31	 *     at all, carrying instead an edge some other operator already signed.
    32	 *   · `buildDeviceDelegation` binds them without merging them: the persona root signs
    33	 *     "Operator O delegates to Device D AT PLACE P", where `hearthTrueName` names P — the
    34	 *     hearth's True Name. Peers pin the root and verify that edge offline. In the same act the root
    35	 *     seals its PersonaGroup secret to D's key (`persona-group-secret`), the secret D's sibling
    36	 *     proofs run on.
    37	 * `runDeviceAdmitEdge` carries the same shape outward: the founder's root signs a joinee's
    38	 * OWN vessel key into the PersonaGroup, so no seed ever crosses the wire. A single key
    39	 * copied across vessels would present one collector to every verifier and link every self —
    40	 * the split is what the veil rests on. See lar:///ha.ka.ba/lares/docs/federation.
    41	 *
    42	 * Meme: lar:///ha.ka.ba/lararium/keyhive/ceremony-core
    43	 */
