    99	async function checkpointId(seed: Uint8Array): Promise<string> {
   100	  const material = await crypto.subtle.importKey("raw", Uint8Array.from(seed), "HKDF", false, ["deriveBits"]);
   101	  const bits = await crypto.subtle.deriveBits({
   102	    name: "HKDF", hash: "SHA-256", salt: new Uint8Array(0),
   103	    info: new TextEncoder().encode(`${FACE_CHECKPOINT_INFO}:title`),
   104	  }, material, 256);
   105	  return hexEncode(new Uint8Array(bits));
   106	}
