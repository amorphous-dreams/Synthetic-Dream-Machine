    70	/**
    71	 * A BROAD SYNC PORT, HARDENED. A worker on a broad port (the daemon island's, a wiki island's) runs code the
    72	 * owner did not write, and whatever that code posts lands in the owner's port listener. This facade stands
    73	 * between the port and the stock adapter: an arrival that does not read as a sync message drops here, named to
    74	 * the sink, and the adapter's listener never sees it. Every other member passes straight through. A session's
    75	 * scoped leg goes further and judges every message through a gate (`gated-sync-leg`).
    76	 */
    77	export function hardenedSyncPort(port: MessagePort, onDropped?: (why: string) => void): MessagePort {
    78	  const facade = {
    79	    addEventListener(type: string, listener: (event: MessageEvent) => void): void {
    80	      if (type !== "message") { port.addEventListener(type as "messageerror", listener as (e: Event) => void); return; }
    81	      port.addEventListener("message", (event: MessageEvent) => {
    82	        if (readsAsSyncMessage(event.data)) { listener(event); return; }
    83	        const shape = event.data === null ? "null" : Array.isArray(event.data) ? "array" : typeof event.data;
    84	        try { onDropped?.(`an arrival that reads as no sync message (${shape}) dropped at the port`); } catch { /* a sink never breaks the leg */ }
    85	      });
    86	    },
    87	    postMessage: (message: unknown, transfer?: Transferable[]): void => port.postMessage(message, transfer ?? []),
    88	    start: (): void => port.start(),
    89	    close: (): void => port.close(),
    90	  };
    91	  return facade as unknown as MessagePort;
    92	}
