    44	/**
    45	 * Whether one arrival reads as a message the stock message-channel adapter may take. The adapter dereferences an
    46	 * arrival inside its port listener (`"targetId" in message`, `message.type`, `new Uint8Array(message.data)`), and a
    47	 * throw there can end the process that owns the port. So an arrival passes only as a plain object with a string
    48	 * `type` and a string `senderId`; a `targetId` that reads as a string when present; `data` that reads as bytes when
    49	 * present, never as a length; and `peerMetadata` that reads as an object when present. The `type` must name the
    50	 * adapter's own handshake or a message the Repo knows: the Repo prints any other type whole, and a value that
    51	 * cannot print throws inside the same listener.
    52	 */
    53	const SYNC_MESSAGE_TYPES: ReadonlySet<string> = new Set([
    54	  "arrive", "welcome", "leave",
    55	  "sync", "request", "doc-unavailable", "ephemeral", "remote-subscription-change", "remote-heads-changed",
    56	]);
    57	
    58	export function readsAsSyncMessage(raw: unknown): boolean {
    59	  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) return false;
    60	  const m = raw as Record<string, unknown>;
    61	  if (typeof m["type"] !== "string" || !SYNC_MESSAGE_TYPES.has(m["type"]) || typeof m["senderId"] !== "string") return false;
    62	  if ("targetId" in m && m["targetId"] !== undefined && typeof m["targetId"] !== "string") return false;
    63	  const data = m["data"];
    64	  if (data !== undefined && data !== null && !(data instanceof ArrayBuffer) && !ArrayBuffer.isView(data)) return false;
    65	  const meta = m["peerMetadata"];
    66	  if (meta !== undefined && (typeof meta !== "object" || meta === null || Array.isArray(meta))) return false;
    67	  return true;
    68	}
