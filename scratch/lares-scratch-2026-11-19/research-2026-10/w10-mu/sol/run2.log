   291	/** Where a stood gate answers. */
   292	export interface StoodGate {
   293	  /** The exact upgrade pathname: `<route>/<knock>`. */
   294	  readonly path: string;
   295	  /** Stop answering on this path; a socket already accepted runs on. Idempotent. */
