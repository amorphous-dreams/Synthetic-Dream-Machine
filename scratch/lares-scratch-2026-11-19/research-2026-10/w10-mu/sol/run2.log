   328	/** The exact pathname a gate answers on: its pin's route, then its knock. */
   329	export function gatePath(pin: GateBundlePin): string {
   330	  const read = readGateBundlePin(pin);
   331	  if (!("pin" in read)) throw new RangeError(`face-gate-server: the pin does not read (${read.refusal})`);
   332	  return `${read.pin.route}/${gateKnock(read.pin)}`;
