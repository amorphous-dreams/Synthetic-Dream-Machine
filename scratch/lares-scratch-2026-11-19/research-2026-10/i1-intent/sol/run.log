/** The planes a vessel may REGISTER: a bootstrap's plane URL registers only where a verified `plane` act put the
 *  same URL there. A URL with no signed act behind it never registers. */
export function registerablePlanes(bootstrap: Readonly<Record<string, string>>, projection: PersonaProjection): Record<string, string> {
  const out: Record<string, string> = {};
  for (const [name, url] of Object.entries(bootstrap)) if (projection.planes[name] === url) out[name] = url;
  return out;
}

export type { SignedAct };

/**
 * The verifying key a proven identifier carries — its trailing 64 hex. A bare verifying key is its own
 * trailing 64 hex. A peer that proved nothing, or an identifier too short to carry a key, reads null.
 */
export function provenVesselKeyOf(identifier: string | null | undefined): string | null {
  if (typeof identifier !== "string") return null;
  const m = identifier.toLowerCase().match(/[0-9a-f]{64}$/);
  return m ? m[0] : null;
}

/**
 * The face's four plane bags resolved to the doc-ids a ring decides over, off the vessel's own catalog — the
 * SAME resolution `DeterministicFederationGate` runs for its own set. An absent plane falls out (fail-closed).
 */
export async function governedPlaneDocIds(catalog: PlaneCatalog, personaGroupId: string): Promise<ReadonlySet<DocumentId>> {
  const planes = personaScopedBagIds(personaGroupId);
  const ids = new Set<DocumentId>();
  for (const bag of [planes.persona, planes.circles, planes.identities, planes.sessions]) {
    const url = await catalog.urlOf(bag);
    if (url) ids.add(interpretAsDocumentId(url as AutomergeUrl) as DocumentId);
  }
  return ids;
}

/** The act's content id: sha-256 over the signed bytes. */
export function actCid(body: ActBody): string {
  return sha256HexBytesSync(actBytes(body));
}

/** Mint an act: the caller supplies the signer; this module holds no key and grades no authority. */
export async function signAct<B extends ActBody>(
  body: B,
  signer: { readonly key: string; readonly sign: (bytes: Uint8Array) => Promise<string> },
): Promise<SignedAct<B>> {
  if (!Number.isSafeInteger(body.seq) || body.seq < 0) throw new Error("signed-act: seq reads a non-negative integer");
  if ((body.seq === 0) !== (body.prior === null)) throw new Error("signed-act: prior is null at seq 0 and a cid after it");
  return { body, signer: signer.key.toLowerCase(), sig: await signer.sign(actBytes(body)) };
}

