   156	  }
   157	  // The signature check plus the causal lease frontier: the current max-register decides authority.
   158	  const verdict = await verifyDeviceDelegation(edge, ctx.personaRootDid, {
   159	    expectedEpoch: ctx.leaseEpoch,
