   214	  }
   215	
   216	  // Pass two — the card now names a key, so bind it to the edge that licensed the summons.
   217	  const boundVerdict = await gateFaceJoin({ edge: summons.deviceEdge, ctx, cardIdentifierHex: joineeAgentIdHex });
