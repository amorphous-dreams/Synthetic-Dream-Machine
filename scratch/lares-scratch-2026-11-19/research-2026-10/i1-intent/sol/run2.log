   236	  // the raise names, and its earlier key epoch with it. So the join rolls the seat before it seats: revoke, then add.
   237	  // Where this hand holds no authority over the earlier seat, or no revoke capability at all, the join REFUSES:
   238	  // the raise still owes its roll, and the vessel that seated the device answers it first (kapae#/keys).
   239	  let rolledFirst = false;
   240	  if (dyad === "owing" && seated.ok) {
   241	    const how = provider.revokeGroupSeat ? (await provider.revokeGroupSeat(joineeAgentIdHex, ctx.personaGroupId)).how : "no-authority";
