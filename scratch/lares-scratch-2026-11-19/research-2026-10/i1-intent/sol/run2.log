   152	export type QuorumRefusal = "shape" | "domain" | "group" | "no-roster" | "below-threshold";
   153	
   154	/** Read a quorum act. `seatsFor` names the roster the body's own epoch reads under (null: none stood). */
   155	export function readQuorumAct(
   156	  raw: unknown,
   157	  opts: { readonly domain: string; readonly group: string; readonly seatsFor: (body: ActBody) => { readonly signers: readonly string[]; readonly threshold: number } | null },
   158	): { readonly ok: true; readonly act: QuorumAct; readonly cid: string } | { readonly ok: false; readonly refusal: QuorumRefusal } {
   159	  if (typeof raw !== "object" || raw === null) return { ok: false, refusal: "shape" };
   160	  const r = raw as Record<string, unknown>;
   161	  const body = r["body"] as Record<string, unknown> | null;
   162	  if (typeof body !== "object" || body === null || !Array.isArray(r["signatures"])) return { ok: false, refusal: "shape" };
   163	  if (typeof body["kind"] !== "string" || typeof body["group"] !== "string") return { ok: false, refusal: "shape" };
   164	  const seq = body["seq"], prior = body["prior"];
   165	  if (typeof seq !== "number" || !Number.isSafeInteger(seq) || seq < 0) return { ok: false, refusal: "shape" };
   166	  if (prior !== null && typeof prior !== "string") return { ok: false, refusal: "shape" };
   167	  if ((seq === 0) !== (prior === null)) return { ok: false, refusal: "shape" };
   168	  if (body["kind"] !== opts.domain) return { ok: false, refusal: "domain" };
   169	  if (body["group"] !== opts.group) return { ok: false, refusal: "group" };
   170	  const seats = opts.seatsFor(body as ActBody);
   171	  if (!seats) return { ok: false, refusal: "no-roster" };
   172	  const bytes = actBytes(body as ActBody);
   173	  const seated = new Set(seats.signers.map((k) => k.toLowerCase()));
   174	  const verified = new Map<string, QuorumSignature>();
   175	  for (const s of r["signatures"] as unknown[]) {
   176	    if (typeof s !== "object" || s === null) continue;
   177	    const { signer, sig } = s as Record<string, unknown>;
   178	    if (typeof signer !== "string" || typeof sig !== "string") continue;
   179	    const key = signer.toLowerCase();
   180	    if (verified.has(key) || !seated.has(key)) continue;
   181	    let ok = false;
   182	    try { ok = verifyEd25519(sig, bytes, key); } catch { ok = false; }
   183	    if (ok) verified.set(key, { signer: key, sig });
   184	  }
   185	  if (seats.threshold < 1 || verified.size < seats.threshold) return { ok: false, refusal: "below-threshold" };
   186	  const act: QuorumAct = { body: body as ActBody, signatures: [...verified.values()] };
   187	  return { ok: true, act, cid: actCid(act.body) };
   188	}

