   146	export async function gateFaceJoin(args: {
   147	  readonly edge: DeviceDelegationTiddler;
   148	  readonly ctx: FaceJoinContext;
   149	  /** Absent on the pre-card pass; supplied for the binding check once the card is parsed. */
   150	  readonly cardIdentifierHex?: string;
