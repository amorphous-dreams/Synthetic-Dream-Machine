    68	   * and content sealed after the seat opens for the member with no re-delegation. Keyhive reads FORWARD-ONLY: a
    69	   * chunk sealed before this seat stays keyed to an epoch the new member stands outside of and reads `Key not
    70	   * found`. The holder therefore re-encrypts each standing chunk at the current epoch here; the joinee ingests
    71	   * these to reach what the group held before it arrived. Empty when nothing stood sealed on the named bags (a
    72	   * freshly minted bag), or when the provider tracks no content.
    73	   */
    74	  readonly reSealed: readonly { bagUrl: string; contentRefB64: string; ciphertextB64: string }[];
    75	}
    76	
    77	export type FaceJoinRefusal = { readonly ok: false; readonly reason: string };
    78	export type FaceJoinOutcome = { readonly ok: true; readonly grant: FaceJoinGrant } | FaceJoinRefusal;
    79	
    80	/** What the island supplies. Structural, so a test stands it without a WASM provider. */
    81	export interface FaceJoinProvider {
    82	  receiveContactCard(bytes: Uint8Array): Promise<{ id: string }>;
    83	  verifyGroupMembership(agentIdHex: string, groupId: string): Promise<{ ok: boolean; reason?: string }>;
    84	  addGroupMember(memberIdentifierHex: string, groupId: string): Promise<void>;
    85	  /** Roll one seat: revoke it and say how the key group answered (`KeyhiveProvider.revokeGroupSeat`). A join
    86	   *  for a device that returns while its earlier seat stands runs this first. Absent, such a join refuses. */
    87	  revokeGroupSeat?(memberIdentifierHex: string, groupId: string): Promise<{ how: "revoked" | "gone" | "no-authority" }>;
    88	  /** Re-seal a bag's standing chunks to the group's current key, returning the fresh ciphertext per chunk — the
    89	   *  step a seat cannot do, because keyhive reads FORWARD-ONLY and a chunk sealed before the seat stays keyed to
    90	   *  an epoch the new member stands outside of. Absent when the holder tracks no bag content. */
    91	  reSealBag?(bagUrl: string): Promise<{ contentRef: Uint8Array; ciphertext: Uint8Array }[]>;
    92	  eventsForPeer(peerAgentIdHex: string): Promise<Uint8Array[]>;
    93	  contactCard(): Promise<Uint8Array>;
    94	}
    95	
    96	export interface FaceJoinContext {
    97	  /** This vessel's persona-root DID — the ONLY signer whose edge this gate honours. */
    98	  readonly personaRootDid: string;
    99	  /** The hearth true-name an edge must bind to; an edge for another hearth reads as another place's business. */
   100	  readonly hearthTrueName: string;
   101	  /** The PersonaGroup the joinee joins: a Keyhive group's id, which also names the audience its bags delegate to. */
   102	  readonly personaGroupId: string;
   103	  /**
   104	   * The bags whose standing chunks the join RE-SEALS once the seat lands: bags this vessel ALREADY delegated to
   105	   * the group. The seat reaches every such bag's later content by itself (a group carries a seat into the key
   106	   * agreement of every document it reaches); the chunks sealed before it stay keyed to an epoch the member
   107	   * stands outside of, and only a re-seal carries them across. The list grants no reach the group lacks, and it
   108	   * belongs to the caller that knows its own grants.
   109	   */
   110	  readonly reseal?: readonly string[];
   111	  /**
   112	   * THE LEASE AUTHORITY — this resource's current max-register epoch (`effectiveLeaseEpoch` over its slots).
   113	   * A grant whose `boundEpoch` sits below it reads STALE and the gate refuses. A max-register is monotone and
   114	   * read locally, so two islands need no shared clock to agree which way it moved; an unfed resource reads 0
   115	   * and admits the epoch-0 grants a founding issues.
   116	   */
   117	  readonly leaseEpoch: number;
   118	  /**
   119	   * THE DYAD'S READING for the device a summons names, off the fleet's own edge board (kapae#/reach).
   120	   *
   121	   *   · `aside`    — the fleet root set this device aside. The gate answers as though no delegation stood: the
   122	   *                  summons draws the refusal an edge with a false signature draws, word for word, and names
   123	   *                  no cause.
   124	   *   · `returned` — a raise once set the device aside and its lift stands. The seat lands FRESH: the group
   125	   *                  re-keys forward, and NOTHING the group sealed before this seat gets re-sealed to it. A lift
   126	   *                  restores standing, never keys (kapae#/re-admission); a holder hands the missed span over by
   127	   *                  a separate, explicit act alone.
   128	   *   · `owing`    — the same, and the vessel has not yet answered every raise: where the device's earlier seat
   129	   *                  still stands, the join rolls it first (revoke, then a fresh seat), or refuses where this
   130	   *                  hand holds no authority over that seat.
   131	   *   · `clear`    — no raise ever named the device.
   132	   *
   133	   * The caller reads it where the fleet board folds (`edgeStandingOf`), and answers `aside` while that fold has
   134	   * not landed.
   135	   */
   136	  readonly dyad: (deviceVerifyingKey: string) => EdgeStanding;
   137	}
   138	
   139	/**
   140	 * The gate, over the EDGE alone. Runs before the card touches local state, so a refused summons leaves the
   141	 * provider exactly as it found it.
   142	 *
   143	 * `cardIdentifierHex` binds the two halves: an edge licenses ONE key, and the card must carry that key, or a
   144	 * holder of somebody else's edge would join under its own identity.
   145	 */
   146	export async function gateFaceJoin(args: {
   147	  readonly edge: DeviceDelegationTiddler;
   148	  readonly ctx: FaceJoinContext;
   149	  /** Absent on the pre-card pass; supplied for the binding check once the card is parsed. */
   150	  readonly cardIdentifierHex?: string;
   151	}): Promise<{ ok: true } | FaceJoinRefusal> {
   152	  const { edge, ctx } = args;
   153	
   154	  if (edge?.kind !== "device-delegation") {
   155	    return { ok: false, reason: "the summons carries no device-delegation edge" };
   156	  }
   157	  // The signature check plus the causal lease frontier: the current max-register decides authority.
   158	  const verdict = await verifyDeviceDelegation(edge, ctx.personaRootDid, {
   159	    expectedEpoch: ctx.leaseEpoch,
   160	  });
   161	  if (!verdict.ok) {
   162	    return { ok: false, reason: `edge refused: ${verdict.reason ?? "signature or window"}` };
   163	  }
   164	  // THE BINDING GATE READS THE DYAD'S SHADOW. A device the fleet root set aside binds nothing here, whatever its
   165	  // edge proves. It draws Mu: the words an edge with no relation behind it draws, and no cause.
   166	  const standing = ctx.dyad(edge.deviceVerifyingKey);
   167	  if (standing === "aside") {
   168	    return { ok: false, reason: "edge refused: signature mismatch" };
   169	  }
   170	  // ABSENCE IS NOT CLEAR: a fleet whose signed frontier reads unknown vouches for no device, so the gate binds nobody until it does.
   171	  if (standing === "unknown") {
   172	    return { ok: false, reason: "edge refused: no qualifying signed edge frontier" };
   173	  }
   174	  // The binding IS (vessel × hearth) — an edge minted for another place carries no seat at this one.
   175	  if (edge.hearthTrueName !== ctx.hearthTrueName) {
   176	    return { ok: false, reason: "edge binds a different hearth" };
   177	  }
   178	  if (args.cardIdentifierHex !== undefined) {
   179	    // The identifier a card derives ends in the raw verifying key (the relationship the Binding Gate also
   180	    // leans on), so a card presented against somebody else's edge fails here rather than joining.
   181	    if (!args.cardIdentifierHex.toLowerCase().endsWith(edge.deviceVerifyingKey.toLowerCase())) {
   182	      return { ok: false, reason: "the presented card names a different key than the edge licenses" };
   183	    }
   184	  }
   185	  return { ok: true };
   186	}
   187	
   188	/**
   189	 * Run the join. Refuses by RETURNING a reason — a summons from an unlicensed vessel names an absent contract,
   190	 * never an attack, and the island keeps serving.
   191	 *
   192	 * Order follows `packPersonaCrossing`: ADD, then CAPTURE. Events captured before the add would carry an epoch
   193	 * the joinee stands outside of.
   194	 */
   195	export async function runFaceJoin(
   196	  provider: FaceJoinProvider,
   197	  summons: FaceJoinSummons,
   198	  ctx: FaceJoinContext,
   199	): Promise<FaceJoinOutcome> {
   200	  // Pass one — the edge alone. Nothing has entered local state yet.
   201	  const edgeVerdict = await gateFaceJoin({ edge: summons.deviceEdge, ctx });
   202	  if (!edgeVerdict.ok) return edgeVerdict;
   203	
   204	  if (typeof summons.contactCard !== "string" || summons.contactCard.length === 0) {
   205	    return { ok: false, reason: "the summons carries no contact card" };
   206	  }
   207	
   208	  let joineeAgentIdHex: string;
   209	  try {
   210	    const received = await provider.receiveContactCard(new TextEncoder().encode(summons.contactCard));
   211	    joineeAgentIdHex = received.id;
   212	  } catch (err) {
   213	    return { ok: false, reason: `contact card unreadable: ${(err as Error)?.message ?? String(err)}` };
   214	  }
   215	
   216	  // Pass two — the card now names a key, so bind it to the edge that licensed the summons.
   217	  const boundVerdict = await gateFaceJoin({ edge: summons.deviceEdge, ctx, cardIdentifierHex: joineeAgentIdHex });
   218	  if (!boundVerdict.ok) return boundVerdict;
   219	
   220	  // Membership lives FOUNDER-side, so a joinee that lost its own store still reads as seated here and takes the
   221	  // no-re-key path. That returns its membership, NEVER its keys: keyhive mints fresh prekeys per init, and the
   222	  // group's already-sealed material stays keyed to the prekeys that vessel held when it was seated. A wiped
   223	  // store recovers from its ARCHIVE (`keyhive-provider` init: RESTORE-OR-FRESH) and from nothing here — force
   224	  // re-keys the group and still opens none of it. A seat is not a key.
   225	  //
   226	  // A joinee whose group was re-founded holds no seat in the NEW group, so the add genuinely runs.
   227	  const seated = await provider.verifyGroupMembership(joineeAgentIdHex, ctx.personaGroupId);
   228	  const addUnlessRolled = summons.force === true || !seated.ok;
   229	  // A DEVICE THAT RETURNS AFTER A LIFT TAKES A FRESH SEAT AND NO EARLIER KEY. The seat reaches each bag FORWARD;
   230	  // the re-seal that would carry the standing chunks across stays out, since those chunks hold the span the
   231	  // device missed.
   232	  const dyad = ctx.dyad(summons.deviceEdge.deviceVerifyingKey);
   233	  if (dyad === "unknown") return { ok: false, reason: "no qualifying signed edge frontier" };
   234	  const returned = dyad === "returned" || dyad === "owing";
   235	  // THE EARLIER SEAT LEAVES FIRST. A device that returns while a raise still owes its roll may hold the very seat
   236	  // the raise names, and its earlier key epoch with it. So the join rolls the seat before it seats: revoke, then add.
   237	  // Where this hand holds no authority over the earlier seat, or no revoke capability at all, the join REFUSES:
   238	  // the raise still owes its roll, and the vessel that seated the device answers it first (kapae#/keys).
   239	  let rolledFirst = false;
   240	  if (dyad === "owing" && seated.ok) {
   241	    const how = provider.revokeGroupSeat ? (await provider.revokeGroupSeat(joineeAgentIdHex, ctx.personaGroupId)).how : "no-authority";
   242	    if (how === "no-authority") {
   243	      return { ok: false, reason: "the earlier seat still stands and its roll stays owed — the vessel that seated this device answers the raise first, and the join then seats afresh" };
   244	    }
   245	    rolledFirst = true;
   246	  }
   247	  const mustAdd = addUnlessRolled || rolledFirst;
   248	  const reSealed: { bagUrl: string; contentRefB64: string; ciphertextB64: string }[] = [];
   249	  if (mustAdd) {
   250	    await provider.addGroupMember(joineeAgentIdHex, ctx.personaGroupId);
   251	    // The seat joins the key agreement of every bag the group reaches, FORWARD only. A chunk the group held before
   252	    // this seat stays keyed to an epoch the member stands outside of, so RE-SEAL each standing chunk at the
   253	    // group's current key, after the add. Absent a re-seal capability, or an empty bag, this adds nothing and the
   254	    // pre-seat chunks stay unreached, visibly (an empty `reSealed`).
   255	    for (const bagUrl of returned ? [] : (ctx.reseal ?? [])) {
   256	      for (const chunk of (await provider.reSealBag?.(bagUrl)) ?? []) {
   257	        reSealed.push({
   258	          bagUrl,
   259	          contentRefB64: bytesToBase64(chunk.contentRef),
   260	          ciphertextB64: bytesToBase64(chunk.ciphertext),
   261	        });
   262	      }
   263	    }
   264	  }
   265	
   266	  // CAPTURE LAST — the events must carry the add AND every re-seal above, or the joinee ingests a membership whose
   267	  // re-sealed chunks open under no key it holds (the add→encrypt→capture order `packPersonaCrossing` also keeps).
   268	  const events = await provider.eventsForPeer(joineeAgentIdHex);
   269	  const founderCard = new TextDecoder().decode(await provider.contactCard());
   270	
   271	  return {
   272	    ok: true,
   273	    grant: {
   274	      kind: "face-join-grant/v1",
   275	      joineeAgentIdHex,
   276	      founderCard,
   277	      capEvents: events.map(bytesToBase64),
   278	      reKeyed: mustAdd,
   279	      reSealed,
   280	    },
   281	  };
   282	}

