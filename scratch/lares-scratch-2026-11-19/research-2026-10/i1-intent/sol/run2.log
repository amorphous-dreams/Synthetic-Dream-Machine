   258	          bagUrl,
   259	          contentRefB64: bytesToBase64(chunk.contentRef),
   260	          ciphertextB64: bytesToBase64(chunk.ciphertext),
   261	        });
   262	      }
   263	    }
   264	  }
   265	
   266	  // CAPTURE LAST — the events must carry the add AND every re-seal above, or the joinee ingests a membership whose
