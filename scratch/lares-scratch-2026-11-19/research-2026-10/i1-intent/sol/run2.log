   219	
   220	  // Membership lives FOUNDER-side, so a joinee that lost its own store still reads as seated here and takes the
   221	  // no-re-key path. That returns its membership, NEVER its keys: keyhive mints fresh prekeys per init, and the
   222	  // group's already-sealed material stays keyed to the prekeys that vessel held when it was seated. A wiped
   223	  // store recovers from its ARCHIVE (`keyhive-provider` init: RESTORE-OR-FRESH) and from nothing here — force
   224	  // re-keys the group and still opens none of it. A seat is not a key.
   225	  //
   226	  // A joinee whose group was re-founded holds no seat in the NEW group, so the add genuinely runs.
   227	  const seated = await provider.verifyGroupMembership(joineeAgentIdHex, ctx.personaGroupId);
   228	  const addUnlessRolled = summons.force === true || !seated.ok;
   229	  // A DEVICE THAT RETURNS AFTER A LIFT TAKES A FRESH SEAT AND NO EARLIER KEY. The seat reaches each bag FORWARD;
   230	  // the re-seal that would carry the standing chunks across stays out, since those chunks hold the span the
   231	  // device missed.
   232	  const dyad = ctx.dyad(summons.deviceEdge.deviceVerifyingKey);
   233	  if (dyad === "unknown") return { ok: false, reason: "no qualifying signed edge frontier" };
   234	  const returned = dyad === "returned" || dyad === "owing";
