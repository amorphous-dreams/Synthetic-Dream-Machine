   272	    ok: true,
   273	    grant: {
   274	      kind: "face-join-grant/v1",
   275	      joineeAgentIdHex,
   276	      founderCard,
   277	      capEvents: events.map(bytesToBase64),
   278	      reKeyed: mustAdd,
   279	      reSealed,
   280	    },
   281	  };
   282	}

