n inside {@link parseBearingPayload}; never\\n* throws. The OUR-OWN licensed parse (bearing-ast) — the RED URI descended.\\n*/\\nfunction buildSkeletonBearing(h) {\\n\\tif (!h.bearing) return EMPTY_BEARING;\\n\\tconst aim = parseBearingPayload(h.bearing.aimUri);\\n\\tconst yld = parseBearingPayload(h.bearing.yieldUri);\\n\\tconst primary = yld[0] ?? (aim.length > 0 ? aim[aim.length - 1] : void 0) ?? aim[0] ?? null;\\n\\treturn {\\n\\t\\taim,\\n\\t\\tyield: yld,\\n\\t\\tprimary,\\n\\t\\tfacets: primary ? bearingFacets(primary) : {}\\n\\t};\\n}\\n/** Blank one meme-ast node: keep the shape, strip the words. */\\nfunction placeholderNode(node) {\\n\\tconst out = {\\n\\t\\tkind: node.kind,\\n\\t\\tcontent: CONTENT_PLACEHOLDER,\\n\\t\\tchildren: placeholderTree(node.body ?? [])\\n\\t};\\n\\tconst anyNode = node;\\n\\tif (typeof anyNode[\\\"sigilName\\\"] === \\\"string\\\") out.sigilName = anyNode[\\\"sigilName\\\"];\\n\\tif (typeof anyNode[\\\"sigil\\\"] === \\\"string\\\") out.sigil = anyNode[\\\"sigil\\\"];\\n\\tif (typeof anyNode[\\\"family\\\"] === \\\"string\\\") out.family = anyNode[\\\"family\\\"];\\n\\tif (typeof anyNode[\\\"phase\\\"] === \\\"string\\\") out.phase = anyNode[\\\"phase\\\"];\\n\\tif (typeof anyNode[\\\"slot\\\"] === \\\"string\\\") out.slot = anyNode[\\\"slot\\\"];\\n\\tconst attrs = anyNode[\\\"attrs\\\"];\\n\\tif (attrs && typeof attrs === \\\"object\\\") out.attrKeys = Object.keys(attrs).sort();\\n\\tif (typeof node.recoveredAs === \\\"string\\\") out.recoveredAs = node.recoveredAs;\\n\\tif (typeof node.standing === \\\"number\\\") out.standing = node.standing;\\n\\treturn out;\\n}\\n/** Blank a meme-ast forest: every leaf content → `_`, structure preserved. */\\nfunction placeholderTree(nodes) {\\n\\treturn nodes.map(placeholderNode);\\n}\\n/**\\n* Fold a TurnHarvest + a meme-ast tree into the move-skeleton. The harvest\\n* drives the linear stream (Route A — markers already emitted); the tree drives\\n* the placeholdered graph. Pure: no I/O,