t\",\"module-type\":\"library\"},\"lar:///ha.ka.ba/lararium/tw5/filters/stack\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/filters/stack\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/filters/stack\\ntype: application/javascript\\nmodule-type: filteroperator\\n\\\\*/\\nvar LAR_PREFIX = `lar:///ha.ka.ba/`;\\nvar TAG_PREFIX = `${LAR_PREFIX}tags/`;\\nvar VOLATILE_VM_PREFIX = `lar:///lararium.local.vm/`;\\nfunction volatileVmUri(path) {\\n\\treturn `${VOLATILE_VM_PREFIX}${path.replace(/^\\\\/+/, \\\"\\\")}`;\\n}\\nfunction stableLarUri(path) {\\n\\treturn `${LAR_PREFIX}${path.replace(/^\\\\/+/, \\\"\\\")}`;\\n}\\nfunction stableTagUri(name) {\\n\\treturn `${TAG_PREFIX}${name.replace(/^\\\\/+/, \\\"\\\")}`;\\n}\\nvolatileVmUri(\\\"verb/\\\");\\nvar BAGS_SEGMENT = \\\"bags\\\";\\n/** Mint the canonical URI of a BAG (a composable recipe piece; mutable, the IPNS plane). */\\nfunction bagUri(slug) {\\n\\treturn stableLarUri(`${BAGS_SEGMENT}/${slug}`);\\n}\\nbagUri(\\\"oracle\\\");\\nbagUri(\\\"lararium\\\");\\nvar CATALOG_DOC_URI = bagUri(\\\"catalog\\\");\\nbagUri(\\\"lares\\\");\\nbagUri(\\\"crossroads\\\");\\nstableLarUri(\\\"lararium/plugins/lares/memetic-wikitext\\\");\\nstableTagUri(\\\"SharktoothSigil\\\");\\nstableTagUri(\\\"lararium-parse-warnings\\\");\\nstableTagUri(\\\"lararium-bag-mirror\\\");\\nstableTagUri(\\\"lares-verb\\\");\\nstableTagUri(\\\"lares-verb-event\\\");\\nstableTagUri(\\\"lares-pin\\\");\\nstableTagUri(\\\"cap-event\\\");\\nstableTagUri(\\\"cap-event/prekey\\\");\\nstableTagUri(\\\"cap-event/cgka\\\");\\nstableTagUri(\\\"cap-event/delegation\\\");\\nstableTagUri(\\\"cap-event/revocation\\\");\\nstableLarUri(\\\"state/boot-splash/active\\\");\\nbagUri(\\\"identities\\\");\\nbagUri(\\\"circles\\\");\\nbagUri(\\\"sessions\\\");\\n`${CATALOG_DOC_URI}`;\\n/** Daemon wiki bag id — the lararium's own central daemon `daemon` bag (one-recipe model).\\n*  SOVEREIGN-per-vessel: this vessel's own control-plane, never shared across vessels. */\\nvar DAEMON_BAG_ID = bagUri(\\\"daemon\\\");\\n/** The persona NAMESPACE — two jobs, and a reader who fuses them will look for a bag that does not exist.\\n*\\n*  The word is deliberate. SDSI's ruling on this exact shape reads \\\"a NAMESPACE, not a super-key\\\" — a place\\n*  local names hang from, carrying no authority of its own. Calling it a ROOT would claim the opposite and\\n*  name the very thing canon forbids above a person's compartments.\\n*\\n*  ① The TITLE prefix every PersonaGroup plane uses INSIDE its own document: the signer pin, the KEL\\n*     prefix, the selves, the binding records all spell `persona/...` whichever plane holds them. Titles\\n*     resolve verbatim within a document and the composite finds one by walking layers, so every plane\\n*     carries the same internal shape regardless of the bag it answers to.\\n*  ② The STEM a plane's own bag id extends — `personaBagIdFor` derives `persona-<tag>` from that group's\\n*     doc id, and `isPersonaBagId` matches the family by that shape rather than by any fixed id.\\n*\\n*  It NAMES NO BAG on its own. A vessel holds one plane per PersonaGroup it stands in, each seeded,\\n*  mounted, registered and reached under its own derived name; nothing answers to the bare stem. */\\nvar PERSONA_NAMESPACE = bagUri(\\\"persona\\\");\\nstableLarUri(\\\"identities\\\");\\nstableLarUri(\\\"circles\\\");\\nstableLarUri(\\\"sessions\\\");\\nbagUri(\\\"nexus\\\");\\nstableLarUri(\\\"sentinel/kahu-cabal\\\");\\n`${PERSONA_NAMESPACE}`;\\n`${PERSONA_NAMESPACE}`;\\n`${DAEMON_BAG_ID}`;\\n`${DAEMON_BAG_ID}`;\\n`${PERSONA_NAMESPACE}`;\\n`${PERSONA_NAMESPACE}`;\\n`${PERSONA_NAMESPACE}`;\\n`${PERSONA_NAMESPACE}`;\\n`${PERSONA_NAMESPACE}`;\\n`${PERSONA_NAMESPACE}`;\\n`${PERSONA_NAMESPACE}`;\\n`${PERSONA_NAMESPACE}`;\\n//#endregion\\n//#region src/has-stack.ts\\n/**\\n* has-stack — the single-entity component-stack resolution core.\\n*\\n* The has-stack law: a carrier reads as a NAMELESS ENTITY; its `tags` field\\n* carries the component stack; component definitions live as their own\\n* memes at lar:/// addresses (one component, one entity — no shim/pointer\\n* tiddlers at rest). Short tags read as RELATIVE addresses and qualify\\n* against the carrier's own bag scope (`root/@bag`) by derivation.\\n* lar:/// tags pass through already qualified. System (`$:/…`) and\\n* free-form tags ride outside the stack. A relative tag whose definition\\n* has not landed reads declared-unresolved — fertile, not broken.\\n*\\n* Platform-blind pure functions; the TW5 surface rides filters/stack.ts.\\n*\\n* Meme: lar:///ha.ka.ba/lares/api/pono/has-stack\\n*/\\n/** Matches `lar:///<w.w.w>/<namespace>/…` and captures the root + bare namespace. */\\nvar SCOPE_RE = /^lar:\\\\/\\\\/\\\\/(\\\\w+\\\\.\\\\w+\\\\.\\\\w+)\\\\/([\\\\w-]+)\\\\//;\\n/** The reserved kind-plane words — a namespace never equals one. */\\nvar KIND_PLANES = /* @__PURE__ */ new Set([\\n\\t\\\"bags\\\",\\n\\t\\\"wikis\\\",\\n\\t\\\"cid\\\"\\n]);\\n/** A relative component path: word-ish segments joined by `/`. */\\nvar RELATIVE_RE = /^[\\\\w-]+(\\\\/[\\\\w-]+)*$/;\\n/**\\n* Derive the bag scope (`<root>/bags/<namespace>`) from a carrier title. A meme\\n* addresses by its bare namespace (`lar:///ha.ka.ba/sdm/…`); its holding bag is\\n* that namespace as a surface (`bags/sdm`). Returns null when the title carries\\n* no scoped meme address (a kind-plane surface, bad arity, or a system title) —\\n* relative tags on such a carrier stay unresolved.\\n*/\\nfunction bagScopeOf(carrierTitle) {\\n\\tconst m = SCOPE_RE.exec(carrierTitle);\\n\\tif (!m) return null;\\n\\tconst root = m[1], ns = m[2];\\n\\tif (KIND_PLANES.has(ns)) return null;\\n\\treturn `${root}/${BAGS_SEGMENT}/${ns}`;\\n}\\n/**\\n* Qualify one tag against a bag scope.\\n* lar:/// → itself · relative path → the bare-namespace address under the scope ·\\n* system/free-form, or relative-without-scope → null.\\n*/\\nfunction qualifyStackTag(tag, scope) {\\n\\tif (tag.startsWith(\\\"lar:///\\\")) return tag;\\n\\tif (!RELATIVE_RE.test(tag)) return null;\\n\\tif (!scope) return null;\\n\\treturn `lar:///${scope.replace(`/${BAGS_SEGMENT}/`, \\\"/\\\")}/${tag}`;\\n}\\n/** Resolve a carrier's whole tags field into stack entries, order preserved. */\\nfunction stackOf(tags, carrierTitle) {\\n\\tconst scope = bagScopeOf(carrierTitle);\\n\\treturn tags.map((tag) => ({\\n\\t\\ttag,\\n\\t\\turi: qualifyStackTag(tag, scope)\\n\\t}));\\n}\\n//#endregion\\n//#region src/filters/stack.ts\\n/** Read a tiddler's tags defensively (TW5 holds an array; raw fields may hold a string). */\\nfunction tagsOf(fields) {\\n\\tconst t = fields?.[\\\"tags\\\"];\\n\\tif (Array.isArray(t)) return t.filter((x) => typeof x === \\\"string\\\");\\n\\tif (typeof t === \\\"string\\\" && t.length) return t.split(\\\" \\\").filter(Boolean);\\n\\treturn [];\\n}\\n/**\\n* stack[] — emit each input carrier's qualified has-stack URIs (deduped).\\n* stack:has[<name>] — keep carriers whose stack holds <name>; a lar:/// operand\\n* compares directly, a relative operand qualifies against EACH carrier's own\\n* bag scope (TW5 speaks `has` natively; this operator speaks it qualified).\\n*/\\nfunction stack(source, operator) {\\n\\tconst suffix = operator.suffix ?? \\\"\\\";\\n\\tconst operand = operator.operand ?? \\\"\\\";\\n\\tconst results = [];\\n\\tif (suffix === \\\"has\\\") {\\n\\t\\tsource(function(tiddler, title) {\\n\\t\\t\\tif (!tiddler) return;\\n\\t\\t\\tconst scope = bagScopeOf(title);\\n\\t\\t\\tconst target = operand.startsWith(\\\"lar:///\\\") ? operand : qualifyStackTag(operand, scope);\\n\\t\\t\\tif (!target) return;\\n\\t\\t\\tif (stackOf(tagsOf(tiddler.fields), title).some((e) => e.uri === target)) results.push(title);\\n\\t\\t});\\n\\t\\treturn results;\\n\\t}\\n\\tconst seen = /* @__PURE__ */ new Set();\\n\\tsource(function(tiddler, title) {\\n\\t\\tif (!tiddler) return;\\n\\t\\tfor (const e of stackOf(tagsOf(tiddler.fields), title)) if (e.uri && !seen.has(e.uri)) {\\n\\t\\t\\tseen.add(e.uri);\\n\\t\\t\\tresults.push(e.uri);\\n\\t\\t}\\n\\t});\\n\\treturn results;\\n}\\n//#endregion\\nexports.stack = stack;\\n\",\"type\":\"application/javascript\",\"module-type\":\"filteroperator\"},\"lar:///ha.ka.ba/lararium/tw5/filters/toml-field\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/filters/toml-field\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/filters/toml-field\\ntype: application/javascript\\nmodule-type: filteroperator\\n\\\\*/\\n//#region src/filters/toml-field.ts\\n/** toml:key[val] — field filter using TOML field names directly.\\n*  toml:register[CS] → tiddlers where the \\\"register\\\" field equals \\\"CS\\\" */\\nfunction toml(source, operator) {\\n\\tconst fieldName = operator.suffix ?? \\\"\\\";\\n\\tconst value = operator.operand ?? \\\"\\\";\\n\\tconst results = [];\\n\\tsource(function(tiddler, title) {\\n\\t\\tif (!tiddler) return;\\n\\t\\tif (String(tiddler.fields?.[fieldName] ?? \\\"\\\") === value) results.push(title);\\n\\t});\\n\\treturn results;\\n}\\n//#endregion\\nexports.toml = toml;\\n\",\"type\":\"application/javascript\",\"module-type\":\"filteroperator\"},\"lar:///ha.ka.ba/lararium/tw5/modules/weave\":{\"title\":\"lar:///ha.ka.ba/lararium/tw5/modules/weave\",\"text\":\"/*\\\\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/weave\\ntype: application/javascript\\nmodule-type: library\\n\\\\*/\\nlet _lararium_memetic_frame = require(\\\"lar:///ha.ka.ba/lararium/tw5/lib/memetic-frame\\\");\\nlet smol_toml = require(\\\"lar:///ha.ka.ba/lararium/tw5/lib/smol-toml\\\");\\n//#region src/meme-ast/grammar-table.generated.ts\\nvar GENERATED_SIGILS = [\\n\\t{\\n\\t\\tname: \\\"ahu\\\",\\n\\t\\tkind: \\\"child-slot\\\",\\n\\t\\topenPattern: \\\"<<~[^>]*\\\\\\\\bahu\\\\\\\\s+(#\\\\\\\\/[\\\\\\\\wāēīōūʻ-]+(?:\\\\\\\\/[\\\\\\\\wāēīōūʻ-]+)*)(?:\\\\\\\\s+->\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"\\\\\\\\s>]|>(?!>))+)\\\\\\\"?)?\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/ahu\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"aka\\\",\\n\\t\\tkind: \\\"edge-sugar\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*aka\\\\\\\\s+([\\\\\\\\w-]+\\\\\\\\s+)?\\\\\\\"?((?:[^\\\\\\\"\\\\\\\\s>]|>(?!>))+)\\\\\\\"?\\\\\\\\s*>>\\\",\\n\\t\\tdefaultFamily: \\\"observe\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"aperture\\\",\\n\\t\\tkind: \\\"gauge\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*aperture\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"]|\\\\\\\"(?!\\\\\\\\s*>>))*)\\\\\\\"?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"branch\\\",\\n\\t\\tkind: \\\"concurrency\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*branch\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"\\\\\\\\s>]|>(?!>))+)\\\\\\\"?\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"lele\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"carry\\\",\\n\\t\\tkind: \\\"relation\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*carry\\\\\\\\s+([\\\\\\\\w.-]+)(?:\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"]|\\\\\\\"(?!\\\\\\\\s*>>))*)\\\\\\\"?)?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"confidence\\\",\\n\\t\\tkind: \\\"metadata\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*confidence\\\\\\\\b([\\\\\\\\s\\\\\\\\S]*?)>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"config\\\",\\n\\t\\tkind: \\\"relation\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*config\\\\\\\\s+([\\\\\\\\w.-]+)(?:\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"]|\\\\\\\"(?!\\\\\\\\s*>>))*)\\\\\\\"?)?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"const\\\",\\n\\t\\tkind: \\\"pragma-alias\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*const\\\\\\\\s+([\\\\\\\\w-]+)(?:\\\\\\\\s*=\\\\\\\\s*|\\\\\\\\s+)([^\\\\\\\\n>]+?)\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/const\\\\\\\\s*>>\\\",\\n\\t\\tpragmaPattern: \\\"<<~!\\\\\\\\s*const\\\\\\\\s+([\\\\\\\\w-]+)(?:\\\\\\\\s*=\\\\\\\\s*|\\\\\\\\s+)([^\\\\\\\\n>]+?)\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"waiho\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"constraint\\\",\\n\\t\\tkind: \\\"edge-alias\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*constraint\\\\\\\\s+(#[\\\\\\\\w-]+\\\\\\\\s+)?\\\\\\\"?((?:[^\\\\\\\"\\\\\\\\s>]|>(?!>))+)\\\\\\\"?\\\\\\\\s*->\\\\\\\\s*\\\\\\\"?((?:[^\\\\\\\"\\\\\\\\s>]|>(?!>))+)\\\\\\\"?(?:\\\\\\\\s+role[=:]\\\\\\\"?([\\\\\\\\w.-]+)\\\\\\\"?)?\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"pono\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"define\\\",\\n\\t\\tkind: \\\"pragma-alias\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*define\\\\\\\\s+(~?[\\\\\\\\w-]+)(?:\\\\\\\\s*\\\\\\\\(([^)]*)\\\\\\\\))?(?:\\\\\\\\s+([^>]*?))?\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/define\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"wehe\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"dispatcher\\\",\\n\\t\\tkind: \\\"edge-sugar\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"drift-ward\\\",\\n\\t\\tkind: \\\"gauge\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*drift-ward\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"]|\\\\\\\"(?!\\\\\\\\s*>>))*)\\\\\\\"?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"elif\\\",\\n\\t\\tkind: \\\"control\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*elif\\\\\\\\s+([^\\\\\\\\n>]+?)\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"kahawai\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"else\\\",\\n\\t\\tkind: \\\"control\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*else\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"mukuwai\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"for\\\",\\n\\t\\tkind: \\\"control\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*for\\\\\\\\s+([^>]+?)\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/for\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"huli\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"fragment\\\",\\n\\t\\tkind: \\\"child-slot\\\",\\n\\t\\topenPattern: \\\"<<fragment\\\\\\\\s+(#\\\\\\\\/[\\\\\\\\wāēīōūʻ-]+(?:\\\\\\\\/[\\\\\\\\wāēīōūʻ-]+)*)(?:\\\\\\\\s+->\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"\\\\\\\\s>]|>(?!>))+)?\\\\\\\"?)?\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<</fragment\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"ahu\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"frame\\\",\\n\\t\\tkind: \\\"relation\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*frame\\\\\\\\s+([\\\\\\\\w.-]+)(?:\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"]|\\\\\\\"(?!\\\\\\\\s*>>))*)\\\\\\\"?)?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"frame-eot\\\",\\n\\t\\tkind: \\\"frame\\\",\\n\\t\\tpattern: \\\"<<\\\\\\\\^[^>\\\\\\\\n]*&#x0004;\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"frame-etx\\\",\\n\\t\\tkind: \\\"frame\\\",\\n\\t\\tpattern: \\\"<<\\\\\\\\^[^>\\\\\\\\n]*&#x0003;\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"frame-soh\\\",\\n\\t\\tkind: \\\"frame\\\",\\n\\t\\tpattern: \\\"<<\\\\\\\\^[^>\\\\\\\\n]*&#x0001;\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"frame-soh2\\\",\\n\\t\\tkind: \\\"frame\\\",\\n\\t\\tpattern: \\\"<<\\\\\\\\^[^>\\\\\\\\n]*&#x0011;\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"frame-stx\\\",\\n\\t\\tkind: \\\"frame\\\",\\n\\t\\tpattern: \\\"<<\\\\\\\\^[^>\\\\\\\\n]*&#x0002;\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"function\\\",\\n\\t\\tkind: \\\"pragma-alias\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*function\\\\\\\\s+([\\\\\\\\w-]+)(?:\\\\\\\\s+([^>]*?))?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"guard\\\",\\n\\t\\tkind: \\\"edge-alias\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*guard\\\\\\\\s+([^\\\\\\\\n>]*)\\\\\\\\s*>>\\\",\\n\\t\\taliasFor: \\\"kapu\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"hana\\\",\\n\\t\\tkind: \\\"guest-grammar\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*hana\\\\\\\\s+([^\\\\\\\\n>]+?)\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/hana\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"has\\\",\\n\\t\\tkind: \\\"relation\\\",\\n\\t\\tpattern: \\\"<<~\\\\\\\\s*has\\\\\\\\s+([\\\\\\\\w-]+)(?:\\\\\\\\s+([\\\\\\\\w.-]+))?(?:\\\\\\\\s+\\\\\\\"?((?:[^\\\\\\\"]|\\\\\\\"(?!\\\\\\\\s*>>))*)\\\\\\\"?)?\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"heihei\\\",\\n\\t\\tkind: \\\"control\\\",\\n\\t\\topenPattern: \\\"<<~\\\\\\\\s*heihei\\\\\\\\s+([^>]+?)\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<~\\\\\\\\/heihei\\\\\\\\s*>>\\\"\\n\\t},\\n\\t{\\n\\t\\tname: \\\"helu\\\",\\n\\t\\tkind: \\\"pragma\\\",\\n\\t\\topenPattern: \\\"<<~!?\\\\\\\\s*helu\\\\\\\\s+([\\\\\\\\w-]+)(?:\\\\\\\\s*\\\\\\\\(([^)]*)\\\\\\\\))?(?:\\\\\\\\s+([^>]*?))?\\\\\\\\s*>>\\\",\\n\\t\\tclosePattern: \\\"<<