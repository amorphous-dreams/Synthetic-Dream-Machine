nts, and the one TiddlyWiki's own global-import filter spells out loud.\n*   - lar-kind != \"family\" → SigilRule\n*   - lar-kind == \"family\" → FamilyRule\n*\n* Grammar fully self-hosted: every sigil and family rule carries as a tiddler.\n* The `toml` data-fence sigil lives at lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-toml.\n*/\nfunction buildGrammarFromWiki(wiki) {\n\tconst titles = wiki.filterTiddlers(`[all[shadows+tiddlers]tag[${GRAMMAR_TAG}]]`);\n\tconst sigils = [];\n\tconst families = [];\n\tfor (const title of titles) {\n\t\tconst fields = wiki.getTiddler(title)?.fields ?? {};\n\t\tconst family = familyFromFields(title, fields);\n\t\tif (family) {\n\t\t\tfamilies.push(family);\n\t\t\tcontinue;\n\t\t}\n\t\tconst rule = sigilFromFields(title, fields);\n\t\tif (rule) sigils.push(rule);\n\t}\n\tif (sigils.length === 0 && families.length === 0) return null;\n\treturn {\n\t\tsigils,\n\t\tfamilies\n\t};\n}\n//#endregion\nexports.GRAMMAR_TAG = GRAMMAR_TAG;\nexports.after = after;\nexports.familyFromFields = familyFromFields;\nexports.getGrammar = getGrammar;\nexports.name = name;\nexports.nameFromTitle = nameFromTitle;\nexports.resetGrammar = resetGrammar;\nexports.sigilFromFields = sigilFromFields;\nexports.startup = startup;\nexports.vocabularyCidOf = vocabularyCidOf;\n","type":"application/javascript","module-type":"startup"},"lar:///ha.ka.ba/lararium/tw5/modules/host-globals":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/host-globals","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/host-globals\ntype: application/javascript\nmodule-type: startup\n\\*/\n//#region src/host-globals-lend.ts\n/** Define one global where the sandbox lacks it — non-enumerable, so a leak check never lists it. */\nfunction lend(g, name, value) {\n\tif (g[name] !== void 0 && g[name] !== null) return;\n\tObject.defineProperty(g, name, {\n\t\tvalue,\n\t\twritable: true,\n\t\tconfigurable: true,\n\t\tenumerable: false\n\t});\n}\n/**\n* Lend `TextEncoder`, `TextDecoder` and `crypto` into `g` where they stand absent. Idempotent; silent\n* where `process.getBuiltinModule` stands out of reach (a browser, a worker, an older Node).\n*/\nfunction lendHostGlobals(g = globalThis, host) {\n\tif (g.TextEncoder && g.TextDecoder && g.crypto) return;\n\tconst builtin = host?.getBuiltinModule;\n\tif (typeof builtin !== \"function\") return;\n\tconst util = builtin(\"node:util\");\n\tconst nodeCrypto = builtin(\"node:crypto\");\n\tlend(g, \"TextEncoder\", util.TextEncoder);\n\tlend(g, \"TextDecoder\", util.TextDecoder);\n\tlend(g, \"crypto\", nodeCrypto.webcrypto);\n}\n//#endregion\n//#region src/modules/host-globals.ts\n/**\n* host-globals — lend the module sandbox the web globals the host already holds.\n*\n* A plain TiddlyWiki server executes every module in ONE shared `vm.createContext({})`\n* (`boot.js` `$tw.utils.sandbox`), lending it `Buffer`, `process`, timers and `$tw` — no `TextEncoder`,\n* no `crypto`. The meme gate hashes through `new TextEncoder()`, so without this shore every hashing\n* module (the routes, the grammar cache, the deserializer past boot) dies on a plain server with\n* `TextEncoder is not defined`. Node ≥ 24 hands the host's own copies back through\n* `process.getBuiltinModule`; `??=` respects any global the runtime already holds, so a browser or a\n* lararium worker (both already carry them) reads this as a no-op.\n*\n* The lend itself lives in `host-globals-lend` and defines each global NON-ENUMERABLE, so the fork's\n* per-module `globalCheck` never reports it as a leak. The deserializer calls the same lend at its own\n* entry, so a reader reached before this startup module runs holds too.\n*/\nvar name = \"lar-host-globals\";\nvar synchronous = true;\nvar before = [\"startup\"];\nfunction startup() {\n\tlendHostGlobals(globalThis, typeof process === \"undefined\" ? void 0 : process);\n}\n//#endregion\nexports.before = before;\nexports.name = name;\nexports.startup = startup;\nexports.synchronous = synchronous;\n","type":"application/javascript","module-type":"startup"},"lar:///ha.ka.ba/lararium/tw5/modules/import-floor-upgrader":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/import-floor-upgrader","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/import-floor-upgrader\ntype: application/javascript\nmodule-type: upgrader\n\\*/\nlet lararium_deserializer = require(\"lar:///ha.ka.ba/lararium/tw5/modules/deserializer\");\n//#region src/modules/import-floor-upgrader.ts\n/**\n* import-floor-upgrader — the quoteblock floor, made visible where TiddlyWiki's own import doors land.\n*\n* Import, drag-drop, paste and the boot-folder load all read a carrier through the registered\n* `text/memetic-wikitext+tiddlywiki` deserializer, which lays the floor (`ahu.mem#/quoteblock-floor`)\n* and holds a torn frame verbatim. Import and drop then stage every incoming record in `$:/Import` for\n* the operator to review, and TiddlyWiki hands that staging to every `upgrader` module: a message an\n* upgrader answers for a title stands beside that title in the import listing (`message-<title>`).\n*\n* So the fence speaks there, before anything lands. A fenced carrier names the faults its fence holds;\n* a torn carrier names the frame faults it was held verbatim under. Nothing is unchecked or changed —\n* the operator reads the account and decides; an upgrader that edited the payload would decide for them.\n*/\n/** TiddlyWiki's upgrader contract: incoming titles and their fields in, a message per title out. */\nfunction upgrade(_wiki, titles, tiddlers) {\n\tconst messages = {};\n\tfor (const title of titles) {\n\t\tconst fields = tiddlers[title];\n\t\tif (!fields) continue;\n\t\tconst torn = fields[lararium_deserializer.TORN_FIELD];\n\t\tconst fenced = fields[lararium_deserializer.QUOTEBLOCKED_FIELD];\n\t\tif (typeof torn === \"string\" && torn !== \"\") messages[title] = `Torn frame — held verbatim as plain text, never read as a meme: ${torn}`;\n\t\telse if (typeof fenced === \"string\" && fenced !== \"\") messages[title] = `Quoteblocked — ${fenced}`;\n\t}\n\treturn messages;\n}\n//#endregion\nexports.upgrade = upgrade;\n","type":"application/javascript","module-type":"upgrader"},"lar:///ha.ka.ba/lararium/tw5/wikirules/lar-declaration":{"title":"lar:///ha.ka.ba/lararium/tw5/wikirules/lar-declaration","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/wikirules/lar-declaration\ntype: application/javascript\nmodule-type: wikirule\n\\*/\n//#region src/wikirules/lar-declaration.ts\n/** `<<!WORD …>>` at line start — the whole declaration class, one rule. */\nvar DECLARATION_RE = /<<![A-Z][A-Z0-9-]*\\s[^>]*>>/g;\nvar name = \"lar-declaration\";\nvar types = { block: true };\nfunction init(parser) {\n\tthis.parser = parser;\n}\nfunction findNextMatch(startPos) {\n\tconst source = this.parser.source;\n\tDECLARATION_RE.lastIndex = startPos;\n\tconst m = DECLARATION_RE.exec(source);\n\tif (!m) return void 0;\n\tthis.matchPos = m.index;\n\tthis.matchEnd = DECLARATION_RE.lastIndex;\n\tthis.attrs = { __literal__: m[0] };\n\treturn m.index;\n}\nfunction parse() {\n\tconst parser = this.parser;\n\tparser.pos = this.matchEnd;\n\treturn [{\n\t\ttype: \"text\",\n\t\ttext: this.attrs[\"__literal__\"]\n\t}];\n}\n//#endregion\nexports.findNextMatch = findNextMatch;\nexports.init = init;\nexports.name = name;\nexports.parse = parse;\nexports.types = types;\n","type":"application/javascript","module-type":"wikirule"},"lar:///ha.ka.ba/lararium/tw5/filters/lar-kind":{"title":"lar:///ha.ka.ba/lararium/tw5/filters/lar-kind","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/filters/lar-kind\ntype: application/javascript\nmodule-type: filteroperator\n\\*/\n//#region src/filters/lar-kind.ts\n/**\n* The view-state titles that follow a person rather than a device or a wiki. TiddlyWiki names no\n* predicate for this set; the house names it here and the bag-paths cascade reads it through this\n* operator, so the set has one spelling.\n*/\nvar PERSONAL_TITLE_EXACT = [\"$:/StoryList\", \"$:/palette\"];\nvar PERSONAL_TITLE_PREFIXES = [\"$:/state/folded/\", \"$:/state/tab-\"];\nfunction isPersonalTitle(title) {\n\treturn PERSONAL_TITLE_EXACT.includes(title) || PERSONAL_TITLE_PREFIXES.some((p) => title.startsWith(p));\n}\n/** The kind of one tiddler, reading TiddlyWiki's own predicates in their order of specificity. */\nfunction kindOf(wiki, title, tiddler) {\n\tif (wiki.isVolatileTiddler(title)) return \"volatile\";\n\tif (wiki.isTemporaryTiddler(title)) return \"temporary\";\n\tif (tiddler?.isDraft?.() === true) return \"draft\";\n\tif (isPersonalTitle(title)) return \"personal\";\n\tif (wiki.isSystemTiddler(title)) return \"system\";\n\treturn \"content\";\n}\nfunction larKind(source, _operator, options) {\n\tconst results = [];\n\tsource(function(tiddler, title) {\n\t\tresults.push(kindOf(options.wiki, title, tiddler));\n\t});\n\treturn results;\n}\n//#endregion\nexports.PERSONAL_TITLE_EXACT = PERSONAL_TITLE_EXACT;\nexports.PERSONAL_TITLE_PREFIXES = PERSONAL_TITLE_PREFIXES;\nexports.isPersonalTitle = isPersonalTitle;\nexports.kindOf = kindOf;\nexports[\"lar-kind\"] = larKind;\nexports.larKind = larKind;\n","type":"application/javascript","module-type":"filteroperator"},"lar:///ha.ka.ba/lararium/tw5/modules/lar-root-services":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/lar-root-services","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/lar-root-services\ntype: application/javascript\nmodule-type: startup\n\\*/\nvar LAR_PREFIX = `lar:///ha.ka.ba/`;\nvar TAG_PREFIX = `${LAR_PREFIX}tags/`;\nvar VOLATILE_VM_PREFIX = `lar:///lararium.local.vm/`;\nfunction volatileVmUri(path) {\n\treturn `${VOLATILE_VM_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableLarUri(path) {\n\treturn `${LAR_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableTagUri(name) {\n\treturn `${TAG_PREFIX}${name.replace(/^\\/+/, \"\")}`;\n}\nvolatileVmUri(\"verb/\");\n/**\n* The dispatch-intent MARKER field. A genuine DOM verb-summon carries `lares-dispatch`\n* (truthy); the reaction-router fires the verb verse-event only on a marked tiddler.\n* The verb machinery's own invocation/outcome builders NEVER set it — that positive,\n* fail-safe discriminator (absent → no fire) is what breaks the reaction loop (#48).\n*/\nvar LARES_DISPATCH_FIELD = \"lares-dispatch\";\n/** Field-name prefix carrying a summon's named args (`arg-slug`, `arg-bagUrl`, …). The\n*  reaction-router lifts every `arg-<name>` field into the structured args payload. */\nvar LARES_VERB_ARG_PREFIX = \"arg-\";\n/** The clear-password act's one question, naming what the clear returns to the clear. The wiki asks it on its\n*  confirm road and the browser's confirm door answers it, so the person reads the same words, and the same\n*  scope, wherever the act asks. */\nfunction clearCustodyQuestion(clears) {\n\treturn `Clear the passphrase over ${clears}? Those rows will rest in the clear in this browser's storage, readable by anyone who can read it.`;\n}\nvar BAGS_SEGMENT = \"bags\";\n/** Mint the canonical URI of a BAG (a composable recipe piece; mutable, the IPNS plane). */\nfunction bagUri(slug) {\n\treturn stableLarUri(`${BAGS_SEGMENT}/${slug}`);\n}\nbagUri(\"oracle\");\nbagUri(\"lararium\");\nvar CATALOG_DOC_URI = bagUri(\"catalog\");\nbagUri(\"lares\");\nbagUri(\"crossroads\");\nstableLarUri(\"lararium/plugins/lares/memetic-wikitext\");\nstableTagUri(\"SharktoothSigil\");\nstableTagUri(\"lararium-parse-warnings\");\nstableTagUri(\"lararium-bag-mirror\");\nstableTagUri(\"lares-verb\");\nstableTagUri(\"lares-verb-event\");\nstableTagUri(\"lares-pin\");\nstableTagUri(\"cap-event\");\nstableTagUri(\"cap-event/prekey\");\nstableTagUri(\"cap-event/cgka\");\nstableTagUri(\"cap-event/delegation\");\nstableTagUri(\"cap-event/revocation\");\nstableLarUri(\"state/boot-splash/active\");\nbagUri(\"identities\");\nbagUri(\"circles\");\nbagUri(\"sessions\");\n`${CATALOG_DOC_URI}`;\n/** Daemon wiki bag id — the lararium's own central daemon `daemon` bag (one-recipe model).\n*  SOVEREIGN-per-vessel: this vessel's own control-plane, never shared across vessels. */\nvar DAEMON_BAG_ID = bagUri(\"daemon\");\n/** The persona NAMESPACE — two jobs, and a reader who fuses them will look for a bag that does not exist.\n*\n*  The word is deliberate. SDSI's ruling on this exact shape reads \"a NAMESPACE, not a super-key\" — a place\n*  local names hang from, carrying no authority of its own. Calling it a ROOT would claim the opposite and\n*  name the very thing canon forbids above a person's compartments.\n*\n*  ① The TITLE prefix every PersonaGroup plane uses INSIDE its own document: the signer pin, the KEL\n*     prefix, the selves, the binding records all spell `persona/...` whichever plane holds them. Titles\n*     resolve verbatim within a document and the composite finds one by walking layers, so every plane\n*     carries the same internal shape regardless of the bag it answers to.\n*  ② The STEM a plane's own bag id extends — `personaBagIdFor` derives `persona-<tag>` from that group's\n*     doc id, and `isPersonaBagId` matches the family by that shape rather than by any fixed id.\n*\n*  It NAMES NO BAG on its own. A vessel holds one plane per PersonaGroup it stands in, each seeded,\n*  mounted, registered and reached under its own derived name; nothing answers to the bare stem. */\nvar PERSONA_NAMESPACE = bagUri(\"persona\");\nstableLarUri(\"identities\");\nstableLarUri(\"circles\");\nstableLarUri(\"sessions\");\nbagUri(\"nexus\");\nstableLarUri(\"sentinel/kahu-cabal\");\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${DAEMON_BAG_ID}`;\n`${DAEMON_BAG_ID}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n//#endregion\n//#region src/modules/lar-root-services.ts\n/**\n* lar-root-services — the root `tm-*` messages a worker island answers itself, and the host doors it asks the\n* surface to open (dreamdom#/host-services; open ruling 9 as the house reads it).\n*\n* Stock TW5 binds these root-widget listeners under `platforms: [\"browser\"]` alone, so an island that renders\n* through a fake document heard none of them. This module binds them where no browser stands, in two halves:\n*\n*   PURE WIKI LOGIC, run here.\n*     tm-rename-tiddler · tm-relink-tiddler   stock's own handler, over `$tw.wiki`.\n*     tm-home                                 the story from `$:/DefaultTiddlers`, through the stock hook.\n*     tm-modal · tm-show-switcher             a record under `$:/temp/lares/modal/`, painted by the root layer\n*                                             as an `aria-modal` dialog; its own close message removes it.\n*     tm-notify                               a record under `$:/temp/lares/notify/`, painted by the root layer,\n*                                             removed after the notification duration.\n*     tm-scroll · tm-focus-selector           HINTS the frame carries: `$:/temp/lares/hint/{scroll,focus}` with a\n*                                             selector and a rising number, painted as `data-lar-scroll-to` /\n*                                             `data-lar-focus` beside `data-lar-hint`. The page scrolls and\n*                                             focuses; the island never measures.\n*\n*   HOST DOORS, asked through `$tw.lares.serviceDoor` (the mounted camera posts `lar:service` on `ctx.post`).\n*     tm-copy-to-clipboard → clipboard {text}            the success or failure notification on the answer\n*     tm-download-file     → download {filename, text, type}   the template rendered here, as stock saves it\n*     tm-open-window       → open-surface {title, …}\n*     tm-open-external-window → open-external {url, …}\n*     tm-print             → print {}\n*     tm-full-screen       → fullscreen {mode}\n*   A refusal, at once or on the answer, raises `$:/temp/lares/alert/refused/<kind>` tagged `$:/tags/Alert`.\n*\n*   REFUSED BY NAME.\n*     tm-http-request      the Web3-only law: an island makes no HTTP request; `$:/temp/lares/alert/refused/http-request`.\n*\n* A browser page that runs stock TW5 keeps stock's own listeners: this module binds nothing there.\n*/\nvar name = \"lar-root-services\";\nvar after = [\"startup\"];\nvar synchronous = true;\nvar ALERT_REFUSED_PREFIX = \"$:/temp/lares/alert/refused/\";\nvar NOTIFY_PREFIX = \"$:/temp/lares/notify/\";\nvar MODAL_PREFIX = \"$:/temp/lares/modal/\";\nvar HINT_SCROLL = \"$:/temp/lares/hint/scroll\";\nvar HINT_FOCUS = \"$:/temp/lares/hint/focus\";\nvar COPY_OK = \"$:/language/Notifications/CopiedToClipboard/Succeeded\";\nvar COPY_FAILED = \"$:/language/Notifications/CopiedToClipboard/Failed\";\nvar SWITCHER = \"$:/core/ui/SwitcherModal\";\nvar DEFAULT_SAVE_TEMPLATE = \"$:/core/save/all\";\nvar DEFAULT_EXTERNAL = \"https://tiddlywiki.com/\";\nfunction startup() {\n\tif (!$tw || $tw.browser || !$tw.rootWidget) return;\n\tinstallRootServices($tw);\n}\n/** Bind every root listener this module names on `tw.rootWidget`. Exported so a vector binds a wiki it built. */\nfunction installRootServices(tw) {\n\tconst root = tw.rootWidget;\n\tconst wiki = tw.wiki;\n\tlet seq = 0;\n\tconst next = () => String(++seq).padStart(6, \"0\");\n\tconst variablesOf = (event) => JSON.stringify(event.paramObject ?? {});\n\tconst alert = (kind, text) => {\n\t\twiki.addTiddler({\n\t\t\ttitle: ALERT_REFUSED_PREFIX + kind,\n\t\t\ttext,\n\t\t\ttags: [\"$:/tags/Alert\"],\n\t\t\tcomponent: name,\n\t\t\tmodified: /* @__PURE__ */ new Date()\n\t\t});\n\t};\n\tconst notify = (title, variables = \"{}\") => {\n\t\tconst record = NOTIFY_PREFIX + next();\n\t\twiki.addTiddler({\n\t\t\ttitle: record,\n\t\t\ttext: title,\n\t\t\t\"lar-variables\": variables\n\t\t});\n\t\tsetTimeout(() => wiki.deleteTiddler(record), tw.config?.preferences?.notificationDuration ?? 3e3);\n\t};\n\t/** Ask the surface for a door; the answer runs `then` with the status, and a refusal raises th