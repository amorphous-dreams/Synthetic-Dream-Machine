packages/lararium-tw5/plugins/standalone/lares-memetic-wikitext.tid:17:{"tiddlers":{"lar:///config/Lar/AhuTemplate/html":{"title":"lar:///config/Lar/AhuTemplate/html","tags":"lar:///ha.ka.ba/tags/ahu-template","text":"[[lar:///ha.ka.ba/lararium/templates/ahu/html]]\n"},"lar:///ha.ka.ba/lararium/templates/ahu/html":{"title":"lar:///ha.ka.ba/lararium/templates/ahu/html","type":"text/vnd.tiddlywiki","text":"<!-- A SECTION WITH NOTHING UNDER IT SAYS THE SAME NOTHING FOR THREE DIFFERENT FACTS.\n\n     unresolved — no record stands at the child's address. A member left alone and the root's call\n                  stayed: the house keeps the pointer and marks it dead (never invented bytes).\n     arriving   — a record stands and holds no `text` field. The poll lands a group skinny in one\n                  batch and fattens it one title at a time; this is that window, named.\n     empty      — a record stands with an empty text. The author wrote nothing, which is a fact too.\n\n     An arriving child HAS a record and a dead one does not, so one reading tells them apart. -->\n<$let _ahu-state={{{ [<currentTiddler>is[missing]then[unresolved]] ~[<currentTiddler>!has:field[text]then[arriving]] ~[<currentTiddler>!has[text]then[empty]] ~[[filled]] }}}>\n<$let _ahu-class={{{ [<_ahu-state>addprefix[lar-ahu lar-ahu-]] }}}>\n<section class=<<_ahu-class>> data-uri=<<currentTiddler>> data-slot-state=<<_ahu-state>>><header class=\"lar-ahu-slot\"><$link to=<<currentTiddler>>>{{!!slot}}</$link></header><div class=\"lar-ahu-body\"><$transclude $tiddler=<<currentTiddler>> $mode=\"block\"/></div></section>\n</$let>\n</$let>\n"},"lar:///config/Lar/AkaTemplate/html":{"title":"lar:///config/Lar/AkaTemplate/html","tags":"lar:///ha.ka.ba/tags/aka-template","text":"[[lar:///ha.ka.ba/lararium/templates/aka/html]]\n"},"lar:///ha.ka.ba/lararium/templates/aka/html":{"title":"lar:///ha.ka.ba/lararium/templates/aka/html","type":"text/vnd.tiddlywiki","text":"<!-- `aka` PINS a target: rendering follows the TARGET's own kind\n     ({@link lar:///ha.ka.ba/lararium/templates/pin/html}), never a live transclusion of whatever\n     currently sits at the address — `aka` holds the PINNED pole (api/pono/kahea.mem #/head) and\n     renders by target kind. `pin-role` names `aka`'s own posture — informative — and the SIGIL\n     decides it, never the target. -->\n<div class=\"lar-aka\" data-aka-uri=<<currentTiddler>>>\n<$let pin-role=\"informative\">\n<$transclude $tiddler=\"lar:///ha.ka.ba/lararium/templates/pin/html\"/>\n</$let>\n</div>\n"},"$:/config/ConfirmIgnoredFields":{"title":"$:/config/ConfirmIgnoredFields","text":"$origin-bag"},"$:/config/Drafts/TypingTimeout":{"title":"$:/config/Drafts/TypingTimeout","text":"16"},"lar:///ha.ka.ba/lararium/exporters/memetic-wikitext":{"title":"lar:///ha.ka.ba/lararium/exporters/memetic-wikitext","tags":"$:/tags/Exporter","description":"memetic-wikitext — each selected meme recomposed whole (.mem)","extension":".mem","file-type":"text/memetic-wikitext+tiddlywiki","type":"text/vnd.tiddlywiki","text":"\\whitespace trim\n<$list filter=\"[subfilter<exportFilter>lar-uri:bare[]unique[]meme-project[mem]]\" variable=\"carrier\"><$text text=<<carrier>>/></$list>\n"},"lar:///config/Lar/KaheaTemplate/html":{"title":"lar:///config/Lar/KaheaTemplate/html","tags":"lar:///ha.ka.ba/tags/kahea-template","text":"[[lar:///ha.ka.ba/lararium/templates/kahea/html]]\n"},"lar:///ha.ka.ba/lararium/templates/kahea/html":{"title":"lar:///ha.ka.ba/lararium/templates/kahea/html","type":"text/vnd.tiddlywiki","text":"<div class=\"lar-kahea\" data-kahea-uri=<<currentTiddler>>><$transclude $tiddler=<<currentTiddler>> $mode=\"block\"><$fill $name=\"ts-missing\"><span class=\"lar-kahea-missing\"><$link to=<<currentTiddler>>><$text text=<<currentTiddler>>/></$link></span></$fill></$transclude></div>\n"},"lar:///config/Lar/KanawaiTemplate/html":{"title":"lar:///config/Lar/KanawaiTemplate/html","tags":"lar:///ha.ka.ba/tags/kanawai-template","text":"[[lar:///ha.ka.ba/lararium/templates/kanawai/html]]\n"},"lar:///ha.ka.ba/lararium/templates/kanawai/html":{"title":"lar:///ha.ka.ba/lararium/templates/kanawai/html","type":"text/vnd.tiddlywiki","text":"<!-- `kanawai` PINS a target, the BINDING sibling of `aka`: rendering follows the TARGET's own kind\n     ({@link lar:///ha.ka.ba/lararium/templates/pin/html}), identically to `aka`, differing only in\n     `pin-role` — binding, never informative. The SIGIL decides the role, never the target\n     (lar:///ha.ka.ba/lares/api/pono/kanawai). -->\n<div class=\"lar-kanawai\" data-kanawai-uri=<<currentTiddler>>>\n<$let pin-role=\"binding\">\n<$transclude $tiddler=\"lar:///ha.ka.ba/lararium/templates/pin/html\"/>\n</$let>\n</div>\n"},"lar:///config/Lar/KauTemplate/html":{"title":"lar:///config/Lar/KauTemplate/html","tags":"lar:///ha.ka.ba/tags/kau-template","text":"[[lar:///ha.ka.ba/lararium/templates/kau/html]]\n"},"lar:///ha.ka.ba/lararium/templates/kau/html":{"title":"lar:///ha.ka.ba/lararium/templates/kau/html","type":"text/vnd.tiddlywiki","text":"<$list filter=\"[<kau-frag>!match[]]\" variable=ignore>\n<div class=\"lar-kau lar-kau-place\" data-uri=<<currentTiddler>> data-kau-name=<<kau-name>><$list filter=\"[<kau-props>!match[]]\" variable=ignore> data-kau-props=<<kau-props>></$list>><$list filter=\"[<kau-def>!match[]]\" variable=ignore><$transclude $tiddler=<<kau-def>>/></$list><$list filter=\"[<kau-def>match[]]\" variable=ignore><span class=\"lar-kau-hole\">? kau <$text text=<<kau-name>>/></span></$list></div>\n</$list>\n<$list filter=\"[<kau-frag>match[]]\" variable=ignore>\n<div class=\"lar-kau lar-kau-invoke\" data-kau-name=<<kau-name>>><$list filter=\"[<kau-def>!match[]]\" variable=ignore><$transclude $tiddler=<<kau-def>>/></$list><$list filter=\"[<kau-def>match[]]\" variable=ignore><span class=\"lar-kau-hole\">? kau <$text text=<<kau-name>>/></span></$list></div>\n</$list>\n"},"lar:///ha.ka.ba/lararium/config/bag-paths":{"title":"lar:///ha.ka.ba/lararium/config/bag-paths","tags":"$:/tags/Global lar:///ha.ka.ba/tags/LarariumConfig","type":"text/vnd.tiddlywiki","text":"[match[$:/core]then[]]\n[match[$:/library/sjcl.js]then[]]\n[prefix[$:/temp/]then{lar:///ha.ka.ba/lararium/config/current-wiki-temp}]\n[prefix[$:/status/]then{lar:///ha.ka.ba/lararium/config/current-wiki-temp}]\n[prefix[$:/boot/]then{lar:///ha.ka.ba/lararium/config/current-wiki-temp}]\n[prefix[$:/HistoryList]then{lar:///ha.ka.ba/lararium/config/current-wiki-temp}]\n[match[$:/isEncrypted]then{lar:///ha.ka.ba/lararium/config/current-wiki-temp}]\n[status[pending]plugin-type[import]then{lar:///ha.ka.ba/lararium/config/current-wiki-temp}]\n[lar-kind[]match[personal]then{lar:///ha.ka.ba/lararium/config/current-wiki-personal}]\n[prefix[$:/state/]then{lar:///ha.ka.ba/lararium/config/current-wiki-temp}]\n[is[draft]then{lar:///ha.ka.ba/lararium/config/current-wiki-draft}]\n[prefix[lar:]then{lar:///ha.ka.ba/lararium/config/current-wiki-bag}]\n[regexp[.]then{lar:///ha.ka.ba/lararium/config/current-wiki-bag}]\n"},"lar:///config/Lar/LoulouTemplate/html":{"title":"lar:///config/Lar/LoulouTemplate/html","tags":"lar:///ha.ka.ba/tags/loulou-template","text":"[[lar:///ha.ka.ba/lararium/templates/loulou/html]]\n"},"lar:///ha.ka.ba/lararium/templates/loulou/html":{"title":"lar:///ha.ka.ba/lararium/templates/loulou/html","type":"text/vnd.tiddlywiki","text":"<span class=\"lar-loulou\" data-loulou-uri=<<loulou-uri>>><$link to=<<loulou-uri>>><<loulou-uri>></$link></span>\n"},"lar:///ha.ka.ba/lararium/templates/meme/html/root":{"title":"lar:///ha.ka.ba/lararium/templates/meme/html/root","type":"text/vnd.tiddlywiki","text":"\\whitespace trim\n\\import [subfilter{$:/core/config/GlobalImportFilter}]\n<$vars storyTiddler=<<currentTiddler>>>\n<div data-tiddler-title=<<currentTiddler>> class=\"tc-tiddler-frame tc-tiddler-view-frame\" role=\"article\">\n<div class=\"tc-tiddler-title tc-clearfix\"><h2 class=\"tc-title\"><$view field=\"caption\"><$view field=\"title\"/></$view></h2></div>\n<div class=\"tc-tiddler-body tc-clearfix\"><$transclude tiddler=<<currentTiddler>> mode=\"block\"/></div>\n</div>\n</$vars>\n"},"lar:///ha.ka.ba/lararium/templates/meme/html":{"title":"lar:///ha.ka.ba/lararium/templates/meme/html","type":"text/vnd.tiddlywiki","text":"\\define tv-wikilink-template() $uri_doubleencoded$.html\n\\define tv-config-static() yes\n\\define tv-config-toolbar-icons() no\n\\define tv-config-toolbar-text() no\n\\define tv-config-toolbar-class() tc-btn-invisible\n\\import [subfilter{$:/core/config/GlobalImportFilter}]\n`<!doctype html>\n<html>\n<head>\n<meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\" />\n<meta name=\"generator\" content=\"TiddlyWiki\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>`<$view field=\"caption\"><$view field=\"title\"/></$view>`</title>\n</head>\n<body class=\"tc-body\">\n<section class=\"tc-story-river tc-static-story-river\">\n`<$view tiddler=\"lar:///ha.ka.ba/lararium/templates/meme/html/root\" format=\"htmlwikified\"/>`\n</section>\n</body>\n</html>\n`\n"},"lar:///ha.ka.ba/lararium/templates/meme/md.meta":{"title":"lar:///ha.ka.ba/lararium/templates/meme/md.meta","type":"text/vnd.tiddlywiki","text":"\\whitespace trim\n<$text text={{{ [<currentTiddler>meme-project[md.meta],<dialect>,<tongue>] }}}/>\n"},"lar:///ha.ka.ba/lararium/templates/meme/md":{"title":"lar:///ha.ka.ba/lararium/templates/meme/md","type":"text/vnd.tiddlywiki","text":"\\whitespace trim\n<$text text={{{ [<currentTiddler>meme-project[md],<dialect>,<tongue>] }}}/>\n"},"lar:///ha.ka.ba/lararium/templates/meme/mem":{"title":"lar:///ha.ka.ba/lararium/templates/meme/mem","type":"text/vnd.tiddlywiki","text":"\\whitespace trim\n<$text text={{{ [<currentTiddler>meme-project[mem]] }}}/>\n"},"lar:///ha.ka.ba/lararium/templates/parallel-drafts/badge":{"title":"lar:///ha.ka.ba/lararium/templates/parallel-drafts/badge","tags":"$:/tags/ViewTemplate","list-after":"$:/core/ui/ViewTemplate/title","type":"text/vnd.tiddlywiki","text":"\\whitespace trim\n<$list filter=\"[all[tiddlers]field:draft.of<currentTiddler>has[lar-conflict-actor]limit[1]]\" variable=\"-\">\n<div class=\"lar-parallel-drafts\" title=\"A concurrent edit kept as a parallel draft. The live value is the merge's own; discard the draft to let it go.\">\n<$list filter=\"[all[tiddlers]field:draft.of<currentTiddler>has[lar-conflict-actor]sort[title]]\">\n<$link to=<<currentTiddler>> class=\"lar-parallel-draft-badge\">⋔ <$text text={{{ [<currentTiddler>get[modifier]] ~[<currentTiddler>get[lar-conflict-actor]] }}}/></$link>\n</$list>\n</div>\n</$list>\n"},"lar:///ha.ka.ba/lararium/templates/pin/html":{"title":"lar:///ha.ka.ba/lararium/templates/pin/html","type":"text/vnd.tiddlywiki","text":"<!-- THE SHARED PIN RENDER — `aka` and `kanawai` transclude this alike, each setting `pin-role`\n     (informative/binding) before it does. `currentTiddler` here is the TARGET's own address\n     (base, or base#/slot — sigil-aka.tid/sigil-kanawai.tid already bound it before this template\n     runs), never the pin's own position: rendering follows the TARGET's kind, never where the pin\n     stands, and the SIGIL — never the target — decides the role (lar:///ha.ka.ba/lares/api/pono/kahea,\n     lar:///ha.ka.ba/lares/api/pono/kanawai). A reference meme renders a citation card; a content slot\n     renders the frozen image: the target's current bytes, pinned with its own `ni:` check as a\n     badge. Unresolved renders a clearly marked line naming the uri — never silence, never invented\n     content. Each citation row renders only when `meme-pin` answers that part — an absent field is\n     an absent row, never an empty placeholder. -->\n<$let _pin-kind={{{ [<currentTiddler>meme-pin[kind]] }}}>\n<$list filter=\"[<_pin-kind>match[reference]]\" variable=\"_ignore\">\n<div class=\"lar-pin-card\" data-pin-role=<<pin-role>> data-pin-kind=\"reference\" data-pin-uri=<<currentTiddler>>>\n  <div class=\"lar-pin-card-role\">pin-role: <<pin-role>></div>\n  <!-- One row per key `meme-pin[citation-keys]` answers (CITATION_FIELD_KEYS, present fields only) —\n       title/author/date/seriesinfo render alike, as plain text, so one `<$list>` drives all four.\n       `target` differs — it renders as a link, not a text row — so it keeps its own row below and\n       this loop excludes it. -->\n  <$list filter=\"[<currentTiddler>meme-pin[citation-keys]] -[[target]]\" variable=\"_k\">\n  <$list filter=\"[<currentTiddler>meme-pin<_k>]\" variable=\"_v\">\n  <div class={{{ [[lar-pin-card-]addsuffix<_k>] }}}><$text text=<<_v>>/></div>\n  </$list>\n  </$list>\n  <$list filter=\"[<currentTiddler>meme-pin[target]]\" variable=\"_v\">\n  <a class=\"lar-pin-card-target\" href=<<_v>>><$text text=<<_v>>/></a>\n  </$list>\n  <$link to=<<currentTiddler>> class=\"lar-pin-card-self\"><$text text=<<currentTiddler>>/></$link>\n</div>\n</$list>\n<$list filter=\"[<_pin-kind>match[content]]\" variable=\"_ignore\">\n<figure class=\"lar-pin-frozen\" data-pin-role=<<pin-role>> data-pin-kind=\"content\" data-pin-uri=<<currentTiddler>>>\n  <div class=\"lar-pin-frozen-role\">pin-role: <<pin-role>></div>\n  <div class=\"lar-pin-frozen-body\"><$transclude $tiddler=<<currentTiddler>> $mode=\"block\"><$fill $name=\"ts-missing\"><span class=\"lar-pin-empty\"/></$fill></$transclude></div>\n  <figcaption class=\"lar-pin-digest\"><$text text={{{ [<currentTiddler>meme-pin[check]] }}}/></figcaption>\n</figure>\n</$list>\n<$list filter=\"[<_pin-kind>match[unresolved]]\" variable=\"_ignore\">\n<div class=\"lar-pin-unresolved\" data-pin-role=<<pin-role>>>unresolved — <$text text=<<currentTiddler>>/></div>\n</$list>\n</$let>\n"},"lar:///config/Lar/PranalaTemplate/html":{"title":"lar:///config/Lar/PranalaTemplate/html","tags":"lar:///ha.ka.ba/tags/pranala-template","text":"[[lar:///ha.ka.ba/lararium/templates/pranala/html]]\n"},"lar:///config/Lar/PranalaHeaderTemplate/html":{"title":"lar:///config/Lar/PranalaHeaderTemplate/html","tags":"lar:///ha.ka.ba/tags/pranala-header-template","text":"[[lar:///ha.ka.ba/lararium/templates/pranala-header/html]]\n"},"lar:///ha.ka.ba/lararium/templates/pranala-header/html":{"title":"lar:///ha.ka.ba/lararium/templates/pranala-header/html","type":"text/vnd.tiddlywiki","text":"<span class=\"lar-pranala-header\" data-canonical-uri=<<pranala-header-uri>>>? &rarr; <$link to=<<pranala-header-uri>>><<pranala-header-uri>></$link></span>\n"},"lar:///ha.ka.ba/lararium/templates/pranala/html":{"title":"lar:///ha.ka.ba/lararium/templates/pranala/html","type":"text/vnd.tiddlywiki","text":"<span class=\"lar-pranala\" data-from=<<pranala-from>> data-to=<<pranala-to>><$list filter=\"[<pranala-family>!is[blank]]\" variable=\"_\"> data-family=<<pranala-family>></$list><$list filter=\"[<pranala-role>!is[blank]]\" variable=\"_\"> data-role=<<pranala-role>></$list>><$link to=<<pranala-from>>><<pranala-from>></$link>&rarr;<$link to=<<pranala-to>>><<pranala-to>></$link><$list filter=\"[<pranala-body>!is[blank]]\" variable=\"_\"><details class=\"lar-pranala-body\"><summary>note</summary><<pranala-body>></details></$list></span>\n"},"lar:///ha.ka.ba/lararium/templates/root-layer":{"title":"lar:///ha.ka.ba/lararium/templates/root-layer","type":"text/vnd.tiddlywiki","text":"\\whitespace trim\n<$list filter=\"[all[tiddlers]prefix[$:/temp/lares/modal/]sort[title]]\" variable=\"lar-modal\">\n<div class=\"tc-modal-wrapper lar-modal\">\n<div class=\"tc-modal-backdrop\"/>\n<div class=\"tc-modal\" role=\"dialog\" aria-modal=\"true\">\n<$messagecatcher $tm-close-tiddler=\"\"\"<$action-deletetiddler $tiddler=<<lar-modal>>/>\"\"\">\n<$setmultiplevariables $names=\"[<lar-modal>get[lar-variables]jsonindexes[]]\" $values=\"[<lar-modal>get[lar-variables]jsonindexes[]] :map[<lar-modal>get[lar-variables]jsonget<currentTiddler>]\">\n<$let currentTiddler={{{ [<lar-modal>get[text]] }}}>\n<$list filter=\"[<currentTiddler>has[subtitle]]\" variable=\"-\">\n<div class=\"tc-modal-header\"><h3><$transclude $tiddler=<<currentTiddler>> $field=\"subtitle\" $mode=\"inline\"/></h3></div>\n</$list>\n<div class=\"tc-modal-body\"><$transclude $tiddler=<<currentTiddler>> $mode=\"block\"/></div>\n<div class=\"tc-modal-footer\">\n<$list filter=\"[<currentTiddler>has[footer]]\" variable=\"-\" emptyMessage=\"\"\"<$button message=\"tm-close-tiddler\" class=\"tc-btn-big-green lar-modal-close\">{{$:/language/Buttons/Close/Caption}}</$button>\"\"\">\n<$transclude $tiddler=<<currentTiddler>> $field=\"footer\" $mode=\"block\"/>\n</$list>\n</div>\n</$let>\n</$setmultiplevariables>\n</$messagecatcher>\n</div>\n</div>\n</$list>\n<$list filter=\"[all[tiddlers]prefix[$:/temp/lares/notify/]sort[title]]\" variable=\"lar-note\">\n<div class=\"tc-notification lar-notify\" role=\"status\">\n<$setmultiplevariables $names=\"[<lar-note>get[lar-variables]jsonindexes[]]\" $values=\"[<lar-note>get[lar-variables]jsonindexes[]] :map[<lar-note>get[lar-variables]jsonget<currentTiddler>]\">\n<$let currentTiddler={{{ [<lar-note>get[text]] }}}>\n<$transclude $tiddler=<<currentTiddler>> $mode=\"block\"/>\n</$let>\n</$setmultiplevariables>\n</div>\n</$list>\n<$list filter=\"[[$:/temp/lares/hint/scroll]is[tiddler]]\" variable=\"lar-hint\">\n<span class=\"lar-hint\" hidden data-lar-scroll-to={{{ [<lar-hint>get[selector]] }}} data-lar-hint={{{ [<lar-hint>get[seq]] }}}/>\n</$list>\n<$list filter=\"[[$:/temp/lares/hint/focus]is[tiddler]]\" variable=\"lar-hint\">\n<span class=\"lar-hint\" hidden data-lar-focus={{{ [<lar-hint>get[selector]] }}} data-lar-hint={{{ [<lar-hint>get[seq]] }}}/>\n</$list>\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-ahu":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-ahu","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"child-slot","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/ahu","lar-open-pattern":"<<~[^>]*\\bahu\\s+(#\\/[\\wāēīōūʻ-]+(?:\\/[\\wāēīōūʻ-]+)*)(?:\\s+->\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?)?\\s*>>","lar-close-pattern":"<<~\\/ahu\\s*>>","lar-example":"<<~ ahu #/head>>\\nbody\\n<<~/ahu>>","type":"text/vnd.tiddlywiki","text":"<!-- ahu — worksite scope boundary; addressable child-slot tiddler at parentUri#/slot.\n\n     One slot, one address: a slot spelled `#/a` resolves to `#/a` under the meme root, and\n     to `#/a/c` under the child `#/a` — the fragment never repeats its `#`. The same law the\n     deserializer mints the record's title by (composeSlotPath).\n\n     ~kahea~ahu → AhuTemplate cascade (live child-slot transclusion).\n     ~aka~ahu   → AkaTemplate cascade (frozen/projection read of child slot).\n     Render posture lives in the template cascade, not in the sigil procedure.\n\n     Live wiki parent tiddlers hold <<~ kahea ahu #slot>> (space form, HUD-readable).\n     lar-sigil.ts routes compound forms: name=\"kahea~ahu\", p1=slot. -->\n\n\\widget ~ahu(slot:\"\" uri:\"\" p1:\"\")\n<$let _ahu-slot={{{ [<slot>!match[]] ~[<p1>] }}}>\n<$let _ahu-leaf={{{ [<_ahu-slot>removeprefix[#/]] ~[<_ahu-slot>] }}}>\n<$let _ahu-uri={{{ [<uri>!match[]!regexp[^lar:///unknown]] ~[<_ahu-slot>regexp[^lar:]] ~[<currentTiddler>regexp[#/]addsuffix[/]addsuffix<_ahu-leaf>] ~[<currentTiddler>addsuffix[#/]addsuffix<_ahu-leaf>] }}}\n      _ahu-template={{{ [all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/ahu-template]!is[draft]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/ahu/html]] }}}>\n<$tiddler tiddler=<<_ahu-uri>>>\n<$transclude $tiddler=<<_ahu-template>>/>\n</$tiddler>\n</$let>\n</$let>\n</$let>\n\\end\n\n\\procedure ~kahea~ahu(slot:\"\" uri:\"\" p1:\"\")\n<$transclude $variable=\"~ahu\" slot=<<slot>> uri=<<uri>> p1=<<p1>>/>\n\\end\n\n\\procedure ~aka~ahu(slot:\"\" uri:\"\" p1:\"\")\n<$let _a-slot={{{ [<slot>!match[]] ~[<p1>] }}}>\n<$let _a-leaf={{{ [<_a-slot>removeprefix[#/]] ~[<_a-slot>] }}}>\n<$let _a-uri={{{ [<uri>!match[]!regexp[^lar:///unknown]] ~[<_a-slot>regexp[^lar:]] ~[<currentTiddler>regexp[#/]addsuffix[/]addsuffix<_a-leaf>] ~[<currentTiddler>addsuffix[#/]addsuffix<_a-leaf>] }}}\n      _a-template={{{ [all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/aka-template]!is[draft]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/aka/html]] }}}>\n<$tiddler tiddler=<<_a-uri>>>\n<$transclude $tiddler=<<_a-template>>/>\n</$tiddler>\n</$let>\n</$let>\n</$let>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-aka":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-aka","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-sugar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/aka","lar-pattern":"<<~\\s*aka\\s+([\\w-]+\\s+)?\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-default-family":"observe","lar-example":"<<~ aka \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"<!-- aka — projection/frozen read posture. Own AkaTemplate cascade; not a delegation\n     to kahea. The semantic: aka = kahea family:observe (frozen carrier read).\n     Render posture difference lives in the template cascade, not in sigil dispatch. -->\n\n\\widget ~aka(p1:\"\" p2:\"\")\n<$set name=\"_a-uri\" filter=\"[<p1>regexp[^#]]\" value={{{ [<p1>addprefix<currentTiddler>] }}} emptyValue=<<p1>>>\n<$let _a-template={{{ [<p2>!match[]] ~[all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/aka-template]!is[draft]!has[draft.of]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/aka/html]] }}}>\n<$tiddler tiddler=<<_a-uri>>>\n<$transclude $tiddler=<<_a-template>>/>\n</$tiddler>\n</$let>\n</$set>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-aperture":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-aperture","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"gauge","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*aperture\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?\\s*>>","lar-example":"<<~ aperture \"9/measure\">>","type":"text/vnd.tiddlywiki","text":"<!-- aperture (operator ruling: retired `focus`) — a HANDOFF GAUGE, standing alone mid-stream. The\n     same instrument rides `set` as a KEY: two grips, one handle. The boot seed declares both\n     spellings, and both reach one reading. -->\n\n\\procedure ~aperture(p1:\"\")\n<span class=\"lar-gauge\" data-gauge=\"aperture\"><$text text=<<p1>>/></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-branch":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-branch","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/lele","lar-mirror-of":"lele","lar-see-also":"lele","lar-pattern":"<<~\\s*branch\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-example":"<<~ branch \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"<!-- branch — the English mirror of `lele`, the side flow the caller does not wait on. The enclosing\n     async context bounds it and cancels what remains when that context completes.\n\n     ONE DEFINITION ANSWERS FOR BOTH. The mirror delegates to the head rather than restating it, so\n     the discipline moves in one place. -->\n\n\\procedure ~branch(p1:\"\")\n<$transclude $variable=\"~lele\" p1=<<p1>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-carry":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-carry","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*carry\\s+([\\w.-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ carry Rest \"ascii/0 ascii/0\">>","type":"text/vnd.tiddlywiki","text":"<!-- carry — what a turn CARRIES forward. The boot seed declares it as `has` with the entity fixed, so this stands as\n     that same relation under its own head: a NAME, and what it holds, quoted. -->\n\n\\procedure ~carry(p1:\"\" p2:\"\")\n<$transclude $variable=\"~has\" p1=\"carry\" p2=<<p1>> p3=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-confidence":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-confidence","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"metadata","lar-pattern":"<<~\\s*confidence\\b([\\s\\S]*?)>>","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot#/l-prime","lar-example":"<<~ confidence Synthesis 11/20>>","lar-render":"literal","type":"text/vnd.tiddlywiki","text":"<!-- confidence — the certainty vow (register N/20). HUD-frame sigil: recognized in the tree, rendered as\n     plain literal text for now. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-config":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-config","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*config\\s+([\\w.-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ config Defaults \"l-prime/true feedback/5\">>","type":"text/vnd.tiddlywiki","text":"<!-- config — a CONFIG and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as\n     that same relation under its own head: a NAME, and what it holds, quoted. -->\n\n\\procedure ~config(p1:\"\" p2:\"\")\n<$transclude $variable=\"~has\" p1=\"config\" p2=<<p1>> p3=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-const":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-const","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/waiho","lar-mirror-of":"waiho","lar-see-also":"waiho","lar-open-pattern":"<<~\\s*const\\s+([\\w-]+)(?:\\s*=\\s*|\\s+)([^\\n>]+?)\\s*>>","lar-close-pattern":"<<~\\/const\\s*>>","lar-pragma-pattern":"<<~!\\s*const\\s+([\\w-]+)(?:\\s*=\\s*|\\s+)([^\\n>]+?)\\s*>>","lar-example":"<<~ const name \"value\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~const(p1:\"\" p2:\"\" p3:\"\")\n<$transclude $variable=\"~waiho\" p1=<<p1>> p2=<<p2>> p3=<<p3>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-constraint":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-constraint","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pono-sigil","lar-mirror-of":"pono","lar-see-also":"pono","lar-pattern":"<<~\\s*constraint\\s+(#[\\w-]+\\s+)?\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*->\\s*\"?((?:[^\"\\s>]|>(?!>))+)\"?(?:\\s+role[=:]\"?([\\w.-]+)\"?)?\\s*>>","lar-example":"<<~ constraint \"lar:///a.b.c/x\" -> \"lar:///a.b.c/y\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~constraint(p1:\"\" p2:\"\" p3:\"\" p4:\"\")\n<$transclude $variable=\"~pono\" p1=<<p1>> p2=<<p2>> p3=<<p3>> p4=<<p4>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-define":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-define","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/wehe","lar-mirror-of":"wehe","lar-see-also":"wehe","lar-open-pattern":"<<~\\s*define\\s+(~?[\\w-]+)(?:\\s*\\(([^)]*)\\))?(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/define\\s*>>","lar-render":"declares","type":"text/vnd.tiddlywiki","text":"<!-- \\define — English alias for the TW5 \\define macro pragma.\n     Hawaiian equivalent: wehe (same executor scope as \\procedure).\n     lar-see-also: wehe\n\n     lar-kind: pragma-alias — produces no render output; the sigil serves as the declaration.\n     Prefer \\procedure for new code (TW5 5.3+); \\define retained for compatibility\n     with legacy TW5 macro forms. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-dispatcher":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-dispatcher","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-sugar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/dispatcher","type":"text/vnd.tiddlywiki","text":"<!-- THE GRADIENT'S FLOOR. A transclude renders its CHILDREN where the target resolves to nothing, so\n     `src` — the sigil's own verbatim text, handed down by the wikirule — goes to the page when this\n     wiki has never seen the procedure. A sigil a reader typed never disappears.\n\n     It rides through `<$text>` and NOT through `<<src>>`: the verbatim IS sigil syntax, so rendering\n     it as wikitext would re-enter the rule that produced it. Literal text ends the recursion.\n\n     AND AN EMPTY NAME NAMES NOTHING. Definitions compose by handing this widget a name they were\n     given — `~if` renders the sigil its second slot names. An empty slot would make `addprefix` yield\n     the bare `~`, THIS WIDGET'S OWN NAME, and the transclude would re-enter itself until the stack\n     ended. `!is[blank]` empties the variable instead, and an empty variable resolves to nothing —\n     which lands on the floor already standing here.\n\n     A SLOT AND A RUN ANSWER DIFFERENT QUESTIONS. `p1 … p5` hold positional slots — one value each,\n     delimiters stripped, `name=value` pairs stepped over. `args` carries the argument run exactly as\n     written, for the definitions that read a SHAPE rather than an arity: an edge annotation whose\n     from, arrow and to are one assertion, and `kau`, which runs its own parse over `#fragment name\n     props`. Neither derives from the other here, so neither can be got subtly wrong there. -->\n\n\\widget ~(name p1:\"\" p2:\"\" p3:\"\" p4:\"\" p5:\"\" args:\"\" src:\"\")\n<$transclude $variable={{{ [<name>!is[blank]addprefix[~]] }}} p1=<<p1>> p2=<<p2>> p3=<<p3>> p4=<<p4>> p5=<<p5>> args=<<args>>><$text text=<<src>>/></$transclude>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-drift-ward":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-drift-ward","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"gauge","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*drift-ward\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?\\s*>>","lar-example":"<<~ drift-ward \"I hold a preferred answer already\">>","type":"text/vnd.tiddlywiki","text":"<!-- drift-ward — a HANDOFF GAUGE, standing alone mid-stream. The same instrument rides `set` as a KEY:\n     two grips, one handle. The boot seed declares both spellings, and both reach one reading. -->\n\n\\procedure ~drift-ward(p1:\"\")\n<span class=\"lar-gauge\" data-gauge=\"drift-ward\"><$text text=<<p1>>/></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-elif":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-elif","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"control","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kahawai","lar-mirror-of":"kahawai","lar-see-also":"kahawai","lar-pattern":"<<~\\s*elif\\s+([^\\n>]+?)\\s*>>","lar-example":"<<~ elif \"[<x>match[2]]\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~elif(p1:\"\" p2:\"\")\n<%if [<p1>]%><$transclude $variable=\"~\" name=<<p2>>/><%endif%>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-else":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-else","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"control","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/mukuwai","lar-mirror-of":"mukuwai","lar-see-also":"mukuwai","lar-pattern":"<<~\\s*else\\s*>>","lar-example":"<<~ else>>","type":"text/vnd.tiddlywiki","text":"\\procedure ~else(p2:\"\")\n<$transclude $variable=\"~\" name=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-constraint":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-constraint","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-families","lar-dag-required":"false","lar-role-required":"false","lar-role-recommended":"false","lar-confidence-bounded":"false","type":"text/vnd.tiddlywiki","text":"<!-- family:constraint — correctness-asserting alignment edges. -->\n\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-control":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-control","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-families","lar-dag-required":"true","lar-role-required":"false","lar-role-recommended":"true","lar-confidence-bounded":"false","type":"text/vnd.tiddlywiki","text":"<!-- family:control — structural/architectural edges; dag enforced; role recommended. -->\n\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-dataflow":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-dataflow","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-families","lar-dag-required":"false","lar-role-required":"false","lar-role-recommended":"true","lar-confidence-bounded":"false","type":"text/vnd.tiddlywiki","text":"<!-- family:dataflow — live transclusion / value-push edges; role recommended. -->\n\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-frame":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-frame","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/memetic-wikitext","type":"text/vnd.tiddlywiki","text":"<!-- family:frame — the CARRIER FRAME control marks, opened by `<<^` and dispatched by control code.\n     NOT `family:control`, which names structural pranala EDGES: one word, two relations, held apart\n     here. A frame mark names a POSITION IN A TRANSMISSION; a control edge names authority in a graph. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-message":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-message","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-families","lar-dag-required":"false","lar-role-required":"false","lar-role-recommended":"true","lar-confidence-bounded":"false","type":"text/vnd.tiddlywiki","text":"<!-- family:message — fire-and-forget dispatch edges; role recommended. -->\n\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-observe":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-observe","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-families","lar-dag-required":"false","lar-role-required":"false","lar-role-recommended":"false","lar-confidence-bounded":"true","type":"text/vnd.tiddlywiki","text":"<!-- family:observe — read/observe edges; confidence ≤ source confidence. -->\n\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-reaction":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-reaction","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-families","lar-dag-required":"false","lar-role-required":"false","lar-role-recommended":"true","lar-confidence-bounded":"false","type":"text/vnd.tiddlywiki","text":"<!-- family:reaction — observer-subscription / reaction-wire edges; role recommended. -->\n\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-relation":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-relation","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-families","lar-dag-required":"false","lar-role-required":"false","lar-role-recommended":"false","lar-confidence-bounded":"false","type":"text/vnd.tiddlywiki","text":"<!-- family:relation — semantic relational edges; no dag requirement; role optional. -->\n\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-spatial":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-family-spatial","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"family","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-families","lar-dag-required":"false","lar-role-required":"false","lar-role-recommended":"true","lar-confidence-bounded":"false","type":"text/vnd.tiddlywiki","text":"<!-- family:spatial — layout/canvas position edges; role disambiguates relationship type. -->\n\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-for":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-for","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"control","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/huli","lar-mirror-of":"huli","lar-see-also":"huli","lar-open-pattern":"<<~\\s*for\\s+([^>]+?)\\s*>>","lar-close-pattern":"<<~\\/for\\s*>>","lar-example":"<<~ for \"[tag[x]]\">>","type":"text/vnd.tiddlywiki","text":"<!-- \\for — iteration block; maps a filter over a body template.\n     Hawaiian equivalent: huli (search/turn — query or exploration scope).\n     lar-see-also: huli\n\n     <<~ for filter>>body-template<<~/for>> renders body-template once per result.\n     Operator talk-story: body-template receives the current tiddler title as\n     `currentTiddler`. Use `[all[tiddlers]tag[MyTag]]` for tag iteration,\n     `[range[1,10]]` for numeric, `[{!!items}splitTiddlerList[]]` for stored lists.\n\n     No mode= param — control flow has no projection posture. -->\n\n\\procedure ~for(p1:\"\" p2:\"\")\n<$list filter=<<p1>>>\n<$transclude $variable=\"~\" name=<<p2>>/>\n</$list>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-fragment":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-fragment","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"child-slot","lar-mirror-of":"ahu","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/ahu","lar-open-pattern":"<<fragment\\s+(#\\/[\\wāēīōūʻ-]+(?:\\/[\\wāēīōūʻ-]+)*)(?:\\s+->\\s+\"?((?:[^\"\\s>]|>(?!>))+)?\"?)?\\s*>>","lar-close-pattern":"<</fragment\\s*>>","lar-example":"<<fragment #/head>>\\nbody\\n<</fragment>>","type":"text/vnd.tiddlywiki","text":"<!-- English alias of ahu. It lowers to the shared child-slot AST, stream event,\n     record shape, and live template backend. Worksite carriage records hold its exact authored delimiters. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-eot":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-eot","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-family":"frame","lar-code":"&#x0004;","lar-slots":"code target","lar-pattern":"<<\\^[^>\\n]*&#x0004;","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/memetic-wikitext","lar-render":"mark","type":"text/vnd.tiddlywiki","text":"<!-- EOT &#x0004; — transmission ends, bearing forward. The pattern anchors on the CONTROL CODE, never on what precedes\n     it: an SOH may carry a namespace glyph the matcher cannot know, and a shape that scans for\n     the opener alone swallows the whole header. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-etx":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-etx","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-family":"frame","lar-code":"&#x0003;","lar-slots":"code bcc","lar-pattern":"<<\\^[^>\\n]*&#x0003;","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/memetic-wikitext","lar-render":"mark","type":"text/vnd.tiddlywiki","text":"<!-- ETX &#x0003; — text ends; the block check follows the mark directly. The pattern anchors on the CONTROL CODE, never on what precedes\n     it: an SOH may carry a namespace glyph the matcher cannot know, and a shape that scans for\n     the opener alone swallows the whole header. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-soh":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-soh","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-family":"frame","lar-code":"&#x0001;","lar-slots":"code namespace bearing uri","lar-pattern":"<<\\^[^>\\n]*&#x0001;","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/memetic-wikitext","lar-render":"mark","type":"text/vnd.tiddlywiki","text":"<!-- SOH &#x0001; — the carrier declares itself and its canonical address. The pattern anchors on the CONTROL CODE, never on what precedes\n     it: an SOH may carry a namespace glyph the matcher cannot know, and a shape that scans for\n     the opener alone swallows the whole header. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-soh2":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-soh2","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-family":"frame","lar-code":"&#x0011;","lar-slots":"code namespace bearing uri","lar-pattern":"<<\\^[^>\\n]*&#x0011;","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/memetic-wikitext","lar-render":"mark","type":"text/vnd.tiddlywiki","text":"<!-- SOH₂ &#x0011; — the second heading form. The pattern anchors on the CONTROL CODE, never on what precedes\n     it: an SOH may carry a namespace glyph the matcher cannot know, and a shape that scans for\n     the opener alone swallows the whole header. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-stx":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame-stx","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-family":"frame","lar-code":"&#x0002;","lar-slots":"code","lar-pattern":"<<\\^[^>\\n]*&#x0002;","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/memetic-wikitext","lar-render":"mark","type":"text/vnd.tiddlywiki","text":"<!-- STX &#x0002; — text begins. The pattern anchors on the CONTROL CODE, never on what precedes\n     it: an SOH may carry a namespace glyph the matcher cannot know, and a shape that scans for\n     the opener alone swallows the whole header. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-frame","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*frame\\s+([\\w.-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ frame turn \"aim -> yield\">>","type":"text/vnd.tiddlywiki","text":"<!-- frame — a FRAME and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as\n     that same relation under its own head: a NAME, and what it holds, quoted. -->\n\n\\procedure ~frame(p1:\"\" p2:\"\")\n<$transclude $variable=\"~has\" p1=\"frame\" p2=<<p1>> p3=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-function":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-function","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/function","lar-pattern":"<<~\\s*function\\s+([\\w-]+)(?:\\s+([^>]*?))?\\s*>>","lar-example":"<<~ function name \"params\">>","lar-render":"declares","type":"text/vnd.tiddlywiki","text":"<!-- \\function — English alias for the TW5 \\function pragma (TW5 5.3+).\n     No direct Hawaiian equivalent; filter-function semantics are TW5-native.\n\n     <<~ function name(params)>>filter-expression<<~/function>> declares\n     a named filter function. Leaf-only (no block body in practice — filter bodies\n     are inline expressions). lar-kind: pragma-alias — no render output. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-guard":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-guard","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kapu","lar-mirror-of":"kapu","lar-see-also":"kapu","lar-pattern":"<<~\\s*guard\\s+([^\\n>]*)\\s*>>","lar-example":"<<~ guard \"[tag[x]]\">>","lar-render":"compile","type":"text/vnd.tiddlywiki","text":"<!-- guard — compile-layer boundary annotation; English alias for kapu.\n     Marks confidence, restriction, or unresolved threshold.\n     No render output — operates at the parse/compile layer. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-hana":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-hana","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"guest-grammar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/hana","lar-see-also":"task","lar-open-pattern":"<<~\\s*hana\\s+([^\\n>]+?)\\s*>>","lar-close-pattern":"<<~\\/hana\\s*>>","lar-example":"<<~ hana \"toml\" \"a = 1\">>","type":"text/vnd.tiddlywiki","text":"<!-- hana — bounded guest-grammar block; grammar-key selects the interpreter.\n     p1 = grammar-key; p2 = body. Looks up hana-interpreter-<key> tiddler;\n     fallback renders body as labelled code block. -->\n\n\\widget ~hana(p1:\"\" p2:\"\")\n<$set name=\"_h-candidate\" filter=\"[<p1>addprefix[lar:///ha.ka.ba/lararium/hana-interpreter/]]\">\n<$set name=\"_h-interp\" filter=\"[all[shadows+tiddlers+system]field:title<_h-candidate>!is[draft]first[]]\">\n<%if [<_h-interp>!match[]]%><$transclude $tiddler=<<_h-interp>> hana-key=<<p1>> hana-body=<<p2>>/><%else%><pre class=\"lar-hana\" data-hana-key=<<p1>>><code><<p2>></code></pre><%endif%>\n</$set>\n</$set>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-has":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-has","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*has\\s+([\\w-]+)(?:\\s+([\\w.-]+))?(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ has rank pulse \"levels/0-4 reads/a-mark-a-morpheme-a-word\">>","type":"text/vnd.tiddlywiki","text":"<!-- has — an ENTITY, a NAME, and what it HOLDS. The boot seed writes the relation and this shelf\n     answers for it everywhere else:\n\n         <<~ has rank pulse \"levels/0-4 reads/a-mark-a-morpheme-a-word\">>\n\n     Thirty-five carriers each declared a local shorthand for exactly this, hard-coding the entity\n     into the procedure's own name — seventy-two names, one shape. The entity rides as the FIRST\n     POSITIONAL here, so one definition answers for all of them.\n\n     WHAT AN ENTITY HOLDS RIDES QUOTED. It carries slashes, colons, arrows and prose; unquoted, every\n     `word:` binds a parameter nobody named and the slot receives nothing.\n\n     AND IT RIDES AS TEXT. What an entity holds carries square brackets, arrows and backticks — a\n     filtered transclusion renders each as a LINK to a tiddler nobody wrote, and wikitext would read\n     `[Fiduciary: POA]` as a wikilink. A value names no address. -->\n\n\\procedure ~has(p1:\"\" p2:\"\" p3:\"\")\n<span class=\"lar-has\"><<p1>> <<p2>> holds [<$text text=<<p3>>/>]</span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-heihei":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-heihei","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"control","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/heihei","lar-see-also":"if","lar-open-pattern":"<<~\\s*heihei\\s+([^>]+?)\\s*>>","lar-close-pattern":"<<~\\/heihei\\s*>>","lar-example":"<<~ heihei \"[<x>match[1]]\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~heihei(p1:\"\" p2:\"\")\n<%if [<p1>]%><$transclude $variable=\"~\" name=<<p2>>/><%endif%>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-helu":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-helu","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/helu","lar-see-also":"\\function","lar-open-pattern":"<<~!?\\s*helu\\s+([\\w-]+)(?:\\s*\\(([^)]*)\\))?(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/helu\\s*>>","lar-example":"<<~ helu tally \"[tag[x]count[]]\">>","type":"text/vnd.tiddlywiki","text":"<!-- helu — a NAMED FILTER FUNCTION and the filter it reckons. THE NAME FIRST, THE FILTER SECOND:\n\n         <<~ helu tally \"[tag[x]count[]]\">>\n\n     //helu// counts, enumerates, reckons. Where `wehe` declares a body that RENDERS, helu declares\n     one that COMPUTES — the body yields a filter result set, never wikitext.\n\n     THE PAGE STAYS CLEAR. Its law reads \"register a function definition only, producing no render\n     output\", so the definition hands the compile layer a data annotation and leaves the reader\n     nothing to step over.\n\n     THE FILTER RIDES QUOTED. It carries brackets, colons and prose; unquoted, every `word:` binds a\n     parameter nobody named and the slot receives nothing. -->\n\n\\procedure ~helu(p1:\"\" p2:\"\")\n<span class=\"lar-helu\" data-helu-name=<<p1>> data-helu-filter=<<p2>> hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-holo":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-holo","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/holo","lar-see-also":"race","lar-open-pattern":"<<~\\s*holo\\s*>>","lar-close-pattern":"<<~\\/holo\\s*>>","lar-example":"<<~ holo>>","type":"text/vnd.tiddlywiki","text":"<!-- holo — a CANCELLING RACE over the flows its block opens. The first flow to settle yields the\n     block's result, and every losing arm cancels RECURSIVELY — the whole subtree beneath a loser,\n     never its direct children alone:\n\n         <<~ holo>>\n           <<~ lele \"lar:///target-a\">>\n           <<~ lele \"lar:///target-b\">>\n         <<~/holo>>\n\n     `puka` keeps the other discipline: there a loser runs on until the enclosing scope exits.\n     `race` mirrors this head in English and delegates here.\n\n     THE PAGE STAYS CLEAR. Coordination governs execution and never layout, so the definition hands\n     the compile layer a data annotation naming the discipline and renders nothing. -->\n\n\\procedure ~holo()\n<span class=\"lar-holo\" data-losers=\"cancelled-recursively\" hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-hoolele":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-hoolele","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/hoolele","lar-see-also":"\\spawn","lar-pattern":"<<~\\s*hoolele\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-example":"<<~ hoolele \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"<!-- hoolele — a NEW TASK ROOT at a target, outside the tree that launched it. THE TARGET RIDES AS\n     THE FIRST POSITIONAL and it rides QUOTED:\n\n         <<~ hoolele \"lar:///a.b.c/x\">>\n\n     //hoʻolele// causes to fly — the kite released, the canoe with no line back to shore. The task\n     outlives the scope that created it; no scope exit reaches it, and only an explicit Cancel() on\n     the handle it returns ends it. The one unstructured move in the family: it hides the suspends\n     effect from its caller, which supplies the escape.\n\n     PREFER `lele` FOR ANYTHING LOSABLE. hoolele answers the three cases whose work MUST land —\n     persistence across scope destruction, cross-island work, a background daemon loop.\n\n     AN UNQUOTED ADDRESS REACHES NOTHING. `lar:///x` standing bare in a positional slot binds a\n     parameter named `lar`, and the slot receives nothing; one pair of quotes fills it.\n\n     THE PAGE STAYS CLEAR. A launch governs execution and never layout, so the definition hands the\n     compile layer a data annotation carrying the target and renders nothing. -->\n\n\\procedure ~hoolele(p1:\"\")\n<span class=\"lar-hoolele\" data-hoolele-target=<<p1>> data-cancellation=\"explicit\" hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-hud":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-hud","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"metadata","lar-pattern":"<<~\\s*hud\\b([\\s\\S]*?)>>","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot#/exchange-protocol","lar-example":"<<~ hud Focus(11)>>","lar-render":"literal","type":"text/vnd.tiddlywiki","text":"<!-- hud — the turn gauges (Aperture · OODA-HA). HUD-frame sigil: recognized in the tree, rendered as\n     plain literal text for now. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-hui":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-hui","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/hui","lar-see-also":"sync","lar-open-pattern":"<<~\\s*hui\\s*>>","lar-close-pattern":"<<~\\/hui\\s*>>","lar-example":"<<~ hui>>","type":"text/vnd.tiddlywiki","text":"<!-- hui — an AWAIT-ALL JOIN over the flows its block opens. Fan out, then fan in: the containing\n     flow resumes only once every child settles, and a failure in any child reaches the container:\n\n         <<~ hui>>\n           <<~ lele \"lar:///target-a\">>\n           <<~ lele \"lar:///target-b\">>\n         <<~/hui>>\n\n     A //hui// gathers and holds the gathering — no member leaves while another still travels. An\n     enclosing scope that exits first cancels what remains. `sync` mirrors this head in English and\n     delegates here.\n\n     THE PAGE STAYS CLEAR. Coordination governs execution and never layout, so the definition hands\n     the compile layer a data annotation naming the discipline and renders nothing. -->\n\n\\procedure ~hui()\n<span class=\"lar-hui\" data-join=\"await-all\" hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-huli":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-huli","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"control","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/huli","lar-see-also":"for","lar-open-pattern":"<<~\\s*huli\\s+([^>]+?)\\s*>>","lar-close-pattern":"<<~\\/huli\\s*>>","lar-example":"<<~ huli \"[tag[x]]\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~huli(p1:\"\" p2:\"\")\n<$list filter=<<p1>>><$transclude $variable=\"~\" name=<<p2>>/></$list>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-if":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-if","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"control","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/heihei","lar-mirror-of":"heihei","lar-see-also":"heihei","lar-open-pattern":"<<~\\s*if\\s+([^>]+?)\\s*>>","lar-close-pattern":"<<~\\/if\\s*>>","lar-example":"<<~ if \"[<x>match[1]]\">>","type":"text/vnd.tiddlywiki","text":"<!-- \\if — conditional block using TW5 <%if filter%>...<%endif%> shortcut (TW5 5.3+).\n     Hawaiian equivalent: heihei (race/compete — multiple candidate bodies, first wins).\n     lar-see-also: heihei\n\n     <<~ if filter>>body<<~/if>> renders body only when filter yields a non-empty result.\n     Operator talk-story: TW5 filter semantics differ from imperative conditionals.\n     The filter runs in the current tiddler context; true = at least one result.\n     Use `[<variable>match[value]]` for equality, `[condition]` for existence tests.\n\n     No mode= param — control flow has no projection posture. -->\n\n\\procedure ~if(p1:\"\" p2:\"\")\n<%if [<p1>]%>\n<$transclude $variable=\"~\" name=<<p2>>/>\n<%endif%>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-import":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-import","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kahea","lar-mirror-of":"kahea","lar-see-also":"kahea","lar-pattern":"<<~\\s*import\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?(?:\\s+key[=:]\"?([\\w.-]+)\"?)?\\s*>>","lar-example":"<<~ import \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~import(p1:\"\" p2:\"\")\n<$transclude $variable=\"~kahea\" p1=<<p1>> p2=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-integrity":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-integrity","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*integrity\\s+([\\w.-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ integrity pattern \"one spelling, one act\">>","type":"text/vnd.tiddlywiki","text":"<!-- integrity — an INTEGRITY and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as\n     that same relation under its own head: a NAME, and what it holds, quoted. -->\n\n\\procedure ~integrity(p1:\"\" p2:\"\")\n<$transclude $variable=\"~has\" p1=\"integrity\" p2=<<p1>> p3=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kahawai":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kahawai","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"control","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kahawai","lar-see-also":"\\elif","lar-pattern":"<<~\\s*kahawai\\s+([^\\n>]+?)\\s*>>","lar-example":"<<~ kahawai \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~kahawai(p1:\"\" p2:\"\")\n<%if [<p1>]%><$transclude $variable=\"~\" name=<<p2>>/><%endif%>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kahea":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kahea","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-sugar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kahea","lar-pattern":"<<~\\s*kahea\\s+(\"?lar:[^\"\\s>]+\"?|[^\\s>(]+\\/[^\\s>]*|[^\\s>(]+#[^\\s>]*)\\s*>>","lar-open-pattern":"<<~\\s*kahea\\s+([a-z][\\w-]*)(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/kahea\\s*>>","lar-default-family":"dataflow","lar-layer":"both","lar-example":"<<~ kahea \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"<!-- kahea — live transclusion; picks KaheaTemplate cascade.\n     aka carries the projection/frozen posture via its own AkaTemplate cascade.\n\n     Dispatch shapes:\n       <<~ kahea lar:///uri>>      → ~kahea(p1=uri)       — URI leaf\n       <<~ kahea ahu #slot>>       → ~kahea~ahu(p1=\"#slot\") — child-slot summons\n       <<~ aka ahu #slot>>         → ~aka~ahu               — projection child-slot -->\n\n\\widget ~kahea(p1:\"\" p2:\"\")\n<$set name=\"_k-uri\" filter=\"[<p1>regexp[^#]]\" value={{{ [<p1>addprefix<currentTiddler>] }}} emptyValue=<<p1>>>\n<$let _k-template={{{ [<p2>!match[]] ~[all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/kahea-template]!is[draft]!has[draft.of]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/kahea/html]] }}}>\n<$tiddler tiddler=<<_k-uri>>>\n<$transclude $tiddler=<<_k-template>>/>\n</$tiddler>\n</$let>\n</$set>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kanawai":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kanawai","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-sugar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kanawai","lar-pattern":"<<~\\s*kanawai\\s+([\\w-]+\\s+)?\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-default-family":"observe","lar-example":"<<~ kanawai \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"<!-- kanawai — Hawaiian: kānāwai, \"law\" — the BINDING pin, `aka`'s informative sibling. Carries its\n     own KanawaiTemplate cascade; never delegates to aka or kahea. Canon-Scribe's pono/kanawai meme\n     states the binding/informative distinction; this tiddler carries the grammar alone. -->\n\n\\widget ~kanawai(p1:\"\" p2:\"\")\n<$set name=\"_kw-uri\" filter=\"[<p1>regexp[^#]]\" value={{{ [<p1>addprefix<currentTiddler>] }}} emptyValue=<<p1>>>\n<$let _kw-template={{{ [<p2>!match[]] ~[all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/kanawai-template]!is[draft]!has[draft.of]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/kanawai/html]] }}}>\n<$tiddler tiddler=<<_kw-uri>>>\n<$transclude $tiddler=<<_kw-template>>/>\n</$tiddler>\n</$let>\n</$set>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kapu":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kapu","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-sugar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kapu","lar-see-also":"\\guard","lar-pattern":"<<~\\s*kapu\\s+([^\\n>]*)\\s*>>","lar-open-pattern":"<<~\\s*kapu\\s+([^\\n>]*)\\s*>>","lar-close-pattern":"<<~\\/kapu\\s*>>","lar-example":"<<~ kapu \"reason\">>","lar-render":"compile","type":"text/vnd.tiddlywiki","text":"<!-- kapu — boundary/restriction annotation; compile-layer edge sugar.\n     Marks a threshold, restriction, or qualification. No render output — operates at parse layer. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kau":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kau","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"child-slot","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kau","lar-pattern":"<<~\\s*kau\\s+(#[\\w-]+\\s+)?([\\w][\\w.-]*)(?:\\s+([^>]*))?\\s*>>","lar-example":"<<~ kau Laptop>>","type":"text/vnd.tiddlywiki","text":"<!-- kau — device-slot child-slot sigil. TW5-native \\widget handles all render;\n     ~kahea~kau and ~aka~kau follow the ahu template-cascade pattern.\n\n     Dispatch shapes:\n       <<~ kau #frag Name props>>    → ~kau(args=\"#frag Name props\") — placement\n       <<~ kau Name>>                → ~kau(args=\"Name\")             — invocation\n       <<~ kahea kau #slot>>         → ~kahea~kau(p1=\"#slot\")\n       <<~ aka   kau #slot>>         → ~aka~kau(p1=\"#slot\")\n\n     args parse: first token starting with # = fragment; remainder = name + props. This widget\n     reads the argument RUN and not the slots, because its shape is positional-by-prefix rather\n     than positional-by-arity — a placement carries a fragment the invocation form omits.\n     Template cascade tag: lar:///ha.ka.ba/tags/kau-template\n     Keyhive capability and UUID write-back: deferred; handled by explicit action\n     tiddlers when Keyhive WASM lands. -->\n\n\\widget ~kau(p1:\"\" p2:\"\" p3:\"\" args:\"\")\n<$set name=\"_kau-fst\" filter=\"[<args>split[ ]first[]]\" emptyValue=\"\">\n<$set name=\"_kau-frag\" filter=\"[<_kau-fst>regexp[^#]]\" emptyValue=\"\">\n<$set name=\"_kau-after\" filter=\"[<_kau-fst>regexp[^#]]\" value={{{ [<args>removeprefix<_kau-fst>trim[]] }}} emptyValue=<<args>>>\n<$set name=\"_kau-name\" filter=\"[<_kau-after>split[ ]first[]]\" emptyValue=\"\">\n<$set name=\"_kau-props\" filter=\"[<_kau-after>removeprefix<_kau-name>trim[]]\" emptyValue=\"\">\n<$let _kau-def={{{ [all[tiddlers+shadows]tag[lar:///ha.ka.ba/tags/kumu]field:kumu-name<_kau-name>first[]else[]] }}}\n      _kau-template={{{ [all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/kau-template]!is[draft]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/kau/html]] }}}>\n<$set name=\"kau-name\" value=<<_kau-name>>><$set name=\"kau-def\" value=<<_kau-def>>><$set name=\"kau-props\" value=<<_kau-props>>><$set name=\"kau-frag\" value=<<_kau-frag>>>\n<$list filter=\"[<_kau-frag>!match[]]\" variable=ignore>\n<$set name=\"_kau-instance\" filter=\"[<_kau-frag>!match[]]\" value={{{ [<currentTiddler>addsuffix<_kau-frag>] }}} emptyValue=<<currentTiddler>>>\n<$tiddler tiddler=<<_kau-instance>>><$transclude $tiddler=<<_kau-template>>/></$tiddler>\n</$set>\n</$list>\n<$list filter=\"[<_kau-frag>match[]]\" variable=ignore>\n<$transclude $tiddler=<<_kau-template>>/>\n</$list>\n</$set></$set></$set></$set>\n</$let>\n</$set></$set></$set></$set></$set>\n\\end\n\n\\procedure ~kahea~kau(p1:\"\" p2:\"\" p3:\"\" args:\"\")\n<$transclude $variable=\"~kau\" p1=<<p1>> p2=<<p2>> p3=<<p3>> args=<<args>>/>\n\\end\n\n\\procedure ~aka~kau(slot:\"\" uri:\"\" p1:\"\")\n<$let _ak-slot={{{ [<slot>!match[]] ~[<p1>] }}}>\n<$let _ak-uri={{{ [<uri>!match[]!regexp[^lar:///unknown]] ~[<_ak-slot>regexp[^lar:]] ~[<currentTiddler>addsuffix<_ak-slot>] }}}\n      _ak-template={{{ [all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/aka-template]!is[draft]!has[draft.of]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/aka/html]] }}}>\n<$tiddler tiddler=<<_ak-uri>>>\n<$transclude $tiddler=<<_ak-template>>/>\n</$tiddler>\n</$let>\n</$let>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kukali":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kukali","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"leaf","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kukali","lar-see-also":"\\suspends","lar-pattern":"<<~\\s*kukali(?:\\s+trigger[=:]\"?([\\w.-]+)\"?)?\\s*>>","lar-example":"<<~ kukali trigger=\"on-score\">>","type":"text/vnd.tiddlywiki","text":"<!-- kukali — a WAIT inside a causal island, until a named trigger fires:\n\n         <<~ kukali trigger=\"on-score\">>\n\n     //kūkali// waits, patient, remaining in suspense. The island parks rather than freezes, and it\n     resumes EXACTLY ONCE — subscribeOnce semantics. `trigger` names the `#slot` fragment of a\n     papalohe wire in the same carrier; omitted, the wait takes the first reaction that arrives.\n     papalohe declares the wire and kukali declares the wait at the receiving end.\n\n     THE TRIGGER RIDES AS A NAMED PARAMETER, under either separator — `trigger=\"x\"` and `trigger:x`\n     both reach the slot, since a call binds a name through `=` and `:` alike.\n\n     THE PAGE STAYS CLEAR. A wait governs execution and never layout, so the definition hands the\n     compile layer a data annotation carrying the trigger and renders nothing. -->\n\n\\procedure ~kukali(trigger:\"\")\n<span class=\"lar-kukali\" data-kukali-trigger=<<trigger>> hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kumu":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-kumu","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kumu","lar-see-also":"kau","lar-open-pattern":"<<~!?\\s*kumu\\s+(~?[\\w-]+)(?:\\s*\\(([^)]*)\\))?(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/kumu\\s*>>","lar-render":"compile","type":"text/vnd.tiddlywiki","text":"<!-- kumu — canon settled (api/pono/kumu.mem): a template of a Verse-style messaging EDGE WIDGET\n     SET, a `creative_device`-shaped device definition — `@editable` slots `kau` places, OUTPUT pins\n     (`KumuListenable`) and INPUT pins (`KumuSubscribable`) wired between placed instances via\n     `papalohe`, never kumu-to-kumu directly. Where `wehe` declares a callable body, `kumu` declares\n     a device TYPE other nodes instantiate — `kau` stands up an instance; `kumu` never renders.\n     `\\type`/`\\typos` carry NO mirror relation to kumu (native TW5 pragmas, no Hawaiian headword —\n     see sigil-type.tid/sigil-typos.tid, lar:///sigil.kumu.split).\n\n     PENDING (canon's own #/pending, not invented here): the `KumuRegistry` resolution step a\n     `kahea` name-form call takes to reach a built `WidgetNode` stays open — held at Gap 8 of\n     lar:///ha.ka.ba/lares/docs/pono/research-streams/gaps-tensions#/gaps (design resolved,\n     implementation pending). No `lar-*` field here invents that registry's shape. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-lares":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-lares","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*lares\\s+(aim|yield)\\s+(?:from=)?\"?((?:[^\"\\s>]|>(?!>))+)\"?(?:\\s*->\\s*(?:to=)?\"?((?:[^\"\\s>]|>(?!>))+)\"?)?\\s*>>","lar-example":"<<~ lares aim from=\"lar:///a.b.c/x\" -> to=\"lar:///a.b.c/y\">>","type":"text/vnd.tiddlywiki","text":"<!-- lares — the turn's BEARING: which way it fires, where it comes from, where it points. `aim` opens\n     a turn and `yield` closes it, and the two spell one chiasmus. The ends ride as NAMED\n     parameters, so the arrow between them stays readable and binds nothing. -->\n\n\\procedure ~lares(p1:\"aim\" from:\"?\" to:\"?\")\n<span class=\"lar-bearing\" data-fires=<<p1>>><$text text=<<from>>/> -> <$text text=<<to>>/></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-law":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-law","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kanawai","lar-mirror-of":"kanawai","lar-tongue":"en","lar-weave":"primary","lar-see-also":"kanawai","lar-pattern":"<<~\\s*law\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-example":"<<~ law \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"<!-- law — RULED (operator): kānāwai's primary English weave — the BINDING pin, `kanawai`'s own\n     sigil, never a delegation to aka or kahea. `pin` weaves `aka` (informative); `law` weaves\n     `kanawai` (binding). -->\n\n\\procedure ~law(p1:\"\")\n<$transclude $variable=\"~kanawai\" p1=<<p1>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-lele":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-lele","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/lele","lar-see-also":"\\branch","lar-pattern":"<<~\\s*lele\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-example":"<<~ lele \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"<!-- lele — a SIDE FLOW at a target, and the caller carries on. THE TARGET RIDES AS THE FIRST\n     POSITIONAL and it rides QUOTED:\n\n         <<~ lele \"lar:///a.b.c/x\">>\n\n     //lele// leaps and knows the tree it left. The edge emits into the message family, starts the\n     target flow, and waits for no answer; the enclosing async context bounds the leap and cancels\n     what remains when that context completes. `hoolele` makes the other move — it leaves the tree.\n\n     AN UNQUOTED ADDRESS REACHES NOTHING. `lar:///x` standing bare in a positional slot binds a\n     parameter named `lar`, and the slot receives nothing; one pair of quotes fills it.\n\n     THE PAGE STAYS CLEAR. A side flow governs execution and never layout, so the definition hands\n     the compile layer a data annotation carrying the target and renders nothing. -->\n\n\\procedure ~lele(p1:\"\")\n<span class=\"lar-lele\" data-lele-target=<<p1>> data-bound=\"enclosing-scope\" hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-let":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-let","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/waiho","lar-mirror-of":"waiho","lar-see-also":"waiho","lar-open-pattern":"<<~\\s*let\\s+([\\w-]+)(?:\\s*=\\s*|\\s+)([^\\n>]+?)\\s*>>","lar-close-pattern":"<<~\\/let\\s*>>","lar-example":"<<~ let name \"value\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~let(p1:\"\" p2:\"\" p3:\"\")\n<$transclude $variable=\"~waiho\" p1=<<p1>> p2=<<p2>> p3=<<p3>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-link":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-link","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/loulou","lar-mirror-of":"loulou","lar-see-also":"loulou","lar-pattern":"<<~\\s*link\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-example":"<<~ link \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~link(p1:\"\")\n<$transclude $variable=\"~loulou\" p1=<<p1>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-loops":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-loops","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*loops\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?\\s*>>","lar-example":"<<~ loops \"observe -> orient -> decide -> act -> ha\">>","type":"text/vnd.tiddlywiki","text":"<!-- loops — the phases a turn runs. All five always run; the gauge reads VISIBILITY alone, so the\n     phase list names what a reader sees rather than what the turn did. -->\n\n\\procedure ~loops(p1:\"\")\n<span class=\"lar-loops\"><$text text=<<p1>>/></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-loulou":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-loulou","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-sugar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/loulou","lar-pattern":"<<~\\s*loulou\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-default-family":"relation","lar-example":"<<~ loulou \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"\\widget ~loulou(p1:\"\" p2:\"\")\n<$set name=\"_loulou-uri\" filter=\"[<p1>regexp[^#]]\" value={{{ [<p1>addprefix<currentTiddler>] }}} emptyValue=<<p1>>>\n<$let _loulou-template={{{ [<p2>!match[]] ~[all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/loulou-template]!is[draft]!has[draft.of]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/loulou/html]] }}}>\n<$set name=\"loulou-uri\" value=<<_loulou-uri>>>\n<$transclude $tiddler=<<_loulou-template>>/>\n</$set>\n</$let>\n</$set>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-meme":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-meme","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"context","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/meme","lar-see-also":"tiddler","lar-open-pattern":"<<~\\s*meme\\s+(\\S+)\\s*>>","lar-close-pattern":"<<~\\/meme\\s*>>","lar-example":"<<~ meme \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~meme(p1:\"\" p2:\"\")\n<$tiddler tiddler=<<p1>>><$transclude $variable=\"~\" name=<<p2>>/></$tiddler>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-mu":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-mu","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*mu\\s+([\\w.-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ mu Wand \"ascii/* glyph/🜂 element/Fire pull/ignition\">>","type":"text/vnd.tiddlywiki","text":"<!-- mu — a TOOL of the four, and the standpoint it carries. The boot seed declares it as `has` with the entity fixed, so this stands as\n     that same relation under its own head: a NAME, and what it holds, quoted. -->\n\n\\procedure ~mu(p1:\"\" p2:\"\")\n<$transclude $variable=\"~has\" p1=\"mu\" p2=<<p1>> p3=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-mukuwai":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-mukuwai","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"control","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/mukuwai","lar-see-also":"\\else","lar-pattern":"<<~\\s*mukuwai\\s*>>","lar-example":"<<~ mukuwai>>","type":"text/vnd.tiddlywiki","text":"\\procedure ~mukuwai(p2:\"\")\n<$transclude $variable=\"~\" name=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-ooda-ha":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-ooda-ha","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"gauge","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*ooda-ha\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?\\s*>>","lar-example":"<<~ ooda-ha \"closed 1↺\">>","type":"text/vnd.tiddlywiki","text":"<!-- ooda-ha (operator ruling: retired `feedback`) — a HANDOFF GAUGE, standing alone mid-stream. The\n     same instrument rides `set` as a KEY: two grips, one handle. The boot seed declares both\n     spellings, and both reach one reading. -->\n\n\\procedure ~ooda-ha(p1:\"\")\n<span class=\"lar-gauge\" data-gauge=\"ooda-ha\"><$text text=<<p1>>/></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-oracle":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-oracle","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*oracle\\b([\\s\\S]*?)>>","lar-example":"<<~ oracle \"↯15 ✲ ⚄(5) ⁂:⚖️🪞⟁◈〰️\">>","type":"text/vnd.tiddlywiki","text":"<!-- oracle — the entropy drain (↯ ✲ die ⁂ tail). A throw stands as ONE quoted string: it carries\n     glyphs, digits, parentheses and colons, and every one of them reads as the throw. -->\n\n\\procedure ~oracle(p1:\"\")\n<span class=\"lar-oracle\"><$text text=<<p1>>/></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-papalohe":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-papalohe","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-sugar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/papalohe","lar-pattern":"<<~\\s*papalohe\\s+(#[\\w-]+\\s+)?\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*->\\s*\"?((?:[^\"\\s>]|>(?!>))+)\"?(?:\\s+listenable[=:]\"?([\\w.-]+)\"?)?(?:\\s+subscribable[=:]\"?([\\w.-]+)\"?)?\\s*>>","lar-example":"<<~ papalohe \"lar:///a.b.c/x\" -> \"lar:///a.b.c/y\">>","type":"text/vnd.tiddlywiki","text":"<!-- papalohe — reaction-family edge; event wire from source event to target function.\n     Render: hidden data annotation; compile-layer wires the reaction graph edge.\n     p1 carries full args string: #slot FROM -> TO listenable:EventName. -->\n\n\\widget ~papalohe(p1:\"\" p2:\"\" args:\"\")\n<span class=\"lar-papalohe\" data-papalohe-args=<<args>> hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-persona":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-persona","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*persona\\s+([\\w.-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ persona Lares \"a multitude\">>","type":"text/vnd.tiddlywiki","text":"<!-- persona — a PERSONA and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as\n     that same relation under its own head: a NAME, and what it holds, quoted. -->\n\n\\procedure ~persona(p1:\"\" p2:\"\")\n<$transclude $variable=\"~has\" p1=\"persona\" p2=<<p1>> p3=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-pin":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-pin","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/aka","lar-mirror-of":"aka","lar-tongue":"en","lar-weave":"primary","lar-see-also":"aka","lar-pattern":"<<~\\s*pin\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","lar-example":"<<~ pin \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"<!-- pin — RULED (operator): `aka` = PIN a lar: target — a frozen read posture, its own sigil,\n     never a delegation to kahea. `pin` weaves as the primary English name for `aka`.\n     RETIRES `snapshot` and `shadow` whole (alpha, no back-compat) — both read-only mirrors and\n     the prior primary weave, superseded by this single English name. -->\n\n\\procedure ~pin(p1:\"\")\n<$transclude $variable=\"~aka\" p1=<<p1>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-pono":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-pono","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-sugar","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pono-sigil","lar-see-also":"constraint","lar-pattern":"<<~\\s*pono\\s+(#[\\w-]+\\s+)?\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*->\\s*\"?((?:[^\"\\s>]|>(?!>))+)\"?(?:\\s+role[=:]\"?([\\w.-]+)\"?)?\\s*>>","lar-example":"<<~ pono \"lar:///a.b.c/x\" -> \"lar:///a.b.c/y\">>","type":"text/vnd.tiddlywiki","text":"<!-- pono — correctness-asserting edge; asserts FROM holds constraint satisfied by TO.\n     Render: hidden data annotation; compile-layer graph extraction handles semantics.\n     sigil-constraint delegates here via ~constraint → ~pono. -->\n\n\\widget ~pono(p1:\"\" p2:\"\" args:\"\")\n<span class=\"lar-pono\" data-pono-args=<<args>> hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-pranala-header":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-pranala-header","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"header","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala-header","lar-pattern":"<<~\\s*\\?\\s*->\\s*\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>","type":"text/vnd.tiddlywiki","text":"<!-- pranala-header — permanent JS exception: <<~ ? -> uri>> uses ? as a\n     self-reference token (this carrier itself). Parsed before compound dispatch\n     in lar-sigil.ts findNextMatch. -->\n\n\\widget ~pranala-header(p1:\"\" p2:\"\")\n<$set name=\"_ph-uri\" filter=\"[<p1>regexp[^#]]\" value={{{ [<p1>addprefix<currentTiddler>] }}} emptyValue=<<p1>>>\n<$let pranala-header-uri=<<_ph-uri>>\n      _ph-template={{{ [<p2>!match[]] ~[all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/pranala-header-template]!is[draft]!has[draft.of]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/pranala-header/html]] }}}>\n<$transclude $tiddler=<<_ph-template>>/>\n</$let>\n</$set>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-pranala":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-pranala","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/pranala","lar-inline-pattern":"<<~\\s*pranala\\s+(#[\\w-]+\\s+)?\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*->\\s*\"?((?:[^\"\\s>]|>(?!>))+)\"?(?:\\s+family[=:]\"?([\\w.-]+)\"?)?(?:\\s+role[=:]\"?([\\w.-]+)\"?)?\\s*>>","lar-block-pattern":"<<~\\s*pranala\\s+(#[\\w-]+\\s+)?\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*->\\s*\"?((?:[^\"\\s>]|>(?!>))+)\"?\\s*>>([\\s\\S]*?)<<~\\/pranala\\s*>>","lar-close-pattern":"<<~\\/pranala\\s*>>","lar-default-family":"relation","lar-example":"<<~ pranala from=\"lar:///a.b.c/x\" -> to=\"lar:///a.b.c/y\">>","type":"text/vnd.tiddlywiki","text":"<!-- pranala — permanent JS exception: arrow syntax FROM -> TO + keyword attrs\n     (from/to/slot/family/role/body) structurally distinct from <<~ WORD ARGS>>.\n     Parsed directly in lar-sigil.ts findNextMatch before compound dispatch fires. -->\n\n\\widget ~pranala(from:\"\" to:\"\" slot:\"\" family:\"\" role:\"\" body:\"\" template:\"\")\n<$set name=\"_pranala-from\" filter=\"[<from>regexp[^#]]\" value={{{ [<from>addprefix<currentTiddler>] }}} emptyValue=<<from>>>\n<$set name=\"_pranala-to\" filter=\"[<to>regexp[^#]]\" value={{{ [<to>addprefix<currentTiddler>] }}} emptyValue=<<to>>>\n<$let pranala-from=<<_pranala-from>> pranala-to=<<_pranala-to>> pranala-slot=<<slot>> pranala-body=<<body>> pranala-family=<<family>> pranala-role=<<role>>\n      _pranala-template={{{ [<template>!match[]] ~[all[shadows+tiddlers]tag[lar:///ha.ka.ba/tags/pranala-template]!is[draft]!has[draft.of]] :map:flat[subfilter{!!text}] +[first[]else[lar:///ha.ka.ba/lararium/templates/pranala/html]] }}}>\n<$transclude $tiddler=<<_pranala-template>>/>\n</$let>\n</$set>\n</$set>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-procedure":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-procedure","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/procedure","lar-mirror-of":"wehe","lar-see-also":"wehe","lar-open-pattern":"<<~\\s*procedure\\s+(~?[\\w-]+)(?:\\s*\\(([^)]*)\\))?(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/procedure\\s*>>","lar-render":"declares","type":"text/vnd.tiddlywiki","text":"<!-- \\procedure — English alias for the TW5 \\procedure pragma.\n     Hawaiian equivalent: wehe (procedure/function executor; outside/exit boundary).\n     lar-see-also: wehe\n\n     <<~ procedure name(params)>>body<<~/procedure>> declares a named\n     procedure in memetic-wikitext. The sigil form serves as the declaration mechanism —\n     it produces no render output of its own (lar-kind: pragma-alias).\n\n     Operator-readable: <<~ procedure greet(name:\"world\")>>Hello <<name>>!<<~/procedure>>\n     Same semantic as native TW5: \\procedure greet(name:\"world\") Hello <<name>>! \\end -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-puka":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-puka","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/puka","lar-see-also":"rush","lar-open-pattern":"<<~\\s*puka\\s*>>","lar-close-pattern":"<<~\\/puka\\s*>>","lar-example":"<<~ puka>>","type":"text/vnd.tiddlywiki","text":"<!-- puka — a SELECTING RACE over the flows its block opens. The first flow through the opening\n     yields the block's result; the rest run on, and only the enclosing scope's exit cancels them:\n\n         <<~ puka>>\n           <<~ lele \"lar:///target-a\">>\n           <<~ lele \"lar:///target-b\">>\n         <<~/puka>>\n\n     A //puka// marks where passage happens. The fish through the gap decides the outcome; the net\n     stays open behind it. `holo` keeps the other discipline — there the winner cancels the losers\n     at once. `rush` mirrors this head in English and delegates here.\n\n     A puka block stands OUTSIDE a `huli` iteration body — its law forbids the direct nesting.\n\n     THE PAGE STAYS CLEAR. Coordination governs execution and never layout, so the definition hands\n     the compile layer a data annotation naming the discipline and renders nothing. -->\n\n\\procedure ~puka()\n<span class=\"lar-puka\" data-losers=\"continue-until-scope-exit\" hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-query":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-query","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"query-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/ui","lar-mirror-of":"ui","lar-see-also":"ui","lar-pattern":"<<~\\s*query\\s+([^\\n>]+?)\\s*>>","lar-example":"<<~ query \"[tag[x]]\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~query(p1:\"\")\n<$list filter=<<p1>>><$view field=\"title\"/></$list>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-race":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-race","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/holo","lar-mirror-of":"holo","lar-see-also":"holo","lar-open-pattern":"<<~\\s*race\\s*>>","lar-close-pattern":"<<~\\/race\\s*>>","lar-example":"<<~ race>>","type":"text/vnd.tiddlywiki","text":"<!-- race — the English mirror of `holo`, the cancelling race: first flow through wins, every losing\n     arm cancels recursively.\n\n     ONE DEFINITION ANSWERS FOR BOTH. The mirror delegates to the head rather than restating it, so\n     the discipline moves in one place. `rush` mirrors `puka`, which keeps the other discipline. -->\n\n\\procedure ~race()\n<$transclude $variable=\"~holo\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-rush":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-rush","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/puka","lar-mirror-of":"puka","lar-see-also":"puka","lar-open-pattern":"<<~\\s*rush\\s*>>","lar-close-pattern":"<<~\\/rush\\s*>>","lar-example":"<<~ rush>>","type":"text/vnd.tiddlywiki","text":"<!-- rush — the English mirror of `puka`, the selecting race: first flow through wins, the losers run\n     on until the enclosing scope exits.\n\n     ONE DEFINITION ANSWERS FOR BOTH. The mirror delegates to the head rather than restating it, so\n     the discipline moves in one place. `race` mirrors `holo`, which cancels its losers at once. -->\n\n\\procedure ~rush()\n<$transclude $variable=\"~puka\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-scale":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-scale","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"ordered-scale","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/scale","lar-pattern":"<<~\\s*scale\\s+([\\w-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ scale organ \"a ~ one -> b ~ two\">>","type":"text/vnd.tiddlywiki","text":"<!-- scale — an ORDERED SCALE and the ranks it carries. A SCALE is the thing; RANKS are what it\n     holds, joined by the bearing arrow with a gloss apiece:\n\n         <<~ scale organ \"mempalace ~ FIRST -> structurepalace ~ structure plane\">>\n\n     The boot seed held this shape before the sigil did — `\\procedure scale(name ranks)` called as\n     `<<scale levels \"rank-1@0..4 -> rank-2@5..8 -> …\">>`. A name, then a ranked body.\n\n     THE CHAIN RIDES QUOTED. It carries `->`, `~`, backticks, colons and prose; unquoted, every arrow\n     reads as structure and every `word:` binds a parameter nobody named. One pair of quotes makes the\n     whole chain ONE value, and the ranks read within it. -->\n\n\\procedure ~scale(p1:\"\" p2:\"\")\n<span class=\"lar-scale\"><<p1>> <<p2>></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-season":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-season","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*season\\s+([\\w.-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ season winter \"the tending turn\">>","type":"text/vnd.tiddlywiki","text":"<!-- season — a SEASON and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as\n     that same relation under its own head: a NAME, and what it holds, quoted.\n\n     A SECOND WORD NAMING A CHILD SLOT OPENS A COMPOUND. `<<~ season kau …>>` reads as\n     `season~kau` and reaches no definition — the slot names are `ahu` and `kau`, and any\n     sigil whose second word is one of them binds a compound rather than a positional. -->\n\n\\procedure ~season(p1:\"\" p2:\"\")\n<$transclude $variable=\"~has\" p1=\"season\" p2=<<p1>> p3=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-set":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-set","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"frame","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*set\\b((?:[^>]|>(?!>))*)>>","lar-example":"<<~ set hud=\"aim\" mode=\"build\" aperture=\"9/measure\" ooda-ha=\"closed 1↺\">>","type":"text/vnd.tiddlywiki","text":"<!-- set — the TURN FRAME, gathered. Every gauge that stands alone mid-stream also rides here as a\n     KEY: two grips, one handle. `hud` names which end of the turn the panel closes over. A writer\n     places the ward LAST at aim and FIRST at yield, one chiasmus in the WRITTEN sigil; this\n     procedure renders its keys in one fixed order at either end and mirrors nothing. A key left\n     blank writes nothing, so an absent instrument reads absent rather than empty. (operator ruling: `focus` →\n     `aperture`, `feedback` → `ooda-ha`; retired spellings stay readable by the HARVESTER, not here.) -->\n\n\\procedure ~set(hud:\"\" mode:\"\" mood:\"\" mu:\"\" stance:\"\" aperture:\"\" ooda-ha:\"\" drift-ward:\"\" note:\"\")\n<span class=\"lar-set\" data-hud=<<hud>>><$list filter=\"[[hud]] [[mode]] [[mood]] [[mu]] [[stance]] [[aperture]] [[ooda-ha]] [[drift-ward]] [[note]]\" variable=\"k\"><$list filter=\"[<k>getvariable[]!is[blank]]\" variable=\"v\"><span class=\"lar-set-key\"><$text text=<<k>>/>=<$text text=<<v>>/></span> </$list></$list></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-shrine":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-shrine","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"relation","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*shrine\\s+([\\w.-]+)(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ shrine eris \"the golden apple\">>","type":"text/vnd.tiddlywiki","text":"<!-- shrine — a SHRINE and what it holds. The boot seed declares it as `has` with the entity fixed, so this stands as\n     that same relation under its own head: a NAME, and what it holds, quoted. -->\n\n\\procedure ~shrine(p1:\"\" p2:\"\")\n<$transclude $variable=\"~has\" p1=\"shrine\" p2=<<p1>> p3=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-stage":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-stage","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"mask-summon","lar-pono-uri":"lar:///ha.ka.ba/lares/api/masks","lar-pattern":"<<~\\s*stage\\s+\"?(\\d+)\"?(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ stage \"20\" \"Mischief-Muse\">>","type":"text/vnd.tiddlywiki","text":"<!-- stage — a MASK and the theatrical depth it stands at. THE DEPTH FIRST, THE MASK SECOND: a summon\n     answers \"how near\" before \"who\".\n\n         <<~ stage \"20\" \"Mischief-Muse\">>\n\n     The depth reads on the 0-20 scale the boot seed declares by name, so this sigil carries no band\n     table of its own — one scale, one place that writes it:\n\n         <<scale stage \"green-room@1..4 -> offstage@5..8 -> upstage@9..12 -> center-stage@13..16\n                        -> downstage@17..20\">>\n\n     Stage WEIGHTS natural surfacing and never gates; the fourth wall opens at 18 and above.\n\n     A CARRIER'S OWN `~Stage` NAMES SOMETHING ELSE — a lifecycle phase, declared locally by the\n     carrier that uses it, one capital apart and owned by that scope. This summon never reaches it. -->\n\n\\procedure ~stage(p1:\"\" p2:\"\")\n<span class=\"lar-stage\"><<p2>> @<<p1>></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-stance":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-stance","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"stance","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot","lar-pattern":"<<~\\s*stance(?:\\s+\"?((?:[^\"]|\"(?!\\s*>>))*)\"?)?\\s*>>","lar-example":"<<~ stance \"🏛️🗡️\">>","type":"text/vnd.tiddlywiki","text":"<!-- stance — the langkah a turn speaks from. A stance PRIMES the moves possible from a position and\n     NEVER gates the rest; calling it re-declares the foreground. Each stance reads by everyday\n     name, emoji, or Unicode glyph, so this renders whatever spelling the caller wrote. -->\n\n\\procedure ~stance(p1:\"philosopher poet satirist humorist private\")\n<span class=\"lar-stance\"><$text text=<<p1>>/></span>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-suspends":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-suspends","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"leaf","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kukali","lar-mirror-of":"kukali","lar-see-also":"kukali","lar-pattern":"<<~\\s*suspends(?:\\s+trigger[=:]\"?([\\w.-]+)\"?)?\\s*>>","lar-example":"<<~ suspends trigger=\"on-score\">>","type":"text/vnd.tiddlywiki","text":"<!-- suspends — the English mirror of `kukali`, the wait that parks a causal island until a named\n     trigger fires. The island parks rather than freezes, and it resumes exactly once.\n\n     ONE DEFINITION ANSWERS FOR BOTH. The mirror delegates to the head rather than restating it, so\n     the discipline moves in one place. -->\n\n\\procedure ~suspends(trigger:\"\")\n<$transclude $variable=\"~kukali\" trigger=<<trigger>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-syad":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-syad","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"metadata","lar-pattern":"<<~\\s*syad\\b([\\s\\S]*?)>>","lar-pono-uri":"lar:///ha.ka.ba/lares/api/noosphere-boot#/syad","lar-example":"<<~ syad \"maybe\">>","lar-render":"literal","type":"text/vnd.tiddlywiki","text":"<!-- syad — the five-standpoints lens. HUD-frame sigil: recognized in the tree, rendered as plain literal\n     text for now. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-sync":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-sync","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/hui","lar-mirror-of":"hui","lar-see-also":"hui","lar-open-pattern":"<<~\\s*sync\\s*>>","lar-close-pattern":"<<~\\/sync\\s*>>","lar-example":"<<~ sync>>","type":"text/vnd.tiddlywiki","text":"<!-- sync — the English mirror of `hui`, the await-all join: the containing flow resumes once every\n     child settles.\n\n     ONE DEFINITION ANSWERS FOR BOTH. The mirror delegates to the head rather than restating it, so\n     the discipline moves in one place. -->\n\n\\procedure ~sync()\n<$transclude $variable=\"~hui\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-task":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-task","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"guest-grammar-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/hana","lar-mirror-of":"hana","lar-see-also":"hana","lar-open-pattern":"<<~\\s*task\\s+([^\\n>]+?)\\s*>>","lar-close-pattern":"<<~\\/task\\s*>>","lar-example":"<<~ task \"write the thing\">>","type":"text/vnd.tiddlywiki","text":"<!-- \\task — English alias for hana; bounded guest-grammar / work block. -->\n\n\\procedure ~task(p1:\"\" p2:\"\")\n<$transclude $variable=\"~hana\" p1=<<p1>> p2=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-tick":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-tick","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"concurrency","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/tick","lar-see-also":"simulate","lar-open-pattern":"<<~\\s*tick\\s*>>","lar-close-pattern":"<<~\\/tick\\s*>>","lar-example":"<<~ tick>>","type":"text/vnd.tiddlywiki","text":"<!-- tick — a DEVICE LIFECYCLE HOOK: the block it opens runs once per //nalu//, the changeset wave:\n\n         <<~ tick>>\n           <<~ lele \"lar:///a.b.c/x\">>\n         <<~/tick>>\n\n     The nalu sits BELOW the grammar — the engine delivers the wave, and no operator emits one. tick\n     names the grammar-layer hook INTO that wave, so a block under it sees one coherent delivered\n     state per crest rather than each scattered write.\n\n     THE PROPER NAME AND THE FULL LAW STAND DEFERRED, pending Visual Verse tick-node confirmation;\n     the hook holds its grammar and its place in the family meanwhile.\n\n     THE PAGE STAYS CLEAR. A lifecycle hook governs execution and never layout, so the definition\n     hands the compile layer a data annotation naming the wave and renders nothing. -->\n\n\\procedure ~tick()\n<span class=\"lar-tick\" data-hook=\"nalu\" hidden=\"true\"/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-tiddler":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-tiddler","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"context-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/meme","lar-mirror-of":"meme","lar-see-also":"meme","lar-open-pattern":"<<~\\s*tiddler\\s+(\\S+)\\s*>>","lar-close-pattern":"<<~\\/tiddler\\s*>>","lar-example":"<<~ tiddler \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~tiddler(p1:\"\" p2:\"\")\n<$tiddler tiddler=<<p1>>><$transclude $variable=\"~\" name=<<p2>>/></$tiddler>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-toml":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-toml","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"data","lar-name":"toml","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/memetic-wikitext-spec","lar-pattern":"```toml(?:[ \\t]+([A-Za-z0-9_-]+))?[ \\t]*\\n([\\s\\S]*?)```","lar-render":"mark","type":"text/vnd.tiddlywiki","text":"<!-- toml — TOML data fence. Optional profile name in group 1.\n     Profile 'meta' = carrier identity prelude; dissolves into parent tiddler fields via parseTaploFields.\n     Any other profile name (or absent) = general-purpose data block; content available to widget layer.\n     Parser: smol-toml via lar:///ha.ka.ba/lararium/tw5/lib/smol-toml. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-transclude":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-transclude","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"edge-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kahea","lar-mirror-of":"kahea","lar-tongue":"en","lar-weave":"primary","lar-see-also":"kahea","lar-pattern":"<<~\\s*transclude\\s+\"?((?:[^\"\\s>]|>(?!>))+)\"?(?:\\s+key[=:]\"?([\\w.-]+)\"?)?\\s*>>","lar-example":"<<~ transclude \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~transclude(p1:\"\" p2:\"\")\n<$transclude $variable=\"~kahea\" p1=<<p1>> p2=<<p2>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-type":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-type","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kumu","lar-see-also":"kumu","lar-open-pattern":"<<~\\s*type\\s+([\\w~-]+)(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/type\\s*>>","lar-render":"declares","type":"text/vnd.tiddlywiki","text":"<!-- \\type — English alias for kumu (structural declaration emphasis). -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-typos":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-typos","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/kumu","lar-see-also":"kumu","lar-open-pattern":"<<~\\s*typos\\s+([\\w~-]+)(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/typos\\s*>>","lar-render":"declares","type":"text/vnd.tiddlywiki","text":"<!-- \\typos — English alias for kumu (Greek: typos = impression/mold/type). -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-ui":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-ui","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"query","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/ui","lar-see-also":"\\query","lar-pattern":"<<~\\s*ui\\s+([^\\n>]+?)\\s*>>","lar-example":"<<~ ui \"lar:///a.b.c/x\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~ui(p1:\"\")\n<$list filter=<<p1>>><$view field=\"title\"/></$list>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-var":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-var","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma-alias","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/waiho","lar-mirror-of":"waiho","lar-see-also":"waiho","lar-open-pattern":"<<~\\s*var\\s+([\\w-]+)(?:\\s*=\\s*|\\s+)([^\\n>]+?)\\s*>>","lar-close-pattern":"<<~\\/var\\s*>>","lar-example":"<<~ var name \"value\">>","type":"text/vnd.tiddlywiki","text":"\\procedure ~var(p1:\"\" p2:\"\" p3:\"\")\n<$transclude $variable=\"~waiho\" p1=<<p1>> p2=<<p2>> p3=<<p3>>/>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-waiho":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-waiho","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/waiho","lar-see-also":"let","lar-open-pattern":"<<~\\s*waiho\\s+([\\w-]+)(?:\\s*=\\s*|\\s+)([^\\n>]+?)\\s*>>","lar-close-pattern":"<<~\\/waiho\\s*>>","lar-pragma-pattern":"<<~!\\s*waiho\\s+([\\w-]+)(?:\\s*=\\s*|\\s+)([^\\n>]+?)\\s*>>","lar-example":"<<~ waiho name \"value\">>\\nbody\\n<<~/waiho>>","type":"text/vnd.tiddlywiki","text":"<!-- waiho — `<<~ waiho name value>>body<<~/waiho>>` binds `name` for the body's duration (block-scoped).\n     `<<~! waiho name value>>` (lar-pragma-pattern, PRAGMA_HAND_KEPT) carries no closer: it\n     hoists to the top of the carrier's execution context, immutable by convention\n     (api/pono/waiho.mem #/law) — a genuinely DIFFERENT posture from the block form, not a cosmetic\n     `!` variant, so it rides its own pattern field/eventType rather than folding into open/close. -->\n\n\\procedure ~waiho(p1:\"\" p2:\"\" p3:\"\")\n<$set name=<<p1>> value=<<p2>>><$transclude $variable=\"~\" name=<<p3>>/></$set>\n\\end\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-ward":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-ward","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"metadata","lar-pattern":"Drift-Ward\\s*\\(","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/drift-ward","lar-example":"<<~ ward * L-Prime>>","lar-render":"literal","type":"text/vnd.tiddlywiki","text":"<!-- Drift-Ward — the ward, fired INSIDE the `hud` panel rather than as a sigil of its own\n     (last at open, first at close). Recognized in the tree,\n     rendered as plain literal text for now. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-wehe":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-wehe","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/wehe","lar-see-also":"procedure","lar-open-pattern":"<<~!?\\s*wehe\\s+(~?[\\w-]+)(?:\\s*\\(([^)]*)\\))?(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/wehe\\s*>>","lar-render":"declares","type":"text/vnd.tiddlywiki","text":"<!-- wehe — Hawaiian procedure executor; alias for \\procedure.\n     Shares grammar schema with sigil-procedure.tid; both declare a named callable body.\n     lar-kind: pragma — no render output. The memetic parser transpiles\n     <<~ wehe name(params)>>body<<~/wehe>> → \\procedure name(params) body \\end at parse time. -->\n"},"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-widget":{"title":"lar:///ha.ka.ba/lararium/tw5/tiddlers/sigil-widget","tags":"$:/tags/Global lar:///ha.ka.ba/tags/SharktoothSigil","lar-kind":"pragma","lar-pono-uri":"lar:///ha.ka.ba/lares/api/pono/widget","lar-open-pattern":"<<~!?\\s*widget\\s+(~?[\\w-]+)(?:\\s*\\(([^)]*)\\))?(?:\\s+([^>]*?))?\\s*>>","lar-close-pattern":"<<~\\/widget\\s*>>","lar-render":"declares","type":"text/vnd.tiddlywiki","text":"<!-- \\widget — English alias for the TW5 \\widget pragma.\n     No direct Hawaiian equivalent; the ~ prefix is the Lares convention.\n\n     <<~ widget ~name(params)>>body<<~/widget>> declares a named widget\n     callable as <<~name ...>> via the ~ dispatcher.\n     lar-kind: pragma — produces no render output; the sigil serves as the declaration.\n\n     The ~ prefix convention: <<~ widget ~mana(uri:\"\")>>...<<~/widget>>\n     registers a new mana sigil callable as <<~ mana lar:///uri>>. -->\n"},"$:/SiteSubtitle":{"title":"$:/SiteSubtitle","type":"text/vnd.tiddlywiki","text":"Welcome to the DreamNet\n"},"$:/SiteTitle":{"title":"$:/SiteTitle","type":"text/vnd.tiddlywiki","text":"Lararium\n"},"lar:///ha.ka.ba/lararium/tw5/widgets/action-meme-place":{"title":"lar:///ha.ka.ba/lararium/tw5/widgets/action-meme-place","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/widgets/action-meme-place\ntype: application/javascript\nmodule-type: widget\n\\*/\n//#region src/widgets/action-meme-place.ts\n/** The receipt's home — a `$:/temp` prefix, so nothing here persists or syncs. */\nvar MEME_PLACE_RECEIPT_PREFIX = \"$:/temp/lares/meme-place/\";\n/** Where the receipt for one placement lands. */\nfunction memePlaceReceiptTitle(uri) {\n\treturn MEME_PLACE_RECEIPT_PREFIX + uri;\n}\n/** The fields a receipt carries: the whole reply as JSON, the decision flat beside it. */\nfunction memePlaceReceiptFields(uri, container, receipt) {\n\tconst fields = {\n\t\ttitle: memePlaceReceiptTitle(uri),\n\t\ttype: \"application/json\",\n\t\turi,\n\t\tdecision: receipt.decision,\n\t\tgrade: receipt.grade,\n\t\ttext: JSON.stringify(receipt, null, 2)\n\t};\n\tif (receipt.canonicalHash) fields[\"canonical-hash\"] = receipt.canonicalHash;\n\tif (container) fields[\"container\"] = container;\n\treturn fields;\n}\n/** The fields a placement that THREW carries — the reason an author can read, no invented decision. */\nfunction memePlaceErrorFields(uri, container, reason) {\n\tconst fields = {\n\t\ttitle: memePlaceReceiptTitle(uri),\n\t\ttype: \"application/json\",\n\t\turi,\n\t\terror: reason,\n\t\ttext: JSON.stringify({\n\t\t\turi,\n\t\t\terror: reason\n\t\t}, null, 2)\n\t};\n\tif (container) fields[\"container\"] = container;\n\treturn fields;\n}\nvar Widget = (globalThis.require ?? require)(\"$:/core/modules/widgets/widget.js\")[\"widget\"];\nvar ActionMemePlaceWidget = function(parseTreeNode, options) {\n\tthis.initialise(parseTreeNode, options);\n};\nActionMemePlaceWidget.prototype = new Widget();\n/** Render this widget into the DOM. */\nActionMemePlaceWidget.prototype.render = function() {\n\tthis.computeAttributes();\n\tthis.execute();\n};\n/** Compute the internal state of the widget. */\nActionMemePlaceWidget.prototype.execute = function() {\n\tthis.placeUri = this.getAttribute(\"uri\", \"\");\n\tthis.placeText = this.getAttribute(\"text\", \"\");\n\tconst bag = this.getAttribute(\"bag\", \"\");\n\tconst recipe = this.getAttribute(\"recipe\", \"\");\n\tthis.container = bag && recipe ? \"\" : bag ? `bags/${bag}` : recipe ? `recipes/${recipe}` : \"\";\n};\n/** Refresh the widget by ensuring our attributes are up to date. */\nActionMemePlaceWidget.prototype.refresh = function(changedTiddlers) {\n\tconst changedAttributes = this.computeAttributes();\n\tif (changedAttributes[\"uri\"] || changedAttributes[\"text\"] || changedAttributes[\"bag\"] || changedAttributes[\"recipe\"]) {\n\t\tthis.refreshSelf();\n\t\treturn true;\n\t}\n\treturn this.refreshChildren(changedTiddlers);\n};\n/** Invoke the action associated with this widget. */\nActionMemePlaceWidget.prototype.invokeAction = function() {\n\tconst uri = this.placeUri;\n\tconst text = this.placeText;\n\tconst face = $tw?.lares?.meme;\n\tif (!uri || !text || !face) return true;\n\tconst wiki = this.wiki;\n\tconst container = this.container;\n\tPromise.resolve(face.place(uri, text)).then((receipt) => {\n\t\twiki.addTiddler(memePlaceReceiptFields(uri, container, receipt));\n\t}).catch((err) => {\n\t\twiki.addTiddler(memePlaceErrorFields(uri, container, String(err)));\n\t});\n\treturn true;\n};\n//#endregion\nexports.MEME_PLACE_RECEIPT_PREFIX = MEME_PLACE_RECEIPT_PREFIX;\nexports[\"action-meme-place\"] = ActionMemePlaceWidget;\nexports.memePlaceErrorFields = memePlaceErrorFields;\nexports.memePlaceReceiptFields = memePlaceReceiptFields;\nexports.memePlaceReceiptTitle = memePlaceReceiptTitle;\n","type":"application/javascript","module-type":"widget"},"lar:///ha.ka.ba/lararium/tw5/filters/all-memes":{"title":"lar:///ha.ka.ba/lararium/tw5/filters/all-memes","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/filters/all-memes\ntype: application/javascript\nmodule-type: allfilteroperator\n\\*/\n//#region src/filters/lar-title.ts\nfunction isLarTitle(title) {\n\treturn title.startsWith(\"lar:\");\n}\nfunction allLarTitles(wiki) {\n\tconst results = [];\n\twiki.each(function(_tiddler, title) {\n\t\tif (isLarTitle(title)) results.push(title);\n\t});\n\treturn results;\n}\n//#endregion\n//#region src/filters/all-memes.ts\n/**\n* [all[memes]] — all tiddlers whose title carries a lar: URI.\n*\n* A meme means any tiddler or tiddler-group with a lar: URI title,\n* including slot-children (whose titles share the parent's lar: prefix).\n*\n* Mirrors the shape of TW5's built-in tiddlers.js allfilteroperator:\n* returns a string[] so LinkedList.pushTop() can compose it with other\n* all[] suboperators (e.g. [all[memes+shadows]]).\n*/\nfunction memes(_source, _prefix, options) {\n\treturn allLarTitles(options.wiki);\n}\n//#endregion\nexports.memes = memes;\n","type":"application/javascript","module-type":"allfilteroperator"},"lar:///ha.ka.ba/lararium/tw5/filters/bag-path":{"title":"lar:///ha.ka.ba/lararium/tw5/filters/bag-path","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/filters/bag-path\ntype: application/javascript\nmodule-type: filteroperator\n\\*/\nvar LAR_PREFIX = `lar:///ha.ka.ba/`;\nvar TAG_PREFIX = `${LAR_PREFIX}tags/`;\nvar VOLATILE_VM_PREFIX = `lar:///lararium.local.vm/`;\nfunction volatileVmUri(path) {\n\treturn `${VOLATILE_VM_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableLarUri(path) {\n\treturn `${LAR_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableTagUri(name) {\n\treturn `${TAG_PREFIX}${name.replace(/^\\/+/, \"\")}`;\n}\nvolatileVmUri(\"verb/\");\nvar BAGS_SEGMENT = \"bags\";\n/** Mint the canonical URI of a BAG (a composable recipe piece; mutable, the IPNS plane). */\nfunction bagUri(slug) {\n\treturn stableLarUri(`${BAGS_SEGMENT}/${slug}`);\n}\nbagUri(\"oracle\");\nbagUri(\"lararium\");\nvar CATALOG_DOC_URI = bagUri(\"catalog\");\nbagUri(\"lares\");\nbagUri(\"crossroads\");\nstableLarUri(\"lararium/plugins/lares/memetic-wikitext\");\nstableTagUri(\"SharktoothSigil\");\nstableTagUri(\"lararium-parse-warnings\");\nstableTagUri(\"lararium-bag-mirror\");\nstableTagUri(\"lares-verb\");\nstableTagUri(\"lares-verb-event\");\nstableTagUri(\"lares-pin\");\nstableTagUri(\"cap-event\");\nstableTagUri(\"cap-event/prekey\");\nstableTagUri(\"cap-event/cgka\");\nstableTagUri(\"cap-event/delegation\");\nstableTagUri(\"cap-event/revocation\");\nstableLarUri(\"state/boot-splash/active\");\nbagUri(\"identities\");\nbagUri(\"circles\");\nbagUri(\"sessions\");\n`${CATALOG_DOC_URI}`;\n/** Daemon wiki bag id — the lararium's own central daemon `daemon` bag (one-recipe model).\n*  SOVEREIGN-per-vessel: this vessel's own control-plane, never shared across vessels. */\nvar DAEMON_BAG_ID = bagUri(\"daemon\");\n/** The persona NAMESPACE — two jobs, and a reader who fuses them will look for a bag that does not exist.\n*\n*  The word is deliberate. SDSI's ruling on this exact shape reads \"a NAMESPACE, not a super-key\" — a place\n*  local names hang from, carrying no authority of its own. Calling it a ROOT would claim the opposite and\n*  name the very thing canon forbids above a person's compartments.\n*\n*  ① The TITLE prefix every PersonaGroup plane uses INSIDE its own document: the signer pin, the KEL\n*     prefix, the selves, the binding records all spell `persona/...` whichever plane holds them. Titles\n*     resolve verbatim within a document and the composite finds one by walking layers, so every plane\n*     carries the same internal shape regardless of the bag it answers to.\n*  ② The STEM a plane's own bag id extends — `personaBagIdFor` derives `persona-<tag>` from that group's\n*     doc id, and `isPersonaBagId` matches the family by that shape rather than by any fixed id.\n*\n*  It NAMES NO BAG on its own. A vessel holds one plane per PersonaGroup it stands in, each seeded,\n*  mounted, registered and reached under its own derived name; nothing answers to the bare stem. */\nvar PERSONA_NAMESPACE = bagUri(\"persona\");\nstableLarUri(\"identities\");\nstableLarUri(\"circles\");\nstableLarUri(\"sessions\");\nbagUri(\"nexus\");\nstableLarUri(\"sentinel/kahu-cabal\");\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${DAEMON_BAG_ID}`;\n`${DAEMON_BAG_ID}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n`${PERSONA_NAMESPACE}`;\n//#endregion\n//#region ../lararium-mesh/src/mirror-paths.ts\n/**\n* mirror-paths — peer-neutral lar:/// URI → mirror-relative path projection law.\n*\n* TW5 filters, promotion ceremonies, Node disk projection, and future vessels all\n* need the same answer for \"where would this canonical artifact surface in a\n* compatibility mirror?\"  Mesh owns that shore; runtimes only ask.\n*/\n/**\n* The meme file extension. A meme carries memetic-wikitext, not CommonMark, so\n* `.mem` names the filetype on disk and the memetic-wikitext MIME\n* (`text/memetic-wikitext+tiddlywiki`) rides it.\n*/\nvar MEME_EXT = \".mem\";\n/** Strip a trailing `.mem`; pass anything else whole. */\nfunction stripMemeExt(value) {\n\treturn value.endsWith(\".mem\") ? value.slice(0, -4) : value;\n}\nfunction splitHash(value) {\n\tconst index = value.indexOf(\"#\");\n\treturn index >= 0 ? [value.slice(0, index), value.slice(index + 1)] : [value, null];\n}\nfunction withFrag(base, frag) {\n\treturn frag ? `${base}/${frag}${MEME_EXT}` : `${base}${MEME_EXT}`;\n}\nfunction larTail(uri) {\n\treturn uri.startsWith(LAR_PREFIX) ? uri.slice(LAR_PREFIX.length) : null;\n}\n/** Canonical lares-bag mirror path. */\nfunction laresMirrorRelPath(uri) {\n\tconst rest = larTail(uri);\n\tif (rest === null) return null;\n\tconst prefix = `bags/lares/`;\n\tif (!rest.startsWith(prefix)) return null;\n\tconst [pathPart, frag] = splitHash(rest.slice(prefix.length));\n\tconst base = stripMemeExt(pathPart ?? \"\");\n\treturn base ? withFrag(base, frag) : null;\n}\n/** Canonical lararium-bag engine mirror path. */\nfunction engineMirrorRelPath(uri) {\n\tconst rest = larTail(uri);\n\tconst prefix = `bags/lararium/`;\n\tif (rest === null || !rest.startsWith(prefix)) return null;\n\tconst [pathPart, frag] = splitHash(rest.slice(prefix.length));\n\tconst base = stripMemeExt(pathPart ?? \"\");\n\treturn base ? withFrag(base, frag) : null;\n}\n/** Wiki-shadow path used when one mirror contains both lares and lararium bag views. */\nfunction wikiShadowMirrorRelPath(uri) {\n\tlet rest = larTail(uri);\n\tif (rest === null) return null;\n\tlet dirPrefix;\n\tif (rest.startsWith(`lares/`)) {\n\t\trest = rest.slice(`lares/`.length);\n\t\tdirPrefix = `lares/`;\n\t} else if (rest.startsWith(`lararium/`)) {\n\t\trest = rest.slice(`lararium/`.length);\n\t\tdirPrefix = `lararium/`;\n\t} else return null;\n\tconst [pathPart, frag] = splitHash(rest);\n\tconst base = stripMemeExt(pathPart ?? \"\");\n\treturn base ? frag ? `${dirPrefix}${base}/${frag}${MEME_EXT}` : `${dirPrefix}${base}${MEME_EXT}` : null;\n}\nfunction mirrorRelPath(uri, strategy) {\n\tswitch (strategy) {\n\t\tcase \"lares\": return laresMirrorRelPath(uri);\n\t\tcase \"engine\": return engineMirrorRelPath(uri);\n\t\tcase \"wiki-shadow\": return wikiShadowMirrorRelPath(uri);\n\t}\n}\n//#endregion\n//#region src/filters/bag-path.ts\nfunction isMirrorPathStrategy(value) {\n\treturn value === \"lares\" || value === \"engine\" || value === \"wiki-shadow\";\n}\nfunction bagPath(source, operator) {\n\tconst requested = (operator.operand ?? \"lares\").trim();\n\tconst strategy = isMirrorPathStrategy(requested) ? requested : \"lares\";\n\tconst results = [];\n\tsource(function(_tiddler, title) {\n\t\tconst relPath = mirrorRelPath(title, strategy);\n\t\tif (relPath) results.push(relPath);\n\t});\n\treturn results;\n}\n//#endregion\nexports.bagPath = bagPath;\n","type":"application/javascript","module-type":"filteroperator"},"lar:///ha.ka.ba/lararium/tw5/modules/capture-annotate-vm":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/capture-annotate-vm","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/capture-annotate-vm\ntype: application/javascript\nmodule-type: startup\n\\*/\nlet lararium_meme_ast = require(\"lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\");\n//#region ../lararium-mesh/src/capture/bearing-harvest.ts\n/**\n* Standing bands on the 0..20 Maybe-Logic continuum (low = drifted). The bands\n* land on the house register ladder: clean → canon (17-20), the drift grades →\n* provisional-synthesis / provisional (1-8). Tunable; thresholds deferred to in-flight tuning.\n* STANDING, never confidence — the parse earns these backward.\n*/\nvar BEARING_STANDING = {\n\tclean: 18,\n\tarityDrift: 8,\n\tpartialFrame: 6,\n\trootUnparsed: 4\n};\nvar AIM_RE = /<<~\\s*lares\\s+aim\\s+([\\s\\S]*?)>>/i;\nvar YIELD_RE = /<<~\\s*lares\\s+yield\\s+([\\s\\S]*?)>>/i;\nvar LAR_URI_RE = /lar:\\/\\/\\S+/;\n/**\n* Read `(root, sessionForm)` from one `lar:` URI. The root is the three-term\n* `w1.w2.w3` heading: the first path segment for the local form\n* `lar:///root/path`, or the first segment after the authority for the session\n* form `lar://alias@host/root/path`. Returns `{ root: null }` when unreadable;\n* never throws.\n*/\nfunction splitRoot(uri) {\n\tconst idx = uri.indexOf(\"://\");\n\tif (idx === -1) return {\n\t\troot: null,\n\t\tsessionForm: false\n\t};\n\tconst stripped = uri.slice(idx + 3).replace(/>+$/, \"\").trim().replace(/^\\/+/, \"\");\n\tif (!stripped) return {\n\t\troot: null,\n\t\tsessionForm: false\n\t};\n\tconst firstSlash = stripped.indexOf(\"/\");\n\tconst head = firstSlash === -1 ? stripped : stripped.slice(0, firstSlash);\n\tconst sessionForm = head.includes(\"@\");\n\tlet root;\n\tif (sessionForm) root = (firstSlash === -1 ? \"\" : stripped.slice(firstSlash + 1)).split(\"/\")[0] ?? \"\";\n\telse root = head;\n\treturn {\n\t\troot: root || null,\n\t\tsessionForm\n\t};\n}\nfunction primaryUri(payload) {\n\tif (!payload) return null;\n\tconst m = LAR_URI_RE.exec(payload);\n\tif (!m) return null;\n\treturn m[0].replace(/>+$/, \"\").trim();\n}\n/**\n* Scan a verbatim message for its lares aim/yield frame. Returns a {@link Bearing},\n* or null when the message carries no frame at all (an unframed turn — its\n* silence is recorded downstream as a gap, never a fabricated bearing).\n*/\nfunction harvest(text) {\n\tif (!text) return null;\n\tconst aimM = AIM_RE.exec(text);\n\tconst yieldM = YIELD_RE.exec(text);\n\tif (!aimM && !yieldM) return null;\n\tconst aimUri = aimM ? (aimM[1] ?? \"\").trim() : null;\n\tconst yieldUri = yieldM ? (yieldM[1] ?? \"\").trim() : null;\n\tconst driftFlags = [];\n\tlet standing = BEARING_STANDING.clean;\n\tif (!aimM) {\n\t\tdriftFlags.push(\"frame:no-aim\");\n\t\tstanding = Math.min(standing, BEARING_STANDING.partialFrame);\n\t}\n\tif (!yieldM) {\n\t\tdriftFlags.push(\"frame:no-yield\");\n\t\tstanding = Math.min(standing, BEARING_STANDING.partialFrame);\n\t}\n\tconst probe = primaryUri(aimUri) ?? primaryUri(yieldUri);\n\tif (probe === null) {\n\t\tdriftFlags.push(\"root:unparsed\");\n\t\tstanding = Math.min(standing, BEARING_STANDING.rootUnparsed);\n\t} else {\n\t\tconst { root, sessionForm } = splitRoot(probe);\n\t\tif (sessionForm) driftFlags.push(\"session-form\");\n\t\tif (root === null) {\n\t\t\tdriftFlags.push(\"root:unparsed\");\n\t\t\tstanding = Math.min(standing, BEARING_STANDING.rootUnparsed);\n\t\t} else {\n\t\t\tconst arity = root.split(\".\").length;\n\t\t\tif (arity !== 3) {\n\t\t\t\tdriftFlags.push(`arity:${arity}`);\n\t\t\t\tstanding = Math.min(standing, BEARING_STANDING.arityDrift);\n\t\t\t}\n\t\t}\n\t}\n\treturn {\n\t\taimUri,\n\t\tyieldUri,\n\t\tstanding,\n\t\tdriftFlags\n\t};\n}\nvar SIGIL_RE = /<<~\\s*([\\s\\S]*?)>>/g;\nvar SIGIL_OPENER_RE = /<<~/g;\n/** A panel's named keys: `key=\"value\"`, the value taken whole and never re-parsed. */\nvar PANEL_KEY_RE = /([a-z][\\w-]*)\\s*=\\s*\"([^\"]*)\"/gi;\n/** A mid-turn phase marker: the `->` arrow leading a loop glyph. */\nvar PHASE_RE = /->\\s*([✶⏿◇▶↺])/gu;\nvar VOICE_RE = /(?:^|\\n)\\s*(?:\\*\\*\\s*)?(?:(Mask|[A-Za-z][\\w'-]*)\\s*:\\s*)?([A-Z][\\w'’-]*(?:[ -][A-Z][\\w'’-]*)*)\\s*\\(([^)\\n]{1,40})\\)\\s*:/g;\nvar BARE_VOICE_RE = /(?:^|\\n)\\s*(?:\\*\\*\\s*)?([A-Z][\\w'’-]*(?:[ -][A-Z][\\w'’-]*)*)\\s*:/g;\n/**\n* Template placeholders, never surfacings. The seeds and the instruction carriers print `Voice (Role):`\n* and `Voice:` to SHOW the shape a Voice header takes; a Voice takes its name at generation. Counting\n* the template reads a doc's example as a turn's speech, which is how a corpus of instructions came to\n* report a Voice called \"Voice\" holding a role called \"Role\".\n*/\nvar TEMPLATE_NAMES = /* @__PURE__ */ new Set([\n\t\"voice\",\n\t\"role\",\n\t\"name\",\n\t\"persona\",\n\t\"mask\"\n]);\nvar KNOWN_VOICES = /* @__PURE__ */ new Set([\n\t\"lares\",\n\t\"ink-clerk\",\n\t\"lorekeeper\",\n\t\"map-wisp\",\n\t\"scryer\",\n\t\"council\",\n\t\"mischief-muse\",\n\t\"muse\",\n\t\"artificer\",\n\t\"advocate\",\n\t\"diplomat\",\n\t\"pedagogue\",\n\t\"tide-caller\",\n\t\"hierophant\",\n\t\"breach-watch\",\n\t\"triage\",\n\t\"stranger\",\n\t\"liminal\",\n\t\"gatekeeper\"\n]);\n/**\n* Leading keywords a sigil island may carry.\n*\n* A CORPUS STATES ONE GRAMMAR; A READER TOLERATES EVERY GRAMMAR IT WILL MEET. `bags/` authors its\n* own contents and carries current pono alone. This harvester receives input it never authored — a\n* month of real turns, written under whatever the frame said that week — so a retired head stays\n* readable here. Refusing one would read those turns as turns that fired nothing, and that silence\n* is indistinguishable from a turn that skipped the instrument.\n*/\nvar KNOWN_KINDS = /* @__PURE__ */ new Set([\n\t\"aka\",\n\t\"aperture\",\n\t\"branch\",\n\t\"carry\",\n\t\"confidence\",\n\t\"config\",\n\t\"const\",\n\t\"con