Symbol.for(\"lararium.meme-door-charm\");\n/** Strip the entity-tag quotes and any weak marker: `W/\"abc\"` → `abc`. */\nfunction revisionOf(etag) {\n\tif (!etag) return void 0;\n\treturn etag.trim().replace(/^W\\//, \"\").replace(/^\"(.*)\"$/, \"$1\");\n}\n/** Decorate one adaptor instance; a second call finds the charm already laid and leaves it. */\nfunction charmAdaptor(adaptor, httpRequest) {\n\tconst holder = adaptor;\n\tif (holder[CHARMED]) return;\n\tholder[CHARMED] = true;\n\tconst native = adaptor.saveTiddler;\n\tadaptor.saveTiddler = function(tiddler, callback, options) {\n\t\tconst uri = (0, lararium_place_meme.framedRootOf)(tiddler.fields);\n\t\tconst door = uri === null ? null : (0, lararium_place_meme.memePathOf)(uri, {\n\t\t\tkind: \"recipes\",\n\t\t\tname: this.recipe ?? \"default\"\n\t\t});\n\t\tif (door === null) {\n\t\t\tnative.call(this, tiddler, callback, options);\n\t\t\treturn;\n\t\t}\n\t\tif (this.isReadOnly) {\n\t\t\tcallback(null);\n\t\t\treturn;\n\t\t}\n\t\thttpRequest({\n\t\t\turl: (this.host ?? \"\").replace(/\\/$/, \"\") + door,\n\t\t\ttype: \"PUT\",\n\t\t\theaders: { \"Content-type\": \"text/memetic-wikitext+tiddlywiki; charset=utf-8\" },\n\t\t\tdata: String(tiddler.fields[\"text\"] ?? \"\"),\n\t\t\tcallback: (err, _data, request) => {\n\t\t\t\tif (err) {\n\t\t\t\t\tcallback(err);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tcallback(null, { bag: \"default\" }, revisionOf(request?.getResponseHeader(\"Etag\") ?? null));\n\t\t\t}\n\t\t});\n\t};\n}\nfunction startup() {\n\tif (typeof $tw === \"undefined\" || !$tw) return;\n\tconst adaptor = $tw.syncadaptor;\n\tif (!adaptor || adaptor.name !== \"tiddlyweb\" || typeof adaptor.saveTiddler !== \"function\") return;\n\tcharmAdaptor(adaptor, (options) => $tw.utils.httpRequest(options));\n}\n//#endregion\nexports.after = after;\nexports.charmAdaptor = charmAdaptor;\nexports.name = name;\nexports.platforms = platforms;\nexports.startup = startup;\nexports.synchronous = synchronous;\n","type":"application/javascript","module-type":"startup"},"lar:///ha.ka.ba/lararium/tw5/modules/meme-face":{"title":"lar:///ha.ka.ba/lararium/tw5/modules/meme-face","text":"/*\\\ntitle: lar:///ha.ka.ba/lararium/tw5/modules/meme-face\ntype: application/javascript\nmodule-type: startup\n\\*/\nlet lararium_place_meme = require(\"lar:///ha.ka.ba/lararium/tw5/modules/place-meme\");\nlet lararium_meme_laws = require(\"lar:///ha.ka.ba/lararium/tw5/modules/meme-laws\");\nlet _lararium_memetic_frame = require(\"lar:///ha.ka.ba/lararium/tw5/lib/memetic-frame\");\nlet lararium_meme_project = require(\"lar:///ha.ka.ba/lararium/tw5/modules/meme-project\");\nlet lararium_meme_ast = require(\"lar:///ha.ka.ba/lararium/tw5/modules/meme-ast\");\nlet lararium_deserializer = require(\"lar:///ha.ka.ba/lararium/tw5/modules/deserializer\");\nlet smol_toml = require(\"lar:///ha.ka.ba/lararium/tw5/lib/smol-toml\");\n//#endregion\n//#region src/meme-ast/diagnostics.ts\nvar MEMETIC_SOURCE = \"text/memetic-wikitext+tiddlywiki\";\n/** Worst severity first, so a grade moves only when the worst class of fault moves. */\nvar SEVERITY_RANK = {\n\terror: 1,\n\twarning: 2,\n\tinfo: 3,\n\thint: 4\n};\n/**\n* The ladder, stated once.\n*\n* `error` names the one fault that costs the operator their bytes: a carrier that stops\n* round-tripping no longer says what their hands left, so the shore refuses it rather than\n* ingesting a lossy render. Every recovery sits below that line, because a recovery keeps the\n* text: the driver stands an unplaceable construct back up verbatim in an Error node, and grades\n* how far it fell. `warning` marks a construct the grammar could not place; `info` marks one it\n* repaired at lower standing. Refusing a recovery would drop the bytes to protect the grammar,\n* which inverts what the shore exists to do.\n*/\nfunction severityOf(failure) {\n\treturn severityOfRung(failure.recoveredAs);\n}\nfunction severityOfRung(rung) {\n\tswitch (rung) {\n\t\tcase \"missing\": return \"warning\";\n\t\tcase \"water\": return \"warning\";\n\t\tcase \"partial\": return \"info\";\n\t\tcase \"repaired\": return \"info\";\n\t\tdefault: return \"warning\";\n\t}\n}\n/** The shore's fault: the carrier stopped round-tripping, so ingesting it would lose the bytes. */\nvar SHORE_FAULT_CODE = \"shore-round-trip\";\nfunction shoreDiagnostic(message, sourceLength) {\n\treturn {\n\t\tfrom: 0,\n\t\tto: sourceLength,\n\t\tseverity: \"error\",\n\t\tsource: MEMETIC_SOURCE,\n\t\tcode: SHORE_FAULT_CODE,\n\t\tmessage\n\t};\n}\nfunction clamp(value, low, high) {\n\treturn Math.max(low, Math.min(value, high));\n}\nfunction failuresToDiagnostics(failures, sourceLength, source = MEMETIC_SOURCE) {\n\treturn failures.map((failure) => {\n\t\tconst from = clamp(failure.pos, 0, sourceLength);\n\t\treturn {\n\t\t\tfrom,\n\t\t\tto: clamp(failure.pos + failure.raw.length, from, sourceLength),\n\t\t\tseverity: severityOf(failure),\n\t\t\tsource,\n\t\t\tcode: failure.reason,\n\t\t\tmessage: failure.sigilName ? `The ${failure.sigilName} sigil recovered as ${failure.recoveredAs}: ${failure.reason}` : `The parser recovered this span as ${failure.recoveredAs}: ${failure.reason}`\n\t\t};\n\t});\n}\n/** The carrier's grade: the worst severity it carries, or `clean` when it carries none. */\nfunction gradeOf(diagnostics) {\n\tlet worst = \"clean\";\n\tfor (const diagnostic of diagnostics) if (worst === \"clean\" || SEVERITY_RANK[diagnostic.severity] < SEVERITY_RANK[worst]) worst = diagnostic.severity;\n\treturn worst;\n}\nvar LAR_PREFIX = `lar:///ha.ka.ba/`;\nvar TAG_PREFIX = `${LAR_PREFIX}tags/`;\nvar VOLATILE_VM_PREFIX = `lar:///lararium.local.vm/`;\nfunction volatileVmUri(path) {\n\treturn `${VOLATILE_VM_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableLarUri(path) {\n\treturn `${LAR_PREFIX}${path.replace(/^\\/+/, \"\")}`;\n}\nfunction stableTagUri(name) {\n\treturn `${TAG_PREFIX}${name.replace(/^\\/+/, \"\")}`;\n}\nvolatileVmUri(\"verb/\");\nvar BAGS_SEGMENT = \"bags\";\n/** Mint the canoni