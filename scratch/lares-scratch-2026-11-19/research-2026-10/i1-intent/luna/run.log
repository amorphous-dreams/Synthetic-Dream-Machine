t\\tout.push(line);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tconst soh = (0, _lararium_memetic_frame.matchCarrierHeadLine)(line);\\n\\t\\tif (soh) {\\n\\t\\t\\turi = uri ?? soh.uri;\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tconst etx = ETX_LINE.exec(line);\\n\\t\\tif (etx) {\\n\\t\\t\\tcheck = check ?? etx[1];\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif (FRAME_LINE.test(line) || DOCTYPE_LINE.test(line)) continue;\\n\\t\\tif (sigilBuf) {\\n\\t\\t\\tsigilBuf.push(line);\\n\\t\\t\\tif (/>>\\\\s*$/.test(line)) {\\n\\t\\t\\t\\tflushProse();\\n\\t\\t\\t\\tout.push(\\\"```\\\", ...sigilBuf, \\\"```\\\");\\n\\t\\t\\t\\tsigilBuf = null;\\n\\t\\t\\t}\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif (/^<<[~^]/.test(line) && !/>>/.test(line)) {\\n\\t\\t\\tsigilBuf = [line];\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tconst hanaOpen = HANA_OPEN.exec(line);\\n\\t\\tif (hanaOpen) {\\n\\t\\t\\tflushProse();\\n\\t\\t\\thanaKey = hanaOpen[1].trim();\\n\\t\\t\\thanaBuf = [];\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tconst ahu = AHU_OPEN.exec(line);\\n\\t\\tif (ahu) {\\n\\t\\t\\tflushProse();\\n\\t\\t\\tout.push(`<a id=\\\"${ahuId(ahu[1])}\\\"></a>`);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tif (AHU_CLOSE.test(line)) continue;\\n\\t\\tconst loulou = LOULOU_LINE.exec(line);\\n\\t\\tif (loulou) {\\n\\t\\t\\tflushProse();\\n\\t\\t\\tout.push(`- \\\\`${resolveHeadWord(loulou[1], tongue)} ${(loulou[2] ?? \\\"\\\").trim()}\\\\``);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tconst aka = AKA_LINE.exec(line);\\n\\t\\tif (aka) {\\n\\t\\t\\tflushProse();\\n\\t\\t\\tconst woven = weaveAka(aka[1], (aka[2] ?? \\\"\\\").trim(), profile, resolve, tongue);\\n\\t\\t\\tout.push(...woven.lines);\\n\\t\\t\\tfor (const ref of woven.references ?? []) references.set(ref.anchor, ref);\\n\\t\\t\\tcontinue;\\n\\t\\t}\\n\\t\\tconst kahea = KAHEA_LINE.exec(line);\\n\\t\\tif (kahea) {\\n\\t\\t\\tflushProse();\\n\\t\\t\\tconst target = kahea[1].replace(/^\\\"|\\\"$/g, \\\"\\\");\\n\\t\\t\\tconst href = /\\\\s/.test(target) ? `<${target}>` : tar