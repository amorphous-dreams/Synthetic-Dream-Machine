    16	export async function buildIntent(input: Base & { readonly verb: string; readonly args: unknown; readonly nonce: string; readonly audience: IntentAudience; readonly bound?: IntentBound; readonly verbs: IntentVerbRegistry }): Promise<SignedIntentEntry> {
