    36	export function makeFaceIntentDoor(ports: FaceIntentDoorPorts) {
    37	  let running: Promise<void> | null = null, dirty = false;
    38	  const read = async (): Promise<IntentView> => {
    39	    const face = readFace(ports.kelChain, ports.anchor);
    40	    if (!face) throw new Error("face-intent-door: no verified face lineage");
    41	    const projection = face.project(ports.personaRecords(), ports.group);
    42	    const standings = new Map<string, "stands" | "aside" | "unknown">();
    43	    for (const atom of new Set([...projection.devices.map((d) => d.toLowerCase()), ...intentEntryRecordsOfGroup(ports.plane.doc(), ports.group).map((r) => String((r as { signer?: unknown })?.signer ?? "").toLowerCase())])) {
    44	      if (atom) standings.set(atom, await ports.standing(atom));
    45	    }
    46	    return readIntentPlane({ group: ports.group, records: intentEntryRecordsOfGroup(ports.plane.doc(), ports.group),
    47	      face: faceRosterForIntents(projection, face.lineage), standing: (atom) => standings.get(atom.toLowerCase()) ?? "unknown",
    48	      ...(ports.holdsCapability ? { holdsCapability: ports.holdsCapability } : {}), verbs: ports.verbs });
    49	  };
    50	  const pass = async (): Promise<void> => {
    51	    const view = await read();
    52	    const raw = intentEntryRecordsOfGroup(ports.plane.doc(), ports.group) as SignedIntentEntry[];
    53	    for (const state of view.intents) {
    54	      if (!mayAct(view, state.id, ports.atom.key.toLowerCase()).act) continue;
    55	      const effect = ports.effects?.get(state.verb) ?? (ports.runDeclaredEffect && state.class === "idempotent" ? (args: unknown, ctx: { intentId: string; intent: IntentEntryBody; pinnedAtom: string }) => ports.runDeclaredEffect!(state.verb, args, ctx) : undefined);
    56	      if (!effect || !ports.verbs.classOfVerb(state.verb)) continue;
    57	      const invocation = raw.find((r) => r?.body?.entry === "intent" && r.body.issuer === state.issuer &&
    58	        intentId(r.body as unknown as { issuer: string; verb: string; args: unknown; nonce: string }) === state.id);
    59	      if (!invocation) continue;
    60	      const pinnedAtom = state.audience.mode === "pinned" ? state.audience.atom : state.audience.mode === "asks" && state.answer && state.answer !== "contested"
    61	        ? (state.answer.entry.body.executor as string | undefined) : undefined;
    62	      if (state.class === "single-effect" && !pinnedAtom) continue;
    63	      try {
    64	        const result = await effect(invocation.body.args, { intentId: state.id, intent: invocation.body, pinnedAtom: pinnedAtom ?? ports.atom.key });
    65	        const receipt = await buildOutcome({ group: ports.group, signer: ports.atom, cause: state.id, result: { status: "done", ...receiptFields(result) } });
    66	        ports.plane.change((draft) => writeIntentEntry(draft, receipt));
    67	      } catch (error) { ports.log(`face intent ${state.id} faulted: ${String(error)}`); }
    68	    }
    69	  };
    70	  const heed = (): Promise<void> => {
    71	    if (running) { dirty = true; return running; }
    72	    running = (async () => { do { dirty = false; try { await pass(); } catch (error) { ports.log(`face intent read faulted: ${String(error)}`); } } while (dirty); running = null; })();
    73	    return running;
    74	  };
    75	  const attach = (): (() => void) => {
    76	    const changed = () => { void heed(); };
    77	    ports.plane.on("change", changed);
    78	    void heed();
    79	    return () => ports.plane.off("change", changed);
    80	  };
    81	  const describe = async (): Promise<{ readonly view: IntentView; readonly pane: IntentPaneModel }> => { const view = await read(); return { view, pane: intentPaneModel(view) }; };
    82	  return { heed, attach, describe };
    83	}
