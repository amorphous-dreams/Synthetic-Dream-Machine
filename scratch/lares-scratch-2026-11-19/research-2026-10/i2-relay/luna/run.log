    79	/**
    80	 * Stand a carriage relay: the authenticated membership transport bound to `port` (0 → an OS-assigned free port),
    81	 * plus an empty bag-tracker. The gate seed binds the proof-of-possession challenge (a peer proves it holds its key
    82	 * before any envelope crosses); it grants NO read-cap and names NO roster — the member gate lives on the cas-wire
    83	 * SERVE side (in the vessels), never here.
    84	 */
    85	export function startCarriageRelay(cfg: {
    86	  gateSeed: Uint8Array;
    87	  port?: number;
    88	  /** Every sibling frame the relay carries, exactly as it carries it — the herm's whole sight of a channel. */
    89	  onSiblingFrame?: RelayAnnounceObserver["onSiblingFrame"];
    90	  /** Where the relay journals the successor drops it verified, so a restarted herm keeps them. */
    91	  dropJournalPath?: string;
    92	}): Promise<CarriageRelay> {
    93	  return (async (): Promise<CarriageRelay> => {
    94	    const tracker = makeBagTracker();
    95	    // Per-holder cid set — so a DEPARTED holder's every announced cid prunes at once (the tracker forgets by
    96	    // {cid, holder}, holding no holder→cids reverse index; this sniff-local map supplies it, tracker unchanged).
    97	    const heldByHolder = new Map<string, Set<string>>();
    98	
    99	    // The RE-SHARE sniff: a PROVEN peer's `cas-have(cid)` announce lands `cid → holder` in the bag-tracker FROM
   100	    // THE WIRE (the leg that stood empty). A departure prunes every cid that holder announced. The tracker stays
   101	    // a HINT — a member re-verifies `verifyCiphertextCid` on the fetched bytes, so a stale/hostile hint is caught.
   102	    const relay: HermRelayPort = await startHermRelayPort(cfg.gateSeed, cfg.port ?? 0, {
   103	      onEnvelope: (env: MembershipEnvelope) => {
   104	        if (env.kind !== CAS_HAVE) return;                                  // only the announce leg feeds discovery
   105	        const cid = typeof (env.payload as { cid?: unknown })?.cid === "string" ? (env.payload as { cid: string }).cid : "";
   106	        if (!cid) return;
   107	        tracker.note(cid, env.from);                                        // env.from is the relay-PROVEN key (never spoofable)
   108	        let held = heldByHolder.get(env.from);
   109	        if (!held) { held = new Set<string>(); heldByHolder.set(env.from, held); }
   110	        held.add(cid);
   111	      },
   112	      onLeave: (from: string) => {
   113	        const held = heldByHolder.get(from);
   114	        if (!held) return;
   115	        for (const cid of held) tracker.forget(cid, from);                  // prune every cid this holder announced
   116	        heldByHolder.delete(from);
   117	      },
   118	      ...(cfg.onSiblingFrame ? { onSiblingFrame: cfg.onSiblingFrame } : {}),
   119	    }, cfg.dropJournalPath ? { dropJournalPath: cfg.dropJournalPath } : {});
   120	    const gatePubKey = hex(await ed.getPublicKeyAsync(cfg.gateSeed));
   121	    return {
   122	      port: relay.port,
   123	      gatePubKey,
   124	      tracker,
   125	      close: () => relay.close(),
   126	    };
   127	  })();
   128	}
