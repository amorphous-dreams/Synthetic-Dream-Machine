   189	  if (state.audience.mode === "prefer" && !state.audience.atoms.includes(atom)) return { act: false, reason: "not-audience" };
   190	  if (state.audience.mode === "class" && !view.holdsCapability(atom, state.audience.capability)) return { act: false, reason: "not-audience" };
