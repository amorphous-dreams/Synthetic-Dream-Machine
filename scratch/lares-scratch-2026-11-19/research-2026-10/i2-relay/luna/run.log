    85	/** The joinee issues one invocation through the shared plane, keyed by its atom. */
    86	export async function requestFaceJoin(input: { readonly group: string; readonly plane: DocHandle<LarDoc>; readonly atom: IntentSigner;
    87	  readonly hearthAtom?: string; readonly projection?: { readonly admissions: readonly { readonly deviceKey: string }[] };
    88	  readonly summons: unknown; readonly verbs: IntentVerbRegistry }): Promise<string> {
    89	  const hearth = input.hearthAtom ?? input.projection?.admissions[0]?.deviceKey;
    90	  if (!hearth) throw new Error("face-join: no founding hearth admission");
    91	  const entry = await buildIntent({ group: input.group, signer: input.atom, verb: "face-join", args: { summons: input.summons },
    92	    nonce: input.atom.key.toLowerCase(), audience: { mode: "pinned", atom: hearth.toLowerCase() }, verbs: input.verbs });
    93	  const id = intentId(entry.body as unknown as { issuer: string; verb: string; args: unknown; nonce: string });
    94	  input.plane.change((draft) => writeIntentEntry(draft, entry));
    95	  return id;
    96	}
