   177	export type MayActReason = "answered" | "void" | "not-audience" | "pinned-elsewhere" | "fenced-by-claim" | "awaiting-answer" | "unknown-frontier" | "atom-aside";
   178	export function mayAct(view: IntentView, intentId: string, atom: string): { readonly act: true } | { readonly act: false; readonly reason: MayActReason } {
   179	  const state = view.intents.find((i) => i.id === intentId);
   180	  if (!state) return { act: false, reason: "not-audience" };
   181	  if (state.voidCause) return { act: false, reason: "void" };
   182	  const standing = view.standing(atom);
   183	  if (standing === "unknown" || state.status === "unknown-frontier") return { act: false, reason: "unknown-frontier" };
   184	  if (standing === "aside") return { act: false, reason: "atom-aside" };
   185	  if (state.audience.mode === "pinned" && state.audience.atom !== atom) return { act: false, reason: "pinned-elsewhere" };
   186	  if (state.audience.mode === "asks") {
   187	    if (!state.answer || state.answer === "contested" || field(state.answer, "verdict") !== "approve" || field(state.answer, "executor") !== atom) return { act: false, reason: "awaiting-answer" };
