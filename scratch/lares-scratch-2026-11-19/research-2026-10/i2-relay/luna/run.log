     6	export interface FaceIntentDoorPorts {
     7	  readonly group: string;
     8	  readonly atom: IntentSigner;
     9	  readonly plane: DocHandle<LarDoc>;
    10	  readonly personaRecords: () => readonly unknown[];
    11	  readonly kelChain: readonly PersonaKelEvent[];
    12	  readonly anchor?: FaceAnchor | null;
    13	  readonly standing: (atom: string) => "stands" | "aside" | "unknown" | Promise<"stands" | "aside" | "unknown">;
    14	  readonly holdsCapability?: (atom: string, capability: string) => boolean;
    15	  readonly verbs: IntentVerbRegistry;
    16	  readonly effects?: ReadonlyMap<string, (args: unknown, ctx: { intentId: string; intent: IntentEntryBody; pinnedAtom: string }) => Promise<unknown>>;
    17	  readonly runDeclaredEffect?: (verb: string, args: unknown, ctx: { intentId: string; intent: IntentEntryBody; pinnedAtom: string }) => Promise<unknown>;
    18	  readonly log: (message: string) => void;
    19	}
    20	
    21	/** What an outcome keeps of an effect's answer: names, counts, flags and short reasons, never a body (the rubric: content never rides an entry). */
    22	export function receiptFields(result: unknown): Record<string, unknown> {
    23	  if (typeof result !== "object" || result === null) return {};
    24	  const out: Record<string, unknown> = {};
    25	  for (const [key, value] of Object.entries(result as Record<string, unknown>)) {
    26	    if (typeof value === "boolean" || typeof value === "number") out[key] = value;
    27	    else if (typeof value === "string" && value.length <= 512) out[key] = value;
    28	    else if (Array.isArray(value)) {
    29	      if (value.length <= 16 && value.every((v) => typeof v === "string" && v.length <= 128)) out[key] = value;
    30	      else out[`${key}Count`] = value.length;
    31	    }
    32	  }
    33	  return out;
    34	}
