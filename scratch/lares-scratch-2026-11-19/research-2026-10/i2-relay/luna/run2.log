ntime.\n\n`house-rules.test.js` follows the summary line the house reading moved off, asserting the reading it\nnow stands on.\n\nMeasured: 655 of 655 tool tests pass, 0 fail, under the restored pattern.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01QdAMPMM9DsR4rRrmqqQBXe\nEOF\ngit commit --only -F .commit-msg.tmp -- .github/workflows/test.yml package.json tools/house-rules.test.js 2>&1 | tail -3; rm -f .commit-msg.tmp; git push origin release/3.0.0 2>&1 | tail -2","description":"Commit and push the matrix fix"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":764,"cache_read_input_tokens":176288,"output_tokens":955,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":764,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":955,"cache_read_input_tokens":176288,"cache_creation_input_tokens":764,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":764},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_012HGB2viUax31t2QSPgYPhD":{"command":"cd /home/joshu/Synthetic-Dream-Machine/VSCode-TW5-Syntax && cat > .commit-msg.tmp <<'EOF'\nlar:///ha.ka.ba/ci/one-node-because-the-pattern-stands-declared — the matrix drops its Node 20 leg\n\nMY OWN FAULT, PUSHED. The previous commit replaced the `test-tools` glob with `node --test ./tools`\non the reasoning that Node discovers a directory recursively. It does not: it reads the directory as\na single test FILE and dies loading it, `MODULE_NOT_FOUND`, on every version in the matrix. I never\nran the script before pushing it, and CI said so on all four legs in 33 seconds. The reading that\nconvinced me — `ls tools/*.test.js | wc -l` — counted files on disk and measured nothing about\ndiscovery.\n\n`every-test-runs.test.js` then ruled out the two cures that looked next-best. It derives the test\npopulation from a WALK and asks which declared pattern reaches each file, reading patterns only\nwhere a script carries one QUOTED — so an unquoted glob the shell expands declares nothing, and a\nrunner script wrapping the enumeration carries no `node --test` for that reading to find. Both read\nas 100 test files no script reaches. The law stands and is right: a file standing where the glob\ncannot see it must fail where a reader meets it, not run never and say nothing.\n\nA quoted pattern reaches Node unexpanded, and Node 20 cannot expand one. So the LEG goes, not the\nlaw. Nothing here promises a Node version — `engines` names only VS Code — and the claim this matrix\nmakes, in its own comment, is PLATFORM resolution of the VS Code grammar root, which three\noperating systems carry without a fourth runtime.\n\n`house-rules.test.js` follows the summary line the house reading moved off, asserting the reading it\nnow stands on.\n\nMeasured: 655 of 655 tool tests pass, 0 fail, under the restored pattern.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01QdAMPMM9DsR4rRrmqqQBXe\nEOF\ngit commit --only -F .commit-msg.tmp -- .github/workflows/test.yml package.json tools/house-rules.test.js 2>&1 | tail -3; rm -f .commit-msg.tmp; git push origin release/3.0.0 2>&1 | tail -2","description":"Commit and push the matrix fix"}},"wireIngestContext":{"toolu_012HGB2viUax31t2QSPgYPhD":{"cwd":"/home/joshu/Synthetic-Dream-Machine/VSCode-TW5-Syntax"}},"apiBlockIndex":1,"requestId":"req_011CfpNVEFWKc8A3XqwTCRMf","type":"assistant","uuid":"65eb83e0-95b2-4924-a698-3e28d1e0a365","timestamp":"2026-10-08T07:25:21.999Z","advisorModel":"claude-opus-5","effort":"medium","perTurnEff