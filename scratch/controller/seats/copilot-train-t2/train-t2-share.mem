   651        if (!isIndex(handleIndex) || typeof verifyingKey !== "string" || !HEX64.test(verifyingKey) || seen.has(handleIndex)) throw malformed(file);
   652        seen.add(handleIndex);
   653        out.push({ handleIndex, verifyingKey });
   654      }
   655      return out.sort((a, b) => a.handleIndex - b.handleIndex);
