   210    const ascending = (a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0);
   211    const refuse = (refusal: HolderRefusalName, cause?: string): HolderRefusal => (cause === undefined ? { refusal } : { refusal, cause });
   212    const isRefusal = (value: object): value is HolderRefusal => "refusal" in value;
   213    const bare = (reader: string): string => reader.trim().toLowerCase().replace(/^0x/, "");
