1    /**
     2     * session-sign-door — the vessel's side of the session sign door: the daemon island signs a sealed record through the
     3     * session that placed its ask, and that session's key never leaves this thread.
     4     *
     5     * THE BOOK. The session seat books each `session:call` it places by its request id, naming the verb it placed and the
     6     * session that placed it (its signer, its anchor, its proof subject), and drops the booking once the call concludes. The
     7     * island's ask names the request id and the verb; a booking that names another verb, or none, answers
     8     * `signer-unavailable`, so no summons reusing an id and no ask a session never placed borrows a signer.
     9     *
    10     * THE LAW (sealed-store#/the-store, face-proof#/the-key-hierarchy):
    11     *   · The signer holds the only copy of its secret: it signs here, and asks its owner's table before every signature.
    12     *     A lock, a close or a switch drops it, and the next signature refuses `signer-refused`; the island holds nothing
    13     *     to revoke.
    14     *   · Only a Nexus-anchored session signs a sealed record: a place session holds a place certificate, which no record
    15     *     carries, and answers `session-anchor-place`.
    16     *   · The answer carries the vessel's own verified face chain (public), from which the island reads who may write.
    17     *     No chain standing (no dial presentation composed) answers `signer-unavailable`.
    18     *
    19     * Canon: lar:///ha.ka.ba/lararium/mesh/sealed-store#/the-store
    20     */
    21    import type { SessionOwnChain } from "@lararium/mesh";
    22    import type { SessionAnchor, UdsSessionSigner } from "./uds-channel.js";
    23    import type { SessionSignDoor } from "./worker-handle.js";
    24
    25    /** The session that placed one booked call. */
    26    export interface BookedSession {
    27      readonly signer: UdsSessionSigner;
    28      readonly anchor: SessionAnchor;
    29      /** The session's proof subject, as its face reads on the owner's table. */
    30      readonly subject: string;
    31    }
    32
    33    interface Booking { readonly verb: string; readonly session: BookedSession }
    34
    35    export class SessionSignBook {
    36      readonly #held = new Map<string, Booking>();
    37
    38      /** Book one call a session placed; the returned release drops this booking alone. An id already booked keeps its
    39       *  first booking: a second call under it (a retry, a sibling socket of the same face) books nothing, so no later
    40       *  call re-routes an in-flight one to another session's signer. The seat's ledger runs one act per id. */
    41      hold(requestId: string, verb: string, session: BookedSession): () => void {
    42        if (this.#held.has(requestId)) return () => {};
    43        const booking: Booking = { verb, session };
    44        this.#held.set(requestId, booking);
    45        return () => { if (this.#held.get(requestId) === booking) this.#held.delete(requestId); };
    46      }
    47
    48      /** How many calls stand booked now (a vector reads it; a booking never outlives its call). */
    49      get size(): number { return this.#held.size; }
    50
    51      /** The door the daemon island's asks reach. `chain` answers this vessel's own verified face chain, or null. */
    52      door(chain: () => SessionOwnChain | null): SessionSignDoor {
    53        return async (ask) => {
    54          const booking = this.#held.get(ask.ask);
    55          if (booking === undefined || booking.verb !== ask.verb) return { refusal: "signer-unavailable" };
    56          const { signer, anchor, subject } = booking.session;
    57          if (anchor.kind !== "nexus") return { refusal: "session-anchor-place" };
    58          if (signer.dropped) return { refusal: "signer-refused" };
    59          const own = chain();
    60          if (own === null) return { refusal: "signer-unavailable" };
    61          if (ask.op === "read") return { certificate: signer.certificate, subject, chain: own };
    62          if (!(ask.payload instanceof Uint8Array)) return { refusal: "signer-refused" };
    63          const signed = await signer.sign("act", ask.payload);
    64          return "signature" in signed ? { signature: signed.signature } : { refusal: "signer-refused" };
    65        };
    66      }
    67    }
