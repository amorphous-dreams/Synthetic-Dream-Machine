1    /**
     2     * Custody names read no login (T20). A vessel's custody files once took a suffix off the git global `user.email`,
     3     * so a flipped email (an edit, a `GIT_CONFIG_GLOBAL`, an unset `HOME`, a slow `git`) made the same vessel read as
     4     * empty, and the mint paths answered "empty" by minting a second identity beside the first. Custody resolves its
     5     * names from its home alone: a host fact never picks which file a vessel reads.
     6     */
     7    import { afterAll, describe, expect, test, vi } from "vitest";
     8    import { cpSync, mkdirSync, mkdtempSync, readdirSync, rmSync, writeFileSync } from "node:fs";
     9    import { tmpdir } from "node:os";
    10    import { join } from "node:path";
    11    import type { RandomProvider } from "@lararium/mesh";
    12    import { withLarRoot } from "../../../tests/harness/with-lar-root.js";
    13    import { foundDirect } from "./found-route.js";
    14    import { generateOrLoadPersonaGroupRoot, generateOrLoadVesselIdentity, loadVesselIdentity } from "../src/node-vessel-identity.js";
    15    import { larIdentityDir } from "../src/vessel-paths.js";
    16    import { faceRowNames } from "./face-paths.js";
    17
    18    vi.setConfig({ testTimeout: 240_000 });
    19    const roots: string[] = [];
    20    afterAll(() => roots.forEach((r) => rmSync(r, { recursive: true, force: true })));
    21    function root(): string {
    22      const r = mkdtempSync(join(tmpdir(), "lar-custody-names-"));
    23      cpSync(join(import.meta.dirname, "../../../genesis"), join(r, "genesis"), { recursive: true, filter: (s) => !s.endsWith("social-bootstrap.json") });
    24      roots.push(r); return r;
    25    }
    26    function entropy(start: number): RandomProvider {
    27      let n = start;
    28      return { getRandomValues<T extends Uint8Array<ArrayBuffer>>(a: T): T { for (let i = 0; i < a.length; i++) a[i] = n++ & 255; return a; }, randomUUID: () => "deterministic" };
    29    }
    30    const at = (r: string) => ({ storageDir: join(r, "data", "lares", "vessel"), genesisDir: join(r, "genesis") });
    31
    32    /** Run `work` with git's global config at a scratch file naming `email`; `flip` rewrites it mid-run. */
    33    async function underEmail<T>(r: string, email: string, work: (flip: (next: string) => void) => Promise<T>): Promise<T> {
    34      const file = join(r, "gitconfig");
    35      const write = (e: string): void => writeFileSync(file, `[user]\n\temail = ${e}\n`);
    36      write(email);
    37      const prior = process.env["GIT_CONFIG_GLOBAL"];
    38      process.env["GIT_CONFIG_GLOBAL"] = file;
    39      try { return await work(write); }
    40      finally { if (prior === undefined) delete process.env["GIT_CONFIG_GLOBAL"]; else process.env["GIT_CONFIG_GLOBAL"] = prior; }
    41    }
    42    const placeFiles = (): string[] => readdirSync(larIdentityDir()).filter((f) => f.startsWith(".vessel-")).sort();
    43    const rootRows = (): string[] => faceRowNames().filter((f) => f.startsWith(".persona-group-root"));
    44
    45    describe("custody names read no login", () => {
    46      test("RED: a flipped git email loads the persona root that stands, and mints no second root", async () => {
    47        const r = root();
    48        await withLarRoot(r, () => underEmail(r, "a@x.invalid", async (flip) => {
    49          await foundDirect({ ...at(r), entropy: entropy(1), placeFoundingCard: { readBack: async () => {} } });
    50          const first = await generateOrLoadPersonaGroupRoot(0);
    51          flip("b@x.invalid");
    52          const again = await generateOrLoadPersonaGroupRoot(0);
    53          expect(again.verifyingKey, "the same root answers").toBe(first.verifyingKey);
    54          expect(again.created, "nothing mints").toBe(false);
    55          expect(rootRows(), "one root row stands").toHaveLength(1);
    56        }));
    57      });
    58
    59      test("CONTROL: the unchanged email loads the persona root with created:false", async () => {
    60        const r = root();
    61        await withLarRoot(r, () => underEmail(r, "a@x.invalid", async () => {
    62          await foundDirect({ ...at(r), entropy: entropy(1), placeFoundingCard: { readBack: async () => {} } });
    63          const first = await generateOrLoadPersonaGroupRoot(0);
    64          const again = await generateOrLoadPersonaGroupRoot(0);
    65          expect(again).toEqual({ verifyingKey: first.verifyingKey, created: false });
    66          expect(rootRows()).toHaveLength(1);
    67        }));
    68      });
    69
    70      test("RED: a found on a flipped git email loads the place key that stands, and mints no second key or KEL", async () => {
    71        const r = root();
    72        await withLarRoot(r, () => underEmail(r, "a@x.invalid", async (flip) => {
    73          await foundDirect({ ...at(r), entropy: entropy(1), placeFoundingCard: { readBack: async () => {} } });
    74          const standing = placeFiles();
    75          const first = await generateOrLoadVesselIdentity({ placeFoundingCard: { readBack: async () => {} } });
    76          flip("b@x.invalid");
    77          const again = await generateOrLoadVesselIdentity({ placeFoundingCard: { readBack: async () => {} } });
    78          expect(again.verifyingKey, "the same place key answers").toBe(first.verifyingKey);
    79          expect(placeFiles(), "no second key or KEL lands").toEqual(standing);
    80        }));
    81      });
    82
    83      test("CONTROL: a found on the unchanged email loads the place key that stands", async () => {
    84        const r = root();
    85        await withLarRoot(r, () => underEmail(r, "a@x.invalid", async () => {
    86          await foundDirect({ ...at(r), entropy: entropy(1), placeFoundingCard: { readBack: async () => {} } });
    87          const standing = placeFiles();
    88          const first = await generateOrLoadVesselIdentity({ placeFoundingCard: { readBack: async () => {} } });
    89          const again = await generateOrLoadVesselIdentity({ placeFoundingCard: { readBack: async () => {} } });
    90          expect(again.verifyingKey).toBe(first.verifyingKey);
    91          expect(placeFiles()).toEqual(standing);
    92        }));
    93      });
    94
    95      test("a home holding only a file no row names boots to the ordinary refusal, and nothing mints", async () => {
    96        const r = root();
    97        await withLarRoot(r, async () => {
    98          mkdirSync(larIdentityDir(), { recursive: true });
    99          writeFileSync(join(larIdentityDir(), "stray-unrecognised.json"), "{}", { mode: 0o600 });
   100          const before = readdirSync(larIdentityDir()).sort();
   101          await expect(loadVesselIdentity()).rejects.toThrow(/no key file/);
   102          expect(readdirSync(larIdentityDir()).sort(), "the boot lands nothing").toEqual(before);
   103        });
   104      });
