1    /**
     2     * content-key-seat — the content-key holder seated beside one island's Keyhive identities, and the roll it
     3     * subscribes to the vessel's seat rolls.
     4     *
     5     * THE HOLDER LIVES WHERE THE KEYS' SEAT LIVES. A vessel's Keyhive identities stand in its daemon island, so the
     6     * holder stands there too: a bare content key never crosses the island's port. The vessel hands a body in and
     7     * takes a sealed value back.
     8     *
     9     * THIS MODULE SUPPLIES THE VESSEL'S OWN READINGS, and holds none of its own:
    10     *   · WHOM A WRAP SERVES. The readers of a bag read as the seats the face's key group holds on this replica,
    11     *     each one still seated, less every party whose edge this vessel reads as set aside or as owing a roll. A
    12     *     vessel with no face names no key group: its keys wrap for its own identities alone.
    13     *   · WHICH BAGS A SCOPE REACHES. A seat roll names a scope (a fleet root); the bags that scope reaches read
    14     *     as the bags this vessel holds under that face.
    15     *   · WHICH RAISES COUNT. A raise counts where this island's own count of the fleet's acts answered it (every
    16     *     roll this seat took, and every kept roll the vessel handed back under its own receipt), or where the
    17     *     vessel's ledger reading says so.
    18     *   · WHERE THIS VESSEL SITS. Its own seat reads as the one of its identities the face's key group holds and
    19     *     still seats on this replica. A vessel with no face, or whose identities hold no seat there, names none, and
    20     *     an import of a bundle's memory section then refuses: it would wrap a key for no seat.
    21     *   · WHO SIGNS. The session whose act asks. No session proof composed: every mint refuses by name, and this
    22     *     vessel reads no writer as capable, so it counts no record. No vessel key and no daemon key signs in a
    23     *     session's place.
    24     *
    25     * ONE SUBSCRIPTION. `seatContentKeys` subscribes the content-key roll to this island's seat rolls
    26     * (`subscribeSeatRolls`), the one seam kapae#/keys names. A roll it could not finish rejects, the raises stay
    27     * unmarked, and the same roll comes again.
    28     *
    29     * Canon: lar:///ha.ka.ba/lararium/mesh/sealed-store#/the-store · lar:///ha.ka.ba/lares/api/pono/kapae#/keys
    30     */
    31    import {
    32      ContentKeyHolder, SealedStore, contentKeyRollSink, verifiedSeatRoll,
    33      type ContentKeyHolderPorts, type EdgeStanding, type RecordSigner, type RollOutcome, type SealedStoreRest,
    34      type SeatRoll, type SeatRollSink, type WriterStanding,
    35    } from "@lararium/mesh";
    36    import { keyhiveLockboxShore, type LockboxProvider } from "./keyhive-lockbox.js";
    37    import { subscribeSeatRolls } from "./seat-duty-executor.js";
    38
    39    /** The slice of a `KeyhiveProvider` a content-key seat rides. */
    40    export interface ContentKeyProvider extends LockboxProvider {
    41      groupMembers(groupId: string): Promise<string[]>;
    42      verifyGroupMembership(agentIdentifierHex: string, groupId: string): Promise<{ ok: boolean }>;
    43    }
    44
    45    /** What a session's open hands the holder: the signer of the session that acts, and this vessel's own reading
    46     *  of who may write a bag (the face proof's chain check). */
    47    export interface SessionProof {
    48      /** The signer of the session whose act asks now, or null where none stands. */
    49      signer(): RecordSigner | null;
    50      readonly standing: WriterStanding;
    51      readonly apart?: NonNullable<ContentKeyHolderPorts["apart"]>;
    52    }
    53
    54    /** With no session proof composed, this vessel reads no writer as capable: it counts no record and mints none. */
    55    const NO_PROOF: SessionProof = Object.freeze({ signer: () => null, standing: Object.freeze({ holdsWrite: () => false }) });
    56
    57    export interface ContentKeySeatInput {
    58      /** This island's identities, in wrap order: the identity that holds the face's key group first. */
    59      readonly providers: readonly ContentKeyProvider[];
    60      /** Durable rest for lockboxes, records and index rows (the node answers it over files). */
    61      readonly rest: SealedStoreRest;
    62      /** The sealed values' own rest: bytes by address. */
    63      readonly values: ContentKeyHolderPorts["values"];
    64      /** Rest one identity's Archive under the vessel key. It resolves before a wrap answers. */
    65      restArchive(provider: ContentKeyProvider): Promise<void>;
    66      /** The face's key group (a Keyhive group's id) and the scope its edge acts ride. Null: no face stands here. */
    67      readonly group: { readonly groupId: string; readonly scope: string } | null;
    68      /** The bags this vessel holds under the face's key group. */
    69      bags(): readonly string[];
    70      /** What one seat's edge reads on this vessel's own fold. Absent: no reader stands composed, and every other
    71       *  seat reads as set aside. */
    72      readonly standingOf?: (member: string) => EdgeStanding | Promise<EdgeStanding>;
    73      /** Does this vessel read a shadow over its own edge in the face's scope? Absent: it reads none. */
    74      readonly ownEdgeShadowed?: () => boolean | Promise<boolean>;
    75      /** Raises the vessel's own ledger counts on the face's scope, beyond the rolls this seat itself took. */
    76      readonly countedRaises?: () => ReadonlySet<string> | Promise<ReadonlySet<string>>;
    77      /** Admission acts this vessel verified. */
    78      readonly verifiedAdmissions?: () => ReadonlySet<string> | Promise<ReadonlySet<string>>;
    79      readonly session?: SessionProof;
    80      /** What each founding of each bag did with a roll: for a door, a log line or a vector. It names no key. */
    81      readonly report?: (outcome: RollOutcome) => void;
    82      /** Where the roll subscribes. Absent: this island's own seat rolls (`subscribeSeatRolls`), the production
    83       *  seam. A vector that stands several vessels in one process hands each its own. */
    84      readonly subscribe?: (sink: SeatRollSink) => () => void;
    85    }
    86
    87    export interface ContentKeySeat {
    88      readonly holder: ContentKeyHolder;
    89      /** The subscriber this seat stood on the vessel's seat rolls. */
    90      readonly sink: SeatRollSink;
    91      /**
    92       * Hand the seat the rolls the vessel kept (`keptSeatRolls`), each under the vessel's own receipt. A roll
    93       * whose receipt fails under `vesselKey` moves nothing. A roll already answered settles as not owed; a
    94       * founding or a head that arrived since still takes its roll. Answers how many it took and what stays owed.
    95       */
    96      catchUp(rolls: readonly unknown[], vesselKey: string): Promise<{ readonly taken: number; readonly refused: number; readonly owed: readonly string[] }>;
    97      /**
    98       * Seal one private body as a session's act: first settle every roll still owed with that session's own signer,
    99       * then seal under a head that follows every raise still owed in the bag's scope, or refuse `roll-owed`.
   100       */
   101      seal(args: Omit<Parameters<ContentKeyHolder["sealBlob"]>[0], "owedActs">): ReturnType<ContentKeyHolder["sealBlob"]>;
   102      /** Settle the rolls still owed with `signer`, the signer of the session whose act runs now. */
   103      settle(signer: RecordSigner | null): Promise<void>;
   104      /** The raises still owed in one bag's scope (a vector reads it). */
   105      owedFor(bagId: string): readonly string[];
   106      /** Unsubscribe, overwrite every key and forget every reading. */
   107      lock(): void;
   108    }
   109
   110    const bare = (id: string): string => id.trim().toLowerCase().replace(/^0x/, "");
   111
   112    /** Seat the holder beside these identities and subscribe its roll. */
   113    export function seatContentKeys(input: ContentKeySeatInput): ContentKeySeat {
   114      const session = input.session ?? NO_PROOF;
   115      const shore = keyhiveLockboxShore(input.providers, { restArchive: (provider) => input.restArchive(provider as ContentKeyProvider) });
   116      /** Raises this island's own count answered: every roll the sink took, and every kept roll under a receipt. */
   117      const answered = new Set<string>();
   118
   119      const readersOf = async (): Promise<readonly string[]> => {
   120        if (input.group === null) return [];
   121        const own = new Set((await shore.self()).map(bare));
   122        for (const provider of input.providers) {
   123          let members: string[];
   124          try { members = await provider.groupMembers(input.group.groupId); } catch { continue; }   // this identity holds no replica of the group
   125          const readers: string[] = [];
   126          for (const member of members) {
   127            if (own.has(bare(member))) continue;                         // the wrap seats this vessel's own identities itself
   128            if (!(await provider.verifyGroupMembership(member, input.group.groupId)).ok) continue;
   129            const standing = input.standingOf === undefined ? "aside" : await input.standingOf(member);
   130            // A seat that owes its roll leaves first; a party set aside holds no standing. Neither receives a key.
   131            if (standing === "clear" || standing === "returned") readers.push(bare(member));
   132          }
   133          return readers;
   134        }
   135        return [];
   136      };
   137
   138      const holder = new ContentKeyHolder({
   139        store: new SealedStore(input.rest),
   140        shore,
   141        readersOf,
   142        standing: session.standing,
   143        evidenceOf: async () => {
   144          const counted = input.countedRaises === undefined ? new Set<string>() : await input.countedRaises();
   145          const admitted = input.verifiedAdmissions === undefined ? new Set<string>() : await input.verifiedAdmissions();
   146          return { raiseCounts: (act) => answered.has(act) || counted.has(act), admissionVerifies: (act) => admitted.has(act) };
   147        },
   148        ownEdgeShadowed: async () => (input.ownEdgeShadowed === undefined ? false : (await input.ownEdgeShadowed()) === true),
   149        ownSeat: async () => {
   150          if (input.group === null) return null;
   151          const own = (await shore.self()).map(bare);
   152          for (const provider of input.providers) {
   153            let members: string[];
   154            try { members = (await provider.groupMembers(input.group.groupId)).map(bare); } catch { continue; }   // this identity holds no replica of the group
   155            for (const id of own) {
   156              if (members.includes(id) && (await provider.verifyGroupMembership(id, input.group.groupId)).ok) return id;
   157            }
   158            return null;
   159          }
   160          return null;
   161        },
   162        values: input.values,
   163        ...(session.apart ? { apart: session.apart } : {}),
   164      });
   165
   166      // THE SIGNER OF THE ACT THAT SETTLES A ROLL. A seat roll arrives with no session behind it, so it takes the
   167      // session proof's own signer (none in production) and, failing that, stays owed here. The next session act settles
   168      // it with THAT session's signer (`settle`), before its seal; a seal ahead of an owed roll refuses `roll-owed`.
   169      let actSigner: RecordSigner | null = null;
   170      const roll = contentKeyRollSink(holder.rollerPorts({
   171        bagsOf: (scope) => (input.group !== null && bare(scope) === bare(input.group.scope) ? input.bags() : []),
   172        signer: () => actSigner ?? session.signer(),
   173        ...(input.report ? { report: input.report } : {}),
   174      }));
   175      /** The rolls that did not finish, by their scope and raises: each stays owed until a session act settles it. The
   176       *  executor also leaves each raise unmarked, so the roll comes again on its next run, a restart included. */
   177      const owed = new Map<string, SeatRoll>();
   178      const owedKey = (r: SeatRoll): string => JSON.stringify([bare(r.scope), [...r.raiseCids].sort()]);
   179      const sink: SeatRollSink = async (seatRoll: SeatRoll) => {
   180        // This island's own count of the fleet's acts answered these raises (`answerFleetSeatDuties`), so the
   181        // version a roll mints for them verifies against this seat's own evidence.
   182        for (const cid of seatRoll.raiseCids) answered.add(cid);
   183        // OWED FROM THE MOMENT IT ARRIVES: a seal that reads the owed raises while this roll runs refuses ahead of it.
   184        owed.set(owedKey(seatRoll), seatRoll);
   185        await roll(seatRoll);
   186        owed.delete(owedKey(seatRoll));
   187      };
   188      let settling: Promise<unknown> = Promise.resolve();
   189      const settle = (signer: RecordSigner | null): Promise<void> => {
   190        const run = settling.then(async () => {
   191          if (signer === null || owed.size === 0) return;
   192          actSigner = signer;
   193          try {
   194            for (const [key, seatRoll] of [...owed]) {
   195              try { await roll(seatRoll); owed.delete(key); } catch { /* it stays owed; the seal reads it below */ }
   196            }
   197          } finally { actSigner = null; }
   198        });
