1250      // what that verdict reads — the member set, the posture, the antigen, a realm registration — must ask the Repo
  1251      // to read it again, or a member contracted AFTER its socket stood keeps drawing DENIED (measured: B's realm doc
  1252      // arrived empty while A's board named her). `shareConfigChanged` re-evaluates every doc for every peer.
  1253      const reverdict = (): void => { try { repo.shareConfigChanged(); } catch { /* the repo may be closing */ } };
  1254      reverdictLater = reverdict;
  1255      // THE CARRIED NEXUSES' BOARDS, read off this vessel's own live replica: every Nexus in the carried set, each
  1256      // island resolved over its own charter home. A change on any of them — a revoke arriving by sync — refolds
  1257      // the leaf map; the dialed island's board also re-checks what this vessel presents when it dials.
  1258      const carriedBoards = liveBoardOpener(repo, () => {
  1259        void nexusMembershipHolder?.refold();
  1260        void representIfMoved?.();
  1261      });
  1262      stood.push({ what: "the carried boards", down: () => carriedBoards.dispose() });
  1263      const readCarried = (): Promise<readonly CarriedNexusReading[]> =>
  1264        readCarriedNexuses({ sealHome, ownVesselKey: vesselIdentity.verifyingKey, open: carriedBoards.open });
  1265      // Every Nexus this vessel carries, either way it carries: a persona's consent or seated chair, or this PLACE's
  1266      // own counted carrier seal. The sorter reads the postures of all of them.
  1267      const readEveryCarried = async (): Promise<readonly CarriedNexusReading[]> => unionReadings(
  1268        await readCarried(),
  1269        await placeCarriedNexuses({ sealHome, ownVesselKey: vesselIdentity.verifyingKey, open: carriedBoards.open }),
  1270      );
  1271      // The Nexuses this vessel's gates stand in, as the last gate sweep read them (`standGates`, below).
  1272      let gateReadings: readonly CarriedNexusReading[] = [];
  1273      // The sync gates' sweep, set once they first stand (at the arm, below): every refold sweeps again.
  1274      let resweepGates: (() => Promise<void>) | null = null;
  1275      // The oracle faces that follow the floor gates' set (`floorGates`, below): every refold tells them, and each sweeps again.
  1276      const floorFollowers = new Set<() => void>();
  1277      const floorGatesMoved = (): void => { for (const follower of [...floorFollowers]) { try { follower(); } catch { /* a face's own fault */ } } };
  1278      /** This vessel's own Nexus: the AID of the charter it keeps at its seal home, or null. */
  1279      const ownNexusAid = (): string | null => nexusAidOf(readNexusDoc(sealHome)) ?? null;
  1280      /**
  1281       * The posture of ONE Nexus a gate stands in. A herm answers the knock (operator ruling): OPEN by class at every gate it
  1282       * stands, and it stands one only where a quorum counted its carry (`gateNexuses`); this vessel's own Nexus reads its
  1283       * charter; a carried one reads the charter this vessel holds for it; any other reads PRIVATE.
  1284       */
  1285      const postureOf = (nexus: string): FederationPosture => {
  1286        const aid = nexus.trim().toLowerCase();
  1287        if (placeClass === "herm") return ownPlacePosture(placeClass, null);
  1288        if (ownNexusAid()?.toLowerCase() === aid) return ownPlacePosture(placeClass, readNexusDoc(sealHome));
  1289        return gateReadings.find((r) => r.aid.toLowerCase() === aid)?.posture ?? "private";
  1290      };
  1291      /** A peer a contracted class holds: a leaf the membership reads held, or a PLACE whose key this board carries. */
  1292      const contractHolds = (peerId: string): boolean => {
  1293        const holder = nexusMembershipHolder;
  1294        if (!holder) return false;
  1295        if (holder.membership.holdsCarriagePeer(peerId)) return true;
  1296        const ident = peerIdentifierMap.get(peerId);
  1297        return ident !== undefined && holder.carriers().has(ident.slice(-64).toLowerCase());
  1298      };
  1299      // A REFOLD THAT DEMOTES CLOSES. When a refold reads a contracted socket's admit no longer held, or reads every
  1300      // carried Nexus PRIVATE under a stranger's socket, that socket would be silence at the gate today — so it is
  1301      // dropped the way the gate drops a refused one: no frame, no reason.
  1302      const dropNoLongerHeld = (): void => {
  1303        const holder = nexusMembershipHolder;
  1304        if (!holder) return;
  1305        const sockets = (network.sockets ?? {}) as Record<string, unknown>;
  1306        const admitted = Object.entries(sockets).map(([peerId, socket]) => ({ peerId, socket, cls: peerClassMap.get(peerId) }));
  1307        // One gate stands per Nexus, so each session answers to the posture of the Nexus whose gate seated it.
