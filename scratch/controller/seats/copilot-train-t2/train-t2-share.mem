   381        // stages until it has: the chain, the key file and the stage change only inside the claim below.
   382        await opts.placeFoundingCard.readBack({ seed: next.seed, digest: event.next, verifyingKey: next.verifyingKey }, reading.aid.slice(-16), reading.seq + 1);
   383        return await exclusiveCustody(async () => {
   384          if (existsSync(files.stage)) throw new Error("place-rotation-torn");
