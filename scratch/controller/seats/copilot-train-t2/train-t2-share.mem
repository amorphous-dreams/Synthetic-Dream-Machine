    97          await foundDirect({ ...at(r), entropy: entropy(1), placeFoundingCard: { readBack: async (c) => { card = new Uint8Array(c.seed); } } });
    98          const unread = await stageOnly(card, 77, false);
    99          await expect(reconcilePlaceRotation()).rejects.toThrow("place-rotation-torn");
   100          await expect(rotatePlace({ card, entropy: entropy(90), placeFoundingCard: { readBack: async () => {} } })).rejects.toThrow("place-rotation-torn");
   101          expect((await loadPlaceKelChain().catch(() => [])).length).toBe(0);   // the torn stage refuses every read until it is cleared
   102          rmSync(unread.path);
   103          expect((await loadPlaceKelChain()).length).toBe(1);
   104          const staged = await stageOnly(card, 78, true);
   105          await reconcilePlaceRotation();                                         // the restart's reconcile finishes the publish
   106          expect(existsSync(staged.path)).toBe(false);
   107          expect((await loadPlaceKelChain()).length).toBe(2);
   108          expect(await loadVesselVerifyingKey()).toBe(staged.event.key);
   109          // a stage naming an event the chain already holds finishes idempotently
   110          writeFileSync(staged.path, canonicalJson({ event: staged.event, signingKey: Buffer.from(new Uint8Array(32).fill(78)).toString("hex"), cardRead: true }));
   111          await expect(reconcilePlaceRotation()).resolves.toBeUndefined();
   112          expect(existsSync(staged.path)).toBe(false);
   113        });
   114      });
   115
