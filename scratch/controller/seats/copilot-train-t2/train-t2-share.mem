    80        const door = book.door(() => CHAIN);
    81        expect(await door({ op: "read", ask: "req-1", verb: "sealed-seal" })).toEqual({ refusal: "session-anchor-place" });
    82        expect(await door({ op: "sign", ask: "req-1", verb: "sealed-seal", payload })).toEqual({ refusal: "session-anchor-place" });
    83        expect(s.signed).toEqual([]);
    84      });
    85
    86      test("a lock, a close or a switch drops the signer, and the next ask refuses `signer-refused`", async () => {
