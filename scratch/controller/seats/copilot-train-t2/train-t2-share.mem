   711     * another key at this index refuses and moves nothing further.
   712     */
   713    async function commitRoot(handleIndex: number, keypair: PersistedKeypair): Promise<{ root: PersistedKeypair; wrote: boolean }> {
   714      const idDir = larIdentityDir();
   715      mkdirSync(idDir, { recursive: true, mode: 0o700 });
