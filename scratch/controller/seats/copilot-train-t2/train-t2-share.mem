   178
   179    /** A single 0o600 JSON keypair slot at `keyFile`; save() stamps the git-email hint. */
   180    function fileKeypairStore(keyFile: string, login: string | null): KeypairStore {
   181      return {
   182        async load() {
   183          if (!existsSync(keyFile)) return undefined;
   184          const raw = JSON.parse(readFileSync(keyFile, "utf8")) as PersistedKey;
   185          return { verifyingKey: raw.verifyingKey, signingKey: raw.signingKey };
   186        },
   187        async save(kp) {
   188          const persisted: PersistedKey = {
   189            verifyingKey: kp.verifyingKey,
   190            signingKey:   kp.signingKey,
   191            ...(login ? { gitEmail: login } : {}),
   192          };
   193          writeFileSync(keyFile, JSON.stringify(persisted, null, 2), { mode: 0o600, encoding: "utf8" });
   194          chmodSync(keyFile, 0o600);
   195        },
   196      };
   197    }
