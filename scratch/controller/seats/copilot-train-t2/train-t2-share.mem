   926            const unlicensed = memoryAskRefusal({ requestId, act, facts, ask: args["ask"], vesselVerifyingKey: faceAtom().key });
   927            if (unlicensed) throw new VerbRefusal("memory-ask-unlicensed", `[daemon] ${verb}: ${unlicensed}`);
   928            if (memoryAsked.has(requestId as string)) throw new VerbRefusal("memory-ask-spent", `[daemon] ${verb}: this island already answered that request; a fresh ask carries a fresh request id.`);
   929            memoryAsked.add(requestId as string);
   930          };
   931          /** The pair this island named for ONE import. The next `sealed-memory-door` replaces it; an import spends it. */
   932          let memoryDoor: MemoryKeypair | null = null;
   933          registry.register("sealed-memory-cut", async (args, context) => {
   934            const to = typeof args["to"] === "string" && /^[0-9a-f]{64}$/.test(args["to"]) ? args["to"] : null;
   935            // THE ACT'S ONE SHADOW READ. The vessel's main thread reads its own edge's shadow at the entry of a
   936            // backup's cut, before any row opens, and says so inside the ask it signs. The holder then reads none of
   937            // its own, so a raise that lands while the cut runs binds the next act. An ask that says nothing of a
   938            // read leaves the holder to read at its own entry.
   939            const shadowRead = args["shadow"] === MEMORY_CUT_SHADOW_READ;
   940            memoryAsk("sealed-memory-cut", "cut", shadowRead ? { to, shadow: MEMORY_CUT_SHADOW_READ } : { to }, args, context.invocation.requestId);
