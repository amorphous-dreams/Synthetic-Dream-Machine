   218    const leftNote = (bagId: string, reader: string): string => ownNote("left", bagId, reader);
   219    const digestsOf = (note: Uint8Array | null): string[] => {
   220      if (note === null || note.length % 32 !== 0) return [];
   221      const out: string[] = [];
   222      for (let at = 0; at < note.length; at += 32) out.push(hex(note.subarray(at, at + 32)));
