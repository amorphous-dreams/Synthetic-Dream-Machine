    14    function root() {
    15      const r = mkdtempSync(join(tmpdir(), "lar-place-rotation-"));
    16      cpSync(join(import.meta.dirname, "../../../genesis"), join(r, "genesis"), { recursive: true, filter: (s) => !s.endsWith("social-bootstrap.json") });
    17      roots.push(r); return r;
    18    }
    19    function entropy(start: number): RandomProvider {
    20      let n = start;
    21      return { getRandomValues<T extends Uint8Array<ArrayBuffer>>(a: T): T { for (let i = 0; i < a.length; i++) a[i] = n++ & 255; return a; }, randomUUID: () => "deterministic" };
    22    }
    23    const at = (r: string) => ({ storageDir: join(r, "data", "lares", "vessel"), genesisDir: join(r, "genesis") });
    24
    25    describe("place rotation", () => {
    26      test("a read-back rotates twice and a fresh read sees each committed head", async () => {
    27        const r = root(); let card = new Uint8Array();
    28        await withLarRoot(r, async () => {
    29          await foundDirect({ ...at(r), entropy: entropy(1), placeFoundingCard: { readBack: async (c) => { card = new Uint8Array(c.seed); } } });
    30          const old = (await vesselPlaceSignerDoor()).key;
    31          let next = new Uint8Array();
