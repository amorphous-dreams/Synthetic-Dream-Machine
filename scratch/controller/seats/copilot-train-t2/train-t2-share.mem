360     *
   361     * Causal-islands alignment: keypair generation runs as a device-local operation that
   362     * MUST complete before any Automerge doc opens. The verifyingKey flows into the
   363     * cold-boot ceremony which writes the IdentityTiddler into IdentitiesDoc via
   364     * direct handle.change() — not through the TW5 sync adaptor (wrong island).
   365     */
   366    /** A vessel key that could not mint: no custody stands open, so no founding holds this place. */
   367    export class VesselKeyMintRefused extends Error {
   368      override readonly name = "VesselKeyMintRefused";
   369      constructor(keyFile: string, cause: unknown) {
   370        super(
   371          `no vessel key stands at ${keyFile}, and a vessel key mints only inside a held custody (a founding seals its ` +
   372          `custody first, and the mint lands under its one claim): found the vessel with \`lares vessel found\` — ${cause instanceof Error ? cause.message : String(cause)}`,
   373          { cause },
   374        );
   375      }
   376    }
   377
   378    export async function generateOrLoadVesselIdentity(opts: { placeFoundingCard?: PlaceFoundingCard; entropy?: RandomProvider } = {}): Promise<VesselIdentity> {
   379      const idDir = identityDir();
   380      mkdirSync(idDir, { recursive: true });
   381
   382      // Keep both identity files beside the runtime store on every boot/init — the card
   383      // is re-mintable but still identity, and belongs beside its key.
   384      const keyFile  = join(idDir, KEY_FILE);
   385      const base     = fileKeypairStore(keyFile);
   386      if (existsSync(join(idDir, STAGED_FILE))) await reconcilePlaceRotation();
   387
   388      // THE MINT: the inception, then the key file, and THE KEY FILE COMMITS THE MINT. Both land inside ONE hold of the
   389      // custody claim (`exclusiveCustody`), the same claim every sealed write in every process takes, so two racing acts
   390      // never interleave: the first lands both files, and the later act meets the key that stands, writes nothing and
   391      // answers that key. A mint runs only inside a held custody and refuses by name outside one, before any byte lands:
   392      // a founding seals its custody first (`lares vessel found`), so the place's key mints inside the act that holds
   393      // its custody open. A key file that stands always stands beside the inception that names it; an act that stops
   394      // between the two leaves an inception no key answers to, and the next mint writes it afresh.
   395      let lostTo: PersistedKeypair | undefined;
   396      const kelFile = join(idDir, KEL_FILE);
   397      const minting: KeypairStore = {
   398        load: () => base.load(),
   399        async save(keypair) {
   400          try { await openedCustody(); } catch (err) { throw new VesselKeyMintRefused(keyFile, err); }
   401          // THE CARD READS BACK BEFORE THE CLAIM: a read-back may ask the custody its own questions (a staged root's stand-in
   402          // proves the test route), and the claim admits one holder. Nothing lands until the card reads back.
   403          const seed = signingSeedFromHex(keypair.signingKey);
   404          let inception: PlaceKelEvent;
   405          try {
   406            const card: PlaceFoundingCard | null = opts.placeFoundingCard ?? ((await readBackStandsIn()) ? { readBack: async () => {} } : null);
   407            if (card === null) throw new PlaceFoundingCardUnread();
   408            inception = (await armPlaceInception({ signerSeed: seed, card, ...(opts.entropy ? { entropy: opts.entropy } : {}) })).event;
   409          } finally { seed.fill(0); }
   410          const committed = await exclusiveCustody(async () => {
   411            if (existsSync(keyFile)) return false;
   412            publishFile(kelFile, canonicalJson([inception]));
   413            const persisted: PersistedKey = { verifyingKey: keypair.verifyingKey, signingKey: keypair.signingKey };
   414            publishFile(keyFile, JSON.stringify(persisted, null, 2));
   415            return true;
   416          });
   417          if (committed) return;
   418          lostTo = await base.load();   // another act's key stands: this act's keypair goes nowhere
   419          if (!lostTo) throw new VesselKeyMintRefused(keyFile, new Error("the key another act landed vanished before this act read it; run the founding again"));
   420        },
   421      };
   422      const crypto = opts.entropy ? { generate: async () => {
   423        const seed = new Uint8Array(32);
   424        opts.entropy!.getRandomValues(seed);
   425        try { const signingKey = hex(seed); return { signingKey, verifyingKey: verifyingKeyOfSeed(signingKey) }; }
   426        finally { seed.fill(0); }
   427      } } : nodeKeypairCrypto;
   428      const minted = await generateOrLoadKeypair(minting, crypto);
   429      const verifyingKey = lostTo ? lostTo.verifyingKey : minted.verifyingKey;
   430      const created = minted.created && !lostTo;
   431
   432      if (!created) {
   433        // A standing key proves itself by its own inception, or the act refuses by name and writes nothing.
   434        const standing = JSON.parse(readFileSync(keyFile, "utf8")) as PersistedKey;
   435        if (standing.verifyingKey !== verifyingKey) throw new VesselInceptionRefused(kelFile, "names-another-key");
   436        proveStandingKey(kelFile, standing);
   437        console.log("[vessel-identity] loaded keypair");
   438      } else {
   439        console.log("[vessel-identity] generated place signer and armed KEL");
   440      }
   441
   442      const base2: VesselIdentity = { verifyingKey };
   443      const displayName = await readOperatorDisplayName();
   444      return displayName ? { ...base2, displayName } : base2;
   445    }
   446
   447    /**
   448     * The vessel's identity as a BOOT reads it: the public key off the key file and the display name off git config.
   449     * Load-only. A boot mints no key (a key mints only inside a held custody, and a boot holds none), so a vessel
   450     * with no key file refuses here by name and points at the founding.
   451     */
   452    export async function loadVesselIdentity(): Promise<VesselIdentity> {
   453      const verifyingKey = await loadVesselVerifyingKey();
   454      const displayName = await readOperatorDisplayName();
   455      return displayName ? { verifyingKey, displayName } : { verifyingKey };
   456    }
   457
   458    /**
   459     * Load the operator's 32-byte Ed25519 SIGNING seed (private key bytes).
   460     *
   461     * Separate from `generateOrLoadVesselIdentity` — that function returns only
   462     * the public verifying key (sufficient for IdentityTiddler), while this one
   463     * surfaces the private seed needed by KeyhiveProvider.init({ seed }) and any
   464     * other capability layer that signs on the operator's behalf.
   465     *
   466     * SECURITY: the returned bytes ARE the operator's private signing key. Treat
   467     * with care: don't log it, don't write it anywhere outside the vessel-identity
   468     * file, and don't pass it across process boundaries that aren't already
   469     * inside the operator's trust domain.
   470     *
   471     * Throws when no key file exists — caller must call
   472     * `generateOrLoadVesselIdentity()` first to ensure one is on disk.
   473     */
   474    /**
   475     * Load the operator's hex-encoded Ed25519 PUBLIC verifying key from disk, proven: the file's seed derives it and
   476     * its inception signs it (`proveStandingKey`; one key derivation and one signature check). Returns the same
   477     * `verifyingKey` field generateOrLoadVesselIdentity surfaces, without regenerating if missing.
   478     *
   479     * Used by the CLI to populate verb-tiddler `requested-by` with a
   480     * Keyhive-recognizable DID (`0x` + verifyingKey hex). Throws when no key
   481     * file exists, and refuses `VesselInceptionRefused` by name where the key fails its proof.
   482     */
   483    export async function loadVesselVerifyingKey(): Promise<string> {
   484      await reconcilePlaceRotation();
   485      const keyFile = join(identityDir(), KEY_FILE);
   486      if (!existsSync(keyFile)) {
   487        throw new Error(
   488          `[vessel-identity] no key file at ${keyFile} — run \`lares vessel found\` first to generate the keypair`,
   489        );
   490      }
   491      const raw = JSON.parse(readFileSync(keyFile, "utf8")) as PersistedKey;
   492      if (typeof raw.verifyingKey !== "string" || raw.verifyingKey.length !== 64) {
   493        throw new Error(`[vessel-identity] malformed verifyingKey in ${keyFile}`);
   494      }
   495      proveStandingKey(join(identityDir(), KEL_FILE), raw);
   496      return raw.verifyingKey;
   497    }
   498
   499    async function loadVesselSigningSeed(): Promise<Uint8Array> {
   500      await reconcilePlaceRotation();
   501      const keyFile = join(identityDir(), KEY_FILE);
   502      if (!existsSync(keyFile)) {
   503        throw new Error(
   504          `[vessel-identity] no key file at ${keyFile} — run \`lares vessel found\` first to generate the keypair`,
   505        );
   506      }
   507      const raw = JSON.parse(readFileSync(keyFile, "utf8")) as PersistedKey;
   508      if (typeof raw.signingKey !== "string" || raw.signingKey.length !== 64) {
   509        throw new Error(`[vessel-identity] malformed signingKey in ${keyFile}`);
   510      }
   511      proveStandingKey(join(identityDir(), KEL_FILE), raw);
   512      return signingSeedFromHex(raw.signingKey);
   513    }
   514
   515    /** Open only the five framed place duties after proving the key at the current KEL head. */
   516    export async function vesselPlaceSignerDoor(): Promise<PlaceSigner> {
   517      const seed = await loadVesselSigningSeed();
   518      try { return placeSignerFromSeed(seed); }
   519      finally { seed.fill(0); }
   520    }
   521
