   972    /** Read an index-map row, change it, and write it under one custody holder. */
   973    function changeIndexMap<T>(
   974      file: string, field: string, shaped: (entry: unknown) => entry is T, change: (map: Record<string, T>) => void,
   975    ): Promise<void> {
   976      mkdirSync(larIdentityDir(), { recursive: true, mode: 0o700 });
   977      return updateCustodyRow("identity", file, (bytes) => {
   978        const map = parseIndexMap(bytes, file, field, shaped);
   979        change(map);
   980        return { plaintext: encodeRow({ [field]: map }), value: undefined };
