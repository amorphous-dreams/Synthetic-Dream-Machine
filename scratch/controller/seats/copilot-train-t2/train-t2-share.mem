   438        async save(keypair) {
   439          try { await openedCustody(); } catch (err) { throw new VesselKeyMintRefused(keyFile, err); }
   440          // THE CARD READS BACK BEFORE THE CLAIM: a read-back may ask the custody its own questions (a staged root's stand-in
   441          // proves the test route), and the claim admits one holder. Nothing lands until the card reads back.
   442          const seed = signingSeedFromHex(keypair.signingKey);
