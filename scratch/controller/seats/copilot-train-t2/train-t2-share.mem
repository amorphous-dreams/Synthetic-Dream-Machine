   275      /** A seal paused inside its signer's first signature while a raise is counted and its roll arrives (the train's Sol
   276       *  read, 2026-10-31): the seal must not commit under a key the removed reader holds. */
   277      async function raceDuringSeal(founding: boolean, raiseLands: boolean) {
   278        const { group, devices: [f, , c] } = await fleet(founding ? 0x50 : 0x52, ["f", "b", "c"]);
   279        const before = founding ? null : await seal(f!, "sealed while c stood");
   280        if (before) await carry(f!, c!);
   281        let paused!: () => void, resume!: () => void;
   282        const atFirstSign = new Promise<void>((r) => { paused = r; });
   283        const release = new Promise<void>((r) => { resume = r; });
   284        let signs = 0;
   285        const slow: RecordSigner = { certificate: f!.signer.certificate, async sign(purpose, payload) { if (++signs === 1) { paused(); await release; } return f!.signer.sign(purpose, payload); } };
   286        const sealing = f!.seat.seal({ bagId: BAG, plaintext: utf8Bytes("private after removal"), signer: slow });
   287        await atFirstSign;
   288        let rolling: Promise<string> = Promise.resolve("none");
   289        if (raiseLands) {
   290          f!.raises.add("raise-race");
   291          f!.standing.set(bare(c!.id), "aside");
   292          f!.signs = false;
   293          rolling = f!.seat.sink({ kind: "seat-roll", scope: SCOPE, edgeId: "edge-c", raiseCids: ["raise-race"], how: "revoked", seat: { group, member: c!.id } } as never).then(() => "settled", () => "owed");
   294        }
   295        resume();
   296        const sealed = await sealing;
   297        await rolling;
   298        let removedOpens = "nothing sealed";
   299        if (!("refusal" in sealed)) { await carry(f!, c!); removedOpens = await opens(c!, sealed.body.ref); }
   300        return { sealed, removedOpens, before };
   301      }
