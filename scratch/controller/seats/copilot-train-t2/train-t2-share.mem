1    import { sha256BytesSync, utf8Bytes } from "./crypto.js";
     2
     3    export class FaceScopedIdError extends Error {
     4      override readonly name = "FaceScopedIdError";
     5    }
     6
     7    /** Namespace a caller's request or effect key under its verified proof subject. */
     8    export function faceScopedId(proofSubject: string, id: string): string {
     9      if (typeof proofSubject !== "string" || !proofSubject) throw new FaceScopedIdError("proof subject required");
    10      if (typeof id !== "string" || !id) throw new FaceScopedIdError("id required");
    11      const prefix = Array.from(sha256BytesSync(utf8Bytes(proofSubject)).subarray(0, 16),
    12        (byte) => byte.toString(16).padStart(2, "0")).join("");
    13      return `${prefix}-${id}`;
    14    }
