1    /**
     2     * scratch-custody-setup — the node suites' custody, seated when a row first needs it (a vitest setup file).
     3     *
     4     * A vessel's private rows rest sealed under its vessel key, and a vessel key mints only inside a held custody. A
     5     * suite that drives a node function in its own process stands where a `lares` command stands with no vessel
     6     * running: the command seats a holder for its act and opens it at the first sealed row (`offline-custody`, on a
     7     * terminal). A suite holds no terminal, so this file names the same when-needed seat with a scratch route: at the
     8     * first sealed row under a root, it founds that root's custody under a synthetic passphrase, or opens the custody
     9     * a fixture already founded there under that same passphrase.
    10     *
    11     * ── SCRATCH ROOTS ALONE ─────────────────────────────────────────────────────────────────────────
    12     * The opener refuses unless all three custody homes (identity, storage, seal) resolve under the operating system's
    13     * temp directory, so no suite ever founds or opens a custody in a home a person keeps. The passphrases guard
    14     * nothing: a tree a suite founded here answers the first, and a root a harness tool staged
    15     * (`tools/seed-test-custody.mjs`) answers the published test route.
    16     *
    17     * A suite that proves the FLOOR seats its own holder and locks it (`custody-seat-fixture`), or clears every seat
    18     * with `seatCustody(null)`; an explicit seat for a home always answers ahead of this one.
    19     */
    20    import { mkdirSync, realpathSync } from "node:fs";
    21    import { tmpdir } from "node:os";
    22    import { basename, dirname, join, resolve, sep } from "node:path";
    23    import { beforeEach } from "vitest";
    24    import { FsCustodyIo } from "../../src/custody-io.js";
    25    import { custodyTreeStands, foundCustody } from "../../src/custody-session.js";
    26    import { makeCustodyHolder, seatFaceAutoFounder, type CustodyHolder } from "../../src/custody-holder.js";
    27    import { seatCustodyWhenNeeded } from "../../src/custody-seat.js";
    28    import { vesselCustodyHomes } from "../../src/vault-carriers.js";
    29
    30    // The suites read no person's git config: the vessel's display name reads the global user.name, and a person's own
    31    // config would move what a suite sees. The null device gives every suite, and every child it spawns, the same empty
    32    // global.
    33    process.env.GIT_CONFIG_GLOBAL = "/dev/null";
    34
    35    /** The synthetic route (the seat fixture founds under the same string, so either opens the other's tree). */
    36    export const SCRATCH_PASSPHRASE = "⟨test passphrase: published fixture, withheld from canon⟩";
    37    /** The published test route a harness tool binds a staged root to (`tools/test-custody-route.mjs` spells it). */
    38    const STAGED_ROUTE_PASSPHRASE = "⟨test passphrase: published fixture, withheld from canon⟩";
    39
    40    // A write to a face the floor index does not name founds that face under the scratch route, in every suite: the product
    41    // founds each face by its own act and seats no such policy.
    42    seatFaceAutoFounder(() => [{ t: 1, pins: [{ kind: "passphrase", passphrase: SCRATCH_PASSPHRASE }] }]);
    43
    44    /** Thrown when a suite reaches a sealed row outside a scratch root. */
    45    export class ScratchCustodyRefused extends Error {
    46      override readonly name = "ScratchCustodyRefused";
    47    }
    48
    49    /**
    50     * Whether `dir` resolves under the temp directory once every link on its path resolves. A home that does not stand
    51     * yet resolves through its nearest standing parent, so a link above it that points out of temp reads as outside.
    52     */
    53    function underTemp(dir: string): boolean {
    54      const real = (p: string): string => {
    55        let at = resolve(p);
    56        const rest: string[] = [];
    57        for (;;) {
    58          try { return rest.length ? join(realpathSync(at), ...rest) : realpathSync(at); } catch { /* not standing: climb */ }
    59          const parent = dirname(at);
    60          if (parent === at) return resolve(p);
    61          rest.unshift(basename(at));
    62          at = parent;
    63        }
    64      };
    65      const temp = real(tmpdir());
    66      const at = real(dir);
    67      return at !== temp && at.startsWith(temp + sep);
    68    }
    69
    70    async function openScratch(holder: CustodyHolder): Promise<void> {
    71      const { identity, storage, seal } = holder.homes;
    72      if (![identity, storage, seal].every(underTemp)) {
    73        throw new ScratchCustodyRefused(
    74          `a suite reached a sealed row whose custody homes stand at ${identity}, ${storage} and ${seal}: the scratch custody founds and opens only under ${tmpdir()}`,
    75        );
    76      }
    77      const io = new FsCustodyIo(holder.homes);
    78      const slots = [{ t: 1, pins: [{ kind: "passphrase" as const, passphrase: SCRATCH_PASSPHRASE }] }];
    79      if (!(await custodyTreeStands(io, holder.homes))) {
    80        mkdirSync(holder.homes.identity, { recursive: true, mode: 0o700 });
    81        const founded = await foundCustody({ io, homes: holder.homes, slots });
    82        await holder.adopt(founded.treeKey);
    83        founded.treeKey.fill(0);
    84        return;
    85      }
    86      const u = await holder.unlock([
    87        { kind: "passphrase", passphrase: SCRATCH_PASSPHRASE },
    88        { kind: "passphrase", passphrase: STAGED_ROUTE_PASSPHRASE },
    89      ]);
    90      if (u.reading !== "opens" && u.reading !== "already-unlocked") {
    91        throw new ScratchCustodyRefused(`the custody standing at ${identity} reads ${u.reading} under the scratch routes`);
    92      }
    93      // The scratch routes try every face tree too (`--all`): a face they do not fit stays shut.
    94      await holder.unlockFaces([
    95        { kind: "passphrase", passphrase: SCRATCH_PASSPHRASE },
    96        { kind: "passphrase", passphrase: STAGED_ROUTE_PASSPHRASE },
    97      ]);
    98    }
    99
   100    function arm(): void {
   101      seatCustodyWhenNeeded(() => {
   102        const homes = vesselCustodyHomes();
   103        return makeCustodyHolder({ io: new FsCustodyIo(homes), homes });
   104      }, openScratch);
   105    }
   106
   107    arm();
   108    beforeEach(arm);
