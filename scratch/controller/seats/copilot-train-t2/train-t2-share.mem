   124    // the vessel's book answers from that session's signer, which signs here, behind its owner's table. The DAEMON island's
   125    // channel alone carries the ask: a wiki island's refuses by name.
   126    export type SessionSignDoor = (ask: Pick<IslandMsg_SessionSign, "op" | "ask" | "verb" | "payload">) => Promise<
   127      { readonly certificate: unknown; readonly subject: string; readonly chain: import("@lararium/mesh").SessionOwnChain } | { readonly signature: string } | { readonly refusal: string }>;
   128    let sessionSignDoor: SessionSignDoor | null = null;
   129
   130    /** Stand (or drop) the vessel's session sign door. */
   131    export function setSessionSignDoor(door: SessionSignDoor | null): void { sessionSignDoor = door; }
   132
   133    /** Answer one `session:sign` ask through the door standing now; no door, a malformed ask or a fault each refuse by name. */
   134    export async function answerSessionSign(ask: Partial<IslandMsg_SessionSign> & { requestId: string }): Promise<IslandMsg_SessionSigned> {
   135      const base = { type: "session:signed" as const, requestId: ask.requestId };
   136      if ((ask.op !== "read" && ask.op !== "sign") || typeof ask.ask !== "string" || typeof ask.verb !== "string" ||
   137          (ask.op === "sign" && !(ask.payload instanceof Uint8Array))) return { ...base, refusal: "signer-unavailable" };
   138      const door = sessionSignDoor;
   139      if (!door) return { ...base, refusal: "signer-unavailable" };
   140      try {
   141        const answer = await door({ op: ask.op, ask: ask.ask, verb: ask.verb, ...(ask.payload ? { payload: ask.payload } : {}) });
   142        return { ...base, ...answer } as IslandMsg_SessionSigned;
   143      } catch { return { ...base, refusal: ask.op === "sign" ? "signer-refused" : "signer-unavailable" }; }
   144    }
