    43      test("RED: a standing door's place reading keys on the KEL's bytes: unchanged, it re-verifies nothing; a git config change moves no anchor; a rotation moves the head", async () => {
    44        const r = root(); let card = new Uint8Array();
    45        const gitConfig = join(r, "gitconfig");
    46        writeFileSync(gitConfig, "[user]\n\temail = first.login@example.invalid\n");
    47        const prior = process.env["GIT_CONFIG_GLOBAL"];
    48        process.env["GIT_CONFIG_GLOBAL"] = gitConfig;
    49        try {
    50          await withLarRoot(r, async () => {
    51            await foundDirect({ ...at(r), entropy: entropy(1), placeFoundingCard: { readBack: async (c) => { card = new Uint8Array(c.seed); } } });
    52            const watch = placeReadingWatch();
    53            const first = await watch();
    54            expect(first).toEqual(await loadPlaceReading());
    55            expect(await watch()).toBe(first);                                    // the same reading: the unchanged KEL verified once
    56            // The operator's git config moves: no custody name reads it, so a fresh read and the door both stand on one KEL.
    57            writeFileSync(gitConfig, "[user]\n\temail = another.login@example.invalid\n");
    58            expect(await loadPlaceReading()).toEqual(first);
    59            expect(await watch()).toBe(first);
    60            await rotatePlace({ card, entropy: entropy(90), placeFoundingCard: { readBack: async () => {} } });
    61            const rotated = await watch();
    62            expect(rotated.place).toBe(first.place);
    63            expect(rotated.seq).toBe(first.seq + 1);
    64            expect(rotated.head).not.toBe(first.head);                           // the rotation moved the head the door reads
    65          });
    66        } finally { if (prior === undefined) delete process.env["GIT_CONFIG_GLOBAL"]; else process.env["GIT_CONFIG_GLOBAL"] = prior; }
    67      });
