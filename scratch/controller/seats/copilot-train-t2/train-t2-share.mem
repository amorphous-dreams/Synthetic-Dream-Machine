    99            ".persona-enroll-pending.json": "{}", ".persona-grant-pending.json": "{}", ".persona-admissions.json": "{}",
   100            [`faces/${"ab".repeat(16)}/face-address-secret-g${"5e".repeat(32)}.bin`]: "x", [`faces/${"ab".repeat(16)}/fleet-join-pending-g${"6e".repeat(32)}.json`]: "{}", [`faces/${"ab".repeat(16)}/face-join-record-g${"6f".repeat(32)}.json`]: "{}",
   101          });
   102          // A row the table names by a digest reads under its name with that digest.
   103          expect([...rows.values()].map((r) => r.row).sort()).toEqual(RELATION_ROWS);
   104          for (const r of rows.values()) expect(r, r.name).toMatchObject({ keyClass: "relation", custody: ["face-address-secret", "face-join-record", "fleet-join-pending"].includes(r.row) ? "face-hot" : "hot" });
   105        } finally { v.drop(); }
