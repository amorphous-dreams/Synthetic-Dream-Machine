  1356            // durability floor sits BEFORE `runVerb`/`placeVerb` below, never after.
  1357            let verdict: Awaited<ReturnType<typeof ledger.arbitrate>>;
  1358            try {
  1359              verdict = await ledger.arbitrate(requestId, inputDigest, inv.face, inv.verb, inv.effectKey);
  1360            } catch (error) {
  1361              // THE LEDGER FAILED BEFORE ANY DISPATCH (a flush that rejects mid-arbitration): nothing ran, and the caller
  1362              // hears a fixed code under its own requestId; the detail stays in this vessel's log.
  1363              log(`receipt-fact ledger failed for ${requestId}: ${error instanceof Error ? error.message : String(error)}`);
  1364              if (sessionRequestId !== undefined) { sessionRefuse(sock, "session-fault", sessionRequestId); onSessionReply?.(); }
  1365              else fail("this vessel could not record the request durably; nothing ran", "ledger-unwritten");
  1366              return;
  1367            }
  1368            if (verdict.verdict === "refuse" && verdict.reason === "already-committed") {
  1369              // A genuine concurrent re-read of an id THIS process already dispatched OR a same-digest
  1370              // dispatch attempt reaching a fact a PRIOR process already drove to `done`/`error` (H1R,
  1371              // across a restart) — answer the existing outcome, never a second `placeVerb`.
  1372              awaitOutcome(inv.verb, requestId, inv.timeoutMs).then(
  1373                (outcome) => { respond(outcome); },
  1374                (err)     => { if (err instanceof VesselWaitExpired) return answerUnknown(requestId); fail(err instanceof Error ? err.message : String(err)); },
  1375              );
  1376              return;
  1377            }
  1378            if (verdict.verdict === "refuse") {
  1379              const why = verdict.reason === "abandoned"
  1380                ? `this vessel already refused request ${requestId} before commit — mint a fresh request id`
  1381                : verdict.reason === "interrupted"
  1382                ? `this vessel stopped while request ${requestId} ran — it may have landed in part; mint a fresh request id`
  1383                : verdict.reason === "retention-gap"
  1384                ? `this vessel's receipt ring evicted request ${requestId} before it could be re-read — mint a fresh request id`
  1385                : verdict.reason === "receipt-fact-torn"
  1386                ? `this vessel's receipt for request ${requestId} is unreadable — mint a fresh request id`
  1387                : `request ${requestId} was already used with different arguments — mint a fresh request id`;
  1388              return fail(why, verdict.reason);
  1389            }
  1390            runVerb(inv, requestId).then(
  1391              (outcome) => { respond(outcome); },
  1392              (err) => {
  1393                if (err instanceof VesselWaitExpired) return answerUnknown(requestId); // M2: never told as {status:"error"}
  1394                fail(err instanceof Error ? err.message : String(err));
  1395              },
  1396            );
  1397          })().catch((error: unknown) => {
  1398            // A fault before the arbitrate (the digest, or an abandonment's own record) dispatched nothing either; the
  1399            // caller hears a fixed code under its own requestId, and the detail stays in this vessel's log.
  1400            log(`invocation ${requestId} faulted before dispatch: ${error instanceof Error ? error.message : String(error)}`);
  1401            if (sessionRequestId !== undefined) { sessionRefuse(sock, "session-fault", sessionRequestId); onSessionReply?.(); }
  1402            else fail("this vessel faulted before dispatch; nothing ran", "ledger-unwritten");
  1403          }).finally(() => { arbitrating -= 1; if (idle()) drained?.(); }); }));
  1404      };
  1405
  1406      return {
  1407        handle,
  1408        handleSessionFrame: queueSession,
  1409        close: async () => {
  1410          closing = true;
  1411          for (const [sock, state] of sessionSockets) {
  1412            if (state.sessionId) table.close(state.sessionId);
  1413            state.signer?.drop();
  1414            sock.end();
  1415          }
```

