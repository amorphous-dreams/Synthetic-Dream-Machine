   123    /**
   124     * THE SESSION SIGN DOOR, worker side (`island-session-proof.ts`). The island names the invocation a session placed; the
   125     * vessel answers from that session: its certificate, its proof subject and the vessel's own verified chain, and each
   126     * signature on ask, signed on the main thread behind the owner's table. No answer inside this side's patience reads
   127     * as a refusal by name, never as a signer: the island holds no key to fall back on.
   128     */
   129    export function vesselSessionDoor(port: { postMessage(msg: unknown): void; on(ev: "message", fn: (m: unknown) => void): void }, patienceMs: number = DOC_REST_PATIENCE_MS): IslandSessionProof {
   130      const pending = new Map<string, (answer: IslandMsg_SessionSigned | null) => void>();
   131      port.on("message", (raw: unknown) => {
   132        const m = raw as Partial<IslandMsg_SessionSigned> | null;
   133        if (!m || m.type !== "session:signed" || typeof m.requestId !== "string") return;
   134        const settle = pending.get(m.requestId);
   135        if (!settle) return;
   136        pending.delete(m.requestId);
   137        settle(m as IslandMsg_SessionSigned);
   138      });
   139      let seq = 0;
   140      const askVessel = (op: "read" | "sign", ask: { requestId: string; verb: string }, payload?: Uint8Array): Promise<IslandMsg_SessionSigned | null> => new Promise((resolve) => {
   141        const requestId = `session-sign-${process.pid}-${++seq}`;
   142        const timer = setTimeout(() => { pending.delete(requestId); resolve(null); }, patienceMs);
   143        timer.unref?.();
   144        pending.set(requestId, (answer) => { clearTimeout(timer); resolve(answer); });
   145        const msg: IslandMsg_SessionSign = { type: "session:sign", requestId, op, ask: ask.requestId, verb: ask.verb, ...(payload ? { payload } : {}) };
   146        try { port.postMessage(msg); } catch { pending.delete(requestId); clearTimeout(timer); resolve(null); }
   147      });
   148      return {
   149        async signer(ask): Promise<SessionReading> {
   150          if (ask === null) return { refusal: "signer-unavailable" };
   151          const read = await askVessel("read", ask);
   152          if (read === null) return { refusal: "signer-unavailable" };
   153          if ("refusal" in read) return { refusal: read.refusal };
   154          if (!("certificate" in read)) return { refusal: "signer-unavailable" };
   155          const certificate = read.certificate as never;
