1    /**
     2     * session-sign-door — the vessel's book answers the daemon island from the session that placed one call, and from no
     3     * other: its certificate, its subject and the vessel's own chain, then each signature, signed on this thread.
     4     *
     5     * Canon: lar:///ha.ka.ba/lararium/mesh/sealed-store#/the-store
     6     */
     7    import { describe, expect, test } from "vitest";
     8    import { SessionSignBook } from "../src/session-sign-door.js";
     9    import { answerSessionSign, setSessionSignDoor } from "../src/worker-handle.js";
    10    import type { UdsSessionSigner } from "../src/uds-channel.js";
    11
    12    const CHAIN = { scope: { faceKey: "aa".repeat(32), nexus: "nexus-one" }, vesselFaceKey: "bb".repeat(32) };
    13    const NEXUS = { kind: "nexus" as const, aid: "nexus-one" };
    14    const PLACE = { kind: "place" as const, aid: "place-one", head: "head-one" };
    15
    16    function signer(): UdsSessionSigner & { signed: Uint8Array[] } {
    17      const signed: Uint8Array[] = [];
    18      let dropped = false;
    19      return {
    20        signed,
    21        get dropped() { return dropped; },
    22        drop() { dropped = true; },
    23        certificate: { scope: CHAIN.scope, vesselFaceKey: CHAIN.vesselFaceKey, sessionKey: "cc".repeat(32) },
    24        async sign(purpose, payload) {
    25          if (dropped) return { refusal: "signer-dropped" };
    26          signed.push(payload);
    27          return { signature: `sig-${purpose}-${payload.length}` };
    28        },
    29      };
    30    }
    31    const payload = new Uint8Array([1, 2, 3]);
    32
    33    describe("the session sign door answers from the session that placed the call", () => {
    34      test("a Nexus session's booked call reads its certificate, subject and the vessel's own chain, and signs on this thread", async () => {
    35        const book = new SessionSignBook();
    36        const s = signer();
    37        const release = book.hold("req-1", "sealed-seal", { signer: s, anchor: NEXUS, subject: "subject-1" });
    38        const door = book.door(() => CHAIN);
    39        expect(await door({ op: "read", ask: "req-1", verb: "sealed-seal" })).toEqual({ certificate: s.certificate, subject: "subject-1", chain: CHAIN });
    40        expect(await door({ op: "sign", ask: "req-1", verb: "sealed-seal", payload })).toEqual({ signature: "sig-act-3" });
    41        expect(s.signed).toEqual([payload]);
    42        release();
    43        expect(book.size).toBe(0);
    44      });
    45
    46      test("an ask no session booked, or one naming another verb under a booked id, borrows no signer", async () => {
    47        const book = new SessionSignBook();
    48        const s = signer();
    49        book.hold("req-1", "sealed-open", { signer: s, anchor: NEXUS, subject: "subject-1" });
    50        const door = book.door(() => CHAIN);
    51        expect(await door({ op: "sign", ask: "req-2", verb: "sealed-open", payload })).toEqual({ refusal: "signer-unavailable" });
    52        expect(await door({ op: "sign", ask: "req-1", verb: "sealed-seal", payload })).toEqual({ refusal: "signer-unavailable" });
    53        expect(s.signed).toEqual([]);
    54      });
    55
    56      test("a second call under a booked id books nothing: the in-flight call keeps its own session's signer", async () => {
    57        const book = new SessionSignBook();
    58        const first = signer(), second = signer();
    59        book.hold("req-1", "sealed-seal", { signer: first, anchor: NEXUS, subject: "subject-1" });
    60        const releaseSecond = book.hold("req-1", "sealed-seal", { signer: second, anchor: NEXUS, subject: "subject-2" });
    61        const door = book.door(() => CHAIN);
    62        expect(await door({ op: "read", ask: "req-1", verb: "sealed-seal" })).toMatchObject({ subject: "subject-1" });
    63        await door({ op: "sign", ask: "req-1", verb: "sealed-seal", payload });
    64        releaseSecond();
    65        expect(await door({ op: "read", ask: "req-1", verb: "sealed-seal" })).toMatchObject({ subject: "subject-1" });
    66        expect([first.signed.length, second.signed.length]).toEqual([1, 0]);
    67      });
    68
    69      test("a released call answers nothing more: the booking lives for the call alone", async () => {
    70        const book = new SessionSignBook();
    71        const release = book.hold("req-1", "sealed-seal", { signer: signer(), anchor: NEXUS, subject: "subject-1" });
    72        release();
    73        expect(await book.door(() => CHAIN)({ op: "read", ask: "req-1", verb: "sealed-seal" })).toEqual({ refusal: "signer-unavailable" });
    74      });
    75
    76      test("a place session reaches no sealed store: `session-anchor-place`, and it signs nothing", async () => {
    77        const book = new SessionSignBook();
