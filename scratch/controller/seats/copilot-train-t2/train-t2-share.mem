   685     */
   686    function parseRootRow(bytes: Uint8Array, file: string): PersistedKeypair {
   687      const raw = objectOf(parseRow(bytes, file), file);
   688      const verifyingKey = raw["verifyingKey"];
   689      const signingKey = raw["signingKey"];
   690      if (typeof verifyingKey !== "string" || !HEX64.test(verifyingKey) || typeof signingKey !== "string" || !HEX64.test(signingKey)) throw malformed(file);
