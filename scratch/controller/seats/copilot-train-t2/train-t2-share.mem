   485    /**
   486     * The vessel's identity as a BOOT reads it: the public key off the key file and the display name off git config.
   487     * Load-only. A boot mints no key (a key mints only inside a held custody, and a boot holds none), so a vessel
   488     * with no key file refuses here by name and points at the founding.
   489     */
   490    export async function loadVesselIdentity(): Promise<VesselIdentity> {
   491      const verifyingKey = await loadVesselVerifyingKey();
   492      const hint = await readLocalOperatorHint().catch(() => ({ login: null, displayName: null }));
   493      return hint.displayName ? { verifyingKey, displayName: hint.displayName } : { verifyingKey };
