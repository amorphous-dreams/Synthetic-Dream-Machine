   956    function parseIndexMap<T>(bytes: Uint8Array | null, file: string, field: string, shaped: (entry: unknown) => entry is T): Record<string, T> {
   957      const out: Record<string, T> = Object.create(null) as Record<string, T>;
   958      if (bytes === null) return out;
   959      const map = objectOf(objectOf(parseRow(bytes, file), file)[field], file);
