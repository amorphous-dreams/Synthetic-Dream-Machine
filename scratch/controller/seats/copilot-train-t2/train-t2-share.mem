   220    /**
   221     * THE CUSTODY WRITE DOOR, worker side. Workers hold bytes to seal but never the vessel key; the vessel seals the
   222     * named carrier and answers on the same request id. A refusal or silence rejects without exposing the bytes.
   223     */
   224    export function vesselCustodyWriter(port: { postMessage(msg: unknown): void; on(ev: "message", fn: (m: unknown) => void): void }, patienceMs: number = DOC_REST_PATIENCE_MS): (carrier: CustodyWriteCarrier, bytes: Uint8Array) => Promise<void> {
