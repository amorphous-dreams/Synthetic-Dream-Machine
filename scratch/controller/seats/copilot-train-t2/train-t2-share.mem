   216        for (const [file, shapes, readDoor, writeDoor] of cases) {
   217          // What stood before this row's cases returns after them, so each row's refusal names that row alone.
   218          const before = existsSync(at(file)) ? read(file) : null;
   219          for (const shape of shapes) {
