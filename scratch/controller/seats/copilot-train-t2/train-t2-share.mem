     9    /** The vessel's answer to a worker's `cas:want` — verified bytes, or null (a miss stays a miss). */
    10    export type CasDoor = (cid: string) => Promise<Uint8Array | null>;
    11
    12    // THE FETCH DOOR, vessel side. ONE cid plane per vessel, so ONE door: the daemon island and each wiki island ask
    13    // through it (a session island reaches no vessel door). `null` (the boot default) answers every ask with a
    14    // miss at once — a worker's resolver then degenerates to its local read, exactly as before the door stood.
    15    let casDoor: CasDoor | null = null;
    16
    17    /** Stand (or drop) the vessel's fetch door. Set once the transport stands; cleared at close. */
    18    export function setCasDoor(door: CasDoor | null): void { casDoor = door; }
    19
    20    /** Ask the vessel's fetch door for the bytes a cid names. No door standing, or a faulting one, reads as a miss. */
    21    export function fetchThroughCasDoor(cid: string): Promise<Uint8Array | null> {
    22      const door = casDoor;
    23      return door ? door(cid).catch(() => null) : Promise.resolve(null);
    24    }
    25
    26    /** Answer a worker's `cas:want` on the same requestId — through the door when one stands, else a miss. */
    27    function attachCasDoor(w: Worker): void {
    28      w.on("message", (raw: unknown) => {
    29        const m = raw as Partial<IslandMsg_CasWant> | null;
    30        if (!m || m.type !== "cas:want" || typeof m.requestId !== "string" || typeof m.cid !== "string") return;
    31        const { requestId, cid } = m;
    32        const answer = (bytes: Uint8Array | null): void => {
    33          const reply: IslandMsg_CasBlock = { type: "cas:block", requestId, bytes };
    34          try { w.postMessage(reply); } catch { /* the worker went away — nothing to answer */ }
    35        };
    36        const door = casDoor;
    37        if (!door) { answer(null); return; }
    38        door(cid).then(answer, () => answer(null));   // a faulting door reads as a miss, never a worker fault
    39      });
    40    }
    41
    42    /** The vessel's answer to a worker's `doc:rest` — resolves once every named document rests in the vessel's store. */
    43    export type RestDoor = (documentIds: readonly string[], heads?: Readonly<Record<string, readonly string[]>>) => Promise<void>;
    44
    45    // THE REST DOOR, vessel side. A worker's Repo holds no store for the documents it mints beside its own bag: the
    46    // vessel's Repo saves them. ONE store per vessel, so ONE door, stood with the composition and dropped at its
    47    // teardown. No door standing answers every ask `rested: false` — a pointer never lands on an unacknowledged save.
    48    let restDoor: RestDoor | null = null;
    49
    50    /** Stand (or drop) the vessel's rest door. */
    51    export function setRestDoor(door: RestDoor | null): void { restDoor = door; }
    52
    53    /** Answer one `doc:rest` ask through the door standing now. Exported so a test asks it without a worker. */
    54    export async function answerDocRest(ask: Pick<IslandMsg_DocRest, "requestId" | "documentIds" | "heads">): Promise<IslandMsg_DocRested> {
    55      const base = { type: "doc:rested" as const, requestId: ask.requestId };
    56      const door = restDoor;
    57      if (!door) return { ...base, rested: false, why: "no rest door stands on this vessel" };
    58      try { await door(ask.documentIds, ask.heads); return { ...base, rested: true, proof: { documentIds: [...ask.documentIds] } }; }
    59      catch (e) { return { ...base, rested: false, why: e instanceof Error ? e.message : String(e) }; }
    60    }
    61
    62    /** The vessel's answer to a worker's `custody:write` — seals the bytes under the vessel key. */
    63    export type CustodyWriteDoor = (carrier: CustodyWriteCarrier, bytes: Uint8Array) => Promise<void>;
    64
    65    /** The vessel's reading of one device edge on one fleet root. */
    66    export type DyadDoor = (fleetRoot: string, deviceKey: string) => EdgeStanding | Promise<EdgeStanding>;
    67    let dyadDoor: DyadDoor | null = null;
    68
    69    /** Stand (or drop) the vessel's dyad reading door. */
    70    export function setDyadDoor(door: DyadDoor | null): void { dyadDoor = door; }
    71
    72    /** Answer one dyad ask through the vessel's live board, failing closed on missing or malformed readings. */
    73    export async function answerDyadAsk(ask: Pick<IslandMsg_DyadAsk, "requestId" | "fleetRoot" | "deviceKey">): Promise<IslandMsg_DyadRead> {
    74      const base = { type: "dyad:read" as const, requestId: ask.requestId };
    75      if (typeof ask.fleetRoot !== "string" || typeof ask.deviceKey !== "string") return { ...base, standing: "aside" };
    76      const door = dyadDoor;
    77      if (!door) return { ...base, standing: "aside" };
    78      try {
    79        const standing = await door(ask.fleetRoot, ask.deviceKey);
    80        return { ...base, standing: standing === "clear" || standing === "aside" || standing === "owing" || standing === "returned" || standing === "unknown" ? standing : "aside" };
    81      } catch { return { ...base, standing: "aside" }; }
    82    }
    83
    84    function attachDyadDoor(w: Worker): void {
    85      w.on("message", (raw: unknown) => {
    86        const m = raw as Partial<IslandMsg_DyadAsk> | null;
    87        if (!m || m.type !== "dyad:ask" || typeof m.requestId !== "string") return;
    88        void answerDyadAsk({ requestId: m.requestId, fleetRoot: m.fleetRoot as string, deviceKey: m.deviceKey as string }).then((reply) => {
    89          try { w.postMessage(reply); } catch { /* the worker went away — nothing to answer */ }
    90        });
    91      });
    92    }
