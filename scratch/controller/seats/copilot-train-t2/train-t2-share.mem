   256    // ── runSovereignWorker — node host shore over the shared kernel ──────────────
   257
   258    export function runSovereignWorker(
   259      behaviorOrFactory: IslandBehavior | ((manifest: IslandMsg_Manifest) => IslandBehavior),
   260    ): void {
   261      if (!parentPort) {
   262        throw new Error("[sovereign-island] parentPort is null — must run as a Worker thread.");
   263      }
   264      const port = parentPort;
   265
   266      // The fs CAS dir — captured from the manifest storage dir when the kernel builds the repo
   267      // (host.storage runs before resolveByCid). Engine + plugin bytes ride this local CID plane,
   268      // pulled by content-address off the sync port — the nodefs face of the worker CAS. A
   269      // memory-storage island carries no CAS dir; resolveByCid yields null and the kernel faults
   270      // (the CID plane is required).
   271      let casDir: string | null = null;
   272
   273      // The CORPUS CAS dir — where the operator gesture stages oversized carrier bodies (whole
   274      // books) that ride LOAD/INGEST verbs BY REFERENCE, never inline. Read from the inherited
   275      // env (LAR_CAS, else <LAR_ROOT>/cas) so the fs-less worker resolves the SAME dir the CLI
   276      // stager wrote — process-shared filesystem, no IPC. The `wake` gesture exports LAR_CAS =
   277      // larCasDir() when it spawns the daemon, so this stays deterministic across the two processes.
   278      // Distinct from the runtime `casDir` (engine/plugin bytes under <storage>/cas, held by the runtime store):
   279      // the corpus CAS is repo-relative and persistent.
   280      const corpusCasDir: string | null =
   281        process.env["LAR_CAS"] ?? (process.env["LAR_ROOT"] ? join(process.env["LAR_ROOT"], "cas") : null);
   282
   283      const host: IslandHostShore = {
   284        post:    (msg: IslandToVesselMsg) => port.postMessage(msg),
   285        listen:  (onMessage) => port.on("message", onMessage),
   286        storage: (msg) => {
   287          if (msg.storage?.type === "nodefs") casDir = casDirFromIslandStorageDir(msg.storage.dir);
   288          return _buildStorage(msg.storage);
   289        },
   290        // Resolve by content-address — THE FETCH DOOR (basket-one #/the-fetch-door), composed here as
   291        // `makeCidResolver(localRead, portTransit, cacheWriteThrough)` (@lararium/mesh):
   292        //   · localRead — the runtime CID plane first (engine/plugin bytes), then the corpus CAS (staged
   293        //     carrier bodies); the caller re-verifies cid==hash(bytes), so a two-dir lookup never widens trust;
   294        //   · portTransit — a local miss asks the VESSEL over the parent port (the worker holds no socket; the
   295        //     vessel's door reaches Socket B and its fleet holders); the transit leg re-verifies the bytes
   296        //     against the cid's own class before they return — a body that fails verify never returns;
   297        //   · cacheWriteThrough — the verified body lands in the local `cid/` so the next read stays local.
   298        // Absent a door (the vessel answers every ask with a miss) the leg degenerates to exactly the local
   299        // read: a miss is a miss, PENDING stays PENDING, never an unverified body, never a fault.
   300        resolveByCid: makeCidResolver(
   301          (cid) => {
   302            const runtime = casDir ? readCasBlobFromFs(cid, casDir) : null;
   303            if (runtime) return runtime;
   304            return corpusCasDir ? readCasBlobFromFs(cid, corpusCasDir) : null;
   305          },
   306          portTransit(port),
   307          (cid, bytes) => {
   308            const dir = casDir ?? corpusCasDir;
   309            if (!dir) return;
   310            try {
   311              mkdirSync(dir, { recursive: true });
   312              const path = join(dir, cid);
   313              if (!existsSync(path)) writeFileSync(path, bytes);
   314            } catch { /* a failed write-through costs the next read a re-fetch, never the bytes */ }
   315          },
   316        ),
   317      };
   318
   319      runSovereignKernel(host, behaviorOrFactory);
   320    }
