   216          reply(refused);
   217        } else if (m.type === "dyad:ask") {
   218          once("DyadDoorRefused", "dyad door");
   219          const refused: IslandMsg_DyadRead = {
   220            type: "dyad:read", requestId: m.requestId, standing: "aside",
   221          };
   222          reply(refused);
   223        }
   224      });
