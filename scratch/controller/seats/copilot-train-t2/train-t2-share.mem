    22        const dir = mkdtempSync(join(tmpdir(), "hermetic-git-"));
    23        const file = join(dir, "gitconfig");
    24        writeFileSync(file, "[user]\n\temail = someone@example.test\n");
    25        expect(globalEmail({ ...process.env, GIT_CONFIG_GLOBAL: file })).toBe("someone@example.test");
    26      });
    27    });
