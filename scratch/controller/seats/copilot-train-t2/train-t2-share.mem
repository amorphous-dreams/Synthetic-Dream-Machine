   677      const jwk = createPublicKey(createPrivateKey({ key: pkcs8, format: "der", type: "pkcs8" })).export({ format: "jwk" }) as { x: string };
   678      return Buffer.from(jwk.x, "base64url").toString("hex");
   679    }
