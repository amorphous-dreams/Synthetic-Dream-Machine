   128        // SEAL, in the island, beside the key seat.
   129        const sealed = await first.run("sealed-seal", { bag: BAG, text: BODY });
   130        expect(sealed["founded"]).toBe(true);
   131        expect(sealed["ref"]).toBe(sha256HexBytesSync(utf8Bytes(BODY)));
   132        expect(String(sealed["cid"])).toMatch(/^blake3:[0-9a-f]{64}$/);
