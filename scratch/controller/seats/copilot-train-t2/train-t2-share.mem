1    /**
     2     * uds-session-door — the node's production door onto the session socket: the face a session wears, verified afresh at
     3     * every open and at every switch's preflight.
     4     *
     5     * A caller names a face by its ordinal hint, `h<N>`. The hint grants nothing: the door reads the face's PersonaGroup
     6     * from its own anchors and the face's K15 atom from its custody row (a locked face's row refuses).
     7     *
     8     * A SESSION IS A MEETING BETWEEN A FACE AND AN ANCHOR, held by neither's registry (session-contract#/the-hands). The
     9     * anchor follows the vessel's state, never its config: a dial pin standing (set once the vessel's own presentation
    10     * composed there) anchors the session at that Nexus, where the door reads the face's proof through the dial's own
    11     * reading (`composeFaceTarget`); no pin standing anchors it at the vessel's own place, its W29 place KEL prefix, where
    12     * the face proves itself by its atom presented to its own vessel and no Nexus admits it (`preparePlaceFace`). A hint
    13     * that names a Nexus (`h<N>@<aid>`) waits on a vessel that dials a second Nexus.
    14     *
    15     * The door reads and writes nothing: a founder's certificate stands from the dial's own presentation, and a face whose
    16     * certificate does not stand yet refuses by the absent piece. Each supply names its anchor; `anchorNow` answers where
    17     * the vessel stands, so the seat refuses `anchor-moved` to a session whose anchor the vessel left. The proven face's
    18     * PersonaGroup must be the hinted face's, or the door refuses `face-group-mismatch`.
    19     *
    20     * The supply it answers mounts nothing and mints no key. Its presenter names the face's atom, the key the daemon judges
    21     * that face's verbs by; its mint draws the session's signer once the owner's table holds the session live. At a place
    22     * the atom signs that signer's certificate, read afresh from custody at the mint and overwritten after.
    23     *
    24     * Meme: lar:///ha.ka.ba/lararium/node/uds-session-door
    25     */
    26    import {
    27      faceAtomPublicKey, signAsFaceAtom, HANDLE_INDEX_CEILING, nexusAidOfPin, preparePlaceFace, type GateBundlePin, type JoinedFaceTarget, type PlaceReading,
    28    } from "@lararium/mesh";
    29    import type { Hand } from "@lararium/mesh/session-contract";
    30    import type { SessionOwnChain } from "@lararium/mesh";
    31    import { HAND_PROFILES } from "@lararium/mesh/session-contract";
    32    import { CustodyLocked } from "./custody-holder.js";
    33    import { composeFaceTarget } from "./dial-presentation.js";
    34    import { loadFaceAtomOfGroup } from "./face-atom-store.js";
    35    import { loadIdentityAnchors } from "./identity-anchors.js";
    36    import { placeReadingWatch } from "./node-vessel-identity.js";
    37    import type { SessionAnchor, UdsSessionDoor } from "./uds-channel.js";
    38
    39    /** The ports the door reads; a vector replaces them, a vessel takes the defaults. */
    40    export interface NodeSessionDoorPorts {
    41      /** The pin of the Nexus this vessel dials now (its own presentation composed there), or null: the place anchor. */
    42      readonly pin:          () => GateBundlePin | null;
    43      /** This vessel's own place, read from its verified place KEL. */
    44      readonly placeOf?:     () => Promise<PlaceReading>;
    45      readonly sealHome:     string;
    46      /** Where a fault's detail goes; the wire carries its code alone. */
    47      readonly onLog?:       (line: string) => void;
    48      readonly groupOfFace?: (face: number) => Promise<string | null>;
    49      readonly atomOfGroup?: (group: string) => Promise<Uint8Array | null>;
    50      readonly targetOf?:    (at: { readonly sealHome: string; readonly pin: GateBundlePin; readonly personaGroup: string }) =>
    51        Promise<{ readonly target: JoinedFaceTarget } | { readonly refusal: string }>;
    52    }
    53
    54    const HINT = /^h(0|[1-9][0-9]{0,9})$/;
    55    type DoorAnswer = Awaited<ReturnType<UdsSessionDoor["open"]>>;
    56
    57    /** Read a face hint: `h<N>`, the face ordinal below the handle-index ceiling. Anything else names no face. */
    58    export function readFaceHint(hint: string): number | null {
    59      const m = HINT.exec(hint);
    60      if (!m) return null;
    61      const face = Number(m[1]);
    62      return face < HANDLE_INDEX_CEILING ? face : null;
    63    }
    64
    65    export function nodeSessionDoor(ports: NodeSessionDoorPorts): UdsSessionDoor {
    66      const groupOfFace = ports.groupOfFace ?? (async (face: number) => (await loadIdentityAnchors(face))?.personaGroupId ?? null);
    67      const atomOfGroup = ports.atomOfGroup ?? loadFaceAtomOfGroup;
    68      const targetOf = ports.targetOf ?? ((at) => composeFaceTarget(at));
    69      const placeOf = ports.placeOf ?? placeReadingWatch();
    70      // THE PLACE ANCHOR NAMES ITS HEAD: each check reads where the place KEL stands (a stat, and a verify only once its bytes
    71      // moved), so a rotation of the place moves the anchor and ends the place's sessions `anchor-moved`; a read that fails
    72      // throws, and the seat refuses that frame `anchor-unread`. The signer reads the same head at each signature, so a
    73      // rotation mid-verb refuses `anchor-moved` there too.
    74      const placeAnchor = async (): Promise<SessionAnchor> => {
    75        const place = await placeOf();
    76        return { kind: "place", aid: place.place, head: place.head };
    77      };
    78      const anchorNow = async (): Promise<SessionAnchor> => {
    79        const pin = ports.pin();
    80        if (pin === null) return placeAnchor();
    81        const aid = nexusAidOfPin(pin);
    82        if (aid === null) throw new Error("the dial pin names no readable Nexus");
    83        return { kind: "nexus", aid };
    84      };
    85      const open = async (face: number, hand: Hand): Promise<DoorAnswer> => {
    86        const group = await groupOfFace(face);
    87        if (group === null) return { ok: false, refusal: "face-absent" };
    88        const seed = await atomOfGroup(group);
    89        if (seed === null) return { ok: false, refusal: "face-atom-absent" };
    90        let presenter: string;
    91        let atomKey: string;
    92        try { atomKey = faceAtomPublicKey(seed); presenter = `0x${atomKey}`; } finally { seed.fill(0); }
    93        const pin = ports.pin();
    94        if (pin === null) {
    95          // THE PLACE ANCHOR: the face's atom presented to its own vessel; no Nexus admits it.
    96          const place = await placeOf();
