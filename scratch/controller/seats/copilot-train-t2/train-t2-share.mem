   279    /**
   280     * A D row: sealed under its face's custody key and resting in `faces/<fcid>/<file>`. `inner` spells the file as callers name it;
   281     * the row's census match spells the whole path under the identity home. `select` names the face the file belongs to.
   282     */
   283    function faceRowOf(spec: {
   284      readonly row: string; readonly inner: RegExp; readonly select: FaceRowAddress["select"]; readonly custody: "face-hot" | "face-cold";
   285      readonly keyClass: KeyClass | null; readonly writer: string; readonly target: CustodyTarget; readonly bundle?: BundleTreatment;
   286      readonly name: (m: RegExpExecArray) => string; readonly face?: (m: RegExpExecArray) => CarrierFace;
   287    }): CarrierRow {
   288      const body = spec.inner.source.replace(/^\^/, "").replace(/\$$/, "");
   289      const match = new RegExp(`^${FACES_DIR}/([0-9a-f]{32})/(${body})$`);
   290      /** The census match, re-read as the inner file's own match: the captures after the directory and the file. */
   291      const innerOf = (m: RegExpExecArray): RegExpExecArray => {
   292        const view = [m[2]!, ...m.slice(3)] as unknown as RegExpExecArray;
   293        view.index = 0; view.input = m[2]!;
   294        return view;
   295      };
   296      return row({
   297        row: spec.row, home: "identity", under: FACES_DIR, match, custody: spec.custody, keyClass: spec.keyClass, writer: spec.writer, target: spec.target,
   298        name: (m) => spec.name(innerOf(m)), face: (m) => (spec.face ? spec.face(innerOf(m)) : (`fcid:${m[1]}` as const)),
   299        faceRow: { inner: new RegExp(`^(?:${body})$`), select: spec.select },
   300        ...(spec.bundle ? { bundle: spec.bundle } : {}),
   301      });
   302    }
