    29    const HOST = "0123456789abcdef0123456789abcdef";
    30
    31    /** A sown path's first segment names its home on disk: `identity`, `vessel` (storage) or `nexus` (seal). */
    32    function homeOf(segment: string): keyof CustodyHomes {
    33      return segment === "identity" ? "identity" : segment === "vessel" ? "storage" : "seal";
    34    }
    35
    36    function sow(homes: CustodyHomes, files: Record<string, string>): void {
    37      for (const [rel, body] of Object.entries(files)) {
    38        const [home, ...rest] = rel.split("/");
    39        const path = join(homes[homeOf(home!)], ...rest);
    40        mkdirSync(dirname(path), { recursive: true });
    41        writeFileSync(path, body);
    42      }
    43    }
    44
    45    function freshHomes(): { homes: CustodyHomes; root: string } {
    46      const root = mkdtempSync(join(tmpdir(), "lar-carriers-"));
    47      const homes = { identity: join(root, "identity"), storage: join(root, "vessel"), seal: join(root, "nexus") };
    48      return { homes, root };
    49    }
    50
    51    /** Every file and its bytes under `root`, hashed — the reader's write-nothing witness. */
    52    function treeHash(root: string): string {
    53      const h = createHash("sha256");
    54      const walk = (dir: string): void => {
    55        for (const name of readdirSync(dir).sort()) {
    56          const p = join(dir, name);
    57          if (statSync(p).isDirectory()) { h.update(`d:${p}\n`); walk(p); }
    58          else h.update(`f:${p}:`).update(readFileSync(p)).update("\n");
    59        }
    60      };
    61      walk(root);
    62      return h.digest("hex");
    63    }
    64
