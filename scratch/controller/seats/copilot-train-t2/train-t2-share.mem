   640    /** The roster a row's plaintext carries (ascending); nothing standing reads as no root held, any other shape refuses. */
   641    function parseRoster(bytes: Uint8Array | null, file: string): PersonaRosterLine[] {
   642      if (bytes === null) return [];
   643      const roots = objectOf(parseRow(bytes, file), file)["roots"];
   644      if (!Array.isArray(roots)) throw malformed(file);
   645      const seen = new Set<number>();
   646      const out: PersonaRosterLine[] = [];
   647      for (const raw of roots as unknown[]) {
   648        const line = objectOf(raw, file);
   649        const handleIndex = line["handleIndex"];
