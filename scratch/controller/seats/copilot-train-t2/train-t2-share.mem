   635      readonly handleSessionFrame?: (parsed: unknown, sock: Socket) => void;
   636      /**
   637       * Leave the socket. Resolves once every frame this seat was handed has its answer written (or its caller gone),
   638       * so the composition beneath it tears down under no request still reading its ledger or awaiting its worker.
   639       */
   640      readonly close: () => void | Promise<void>;
   641    }
   642
   643    /** The floor's hold on the verb socket: it serves the claim once and outlives every composition. */
   644    export interface UdsFront {
   645      /** Seat a composition; held callers are handed over in arrival order without another seat reading them first. */
   646      readonly attach: (seat: UdsSeat) => void;
   647      /**
   648       * Unseat it. New callers remain held until the next attach. Resolves once the seat's own `close` settles: every
   649       * frame already handed to it has answered, so nothing of the retiring composition still serves a caller.
   650       */
   651      readonly detach: () => Promise<void>;
   652      /** Refuse every caller and stop serving. */
   653      readonly close: () => void;
   654    }
   655
   656    export function serveUdsFront(a: {
   657      readonly claim: StoreClaim & { readonly holder: "vessel" };
   658      readonly onLog?: (line: string) => void;
   659      readonly onFrame?: (parsed: unknown, sock: Socket) => boolean;
   660      readonly holdLimit?: number;
   661    }): UdsFront {
   662      type Held = { parsed: unknown; sock: Socket; onClose: () => void };
   663      const held: Held[] = [];
   664      let seat: UdsSeat | null = null;
   665      let stopped = false;
   666      const refusal = (sock: Socket) => {
   667        try { sock.end(JSON.stringify({ status: "error", errorMessage: "the vessel recomposes — run again", refusal: { reason: "recomposing" } }) + "\n"); } catch { /* gone */ }
   668      };
   669      const hand = (parsed: unknown, sock: Socket): void => {
   670        if (stopped) return refusal(sock);
   671        if (a.onFrame?.(parsed, sock)) return;
   672        if (seat) return seat.handle(parsed, sock);
   673        const entry: Held = { parsed, sock, onClose: () => {
   674          const i = held.indexOf(entry);
   675          if (i !== -1) held.splice(i, 1);
   676        } };
   677        sock.once("close", entry.onClose);
   678        held.push(entry);
   679        if (held.length > (a.holdLimit ?? PARK_LIMIT)) {
   680          const oldest = held.shift()!;
   681          oldest.sock.off("close", oldest.onClose);
   682          refusal(oldest.sock);
   683        }
   684      };
   685      const refuseSession = (sock: Socket): void => {
   686        try { sock.end(JSON.stringify({ kind: "session:refused", refusal: "recomposing" }) + "\n"); } catch { /* gone */ }
   687      };
   688      a.claim.serve((sock: Socket) => {
   689        let buf = "";
   690        let read = true;
   691        let sessionMode = false;
   692        sock.setEncoding("utf8");
   693        sock.on("data", (chunk: string) => {
   694          if (!read) return;
   695          buf += chunk;
   696          let nl: number;
   697          while (read && (nl = buf.indexOf("\n")) !== -1) {
   698            const line = buf.slice(0, nl);
   699            buf = buf.slice(nl + 1);
   700            let parsed: unknown;
   701            try { parsed = JSON.parse(line); }
   702            catch { try { sock.end(JSON.stringify({ status: "error", errorMessage: "bad invocation json" }) + "\n"); } catch { /* gone */ } read = false; return; }
   703            if (!sessionMode) {
   704              sessionMode = !!parsed && typeof parsed === "object" && (parsed as { op?: unknown }).op === "session:open";
   705              if (!sessionMode) read = false;
   706              hand(parsed, sock);
   707            } else if (seat?.handleSessionFrame) seat.handleSessionFrame(parsed, sock);
   708            else { read = false; refuseSession(sock); }
   709          }
   710        });
