    33          expect(one.seq).toBe(1);
    34          expect((await loadPlaceKelChain()).length).toBe(2);
    35          expect(await loadVesselVerifyingKey()).toBe(one.event.key);
    36          expect((await vesselPlaceSignerDoor()).key).not.toEqual(old);
    37          const two = await rotatePlace({ card: next, entropy: entropy(180), placeFoundingCard: { readBack: async () => {} } });
