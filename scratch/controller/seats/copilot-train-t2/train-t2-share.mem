    30    // to rest the new document and records its binding only on the vessel's acknowledgment.
    31    const restOnVessel = parentPort ? vesselRestAsker(parentPort) : null;
    32    const sealOnVessel = parentPort ? vesselCustodyWriter(parentPort) : null;
    33    // The vessel keeps the live fleet reading on its main thread and answers the daemon through this door.
    34    const dyadOnVessel = parentPort ? vesselDyadAsker(parentPort) : null;
