   499    let table: readonly CarrierRow[] | null = null;
   500
   501    /** The rows a face's backup bundle carries, each beside its treatment: every row the column names anything but `stays`. */
   502    export function bundleRows(): ReadonlyArray<{ readonly row: string; readonly bundle: Exclude<BundleTreatment, "stays"> }> {
   503      return carrierTable().flatMap((r) => (r.bundle === "stays" ? [] : [{ row: r.row, bundle: r.bundle }]));
   504    }
   505
   506    /** The one carrier table. */
   507    export function carrierTable(): readonly CarrierRow[] {
   508      return (table ??= buildTable());
   509    }
   510
   511    /** Every file under `dir`, as `/`-separated paths relative to `base`; flat when `deep` is false. */
   512    function listFiles(base: string, under: string, deep: boolean): string[] {
   513      const out: string[] = [];
   514      const walk = (rel: string): void => {
   515        let entries: Dirent[];
   516        try { entries = readdirSync(join(base, rel), { withFileTypes: true }); } catch { return; }
   517        for (const e of entries) {
   518          const child = rel ? `${rel}/${e.name}` : e.name;
   519          if (e.isFile()) out.push(child);
   520          else if (deep && e.isDirectory()) walk(child);
   521        }
   522      };
   523      walk(under);
   524      return out;
   525    }
   526
   527    /** The census of one home over `table`'s rows: every file a row names, first matching row wins (the table stays disjoint). */
   528    function censusHome(home: CustodyHome, dir: string, table: readonly CarrierRow[] = carrierTable()): CarrierEntry[] {
   529      const rows = table.filter((r) => r.home === home);
   530      const out: CarrierEntry[] = [];
   531      for (const under of [...new Set(rows.map((r) => r.under))]) {
   532        const scoped = rows.filter((r) => r.under === under);
   533        for (const rel of listFiles(dir, under, under !== "")) {
   534          for (const r of scoped) {
   535            const m = r.match.exec(rel);
   536            if (!m) continue;
   537            out.push({
   538              row: r.row, name: r.name(m), home, file: rel, path: join(dir, ...rel.split("/")),
   539              custody: r.custody, keyClass: r.keyClass, bare: r.bare, holds: r.holds, face: r.face(m),
   540            });
   541            break;
   542          }
   543        }
   544      }
   545      return out.sort((a, b) => (a.file < b.file ? -1 : a.file > b.file ? 1 : 0));
   546    }
   547
   548    /**
   549     * Census every carrier standing in `homes`, named by its row. An absent or unreadable home names nothing
   550     * and faults nothing: no home yet means no carrier stands. The census only reads.
   551     */
   552    export function carrierCensus(homes: CustodyHomes): CarrierEntry[] {
   553      return [
   554        ...censusHome("identity", homes.identity),
   555        ...censusHome("storage", homes.storage),
   556        ...censusHome("seal", homes.seal),
   557      ];
   558    }
   559
