   360    /** Rotate a place only after the replacement cold card reads back. */
   361    export async function rotatePlace(opts: { card: Uint8Array; placeFoundingCard: PlaceFoundingCard; entropy?: RandomProvider }):
   362      Promise<{ event: PlaceRotation; aid: string; seq: number }> {
   363      await openedCustody();
   364      const hint = await readLocalOperatorHint();
   365      const files = placeFiles(hint.login);
   366      // A staged rotation finishes (or refuses) before another begins.
   367      await reconcilePlaceRotation();
   368      const reading = verifiedPlaceChain(files.kel);
   369      if (!(opts.card instanceof Uint8Array) || opts.card.length !== 32) throw new Error("place-card-refused");
   370      let reveal: string;
   371      try { reveal = verifyingKeyOfSeed(hex(opts.card)); }
   372      catch { throw new Error("place-card-refused"); }
   373      if (placeNextDigest(reveal) !== reading.nextDigest) throw new Error("place-card-refused");
   374      const next = await mintColdKey(opts.entropy);
   375      const signer = new Uint8Array(32);
   376      (opts.entropy ?? globalThis.crypto).getRandomValues(signer);
   377      try {
   378        const signingKey = hex(signer);
