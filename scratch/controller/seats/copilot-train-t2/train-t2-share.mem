   121    describe("a private body seals on a real founded vessel, end to end", () => {
   122      test("seal → the vessel registers it → restart from the kept Archive → open; nothing private rests in the sealed tiers", async () => {
   123        const root = scratch();
   124        const st = await standFoundedIsland(teardown);
   125        const session = await proof();
