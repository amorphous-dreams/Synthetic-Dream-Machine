   124          if (shape.kind === "occupied") {
   125            expect(shape.offenders).toEqual([
   126              { home: "identity", file: `faces/${"ab".repeat(16)}/walk-h0-0123456789abcdef0123456789abcdef.json`, row: "walk", reason: "cleartext-beside-tree" },
   127            ]);
   128          }
   129        } finally { rmSync(root, { recursive: true, force: true }); }
   130      });
   131
   132      test("CONTROL: empty homes, and absent ones, read FRESH — the founding may write", () => {
   133        const { homes, root } = freshHomes();
