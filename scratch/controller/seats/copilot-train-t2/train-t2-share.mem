1    /**
     2     * custody-shape.test — the custody shape reader reads every home before any write and names one of four
     3     * shapes: `fresh` · `floor-only` · `slotted` · `occupied`.
     4     *
     5     * A home holding a secret with no slot tree to guard it, a carrier under an envelope this build cannot open,
     6     * or a cleartext secret beside a slot tree reads as a shape nothing here writes over, and the reader names
     7     * every offender. The reader writes nothing: a recursive hash of every home reads identical before and after.
     8     *
     9     * The S key envelope's recognizer arrives as an input (`sealed`); these tests stand a fixture recognizer that
    10     * answers for a fixture magic. The house envelope reader (`readSCarrier`) names a frame no unlock here opens.
    11     */
    12    import { describe, test, expect } from "vitest";
    13    import { createHash } from "node:crypto";
    14    import { existsSync, mkdtempSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
    15    import { tmpdir } from "node:os";
    16    import { dirname, join } from "node:path";
    17    import { readCustodyShape, occupiedStoreRefusal } from "../src/custody-shape.js";
    18    import type { CustodyHomes } from "../src/vault-carriers.js";
    19
    20    const FIXTURE_MAGIC = Buffer.from("FIXTURE-S key-SEAL:");
    21    /** The fixture recognizer: bytes that open with the fixture magic read sealed. */
    22    const reading = { sealed: (head: Uint8Array): boolean => Buffer.from(head).subarray(0, FIXTURE_MAGIC.length).equals(FIXTURE_MAGIC) };
    23    const sealedBytes = (body: string): Buffer => Buffer.concat([FIXTURE_MAGIC, Buffer.from(body)]);
    24    /** A frame that reads sealed to the face-key reader: its magic over a body long enough to hold a nonce and a tag. */
    25    const fckSealedBytes = (body: string): Buffer => Buffer.concat([Buffer.from("lares-fck-seal"), Buffer.alloc(48, 5), Buffer.from(body)]);
    26    /** A seal of the house family under a scheme this build does not frame: the family prefix, a scheme name, a frame. */
    27    const otherSchemeBytes = (scheme: string): Buffer => Buffer.concat([Buffer.from(`lares-${scheme}-seal`), Buffer.alloc(48, 7)]);
    28    /** The S key magic standing in a face row (another house scheme), over a frame long enough to hold a nonce and a tag. */
    29    const damagedMagicBytes = (): Buffer => Buffer.concat([Buffer.from("lares-s-seal"), Buffer.alloc(48, 9)]);
    30
    31    function freshHomes(): { homes: CustodyHomes; root: string } {
    32      const root = mkdtempSync(join(tmpdir(), "lar-shape-"));
    33      return { root, homes: { identity: join(root, "identity"), storage: join(root, "vessel"), seal: join(root, "nexus") } };
    34    }
    35
    36    function sow(homes: CustodyHomes, files: Record<string, string | Buffer>): void {
    37      for (const [rel, body] of Object.entries(files)) {
    38        const [home, ...rest] = rel.split("/");
    39        const key = home === "identity" ? "identity" : home === "vessel" ? "storage" : "seal";
    40        const path = join(homes[key], ...rest);
    41        mkdirSync(dirname(path), { recursive: true });
    42        writeFileSync(path, body);
    43      }
    44    }
    45
    46    /** Every directory and file under `root` with its bytes, hashed: the write-nothing witness. */
    47    function treeHash(root: string): string {
    48      const h = createHash("sha256");
    49      const walk = (dir: string): void => {
    50        if (!existsSync(dir)) return;
    51        for (const name of readdirSync(dir).sort()) {
    52          const p = join(dir, name);
    53          if (statSync(p).isDirectory()) { h.update(`d:${p}\n`); walk(p); }
    54          else h.update(`f:${p}:`).update(readFileSync(p)).update("\n");
    55        }
    56      };
    57      walk(root);
    58      return h.digest("hex");
    59    }
    60
    61    describe("readCustodyShape — the custody shape refusal reads before any write", () => {
    62      test("RED — a cleartext persona root with no slot tree reads OCCUPIED, and every home stays byte-identical", () => {
    63        const { homes, root } = freshHomes();
    64        try {
    65          sow(homes, {
    66            "identity/.vessel-key.json": "{}",
    67            [`identity/faces/abababababababababababababababab/.persona-group-root-h0.json`]: '{"seed":"00"}',
    68            "nexus/founding-roster.mem": "charter",
    69          });
    70          const before = treeHash(root);
    71          const shape = readCustodyShape(homes, reading);
    72          expect(shape.kind).toBe("occupied");
    73          if (shape.kind !== "occupied") return;
    74          expect(shape.offenders).toEqual([
    75            { home: "identity", file: "faces/abababababababababababababababab/.persona-group-root-h0.json", row: "persona-root", reason: "unslotted-secret" },
    76          ]);
    77          expect(treeHash(root)).toBe(before);
    78          const refusal = occupiedStoreRefusal(shape);
    79          expect(refusal).toContain(".persona-group-root-h0.json");
    80          expect(refusal).toContain("move these homes aside by hand");
    81        } finally { rmSync(root, { recursive: true, force: true }); }
    82      });
    83
    84      test("RED — a seal of another house scheme reads UNKNOWN-ENVELOPE even beside a slot tree, and even when a recognizer would call it sealed", () => {
    85        const { homes, root } = freshHomes();
    86        try {
    87          sow(homes, {
    88            "identity/.vessel-key.json": "{}",
    89            "identity/s-slots.bin": "slots",
    90            [`identity/faces/${"ab".repeat(16)}/veil-archive-g${"cd".repeat(32)}.bin`]: otherSchemeBytes("kh"),
    91          });
    92          for (const r of [reading, { sealed: () => true }]) {
    93            const shape = readCustodyShape(homes, r);
    94            expect(shape.kind).toBe("occupied");
    95            if (shape.kind === "occupied") {
    96              expect(shape.offenders).toEqual([{ home: "identity", file: `faces/${"ab".repeat(16)}/veil-archive-g${"cd".repeat(32)}.bin`, row: "veil-archive", reason: "unknown-envelope" }]);
    97            }
    98          }
    99        } finally { rmSync(root, { recursive: true, force: true }); }
   100      });
   101
   102      test("RED — a damaged house magic reads UNKNOWN-ENVELOPE (the frame decides, never the recognizer)", () => {
   103        const { homes, root } = freshHomes();
   104        try {
   105          sow(homes, { "identity/s-slots.bin": "slots", [`identity/faces/abababababababababababababababab/recovery-device-share-h0.bin`]: damagedMagicBytes() });
   106          for (const r of [reading, { sealed: () => true }]) {
   107            const shape = readCustodyShape(homes, r);
   108            expect(shape.kind === "occupied" && shape.offenders.map((o) => o.reason)).toEqual(["unknown-envelope"]);
   109          }
   110        } finally { rmSync(root, { recursive: true, force: true }); }
   111      });
   112
   113      test("RED — a cleartext secret beside a slot tree reads OCCUPIED; a public transition stays plain", () => {
   114        const { homes, root } = freshHomes();
   115        try {
   116          sow(homes, {
   117            "identity/s-slots.bin": "slots",
   118            "identity/gate-root.bin": sealedBytes("root"),
   119            [`identity/faces/${"ab".repeat(16)}/walk-h0-0123456789abcdef0123456789abcdef.json`]: '{"wallet":"plain"}',
   120            "nexus/transitions.json": "{}",
   121          });
   122          const shape = readCustodyShape(homes, reading);
