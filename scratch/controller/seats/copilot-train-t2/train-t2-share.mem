   782          // opens (`session-face-foreign`). The chain the reading carries is what the seat's standing reads.
   783          const sessionOf = async (verb: string, context: { readonly invocation?: { readonly requestId?: string }; readonly local?: boolean }): Promise<RecordSigner> => {
