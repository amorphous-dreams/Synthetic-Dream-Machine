490      leg?: { readonly ready: Promise<unknown>; readonly onClose: (fn: () => void) => () => void },
   491      heads?: Readonly<Record<string, readonly string[]>>,
   492    ): Promise<void> {
   493      let islandPeer: string | undefined;
   494      if (leg) {
   495        // The teardown subscription leaves when the wait settles, so a completed ask holds nothing of the door.
   496        const stood = await new Promise<{ peer: unknown } | null>((resolve, reject) => {
   497          const off = leg.onClose(() => resolve(null));
   498          leg.ready.then((peer) => { off(); resolve({ peer }); }, (error: unknown) => { off(); reject(error); });
   499        });
   500        if (stood === null) throw new Error(`the vessel stood down before the island's sync leg stood (${documentIds.join(", ")})`);
   501        if (typeof stood.peer === "string") islandPeer = stood.peer;
   502      }
   503      const named = heads && documentIds.length > 0 && documentIds.every((id) => (heads[id]?.length ?? 0) > 0);
   504      if (named && repo.findWithProgress && repo.handles) {
   505        // The island names the heads it holds. A derived id the vessel asked for earlier may stand cached unavailable, and
