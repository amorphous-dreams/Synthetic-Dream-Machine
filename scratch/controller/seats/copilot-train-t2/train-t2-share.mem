   236        const requestId = `custody-${process.pid}-${++seq}`;
   237        const timer = setTimeout(() => { pending.delete(requestId); settleWith(null); }, patienceMs);
   238        timer.unref?.();
   239        const settleWith = (answer: IslandMsg_CustodyWritten | null): void => {
   240          clearTimeout(timer);
   241          if (answer?.written === true) resolve();
   242          else reject(new Error(`the vessel did not seal the ${carrier} carrier (${answer ? answer.why ?? "unwritten" : "no answer"})`));
   243        };
   244        pending.set(requestId, settleWith);
   245        const ask: IslandMsg_CustodyWrite = { type: "custody:write", requestId, carrier, bytes };
   246        port.postMessage(ask);
