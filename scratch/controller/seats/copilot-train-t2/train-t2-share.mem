   305        expect("refusal" in sealed && sealed.refusal).toBe("roll-owed");
   306        expect(removedOpens).toBe("nothing sealed");
   307      });
   308
   309      it("A RAISE COUNTED WHILE A SEAL SIGNS, ON A BAG ALREADY FOUNDED: the seal refuses `roll-owed` at its commit point, and the removed reader opens nothing", async () => {
   310        const { sealed, removedOpens } = await raceDuringSeal(false, true);
   311        expect("refusal" in sealed && sealed.refusal).toBe("roll-owed");
