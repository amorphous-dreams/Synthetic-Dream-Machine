   304        const { sealed, removedOpens } = await raceDuringSeal(true, true);
   305        expect("refusal" in sealed && sealed.refusal).toBe("roll-owed");
   306        expect(removedOpens).toBe("nothing sealed");
   307      });
   308
   309      it("A RAISE COUNTED WHILE A SEAL SIGNS, ON A BAG ALREADY FOUNDED: the seal refuses `roll-owed` at its commit point, and the removed reader opens nothing", async () => {
   310        const { sealed, removedOpens } = await raceDuringSeal(false, true);
   311        expect("refusal" in sealed && sealed.refusal).toBe("roll-owed");
   312        expect(removedOpens).toBe("nothing sealed");
   313      });
   314
   315      it("CONTROL: the same paused seal with no raise counted commits, founding and existing alike", async () => {
   316        for (const founding of [true, false]) {
   317          const { sealed, before } = await raceDuringSeal(founding, false);
   318          if ("refusal" in sealed) throw new Error(said(sealed));
   319          if (before) expect(sealed.body.keyVersion).toBe(before.body.keyVersion);
   320        }
