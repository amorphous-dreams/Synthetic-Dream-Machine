1    /**
     2     * island-session-proof — what the daemon island reads of the session that placed one ask.
     3     *
     4     * THE ISLAND HOLDS NO SESSION KEY. A session's signer lives on the vessel's main thread, beside the owner's table that
     5     * decides whether its session still stands, and holds the only copy of its secret (face-proof#/the-key-hierarchy). The
     6     * island names the invocation a session placed, and the vessel answers from THAT session: its certificate, its proof
     7     * subject and the vessel's own verified face chain, then each signature on ask. A lock, a close or a switch drops the
     8     * signer on the main thread, and the next signature refuses there; the island learns nothing it must forget.
     9     *
    10     * The law the island applies to a reading (sealed-store#/the-store):
    11     *   · ONLY A NEXUS-ANCHORED SESSION REACHES THE SEALED STORE. A record carries a session certificate beneath the
    12     *     vessel's face-scoped key; a place session holds none, and the vessel refuses it `session-anchor-place`.
    13     *   · THE SESSION WEARS THIS ISLAND'S OWN FACE. Its proof subject equals the subject of the vessel's own chain, or
    14     *     every sealed verb refuses `session-face-foreign`: another face's session opens nothing this face sealed.
    15     *   · A WRITER STANDS ONLY UNDER THE VESSEL'S OWN CHAIN. `holdsWrite` reads true for a certificate whose scope and
    16     *     face-scoped key are the chain's, over a bag this face registers. Every other writer reads not capable until
    17     *     the grant ring reads by face key (face-proof#/owed): the reading fails closed.
    18     *
    19     * Canon: lar:///ha.ka.ba/lararium/mesh/sealed-store#/the-store
    20     */
    21    import type { RecordSigner, WriterStanding } from "@lararium/mesh";
    22    import type { SessionOwnChain } from "@lararium/mesh";
    23
    24    /** The invocation a session placed, as the island names it: its request id and the verb it placed. */
    25    export interface SessionAsk {
    26      readonly requestId: string;
    27      readonly verb: string;
    28    }
    29
    30    /** The vessel's answer for one ask: the session's signer (its certificate, its signatures on the main thread), its
    31     *  proof subject and this vessel's own verified chain; or one refusal by name. */
    32    export type SessionReading =
    33      | { readonly signer: RecordSigner; readonly subject: string; readonly chain: SessionOwnChain }
    34      | { readonly refusal: string };
    35
    36    /** The island's port onto the session that placed an ask. `null` names an ask no session placed (a summons, a
    37     *  maintenance frame): it reads `signer-unavailable`, and no vessel key or daemon key signs in its place. */
    38    export interface IslandSessionProof {
    39      signer(ask: SessionAsk | null): Promise<SessionReading>;
    40    }
    41
    42    const bare = (s: string): string => s.trim().toLowerCase().replace(/^0x/, "");
    43
    44    /** The certificate's scope and face-scoped key, read without trusting its shape. */
    45    function chainOf(certificate: unknown): { faceKey: string; nexus: string; vesselFaceKey: string } | null {
    46      if (typeof certificate !== "object" || certificate === null) return null;
    47      const { scope, vesselFaceKey } = certificate as { scope?: unknown; vesselFaceKey?: unknown };
    48      if (typeof scope !== "object" || scope === null || typeof vesselFaceKey !== "string") return null;
    49      const { faceKey, nexus } = scope as { faceKey?: unknown; nexus?: unknown };
    50      return typeof faceKey === "string" && typeof nexus === "string" ? { faceKey, nexus, vesselFaceKey } : null;
    51    }
    52
    53    /** Does `certificate` stand under `chain`: the same face, the same Nexus, the same face-scoped key? */
    54    export function certificateUnderChain(certificate: unknown, chain: SessionOwnChain | null): boolean {
    55      if (chain === null) return false;
    56      const read = chainOf(certificate);
    57      return read !== null && bare(read.faceKey) === bare(chain.scope.faceKey) && read.nexus === chain.scope.nexus && bare(read.vesselFaceKey) === bare(chain.vesselFaceKey);
    58    }
    59
    60    /**
    61     * The writer standing an island reads under its own chain: `chain()` answers the vessel's verified own-face chain as
    62     * the last session reading carried it (null before any), and `bags()` the bags this face registers.
    63     */
    64    export function ownChainStanding(chain: () => SessionOwnChain | null, bags: () => readonly string[]): WriterStanding {
    65      return { holdsWrite: ({ certificate, bagId }) => certificateUnderChain(certificate, chain()) && bags().includes(bagId) };
    66    }
