   146    function attachSessionSignDoor(w: Worker): void {
   147      w.on("message", (raw: unknown) => {
   148        const m = raw as Partial<IslandMsg_SessionSign> | null;
   149        if (!m || m.type !== "session:sign" || typeof m.requestId !== "string") return;
   150        void answerSessionSign(m as Partial<IslandMsg_SessionSign> & { requestId: string }).then((reply) => {
   151          try { w.postMessage(reply); } catch { /* the worker went away — nothing to answer */ }
   152        });
   153      });
