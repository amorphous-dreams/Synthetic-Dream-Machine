   165          sow(homes, { "identity/.vessel-next.json": "{}", "identity/.vessel-kel.json": "{}" });
   166          expect(carrierTable().map((r) => r.row)).not.toContain("vessel-next");
   167          const census = carrierCensus(homes);
   168          expect(census.filter((e) => e.file.startsWith(".vessel-next"))).toEqual([]);
   169          expect(census.filter((e) => e.file === ".vessel-kel.json").map((e) => e.row)).toEqual(["vessel-kel"]);   // control
   170        } finally { rmSync(root, { recursive: true, force: true }); }
   171      });
   172
   173      test("every row reads its ruled class, and the table names no row the ruling does not", () => {
   174        const table = carrierTable();
   175        expect(Object.fromEntries(table.map((r) => [r.row, r.custody]))).toEqual(RULED);
   176        for (const name of ["transition-pending", "transitions"])
   177          expect(table.find((r) => r.row === name)).toMatchObject({ target: { classes: ["F"] }, custody: "floor-plain", keyClass: null });
   178        expect(table.filter((r) => r.custody === "cold").map((r) => r.row)).toEqual(["intent-relay-key"]);
   179        expect(new Set(table.map((r) => r.row)).size).toBe(table.length);
   180        for (const r of table) {
   181          expect(CUSTODY_CLASSES).toContain(r.custody);
   182          expect(r.writer.length).toBeGreaterThan(0);
   183        }
   184      });
