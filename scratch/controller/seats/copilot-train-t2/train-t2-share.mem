   698     */
   699    async function openCommittedRoot(line: PersonaRosterLine): Promise<PersistedKeypair> {
   700      const file = personaGroupRootFileName(line.handleIndex);
   701      return openColdCustodyRow("identity", file, (bytes) => {
   702        const root = parseRootRow(bytes, file);
