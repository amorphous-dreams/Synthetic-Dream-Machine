   474      // ── Seal and open ─────────────────────────────────────────────────────────────────────────────
   475      /**
   476       * Seal one private body into its bag. A bag no key ever served gets founded first: `founding` declares the
   477       * span's history, and a founding with no declaration stands closed. The sealed value rests, then the
   478       * manifest that names it, then the index rows.
   479       */
   480      sealBlob(args: { readonly bagId: string; readonly plaintext: Uint8Array; readonly signer: RecordSigner | null; readonly founding?: { readonly history: HistoryDeclaration };
   481        /** The raises the vessel counted whose removal roll still owes this bag (sealed-store road, step 2: a removed
   482         *  device opens nothing a vessel seals after it counts the raise). The head this seal writes under must follow
   483         *  every one, or the seal refuses `roll-owed` and seals nothing. A founding this seal makes owes none: its first
   484         *  version wraps for the readers that stand now. */
   485        readonly owedActs?: readonly string[] }): Promise<SealedBlob | HolderRefusal> {
   486        return this.#inTurn<SealedBlob>(async () => {
   487          if (!isWellFormedText(args.bagId)) return refuse("bag-malformed");
   488          if (args.signer === null) return refuse("signer-unavailable");
   489          const { store, random } = this.#ports;
   490          const bags = await this.#loaded();
   491          let founded: MintOutcome | undefined;
   492          let line = await this.#writeLine(bags.get(args.bagId));
   493          if (isRefusal(line)) {
   494            if (line.refusal !== "bag-unfounded") return line;
   495            const made = await this.#found(bags, args.bagId, args.founding?.history ?? "closed", args.signer);
   496            if (isRefusal(made)) return made;
   497            line = made.line; founded = made.minted;
   498          }
   499          const bag = bags.get(args.bagId)!;
   500          const at = await this.#head(bag, line, args.signer);
   501          if (isRefusal(at)) return at;
   502          if (!founded) for (const act of args.owedActs ?? []) if (!line.lineage.followsRemoval(at.head, act)) return refuse("roll-owed");
   503          const key = line.keys.get(at.head)!;
   504          const sealed = sealPrivateBody(args.plaintext, { bagId: args.bagId, key }, random);
   505          if (!("body" in sealed)) return refuse("seal-refused", sealed.refusal);
   506          const { body } = sealed;
   507          const context: SealContext = { bagId: args.bagId, keyVersion: at.head, role: "blob", logicalRef: hexToBytes(body.ref) };
   508          const earlier = await store.own(`manifest-head.${line.locator}.${at.head}`);
   509          const manifest: ManifestBody = {
   510            bag: line.locator, keyVersion: at.head, parents: earlier === null ? [] : [hex(earlier) as RecordId],
   511            entries: [{ role: "blob", address: body.cid, locator: entryLocatorOf(key, context), parents: [] }],
   512          };
   513          const signed = await this.#sign("manifest", manifest, {}, args.bagId, line.locator, key, args.signer);
   514          if (isRefusal(signed)) return signed;
   515          // A lock that landed while the manifest signed overwrote the key, so the record above never read back.
   516          await this.#rest(() => this.#ports.values.write(body.cid, body.ciphertext));
   517          const id = await this.#rest(() => store.putRecord(signed.carried));
   518          await this.#rest(() => store.putIndexRows(indexRowsOf(signed.verified)));
   519          await this.#rest(() => store.noteOwn(`manifest-head.${line.locator}.${at.head}`, hexToBytes(id)));
   520          await this.#rest(() => this.#noteHead(line, at.head));
   521          line.manifests.set(id, signed.verified);
   522          return { body, manifest: id, founding: line.locator, ...(founded ? { founded } : {}), ...(at.joined ? { joined: at.joined } : {}) };
   523        });
   524      }
   525
   526      /** A manifest this vessel verified under one counted version's key, by its id. */
   527      async #manifest(bag: Bag, line: Line, key: ContentKey, id: RecordId): Promise<VerifiedRecord<"manifest"> | null> {
   528        const known = line.manifests.get(id);
   529        if (known) return known;
   530        for (const carried of await this.#ports.store.record("manifest", id)) {
   531          const read = readRecord("manifest", carried, { bagId: bag.bagId, locator: line.locator, key, standing: this.#ports.standing, ...(this.#ports.apart ? { apart: this.#ports.apart } : {}) });
   532          if ("record" in read) { line.manifests.set(id, read.record); return read.record; }
   533        }
   534        return null;
   535      }
   536
   537      /**
   538       * Open one private body by the digest its pointer names. The holder derives the entry locator under each
   539       * version it may open, finds the row, verifies the manifest the row names, and opens the address that
   540       * manifest authorizes. Answers the whole body or one named refusal.
   541       */
   542      openBlob(args: { readonly bagId: string; readonly ref: string }): Promise<{ readonly plaintext: Uint8Array; readonly keyVersion: KeyVersionId } | HolderRefusal> {
   543        return this.#inTurn<{ readonly plaintext: Uint8Array; readonly keyVersion: KeyVersionId }>(async () => {
   544          if (!isWellFormedText(args.bagId)) return refuse("bag-malformed");
   545          if (typeof args.ref !== "string" || !/^[0-9a-f]{64}$/.test(args.ref)) return refuse("open-refused", "reference-malformed");
   546          const bag = (await this.#loaded()).get(args.bagId);
   547          // A bag stands founded here once some founding of it holds a version this vessel may open under.
   548          if (!bag || ![...bag.lines.values()].some((line) => this.#usable(line).size > 0)) return refuse("bag-unfounded");
   549          let met: HolderRefusal = refuse("reference-unknown");
   550          for (const line of bag.lines.values()) for (const keyVersion of this.#usable(line)) {
   551            const key = line.keys.get(keyVersion)!;
   552            const context: SealContext = { bagId: args.bagId, keyVersion, role: "blob", logicalRef: hexToBytes(args.ref) };
   553            for (const row of await this.#ports.store.rowsAt(line.locator, keyVersion, entryLocatorOf(key, context))) {
   554              const manifest = await this.#manifest(bag, line, key, row.manifest);
   555              const authorized = manifest === null ? null : authorizeFromManifest(manifest, key, context);
   556              if (authorized === null) continue;
   557              const ciphertext = await this.#ports.values.read(authorized.address);
   558              if (ciphertext === null) { met = refuse("value-absent"); continue; }
   559              const opened = openPrivateBody({ ciphertext, under: { bagId: args.bagId, key }, ref: args.ref, authorized });
   560              if ("plaintext" in opened) return { plaintext: opened.plaintext, keyVersion };
