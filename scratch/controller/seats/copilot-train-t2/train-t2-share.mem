1    /**
     2     * key-class.test — EVERY KEY NAMES ITS CLASS in the one custody reading (`custodyStatus`, printed by `vault status`).
     3     *
     4     * The vocabulary stands closed in mesh (`device-minted` · `seed` · `cloud-synced` · `relation`). The custody status
     5     * reads each standing file ONCE and carries three facts on that one line, and none answers for another:
     6     *   `keyClass` — what kind of secret the file holds, off its row of the carrier table;
     7     *   `custody`  — which custody key holds it (`floor` · `floor-plain` · `hot` · `cold`), off the same row;
     8     *   `reading`  — what the bytes standing there read as.
     9     * Three rows read `seed` and their face rows rest `face-cold`; a sweep keyed on the class alone could not tell a sealed root
    10     * from a bare one, so the reading rides beside the class and a sealed row that reads anything but `sealed`
    11     * reads as a fault.
    12     */
    13    import { describe, test, expect } from "vitest";
    14    import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
    15    import { tmpdir } from "node:os";
    16    import { dirname, join } from "node:path";
    17    import { isKeyClass } from "@lararium/mesh";
    18    import { carrierTable, type CustodyHomes } from "../src/vault-carriers.js";
    19    import { FsCustodyIo } from "../src/custody-io.js";
    20    import { custodyStatus, foundCustody, type CustodyStatusRow } from "../src/custody-session.js";
    21
    22    function scratch(): { homes: CustodyHomes; drop: () => void } {
    23      const base = mkdtempSync(join(tmpdir(), "lar-key-class-"));
    24      const homes = { identity: join(base, "identity"), storage: join(base, "storage"), seal: join(base, "seal") };
    25      mkdirSync(homes.identity, { recursive: true });
    26      return { homes, drop: () => rmSync(base, { recursive: true, force: true }) };
    27    }
    28
    29    async function rowsOf(homes: CustodyHomes, files: Record<string, string | Uint8Array>): Promise<Map<string, CustodyStatusRow>> {
    30      for (const [name, body] of Object.entries(files)) { mkdirSync(dirname(join(homes.identity, name)), { recursive: true }); writeFileSync(join(homes.identity, name), body); }
    31      const status = await custodyStatus({ io: new FsCustodyIo(homes), homes });
    32      return new Map(status.rows.map((r) => [r.name, r]));
    33    }
    34
    35    describe("custody ⊥ secret-kind — one reading names both axes", () => {
    36      const SOWN = {
    37        ".vessel-key.json": "{}", [`faces/${"ab".repeat(16)}/veil-archive-g${"a".repeat(64)}.bin`]: "x",
    38        [`faces/${"ab".repeat(16)}/.persona-group-root-h0.json`]: "{}", [`faces/${"ab".repeat(16)}/recovery-device-share-h0.bin`]: "x",
    39      };
    40
    41      test("each key names its class and its custody off the one carrier table", async () => {
    42        const v = scratch();
    43        try {
    44          const rows = await rowsOf(v.homes, SOWN);
    45          expect(Object.fromEntries([...rows].map(([name, r]) => [name, `${r.keyClass ?? "-"} ${r.custody}`]))).toEqual({
    46            "vessel-key": "device-minted floor", [`veil-archive-g${"a".repeat(64)}`]: "device-minted face-hot",
    47            "persona-root-h0": "seed face-cold", "recovery-device-share-h0": "seed face-cold",
    48          });
    49          for (const r of rows.values()) expect(r.keyClass === null || isKeyClass(r.keyClass), r.name).toBe(true);
    50          expect([...rows.values()].some((r) => r.keyClass === "cloud-synced")).toBe(false);
    51        } finally { v.drop(); }
    52      });
    53
    54      test("RED: three seeds share a class and a custody, and the READING tells a sealed one from a bare one", async () => {
    55        const v = scratch();
    56        try {
    57          const io = new FsCustodyIo(v.homes);
    58          await foundCustody({ io, homes: v.homes, slots: [{ t: 1, pins: [{ kind: "passphrase", passphrase: "⟨test passphrase: published fixture, withheld from canon⟩" }] }] });
    59          const rows = await rowsOf(v.homes, { [`faces/${"ab".repeat(16)}/.persona-group-root-h0.json`]: "{}", [`faces/${"ab".repeat(16)}/recovery-device-share-h0.bin`]: "x" });
    60          expect(rows.get("gate-root")).toMatchObject({ keyClass: "device-minted", custody: "hot", reading: "sealed", fault: false });
    61          expect(rows.get("persona-root-h0")).toMatchObject({ keyClass: "seed", custody: "face-cold", reading: "bare", fault: true });
    62          expect(rows.get("recovery-device-share-h0")).toMatchObject({ keyClass: "seed", custody: "face-cold", reading: "bare", fault: true });
    63          // CONTROL: the floor's own key reads bare by law, and no fault.
    64          const floor = await rowsOf(v.homes, { ".vessel-key.json": "{}" });
    65          expect(floor.get("vessel-key")).toMatchObject({ custody: "floor", reading: "bare", fault: false });
    66        } finally { v.drop(); }
    67      });
    68
    69      test("an FCK frame that stands DAMAGED reads `torn` and a fault, never bare by law", async () => {
    70        const v = scratch();
    71        try {
    72          const rows = await rowsOf(v.homes, {
    73            [`faces/${"ab".repeat(16)}/recovery-device-share-h0.bin`]: Buffer.concat([Buffer.from("lares-fck-seal"), Buffer.from([1, 2, 3])]),
    74            [`faces/${"ab".repeat(16)}/recovery-device-share-h1.bin`]: "x",
    75          });
    76          expect(rows.get("recovery-device-share-h0")).toMatchObject({ reading: "torn", fault: true, bare: null });
    77          expect(rows.get("recovery-device-share-h1")).toMatchObject({ reading: "bare", fault: true, bare: null });
    78        } finally { v.drop(); }
    79      });
    80
    81      test("CONTROL: a GAP in the handle numbering throws nothing and drops nobody", async () => {
    82        const v = scratch();
    83        try {
    84          const rows = await rowsOf(v.homes, { [`faces/${"ab".repeat(16)}/recovery-device-share-h0.bin`]: "x", [`faces/${"ab".repeat(16)}/recovery-device-share-h3.bin`]: "x", [`faces/${"ab".repeat(16)}/.persona-group-root-h3.json`]: "{}" });
    85          expect([...rows.keys()].sort()).toEqual(["persona-root-h3", "recovery-device-share-h0", "recovery-device-share-h3"]);
    86        } finally { v.drop(); }
    87      });
    88    });
    89
    90    const RELATION_ROWS = ["admissions", "enroll-pending", "face-address-secret", "face-join-record", "fleet-join-pending", "grant-pending"];
    91
    92    describe("the relation class — a secret only the other party re-issues", () => {
    93      // The persona admit's three rows, and the fleet-join door's three: the face's address secret and the grants the
    94      // root re-issues, and a join's seal secret its answer alone consumes.
    95      test("the six relation rows read `relation` and hot", async () => {
