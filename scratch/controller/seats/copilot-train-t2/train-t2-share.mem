   215          return holder.sealBlob({ ...args, owedActs: () => owedActs(args.bagId) });
   216        },
   217        settle,
   218        owedFor: (bagId) => owedActs(bagId),
   219        async catchUp(rolls, vesselKey) {
   220          let taken = 0, refused = 0;
   221          const owed: string[] = [];
   222          for (const raw of rolls) {
   223            const kept = verifiedSeatRoll(raw, vesselKey);
   224            if (kept === null) { refused += 1; continue; }
   225            try { await sink(kept); taken += 1; }
   226            catch (err) { owed.push(err instanceof Error ? err.message : String(err)); }
   227          }
   228          return { taken, refused, owed };
   229        },
   230        lock() { unsubscribe(); holder.lock(); },
   231      };
