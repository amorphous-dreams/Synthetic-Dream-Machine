   108          expect(await answerSessionSign({ requestId: "w3", op: "sign", ask: "req-1", verb: "sealed-seal", payload })).toEqual({ type: "session:signed", requestId: "w3", signature: "sig-act-3" });
   109        } finally { setSessionSignDoor(null); }
