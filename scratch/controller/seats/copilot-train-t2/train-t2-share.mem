    95    // them. The DAEMON island's channel alone carries the ask (`IslandClass`): a wiki island's ask refuses by name.
    96    let custodyWriteDoor: CustodyWriteDoor | null = null;
    97
    98    /** Stand (or drop) the vessel's custody write door. */
    99    export function setCustodyWriteDoor(door: CustodyWriteDoor | null): void { custodyWriteDoor = door; }
   100
   101    /** Answer one `custody:write` ask through the door standing now. */
   102    export async function answerCustodyWrite(ask: Pick<IslandMsg_CustodyWrite, "requestId" | "carrier" | "bytes">): Promise<IslandMsg_CustodyWritten> {
   103      const base = { type: "custody:written" as const, requestId: ask.requestId };
   104      if (ask.carrier !== "veil" || !(ask.bytes instanceof Uint8Array)) {
   105        return { ...base, written: false, why: "bad custody write ask" };
   106      }
   107      const door = custodyWriteDoor;
   108      if (!door) return { ...base, written: false, why: "no custody write door stands on this vessel" };
   109      try { await door(ask.carrier, ask.bytes); return { ...base, written: true }; }
   110      catch (e) { return { ...base, written: false, why: e instanceof Error ? e.message : String(e) }; }
   111    }
   112
   113    function attachCustodyWriteDoor(w: Worker): void {
   114      w.on("message", (raw: unknown) => {
   115        const m = raw as Partial<IslandMsg_CustodyWrite> | null;
   116        if (!m || m.type !== "custody:write" || typeof m.requestId !== "string") return;
   117        void answerCustodyWrite({ requestId: m.requestId, carrier: m.carrier as CustodyWriteCarrier, bytes: m.bytes as Uint8Array }).then((reply) => {
   118          try { w.postMessage(reply); } catch { /* the worker went away — nothing to answer */ }
   119        });
   120      });
