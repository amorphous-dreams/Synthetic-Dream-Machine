   454      /** The head this vessel seals under in one founding, joining sibling heads of one span where it holds them all. */
   455      async #head(bag: Bag, line: Line, signer: RecordSigner): Promise<{ head: KeyVersionId; joined?: MintOutcome } | HolderRefusal> {
   456        const usable = this.#usable(line);
   457        const last = await this.#lastHead(line);
   458        const choice = writeHead(line.lineage, usable, last ?? undefined);
   459        // A head already held: the seal draws no key and wraps for nobody, so it runs under the vessel's own
   460        // shadow. Each reader's own standing check judges the manifest it signs.
   461        if ("head" in choice) return { head: choice.head };
   462        if ("refusal" in choice) return refuse(choice.refusal);
   463        if ("ambiguous" in choice) return refuse("head-ambiguous");
   464        // Every head held: a capable writer joins them. Heads of unlike spans join onto a fresh base, which the
   465        // document store's own checkpoint supplies; here that join refuses by name.
   466        if (new Set(choice.joinOwed.map((head) => line.lineage.fact(head)!.span)).size > 1) return refuse("join-across-spans");
   467        if (await this.#ports.ownEdgeShadowed(bag.bagId)) return refuse("own-edge-shadowed");
   468        const planned = planJoin(line.lineage, { held: usable, historyForNewSpan: "closed", ownEdgeShadowed: false });
   469        if (!("plan" in planned)) return refuse("count-refused", planned.refusal);
   470        const joined = await this.#mint(bag, line, planned.plan, signer, []);
   471        return isRefusal(joined) ? joined : { head: joined.keyVersion, joined };
   472      }
   473
   474      // ── Seal and open ─────────────────────────────────────────────────────────────────────────────
   475      /**
   476       * Seal one private body into its bag. A bag no key ever served gets founded first: `founding` declares the
   477       * span's history, and a founding with no declaration stands closed. The sealed value rests, then the
   478       * manifest that names it, then the index rows.
   479       */
   480      sealBlob(args: { readonly bagId: string; readonly plaintext: Uint8Array; readonly signer: RecordSigner | null; readonly founding?: { readonly history: HistoryDeclaration };
   481        /** The raises the vessel counted whose removal roll still owes this bag (sealed-store road, step 2: a removed
   482         *  device opens nothing a vessel seals after it counts the raise). The head this seal writes under must follow
   483         *  every one, or the seal refuses `roll-owed` and seals nothing. A founding takes no exemption: its first version
   484         *  follows no removal, so no bag founds while a raise in its scope stays owed. Read twice inside the holder's
   485         *  turn: before any key mints, and again at the commit point, after every signature and before the first byte
   486         *  rests, so a raise counted while the seal signed still refuses it. */
   487        readonly owedActs?: () => readonly string[] }): Promise<SealedBlob | HolderRefusal> {
   488        return this.#inTurn<SealedBlob>(async () => {
   489          if (!isWellFormedText(args.bagId)) return refuse("bag-malformed");
   490          if (args.signer === null) return refuse("signer-unavailable");
   491          const { store, random } = this.#ports;
   492          const bags = await this.#loaded();
   493          let founded: MintOutcome | undefined;
   494          let line = await this.#writeLine(bags.get(args.bagId));
   495          if (isRefusal(line)) {
   496            if (line.refusal !== "bag-unfounded") return line;
   497            // A founding follows no removal: while a raise in the bag's scope stays owed, no first version mints.
   498            if ((args.owedActs?.() ?? []).length > 0) return refuse("roll-owed");
   499            const made = await this.#found(bags, args.bagId, args.founding?.history ?? "closed", args.signer);
   500            if (isRefusal(made)) return made;
   501            line = made.line; founded = made.minted;
   502          }
   503          const bag = bags.get(args.bagId)!;
   504          const at = await this.#head(bag, line, args.signer);
   505          if (isRefusal(at)) return at;
   506          const owesRoll = (): boolean => (args.owedActs?.() ?? []).some((act) => !line.lineage.followsRemoval(at.head, act));
   507          if (owesRoll()) return refuse("roll-owed");
   508          const key = line.keys.get(at.head)!;
   509          const sealed = sealPrivateBody(args.plaintext, { bagId: args.bagId, key }, random);
   510          if (!("body" in sealed)) return refuse("seal-refused", sealed.refusal);
   511          const { body } = sealed;
   512          const context: SealContext = { bagId: args.bagId, keyVersion: at.head, role: "blob", logicalRef: hexToBytes(body.ref) };
   513          const earlier = await store.own(`manifest-head.${line.locator}.${at.head}`);
   514          const manifest: ManifestBody = {
   515            bag: line.locator, keyVersion: at.head, parents: earlier === null ? [] : [hex(earlier) as RecordId],
   516            entries: [{ role: "blob", address: body.cid, locator: entryLocatorOf(key, context), parents: [] }],
   517          };
   518          const signed = await this.#sign("manifest", manifest, {}, args.bagId, line.locator, key, args.signer);
   519          if (isRefusal(signed)) return signed;
   520          // THE COMMIT POINT. Every signature this seal waited on has landed; nothing of the value rests yet. A raise the
   521          // vessel counted meanwhile binds it here: the head must still follow every owed raise, or nothing rests.
   522          if (owesRoll()) return refuse("roll-owed");
   523          // A lock that landed while the manifest signed overwrote the key, so the record above never read back.
   524          await this.#rest(() => this.#ports.values.write(body.cid, body.ciphertext));
   525          const id = await this.#rest(() => store.putRecord(signed.carried));
   526          await this.#rest(() => store.putIndexRows(indexRowsOf(signed.verified)));
   527          await this.#rest(() => store.noteOwn(`manifest-head.${line.locator}.${at.head}`, hexToBytes(id)));
   528          await this.#rest(() => this.#noteHead(line, at.head));
   529          line.manifests.set(id, signed.verified);
   530          return { body, manifest: id, founding: line.locator, ...(founded ? { founded } : {}), ...(at.joined ? { joined: at.joined } : {}) };
   531        });
   532      }
