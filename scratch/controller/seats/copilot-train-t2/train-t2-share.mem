   226    /** The one content-key holder of an unlocked vessel. */
   227    export class ContentKeyHolder {
   228      readonly #ports: ContentKeyHolderPorts;
   229      #bags: Map<string, Bag> | null = null;
   230      #locked = false;
   231      #turn: Promise<unknown> = Promise.resolve();
   232
   233      constructor(ports: ContentKeyHolderPorts) { this.#ports = ports; }
   234
   235      get locked(): boolean { return this.#locked; }
   236
   237      /** Overwrite every key, forget every reading, and refuse every later ask. */
   238      lock(): void {
   239        this.#locked = true;
   240        for (const bag of this.#bags?.values() ?? []) for (const line of bag.lines.values()) {
   241          for (const key of line.keys.values()) key.fill(0);
   242          line.keys.clear(); line.records.clear(); line.carried.clear(); line.manifests.clear(); line.why.clear();
   243        }
   244        this.#bags?.clear();
   245        this.#bags = null;
   246      }
   247
   248      /** One act at a time: a mint, a seal and a reload never interleave. */
   249      #inTurn<T>(act: () => Promise<T | HolderRefusal>): Promise<T | HolderRefusal> {
   250        const run = this.#turn.then(async (): Promise<T | HolderRefusal> => {
   251          if (this.#locked) return refuse("holder-locked");
   252          try {
   253            const answer = await act();
   254            // A lock that landed while the act ran ends it: nothing it learned leaves.
   255            return this.#locked ? refuse("holder-locked") : answer;
   256          } catch (err) { return this.#locked ? refuse("holder-locked") : refuse("store-failed", said(err)); }
   257        });
   258        this.#turn = run.catch(() => undefined);
   259        return run;
