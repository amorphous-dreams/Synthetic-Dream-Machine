1    /**
     2     * The node suites read no person's git config. The vessel's display name shells `git config --global user.name`, and a
     3     * person's own global config would move what a suite sees, red on a person's box and green on CI. The shared setup file (`tests/support/scratch-custody-setup.ts`) points git's
     4     * global config at the null device, so every suite and every child it spawns reads the same empty global.
     5     */
     6    import { execFileSync } from "node:child_process";
     7    import { mkdtempSync, writeFileSync } from "node:fs";
     8    import { tmpdir } from "node:os";
     9    import { join } from "node:path";
    10    import { describe, expect, test } from "vitest";
    11
    12    const globalEmail = (env: NodeJS.ProcessEnv): string => {
    13      try { return execFileSync("git", ["config", "--global", "user.email"], { env, encoding: "utf8" }).trim(); } catch { return ""; }
    14    };
    15
    16    describe("hermetic git global", () => {
    17      test("the suite's own environment reads no global user.email", () => {
    18        expect(globalEmail(process.env)).toBe("");
    19      });
    20
    21      test("CONTROL: the instrument sees a global email when one stands", () => {
    22        const dir = mkdtempSync(join(tmpdir(), "hermetic-git-"));
    23        const file = join(dir, "gitconfig");
    24        writeFileSync(file, "[user]\n\temail = someone@example.test\n");
    25        expect(globalEmail({ ...process.env, GIT_CONFIG_GLOBAL: file })).toBe("someone@example.test");
    26      });
    27    });
