   271        return this.#reload();
   272      }
   273
   274      /** Read rest afresh: open every lockbox this seat opens, then count every record under the key it delivered. */
   275      async #reload(): Promise<Map<string, Bag>> {
   276        const { store, shore } = this.#ports;
   277        const bags = new Map<string, Bag>();
   278        const forget = (): void => { for (const bag of bags.values()) for (const line of bag.lines.values()) for (const key of line.keys.values()) key.fill(0); };
   279        try {
   280          for (const lockbox of await store.lockboxes()) {
   281            const opened = await openLockbox({ lockbox, shore });
   282            if (!("payload" in opened)) continue;
   283            const { bagId, locator, keyVersion, key } = opened.payload;
   284            let bag = bags.get(bagId);
   285            if (!bag) { bag = { bagId, lines: new Map() }; bags.set(bagId, bag); }
   286            let line = bag.lines.get(locator);
   287            if (!line) { line = { locator, lineage: KeyLineage.empty(), keys: new Map(), records: new Map(), carried: new Map(), why: new Map(), manifests: new Map() }; bag.lines.set(locator, line); }
   288            if (line.keys.has(keyVersion)) key.fill(0); else line.keys.set(keyVersion, key);
   289          }
   290          const records = await store.records("key-version");
   291          for (const bag of bags.values()) {
   292            const evidence = await this.#ports.evidenceOf(bag.bagId);
   293            for (const line of bag.lines.values()) this.#count(bag, line, records, evidence);
   294          }
   295        } catch (err) { forget(); throw err; }
   296        if (this.#locked) { forget(); throw new Error("the holder locked while it read its lockboxes"); }
