    83      /** A crash between the stage and the publish: the staged file stands, the chain and key file still name the old head. */
    84      async function stageOnly(card: Uint8Array, signerByte: number, cardRead: boolean) {
    85        const chain = await loadPlaceKelChain();
    86        const nextCold = await mintColdKey(entropy(signerByte));
    87        const signingKey = Buffer.from(new Uint8Array(32).fill(signerByte)).toString("hex");
    88        const event = mintPlaceRotation({ chain, coldSeed: card, newSignerKey: placeSignerFromSeed(new Uint8Array(32).fill(signerByte)).key, nextColdVerifyingKey: nextCold.verifyingKey });
    89        const path = join(larIdentityDir(), readdirSync(larIdentityDir()).find((n) => n.startsWith(".vessel-key"))!.replace(".vessel-key", ".vessel-rotating"));
    90        writeFileSync(path, canonicalJson(cardRead ? { event, signingKey, cardRead: true } : { event, signingKey }));
    91        return { path, event };
    92      }
    93
