   403          if (!("lockbox" in wrapped)) return refuse("wrap-failed", wrapped.cause ?? wrapped.refusal);
   404          await this.#rest(() => store.putLockbox(wrapped.lockbox));
   405          const body: KeyVersionBody = { bag: line.locator, keyVersion, parents: fact.parents, span: fact.span };
   406          const joinProofs = plan.cause.kind === "join" ? fact.parents.map((parent) => joinProofOf(line.keys.get(parent)!, keyVersion)) : [];
   407          const secret: KeyVersionPrivate = { cause: plan.cause, history: plan.history, joinProofs, unserved: [...new Set(wrapped.unreached.map(bare))].sort(ascending) };
   408          const signed = await this.#sign("key-version", body, secret, bag.bagId, line.locator, key, signer);
   409          if (isRefusal(signed)) return signed;
   410          const heldParents = new Map(fact.parents.map((parent) => [parent, line.keys.get(parent)!] as const));
   411          const evidence = await this.#ports.evidenceOf(bag.bagId);
   412          const counted = line.lineage.count(factOfRecord(signed.verified), {
   413            raiseCounts: (act) => evidence.raiseCounts(act), admissionVerifies: (act) => evidence.admissionVerifies(act),
   414            joinProven: () => joinProven(signed.verified, heldParents),
   415          });
   416          if (!("lineage" in counted)) return refuse("count-refused", counted.refusal);
