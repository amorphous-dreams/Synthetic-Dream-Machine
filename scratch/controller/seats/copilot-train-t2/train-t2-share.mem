   166
   167    const nodeKeypairCrypto: KeypairCrypto = {
   168      async generate() {
   169        const { publicKey, privateKey } = generateKeyPairSync("ed25519");
   170        const pubJwk  = publicKey.export({ format: "jwk" })  as { x: string };
   171        const privJwk = privateKey.export({ format: "jwk" }) as { d: string };
   172        return {
   173          verifyingKey: Buffer.from(pubJwk.x,  "base64url").toString("hex"),
   174          signingKey:   Buffer.from(privJwk.d, "base64url").toString("hex"),
   175        };
   176      },
