   156    function attachRestDoor(w: Worker): void {
   157      w.on("message", (raw: unknown) => {
   158        const m = raw as Partial<IslandMsg_DocRest> | null;
   159        if (!m || m.type !== "doc:rest" || typeof m.requestId !== "string" || !Array.isArray(m.documentIds)) return;
   160        if (!m.documentIds.every((id) => typeof id === "string")) return;
   161        void answerDocRest({ requestId: m.requestId, documentIds: m.documentIds, ...(m.heads && typeof m.heads === "object" ? { heads: m.heads } : {}) }).then((reply) => {
   162          try { w.postMessage(reply); } catch { /* the worker went away — nothing to answer */ }
   163        });
   164      });
   165    }
   166
   167    /**
   168     * THE CLASS OF ISLAND A WORKER STANDS AS, named at its spawn. Each class reaches the vessel doors it owns and no other:
   169     *
   170     *   daemon   the vessel's own immune core. It reaches all four: the fetch door, the rest door (it mints the
   171     *            binding documents the vessel's store saves), the custody write door (its keyhive archive exports
   172     *            cross to the main thread, which alone holds the vessel key and seals them) and the dyad door (its
   173     *            gates ask what one device's edge reads on the fleet board the main thread folds; no door standing,
   174     *            a door that faults and a malformed ask each read `aside`).
   175     *   wiki     an island that runs a wiki's content and plugins. It reaches the fetch door alone, for the blobs its
   176     *            own tiddlers name. Its custody write and its rest ask each refuse BY NAME on the same request id, and
   177     *            each refusal logs once per worker: code a wiki loads never writes a row under the vessel key and
   178     *            never drives the vessel's store. Its dyad ask draws `aside` and logs the same way: a wiki never
   179     *            learns what a device's edge reads.
   180     *   session  a session's island. It reaches none of the four and draws no answer: it asks through its scoped
   181     *            view alone.
   182     *
   183     * The class binds at the spawn and never moves: a worker carries no way to name itself another class.
   184     */
   185    export type IslandClass = "daemon" | "wiki" | "session";
   186
   187    /** Answer a door a wiki island may not use: the same reply shape the door gives, refused by name, logged once. */
   188    function attachRefusals(w: Worker): void {
   189      const logged = new Set<string>();
   190      const once = (name: string, door: string): void => {
   191        if (logged.has(name)) return;
   192        logged.add(name);
   193        console.warn(`[vessel-door] ${name}: a wiki island asked the ${door}; only the daemon island reaches it. The ask refused and nothing ran.`);
   194      };
   195      const reply = (msg: unknown): void => { try { w.postMessage(msg); } catch { /* the worker went away */ } };
   196      w.on("message", (raw: unknown) => {
   197        const m = raw as { type?: unknown; requestId?: unknown } | null;
   198        if (!m || typeof m !== "object" || typeof m.requestId !== "string") return;
   199        if (m.type === "custody:write") {
   200          once("CustodyDoorRefused", "custody write door");
   201          const refused: IslandMsg_CustodyWritten = {
   202            type: "custody:written", requestId: m.requestId, written: false,
   203            why: "CustodyDoorRefused: only the daemon island reaches the custody write door",
   204          };
   205          reply(refused);
   206        } else if (m.type === "doc:rest") {
   207          once("RestDoorRefused", "rest door");
   208          const refused: IslandMsg_DocRested = {
   209            type: "doc:rested", requestId: m.requestId, rested: false,
   210            why: "RestDoorRefused: only the daemon island reaches the rest door",
   211          };
   212          reply(refused);
   213        } else if (m.type === "session:sign") {
   214          once("SessionSignDoorRefused", "session sign door");
   215          const refused: IslandMsg_SessionSigned = { type: "session:signed", requestId: m.requestId, refusal: "signer-unavailable" };
   216          reply(refused);
   217        } else if (m.type === "dyad:ask") {
   218          once("DyadDoorRefused", "dyad door");
   219          const refused: IslandMsg_DyadRead = {
   220            type: "dyad:read", requestId: m.requestId, standing: "aside",
   221          };
   222          reply(refused);
   223        }
   224      });
   225    }
   226
   227    /** Wrap a worker as a handle, attaching the vessel doors its class owns ({@link IslandClass}). */
   228    export function nodeWorkerHandle(w: Worker, opts: { readonly island: IslandClass }): VesselWorkerHandle {
   229      if (opts.island === "daemon") {
   230        attachCasDoor(w);
   231        attachDyadDoor(w);
   232        attachRestDoor(w);
   233        attachCustodyWriteDoor(w);
   234        attachSessionSignDoor(w);
   235      } else if (opts.island === "wiki") {
   236        attachCasDoor(w);
   237        attachRefusals(w);
   238      }
   239      const post = w.postMessage.bind(w) as (msg: unknown, transfer?: unknown[]) => void;
   240      return {
   241        post:      (msg, transfer) => post(msg, transfer),
   242        listen:    (cb) => { w.on("message", cb); return () => { w.off("message", cb); }; },
   243        onError:   (cb) => { w.on("error",   cb); return () => { w.off("error",   cb); }; },
   244        terminate: () => { void w.terminate(); },
   245      };
   246    }
   247
   248    /** The node island-host parts shared by the daemon VM and the pool: a worker_threads
   249     *  MessageChannel port pair (the host shore types ports as the global MessagePort), and a
   250     *  worker_threads Worker spawned + wrapped as a VesselWorkerHandle. */
   251    export function nodeNewSyncChannel(): { mainPort: MessagePort; syncPort: MessagePort } {
   252      const { port1, port2 } = new MessageChannel();
   253      return { mainPort: port1 as unknown as MessagePort, syncPort: port2 as unknown as MessagePort };
   254    }
   255
   256    /** Spawn the vessel's DAEMON island: the one worker that reaches every vessel door. */
   257    export function nodeSpawnDaemonWorker(url: string | URL, workerData?: unknown): VesselWorkerHandle {
   258      return nodeWorkerHandle(new Worker(url, workerData !== undefined ? { workerData } : undefined), { island: "daemon" });
   259    }
