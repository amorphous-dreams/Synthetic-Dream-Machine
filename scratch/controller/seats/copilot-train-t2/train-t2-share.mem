   416    export async function generateOrLoadVesselIdentity(opts: { placeFoundingCard?: PlaceFoundingCard; entropy?: RandomProvider } = {}): Promise<VesselIdentity> {
   417      const idDir = identityDir();
   418      mkdirSync(idDir, { recursive: true });
   419
   420      const hint     = await readLocalOperatorHint().catch(() => ({ login: null, displayName: null }));
   421      // Keep both identity files beside the runtime store on every boot/init — the card
   422      // is re-mintable but still identity, and belongs beside its key.
