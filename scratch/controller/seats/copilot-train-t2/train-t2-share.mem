1    /**
     2     * e2e/sealed-session-store — a face's session seals and reopens a private body on a real vessel, through the real CLI's
     3     * session socket (lar:///ha.ka.ba/lararium/mesh/sealed-store#/the-store).
     4     *
     5     * THE STAND. A founds its hearth and a Nexus key; B, a vessel of the same face, lands A's fleet-join answer and dials
     6     * A's Nexus by the pin its landing wrote, so B's sessions anchor at that Nexus (a founder alone anchors at its own place,
     7     * and a place session reaches no sealed store). The daemon island holds no session key: it signs each record through
     8     * the session that placed the call, on B's main thread (the session sign door).
     9     *
    10     *   W1 — B's `h0` session seals a body into a bag its face registers: the island answers an address, a key version and
    11     *        the body's digest, and no plaintext rides the outcome
    12     *   W2 — B restarts over the same root; a fresh `h0` session opens the body by its digest, whole
    13     *   W3 — CONTROL: A's `h0` session stands at A's own place (A dials no Nexus): its seal refuses `session-anchor-place`
    14     *        and nothing seals
    15     *
    16     * The suite runs only in a STAGED target: it founds two vessels and never touches a live hearth.
    17     */
    18    import { describe, test, expect, beforeAll, afterAll } from "vitest";
    19    import { openStaged, openStagedJoinee, vesselStorageDir, type LarInstance, type StagedJoinee } from "../harness/instance.js";
    20    import { mintStagedNexusKey } from "../harness/vessel-key.js";
    21    import { openLocalSession } from "../../packages/lares-cli/src/session-connector.js";
    22
    23    const BAG = "lar:///ha.ka.ba/wikis/lares/working";
    24    const BODY = `the household's private note, sealed by a session ${process.pid}`;
    25    const staged = process.env["LAR_TARGET"] !== "live";
    26
    27    let pair: StagedJoinee | null = null;
    28    let B2: LarInstance | null = null;
    29
    30    async function crossed(v: LarInstance): Promise<void> {
    31      const line = "[lar-leaf] verdict OK — crossing open";
    32      const deadline = performance.now() + 90_000;
    33      while (!v.bootLog().includes(line) && performance.now() < deadline) await new Promise((r) => setTimeout(r, 250));
    34      if (!v.bootLog().includes(line)) throw new Error(`B never crossed A's gate:\n${v.bootLog().slice(-2000)}`);
    35    }
    36
    37    /** One call over a fresh `h0` session on `v`'s socket; a refusal answers as data. */
    38    async function call(v: LarInstance, verb: string, args: Record<string, unknown>): Promise<Record<string, unknown>> {
    39      const session = await openLocalSession({ faceRef: "h0", dataDir: vesselStorageDir(v) });
    40      try { return await session.call(verb, args, { timeoutMs: 90_000 }); }
    41      finally { await session.close(); }
    42    }
    43    const refusalOf = (answer: Record<string, unknown>): string | undefined => (answer["refusal"] as { reason?: string } | undefined)?.reason;
    44    const resultOf = (answer: Record<string, unknown>): Record<string, unknown> => {
    45      const summary = (answer["results"] as { summary?: { output?: Record<string, unknown> } } | undefined)?.summary;
    46      return summary?.output ?? {};
    47    };
    48
    49    beforeAll(async () => {
    50      if (!staged) return;
    51      pair = await openStagedJoinee({ tag: "sealed-session", riteA: async (_cli, rootA) => { await mintStagedNexusKey(rootA); } });
    52      if (!pair.B) throw new Error(`B never stood: ${pair.joinGate ?? ""}`);
    53      await crossed(pair.B);
    54    }, 600_000);
    55
    56    afterAll(async () => { await B2?.stopDaemonOnly(); await pair?.stop(); });
    57
    58    describe.runIf(staged)("a face's session reaches the sealed store on a real vessel", () => {
    59      let sealed: Record<string, unknown> = {};
    60
    61      test("W1 — B's session seals a body; the outcome names an address, a key version and a digest, and no plaintext", async () => {
    62        const answer = await call(pair!.B!, "sealed-seal", { bag: BAG, text: BODY });
    63        expect(answer["status"], JSON.stringify(answer).slice(0, 800)).not.toBe("error");
    64        sealed = resultOf(answer);
    65        expect(String(sealed["cid"]), JSON.stringify(answer).slice(0, 800)).toMatch(/^blake3:[0-9a-f]{64}$/);
    66        expect(String(sealed["keyVersion"])).toMatch(/^[0-9a-f]+$/);
    67        expect(String(sealed["ref"])).toMatch(/^[0-9a-f]{64}$/);
    68        expect(JSON.stringify(answer).includes(BODY)).toBe(false);
    69      }, 180_000);
    70
    71      test("W2 — B restarts over the same root, and a fresh session opens the body by its digest, whole", async () => {
    72        expect(sealed["ref"]).toBeTruthy();
    73        await pair!.B!.stopDaemonOnly();
    74        B2 = await openStaged({ tag: "sealed-session-B2", root: pair!.rootB, port: pair!.portB, found: async () => {} });
    75        await crossed(B2);
    76        const answer = await call(B2, "sealed-open", { bag: BAG, ref: sealed["ref"] });
    77        expect(answer["status"], JSON.stringify(answer).slice(0, 800)).not.toBe("error");
    78        const opened = resultOf(answer);
    79        expect(opened["keyVersion"]).toBe(sealed["keyVersion"]);
    80        expect(opened["cid"]).toBe(sealed["ref"]);
    81        expect(opened["bytes"]).toBe(Buffer.byteLength(BODY));
    82      }, 300_000);
    83
    84      test("W3 — CONTROL: a place session (A dials no Nexus) reaches no sealed store: `session-anchor-place`, nothing seals", async () => {
    85        const answer = await call(pair!.A, "sealed-seal", { bag: BAG, text: "x" });
    86        expect(refusalOf(answer), JSON.stringify(answer).slice(0, 800)).toBe("session-anchor-place");
    87      }, 180_000);
    88    });
