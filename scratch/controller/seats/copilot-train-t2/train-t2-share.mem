    38    function asCursor(raw: unknown): JournalCursor | undefined {
    39      if (!raw || typeof raw !== "object") return undefined;
    40      const row = raw as Record<string, unknown>;
    41      const epoch = row["epoch"];
    42      const writer = row["writer"];
    43      const seq = row["seq"];
    44      if (typeof epoch !== "string" || epoch.length === 0) return undefined;
    45      if (typeof writer !== "string" || writer.length === 0) return undefined;
    46      if (!Number.isInteger(seq) || (seq as number) < 1) return undefined;
    47      return { epoch, writer, seq: seq as number };
    48    }
    49
    50    function byKind(kind: JournalKind | undefined): (entry: JournalEntry) => boolean {
    51      if (!kind) return () => true;
    52      return (entry) => entry.kind === kind;
    53    }
    54
    55    runSovereignWorker((manifest) => {
    56      const journalEpoch = `boot-${randomUUID()}`;
    57      const journal = fileJournal(join(larDataDir(), "journal.jsonl"), journalEpoch, "node-daemon");
    58      const projectedBags = new Set<string>();
    59      for (const entry of journal.since()) {
    60        if (entry.kind !== "bag-projected") continue;
    61        projectedBags.add((entry.data as { bagId: string }).bagId);
    62      }
    63      const islandStorageDir = islandStorageDirOf(manifest);
    64      // THE ISOMORPHIC SEED LIFT: a NODE vessel reaches py/R, so it passes HULLS_FULL — makeDaemonBehavior's
    65      // ONE cap-gated seedDaemonProtocol (onEa) then seeds this vessel's FULL enactable flow-set (all three)
    66      // plus the Ui/Persona/Circle seeds, from the single site. This entry seeds nothing of its own. The seeded flow-set IS this vessel's advertised enactable-list a personagroup peer reads.
    67      const base = makeOperatorDaemonBehavior(manifest, {
    68        // The daemon wiki projects to `<root>/wikis/daemon/` through the same projector a wiki island mounts
    69        // (its working layer's carriers reach disk; the control-plane bag beneath holds no mirror); the
    70        // option also lights the daemon's projection cap.
    71        onBoot:         (ctx: IslandContext) => mountDiskProjection(manifest, ctx, { journal }),
    72        ...(restOnVessel ? { restDocuments: restOnVessel } : {}),
    73        ...(dyadOnVessel ? { dyadReading: dyadOnVessel } : {}),
    74        // THE KAHU PREDICATE'S BOARD: this vessel's charter and the admission acts its carriage board carries, read at
    75        // ACCESS through the island's own repo. Every write door into system canon asks it (kahu-canon-reach).
    76        kahuCabal:      (ctx: IslandContext) => () => readKahuCabalBoard(ctx.repo, larSealHome(), manifest.daemonAuth?.placeVerifyingKey),
    77        // THE SEALED STORE'S SHORE: the content-key holder stands in this island, beside its Keyhive identities, over
    78        // the vessel's own `sealed/`, `cad/` and cleartext-local tiers. An island with no directory of its own gets
    79        // none, and its `sealed-*` verbs refuse by name.
    80        ...(islandStorageDir !== null ? { sealedStore: nodeSealedStoreShore(islandStorageDir) } : {}),
    81        ...(sealOnVessel ? {
    82          persistVeilArchive: (bytes: Uint8Array) => sealOnVessel("veil", bytes),
    83        } : {}),
    84        // A person's answers at this island's disk shore: the same door a wiki island stands (`claimShoreVerb`),
    85        // answered from the projector this island mounts. `lares shore` reaches it by this verb, beside the
    86        // `wiki-act` line into the active wiki's island (`shore-core.ts`).
    87        shore:          async (args) => {
    88          const projector = mountedDiskProjector();
    89          return projector === null
    90            ? { ok: false, refusal: "no-disk-shore", why: "the daemon island mounts no disk projection" }
    91            : answerShore(projector, args);
    92        },
    93        events:         async (args, signal) => {
    94          const kindRaw = args["kind"];
    95          const wait = args["wait"] === true;
    96          const kind = typeof kindRaw === "string" && JOURNAL_KINDS.has(kindRaw as JournalKind)
    97            ? kindRaw as JournalKind
    98            : undefined;
    99          const cursor = asCursor(args["since"]);
   100          const match = byKind(kind);
   101          if (wait) {
   102            const waitOptions = {
   103              ...(cursor ? { cursor } : {}),
   104              ...(signal ? { signal } : {}),
   105            };
   106            const entry = await journal.waitFor(match, waitOptions);
   107            return { entries: [entry] };
   108          }
   109          return { entries: journal.since(cursor).filter(match) };
   110        },
   111        journalAppend:  async (args, invocation) => {
   112          const verdict = admitJournalAppend(invocation, args);
   113          if (!verdict.ok) {
   114            console.warn(`[journal-append] refused ${verdict.refusal}: ${verdict.why}`);
   115            return { ok: false, refusal: verdict.refusal, why: verdict.why };
   116          }
   117          if (projectedBags.has(verdict.append.data.bagId)) return { ok: true, deduped: true };
   118          const entry = journal.append(verdict.append.kind, verdict.append.data);
   119          projectedBags.add(verdict.append.data.bagId);
   120          return { ok: true, entry };
   121        },
   122        // The crossing gate reads each bag's declared cap-tier off this vessel's hearth manifests,
   123        // so an outward transfer (veil-ward -> public-ward) refuses without the kahu-cabal.
   124        bagTier:        makeBagTierReader(),
   125        runnableHulls:  HULLS_FULL,
   126      });
   127      return {
   128        onEa:     (ctx) => base.onEa(ctx),
   129        onSignal: (type, raw, ctx) => base.onSignal(type, raw, ctx),
   130        // The daemon-loop reconcile CADENCE at its real hook (F5), FEATURE-GATED OFF: runReconcileCadence()
   131        // reads LIFECYCLE_GATES_DEFAULT → daemonLoopReconcile:false → a no-op ({ran:false}). There and unused;
   132        // flipping the gate ON turns onHooAnu into the k8s-style continuous reconcile over every sensorium.
   133        onHooAnu: (ctx) => { runReconcileCadence(); return base.onHooAnu(ctx); },
