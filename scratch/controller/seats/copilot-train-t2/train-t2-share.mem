    41    function asCursor(raw: unknown): JournalCursor | undefined {
    42      if (!raw || typeof raw !== "object") return undefined;
    43      const row = raw as Record<string, unknown>;
    44      const epoch = row["epoch"];
    45      const writer = row["writer"];
    46      const seq = row["seq"];
    47      if (typeof epoch !== "string" || epoch.length === 0) return undefined;
    48      if (typeof writer !== "string" || writer.length === 0) return undefined;
    49      if (!Number.isInteger(seq) || (seq as number) < 1) return undefined;
    50      return { epoch, writer, seq: seq as number };
    51    }
