   386          publishFile(files.stage, canonicalJson({ event, signingKey, cardRead: true }));
   387          reconcileFiles(files, hint.login);
   388          return { event, aid: reading.aid, seq: event.seq };
   389        });
   390      } finally { next.seed.fill(0); signer.fill(0); }
   391    }
