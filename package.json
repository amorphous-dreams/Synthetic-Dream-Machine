{
  "name": "synthetic-dream-machine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build && node tools/stamp-build.mjs .",
    "build:clean": "pnpm -r clean && pnpm -r build && node tools/stamp-build.mjs .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:fresh": "pnpm -r build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:witness": "tools/typecheck-witness.sh",
    "lint": "pnpm -r lint",
    "dev": "concurrently -n node,vite -c magenta,cyan \"pnpm --filter @lararium/node dev\" \"pnpm --filter @lararium/web dev\"",
    "test:unit": "pnpm -r test",
    "test:sigil-alignment": "pnpm --filter @lararium/tw5 test:sigil-alignment",
    "test:e2e": "pnpm --filter @lares/harness test:e2e",
    "witness:founding": "tools/founding-witness.sh",
    "witness:memes": "tools/meme-coordinates-witness.sh",
    "witness:contract": "tools/contract-witness.sh",
    "witness:parity": "tools/surface-parity-witness.sh",
    "witness:domains": "tools/domain-registry-witness.sh",
    "witness:deps": "tools/exact-deps-witness.sh",
    "witness:rite": "tools/rite-commands-witness.sh",
    "witness:roundtrip": "tools/round-trip-witness.sh",
    "witness": "tools/witness-all.sh",
    "test:e2e:live": "pnpm --filter @lares/harness test:live"
  },
  "devDependencies": {
    "@lares/cli": "workspace:*",
    "@types/node": "26.4.0",
    "concurrently": "10.0.5",
    "playwright": "1.62.1",
    "playwright-mcp-wsl": "1.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "tree-sitter-cli"
    ],
    "overrides": {
      "vite": "^8.0.10"
    }
  }
}
