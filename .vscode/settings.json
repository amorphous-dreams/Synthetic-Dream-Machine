{
    // Point Python tooling at the project venv.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    // Do NOT let the Python extensions TYPE `source .../activate` into terminals —
    // that text leaks into whatever foreground process is reading stdin (e.g. Claude Code)
    // when VSCode reloads. Instead we put the venv on PATH via the terminal env below.
    // `python.terminal.activateEnvironment` governs the CLASSIC ms-python.python ext.
    "python.terminal.activateEnvironment": false,
    // The NEW ms-python.vscode-python-envs ext IGNORES the setting above and has its own:
    // it ran `source .../activate` as a shell-execution that timed out and leaked into
    // Claude's terminal on reload. "off" stops its auto-activation; the env below already
    // puts the venv on PATH, so nothing is lost.
    "python-envs.terminal.autoActivationType": "off",
    "terminal.integrated.env.linux": {
        "VIRTUAL_ENV": "${workspaceFolder}/.venv",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
    },
    "chat.mcp.serverSampling": {
        "Synthetic-Dream-Machine/.vscode/mcp.json: lararium": {
            "allowedModels": [
                "copilot/auto",
                "copilotcli/claude-haiku-4.5",
                "claude-code/claude-haiku-4.5",
                "copilot/claude-haiku-4.5",
                "copilotcli/claude-sonnet-4",
                "claude-code/claude-sonnet-4",
                "copilot/claude-sonnet-4",
                "copilotcli/claude-sonnet-4.5",
                "claude-code/claude-sonnet-4.5",
                "copilot/claude-sonnet-4.5",
                "copilotcli/claude-sonnet-4.6",
                "claude-code/claude-sonnet-4.6",
                "copilot/claude-sonnet-4.6",
                "copilot/gemini-2.5-pro",
                "copilot/gemini-3-flash-preview",
                "copilot/gemini-3.1-pro-preview",
                "copilotcli/gpt-4.1",
                "copilot/gpt-4.1",
                "copilot/gpt-4o",
                "copilotcli/gpt-5-mini",
                "copilot/gpt-5-mini",
                "copilotcli/gpt-5.2",
                "copilot/gpt-5.2",
                "copilotcli/gpt-5.2-codex",
                "copilot/gpt-5.2-codex",
                "copilotcli/gpt-5.3-codex",
                "copilot/gpt-5.3-codex",
                "copilotcli/gpt-5.4",
                "copilot/gpt-5.4",
