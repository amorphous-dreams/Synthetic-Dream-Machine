{
  // The token lives in VS Code's secret storage: the first start prompts once.
  "inputs": [
    {
      "type": "promptString",
      "id": "playwright-extension-token",
      "description": "Playwright MCP extension token",
      "password": true
    }
  ],
  "servers": {
    // playwright - Chrome extension mode
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--extension"],
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${input:playwright-extension-token}"
      }
    }
  }
}
