# Local environments / dependency installs
.venv/
.bundle/
# ROOT-ANCHORED. `bundle install --path vendor` writes here, at the repository root. Unanchored, this
# pattern matched a directory named `vendor` at ANY depth — including `bags/…/lares/api/vendor`, where
# it silently held a carrier out of the tree that every corpus gate walks.
/vendor/

# Generated site/build output
_site/
_osr/source-pdfs/
_todo/_page_renders/.cache/

node_modules/

# Generated media / archives
**/hires_*
*.zip

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python packaging/build artifacts
*.egg-info/
build/
dist/
# lararium-node generated artifacts
lares/lararium-node/snapshot.json
lares/lararium-node/fixtures.current.json

# pnpm/Node
node_modules/
packages/*/dist/
packages/*/dist-bundle/
packages/*/node_modules/
.lararium-data/

# Playwright CLI + test artifacts
.playwright-cli/
packages/lararium-web/test-results
packages/lararium-node/test-results
packages/lararium-node/playwright-report
**/playwright-report/
**/test-results/**/tests/.playwright-userdata/

# The vessel's own state lives in the operator's HOME, never in a tree, and splits by WHOSE IT IS:
# the spirits' own — store, identity, seal, social bootstrap — under <lares>; the house's, which a
# re-founding must not take — library, sensoriums — under <lararium>. Nothing is listed here because
# nothing lands here: a placement holds it out, not a rule.

# scratch wiki — operator's live editable surface, never committed.
# Named wikis (e.g. wikis/lares-history/) are checked in.
wikis/scratch/
!tests/expected/wikis/

# Integration test isolation root (LAR_ROOT=tests/).
# The daemon writes wikis/, bags/, and genesis/ under tests/ during integration runs.
tests/wikis/
tests/packages/
tests/.lararium/
tests/genesis/
tests/results/
tests/runs/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json
.mesh-test/
.swarm-run/

# local dev corpus-root marker — opt-in per install, never ship to clones (#53)
lar-dev-root.json

# Retired build output — `pnpm -r clean` MOVES dist aside rather than deleting it, so a failed build
# leaves a way back (`mv dist.prev dist`). The next clean supersedes it; none of it belongs to the repo.
**/dist.prev/

# runtime content-addressed store — vessel state (larDataDir/cas), never the repo (#54)
/cas
