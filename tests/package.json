{
  "name": "@lares/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Top-level e2e harness — drives the real lares CLI against a STAGED (ephemeral, owned) or LIVE (attached, never reset) lararium instance.",
  "scripts": {
    "test": "vitest run --config vitest.harness.config.ts",
    "test:e2e": "vitest run",
    "test:live": "LAR_TARGET=live vitest run"
  },
  "devDependencies": {
    "@automerge/automerge-repo": "2.6.0-alpha.3",
    "@automerge/automerge-repo-storage-nodefs": "2.6.0-alpha.3",
    "vitest": "4.1.11"
  }
}
